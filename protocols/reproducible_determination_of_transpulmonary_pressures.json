  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Trim data to experiment window",
      "instruction": "Delete every row in the raw data file that was recorded before the recorded start time of the experiment or after the recorded end time.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Select end‑expiratory breaths",
      "instruction": "Filter the remaining rows to keep only end‑expiratory points that satisfy both of the following criteria:\n1. Airway pressure is within ±1 cmH₂O of the set PEEP (e.g., for a set PEEP of 15 cmH₂O keep pressures between 14 and 16 cmH₂O).\n2. Flow is within ±10 L/min of zero (to allow for recording noise).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Exclude outlier transpulmonary pressures",
      "instruction": "From the column of end‑expiratory transpulmonary pressures, remove any values that are outliers according to Tukey’s rule: values smaller than Q1 − 1.5 × IQR or larger than Q3 + 1.5 × IQR are discarded. (Other outlier‑detection methods may be used, but Tukey’s rule is the default.)",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Compute median end‑expiratory pressure",
      "instruction": "Calculate the median of the remaining end‑expiratory transpulmonary pressure values; this median is the representative end‑expiratory transpulmonary pressure (PLee).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Run the R data‑processing script",
      "instruction": "Use the provided purpose‑built R script (compatible with FluxMed GrT or BIOPAC MP36R recordings) as follows:\n1. Place all raw data files in a single directory.\n2. Supply the set PEEP levels (high = 15 cmH₂O, medium = 10 cmH₂O, low = 5 cmH₂O) as input arguments.\n3. The script automatically applies steps 1‑4, removing rows outside set PEEP ± 1 cmH₂O.\n4. The script outputs a table with three columns: ID, set PEEP, and median PLee (the median end‑expiratory transpulmonary pressure for that PEEP).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
