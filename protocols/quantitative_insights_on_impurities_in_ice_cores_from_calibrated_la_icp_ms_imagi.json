  "steps": [
    {
      "step_id": 0,
      "title": "",
      "instruction": "The datasets are supporting information for the manuscript \"Quantitative Insights on Impurities in Ice Cores at the Micro-scale from Calibrated LA-ICP-MS Imaging\" submitted for consideration at Geochemistry, Geophysics, Geosystems. Measurements using ice core LA-ICP-MS imaging were performed at the Ca’Foscari University of Venice, for 23Na, 24Mg, 27Al, 56Fe and 88Sr. Impurity maps are acquired as a pattern of lines, without overlap in the direction perpendicular to that of the scan, and without any further spatial interpolation. If denoted as \"_calibrated\" the files contain concentration values as parts per billion (ppb) after matrix-matched calibration by method B described in the manuscript, using a 40 micron spot. Datasets denoted as \"MethodC_\" refer to the basic grain growth experiment described in the manuscript (Figure 4). Here uncalibrated intensities are recorded as counts for a 20 micron spot.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
