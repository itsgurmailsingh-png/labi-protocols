  "steps": [
    {
      "step_id": 0,
      "title": "Prepare tubes",
      "instruction": "Fill 1.5mL eppendorf tubes with 80µL of acetonitrile.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Add samples",
      "instruction": "Add the appropriate sample volume to the tubes based on sample type.",
      "substeps": [
        {
          "instruction": "Use 20µL of plasma or serum per tube",
          "title": ""
        },
        {
          "instruction": "Use 6µL of urine per tube",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Add internal standard",
      "instruction": "Add 6.5µL of d3-creatinine (5mg/dl) to each tube.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Mix samples",
      "instruction": "Vortex each sample for 5 seconds.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Centrifuge samples",
      "instruction": "Spin each sample at 4˚C for 10 minutes.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Transfer supernatant",
      "instruction": "Transfer the supernatant to LC/MS/MS vials.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Dry samples",
      "instruction": "Dry the samples in a speed vacuum.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Resuspend pellet",
      "instruction": "Resuspend the pellet in 75µL of LC/MS/MS Buffer.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Perform LC/MS/MS analysis",
      "instruction": "Analyze samples using liquid-chromatography/tandem mass spectrometry (LC/MS/MS).",
      "substeps": [
        {
          "instruction": "Use a Hamilton PRP-X200 column with isocratic elution",
          "title": ""
        },
        {
          "instruction": "Operate Mass Spectroscopy in MRM mode",
          "title": ""
        },
        {
          "instruction": "Monitor parent/daughter ion pair 114/44 for creatinine",
          "title": ""
        },
        {
          "instruction": "Monitor parent/daughter ion pair 117/47 for d3-creatine",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
