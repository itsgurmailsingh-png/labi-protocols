  "steps": [
    {
      "step_id": 0,
      "title": "Plate NPCs at appropriate density",
      "instruction": "Plate cells in Neural Induction Medium (NIM) on plates pre‑coated with poly‑L‑ornithine (PLO) and laminin at the following densities: 150 × 10³ cells per well in a 12‑well plate; 75‑50 × 10³ cells per well in 48‑well plates; 30 × 10³ cells per well in 8‑well chamber slides.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Replace medium after 24 h",
      "instruction": "After 24 hours, replace the NIM with cortical neuron differentiation medium consisting of Neurobasal medium supplemented with 1× B27, 20 ng/mL BDNF, 20 ng/mL GDNF, 0.5 mM cAMP, 1 % Glutamax, and 1 % penicillin/streptomycin.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
