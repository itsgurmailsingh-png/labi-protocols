    "stock solutions",
    "For 1 L , Add the stock solutions to an autoclaved bottle. Stock solutionVolume (mL)A1 stock (5X )200Vitamin B1 (1000X)1Vitamin B12 (10000X)0.1Trace metal mix (400X)2.5 Make up the media to 1 L using autoclaved Millipore water. To prevent bacterial contamination, add 1 mL of 100 mg/mL Ampicillin to the final media. One of the vitamins may not be added for the A1 vitamin drop out media."
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare 5X A1 Base Media",
      "instruction": "Prepare a 5X stock solution of the base media by adding the specified components to a media bottle and bringing to volume with water.",
      "substeps": [
        {
          "instruction": "Add CaCl2·2H2O (2.5 g/l)",
          "title": ""
        },
        {
          "instruction": "Add Glycerol (150 g/l)",
          "title": ""
        },
        {
          "instruction": "Add KCl (2 g/l)",
          "title": ""
        },
        {
          "instruction": "Add KH2PO4 (20 g/l)",
          "title": ""
        },
        {
          "instruction": "Add maleic acid (29 g/l)",
          "title": ""
        },
        {
          "instruction": "Add MgCl2 (4 g/l)",
          "title": ""
        },
        {
          "instruction": "Add Na2SO4 (15 g/l)",
          "title": ""
        },
        {
          "instruction": "Add NaCl (72 g/l)",
          "title": ""
        },
        {
          "instruction": "Add Sodium-glutamate hydrate (125 g/l)",
          "title": ""
        },
        {
          "instruction": "Add Tris base (30 g/l)",
          "title": ""
        },
        {
          "instruction": "Autoclave for 20 minutes at 15 PSI and 121 °C",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare Trace Metal Mix",
      "instruction": "Prepare a trace metal mix in an amber bottle, bring to volume with water, and filter sterilize. Do not autoclave; store in refrigerator.",
      "substeps": [
        {
          "instruction": "Add FeSO4 · 7H2O (50 g/l)",
          "title": ""
        },
        {
          "instruction": "Add CuSO4 · 5H2O (3.9 g/l)",
          "title": ""
        },
        {
          "instruction": "Add ZnSO4 · 7H2O (4.4 g/l)",
          "title": ""
        },
        {
          "instruction": "Add MnSO4 · H2O (1.5 g/l)",
          "title": ""
        },
        {
          "instruction": "Add Na2MoO4 · 2H2O (0.1 g/l)",
          "title": ""
        },
        {
          "instruction": "Add CoCl2 · 6H2O in 0.6 M HCl (0.2 g/l)",
          "title": ""
        }
      ],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Prepare Vitamin Stocks",
      "instruction": "Prepare individual vitamin solutions in amber bottles, bring to volume with water, filter sterilize separately, and refrigerate. Do not autoclave.",
      "substeps": [
        {
          "instruction": "Prepare thiamine·HCl (B1) at 5.00E-05 g/L",
          "title": ""
        },
        {
          "instruction": "Prepare cyanocobalamin (B12) at 5.00E-06 g/L",
          "title": ""
        }
      ],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Prepare 1X A1 Agar Plates",
      "instruction": "Prepare the final 1X A1 media and pour plates.",
      "substeps": [
        {
          "instruction": "Prepare 1X stock of A1 media (excluding trace metals and vitamins)",
          "title": ""
        },
        {
          "instruction": "Add 1% (w/v) agar to the 1X A1 media",
          "title": ""
        },
        {
          "instruction": "Autoclave for 20 minutes at 15 PSI and 121 °C",
          "title": ""
        },
        {
          "instruction": "Allow the solution to cool down",
          "title": ""
        },
        {
          "instruction": "Add the trace metal mix, vitamins, and appropriate antibiotics",
          "title": ""
        },
        {
          "instruction": "Pour the plates and store in the refrigerator until use",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
