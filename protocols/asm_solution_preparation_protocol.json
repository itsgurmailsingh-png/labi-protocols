  "steps": [
    {
      "step_id": 0,
      "title": "Dissolve salts",
      "instruction": "Add the specified amounts of each salt to a 1 L glass bottle and dissolve them completely.",
      "substeps": [
        {
          "instruction": "Add 4.796 g MgCl₂·6H₂O and dissolve.",
          "title": ""
        },
        {
          "instruction": "Add 0.672 g CaCl₂·2H₂O and dissolve.",
          "title": ""
        },
        {
          "instruction": "Add 10.95 mg SrCl₂·6H₂O and dissolve.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Add primary stock solutions",
      "instruction": "Add the required primary stock solutions to the bottle.",
      "substeps": [
        {
          "instruction": "Add 1 mL NaNO₃ primary stock solution (75.00 g L⁻¹).",
          "title": ""
        },
        {
          "instruction": "Add 1 mL NaH₂PO₄·H₂O primary stock solution (5.00 g L⁻¹).",
          "title": ""
        },
        {
          "instruction": "If the phytoplankton culture requires silicates, add 1 mL Na₂SiO₃·9H₂O primary stock solution (30.00 g L⁻¹).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Add deionized water",
      "instruction": "Measure and add deionized water to bring the total volume to 500 mL in the 1 L glass bottle.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Mix and autoclave preparation",
      "instruction": "Mix the final solution thoroughly and set the bottle aside until it is ready to be autoclaved.",
