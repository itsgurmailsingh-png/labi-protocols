  "quality_score": 4.5,
  "category": "Bioinformatics",
  "estimated_time_mins": 54,
  "materials": [
    "wget",
    "gunzip",
    "head",
    "tail",
    "seqkit",
    "Prodigal",
    "grep",
    "wc",
    "barrnap",
    "BEDtools",
    "Staphylococcus aureus genome (GCF_000009585.1_ASM958v1_genomic.fna.gz)"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Download and prepare genome",
      "instruction": "Download the Staphylococcus aureus genome from NCBI, unzip it, verify FASTA format, and list the file.",
      "substeps": [
        {
          "instruction": "wget ftp://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/009/585/GCF_000009585.1_ASM958v1/GCF_000009585.1_ASM958v1_genomic.fna.gz",
          "title": ""
        },
        {
          "instruction": "gunzip GCF_000009585.1_ASM958v1_genomic.fna.gz",
          "title": ""
        },
        {
          "instruction": "head GCF_000009585.1_ASM958v1_genomic.fna",
          "title": ""
        },
        {
          "instruction": "tail GCF_000009585.1_ASM958v1_genomic.fna",
          "title": ""
        },
        {
          "instruction": "ls -lh",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Compute basic genome statistics",
      "instruction": "Use seqkit to obtain size, GC content and basic per‑contig information for the downloaded genome.",
      "substeps": [
        {
          "instruction": "seqkit stats GCF_000009585.1_ASM958v1_genomic.fna",
          "title": ""
        },
        {
          "instruction": "seqkit fx2tab -l -n -g GCF_000009585.1_ASM958v1_genomic.fna",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Predict protein-coding genes with Prodigal",
      "instruction": "Run Prodigal to generate nucleotide gene sequences, protein translations, and a GFF table from the genome FASTA.",
      "substeps": [
        {
          "instruction": "prodigal -h",
          "title": ""
        },
        {
          "instruction": "prodigal -i GCF_000009585.1_ASM958v1_genomic.fna -a proteins.faa -d genes.fna -o output_table.gff",
          "title": ""
        },
        {
          "instruction": "ls",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Validate gene and protein files",
      "instruction": "Quickly inspect the output files with head and confirm that gene and protein counts match using seqkit stats.",
      "substeps": [
        {
          "instruction": "head genes.fna",
          "title": ""
        },
        {
          "instruction": "head proteins.faa",
          "title": ""
        },
        {
          "instruction": "seqkit stats genes.fna",
          "title": ""
        },
        {
          "instruction": "seqkit stats proteins.faa",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Analyze gene and protein lengths",
      "instruction": "Identify the longest and shortest genes, their GC extremes, and the longest proteins using seqkit and sort.",
      "substeps": [
        {
          "instruction": "seqkit fx2tab -i -n -g -l genes.fna | sort -rn -k2,2 | head",
          "title": ""
        },
        {
          "instruction": "seqkit fx2tab -i -n -g -l genes.fna | sort -rn -k3,3 | head",
          "title": ""
        },
        {
          "instruction": "seqkit fx2tab -i -n -g -l proteins.faa | sort -rn -k2,2 | head",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Count genes per plasmid",
      "instruction": "Determine how many predicted genes reside on each plasmid and on the chromosome.",
      "substeps": [
        {
          "instruction": "seqkit fx2tab -l -g -n GCF_000009585.1_ASM958v1_genomic.fna",
          "title": ""
        },
        {
          "instruction": "seqkit fx2tab -l -g -n genes.fna | grep \"NC_017334.1\" | wc",
          "title": ""
        },
        {
          "instruction": "seqkit fx2tab -l -g -n genes.fna | grep -v \"NC_017333.1\" | wc",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Predict rRNA and tRNA with barrnap",
      "instruction": "Run barrnap on the genome FASTA to obtain a GFF file of predicted rRNA (and tRNA) loci.",
      "substeps": [
        {
          "instruction": "barrnap -h",
          "title": ""
        },
        {
          "instruction": "barrnap GCF_000009585.1_ASM958v1_genomic.fna > rRNA.gff",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Extract rRNA sequences via BEDtools",
      "instruction": "Use BEDtools to retrieve FASTA sequences of the rRNA loci defined in the GFF file.",
      "substeps": [
        {
          "instruction": "bedtools getfasta -fi GCF_000009585.1_ASM958v1_genomic.fna -bed rRNA.gff -fo rRNA.fasta",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Inspect rRNA results",
      "instruction": "Summarize the rRNA FASTA file, list its entries, and extract the first 16S rRNA sequence.",
      "substeps": [
        {
          "instruction": "seqkit stats rRNA.fasta",
          "title": ""
        },
        {
          "instruction": "seqkit fx2tab -n -l -g rRNA.fasta",
          "title": ""
        },
        {
          "instruction": "seqkit fx2tab rRNA.fasta | grep \"NC_017333.1:564549-566098\"",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
