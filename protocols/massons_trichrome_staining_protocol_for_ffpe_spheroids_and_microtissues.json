  "steps": [
    {
      "step_id": 0,
      "title": "Mordant Formalin-Fixed Tissue",
      "instruction": "Post-fix deparaffinized slides in preheated Bouin’s solution to ensure proper mordanting.",
      "substeps": [
        {
          "instruction": "Incubate slides in Bouin’s solution for 1 hour at 56°C or overnight at room temperature (do not leave in oven overnight).",
          "title": ""
        },
        {
          "instruction": "Wash in water, discarding the first two changes into the red container aqueous waste.",
          "title": ""
        },
        {
          "instruction": "Rinse in sink with running tap water for 5-10 minutes until yellow color is removed (use warm water to accelerate removal).",
          "title": ""
        },
        {
          "instruction": "Rinse in sink with distilled water for 30 seconds.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Perform Sequential Staining and Rinsing",
      "instruction": "Process slides through the following reagent sequence according to the specified durations.",
      "substeps": [
        {
          "instruction": "Dip in Biebrich Scarlett for 5:00",
          "title": ""
        },
        {
          "instruction": "Dip in DI Water station for 3:00",
          "title": ""
        },
        {
          "instruction": "Dip in PTA/PMA Working Solution for 5:00",
          "title": ""
        },
        {
          "instruction": "Dip in Aniline Blue for 5:00",
          "title": ""
        },
        {
          "instruction": "Dip in DI Water station for 2:00",
          "title": ""
        },
        {
          "instruction": "Dip in 1% Acetic Acid for 2:00",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Dehydrate Slides",
      "instruction": "Dehydrate the slides using a series of Isopropanol (IPA) baths.",
      "substeps": [
        {
          "instruction": "Dip in 99% IPA for 0:20",
          "title": ""
        },
        {
          "instruction": "Dip in 99% IPA for 0:20",
          "title": ""
        },
        {
          "instruction": "Dip in 99% IPA for 1:00",
          "title": ""
        },
        {
          "instruction": "Dip in 99% IPA for 1:00",
          "title": ""
        },
        {
          "instruction": "Dip in 99% IPA for 1:00",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Clear and Infiltrate Slides",
      "instruction": "Clear the tissue using a Pro-Par/IPA mixture followed by pure Pro-Par.",
      "substeps": [
        {
          "instruction": "Dip in 50:50 Pro-par/IPA for 1:00",
          "title": ""
        },
        {
          "instruction": "Dip in Pro-Par for 3:00",
          "title": ""
        },
        {
          "instruction": "Dip in Pro-Par for 3:00",
          "title": ""
        },
        {
          "instruction": "Final dip in Pro-Par",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Mount and Dry Slides",
      "instruction": "Apply a resinous mounting medium to coverslip the slides.",
      "substeps": [
        {
          "instruction": "Allow slides to dry flat for a minimum of 2 hours.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
