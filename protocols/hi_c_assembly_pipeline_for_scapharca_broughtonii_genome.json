  "steps": [
    {
      "step_id": 0,
      "title": "Align Hi-C reads to genome",
      "instruction": "Align Hi-C reads to the initially assembled S. broughtonii genome using BWA (v0.7.10-r789).",
      "substeps": [
        {
          "instruction": "Run bwa index -a bwtsw fasta",
          "title": ""
        },
        {
          "instruction": "Run bwa aln -M 3 -O 11 -E 4 -t 2 fq1",
          "title": ""
        },
        {
          "instruction": "Run bwa aln -M 3 -O 11 -E 4 -t 2 fq2",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Filter mapped Hi-C reads",
      "instruction": "Filter the mapped Hi-C reads obtained from the alignment step using HiC-Pro (v. 2.10.0).",
      "substeps": [
        {
          "instruction": "Execute: mapped_2hic_fragments.py -v -S -s 100 -l 1000 -a -f -r -o",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Extract valid interaction pairs",
      "instruction": "Extract valid interaction pair reads based on the HiC-Pro results.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Prepare assembly for LACHESIS",
      "instruction": "Break the initial assembly into 300 bp fragments.",
