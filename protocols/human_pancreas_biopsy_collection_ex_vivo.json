  "steps": [
    {
      "step_id": 0,
      "title": "Label collection tube",
      "instruction": "Label a 15 mL conical tube with the internal identifier number (e.g., Rxxx) and the word “biopsy”.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Excise tissue piece",
      "instruction": "After pancreas perfusion, use surgical scissors to excise a 5 mm cubic piece of tissue from the tail of the pancreas.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Transfer tissue to tube",
      "instruction": "Using forceps, transfer the excised tissue into the labeled 15 mL conical tube.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Add fixative",
      "instruction": "Add 5 mL Z‑fix to the conical tube and securely cap the tube.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Store tube",
      "instruction": "Store the biopsy tube at 4 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Post‑fixation processing",
      "instruction": "After 24 h in fixative, process the biopsy for histology.",
      "substeps": [
        {
          "instruction": "Transfer the biopsy into PBS.",
          "title": ""
        },
        {
          "instruction": "Submit the sample to the Histology Core for paraffin embedding and slide preparation.",
          "title": ""
        },
        {
          "instruction": "Record the sample in the Histology Library Record and in REDCap.",
