  "steps": [
    {
      "step_id": 0,
      "title": "Lyse and Homogenize Sample",
      "instruction": "Homogenize the sample using TRIzol and incubate.",
      "substeps": [
        {
          "instruction": "Add 1 mL TRIzol per 50–100 mg tissue or 5–10×10^6 cells",
          "title": ""
        },
        {
          "instruction": "Homogenize thoroughly",
          "title": ""
        },
        {
          "instruction": "Incubate for 5 min at room temperature (RT)",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Perform Phase Separation",
      "instruction": "Separate the aqueous phase from the sample using chloroform.",
      "substeps": [
        {
          "instruction": "Add 0.2 mL chloroform per 1 mL TRIzol",
          "title": ""
        },
        {
          "instruction": "Vortex for 10 s",
          "title": ""
        },
        {
          "instruction": "Incubate for 10 min at RT",
          "title": ""
        },
        {
          "instruction": "Centrifuge at 12,000×g for 10 min at 4 °C",
          "title": ""
        },
        {
          "instruction": "Transfer the aqueous phase",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Precipitate RNA",
      "instruction": "Precipitate the RNA using isopropanol.",
      "substeps": [
        {
          "instruction": "Add 0.5 mL isopropanol per 1 mL TRIzol",
          "title": ""
        },
        {
          "instruction": "Invert gently",
          "title": ""
        },
        {
          "instruction": "Incubate for 10 min at RT",
          "title": ""
        },
        {
          "instruction": "Centrifuge at 12,000×g for 10 min at 4 °C",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Wash and Dry RNA Pellet",
      "instruction": "Wash the RNA pellet with ethanol and air-dry.",
      "substeps": [
        {
          "instruction": "Wash pellet 3× with 70% ethanol, centrifuging after each wash",
          "title": ""
        },
        {
          "instruction": "Air-dry for 30 min at RT",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Resuspend and Quality Control",
      "instruction": "Dissolve the RNA and verify purity before storage.",
      "substeps": [
        {
          "instruction": "Dissolve in 50 µL RNase-free water",
          "title": ""
        },
        {
          "instruction": "Measure purity (A260/A280 > 1.8)",
          "title": ""
        },
        {
          "instruction": "Store at −80 °C",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Perform Reverse Transcription",
      "instruction": "Synthesize cDNA using a 20 µL reaction mix and specific thermal program.",
      "substeps": [
        {
          "instruction": "Prepare 20 µL reaction: 1 µg RNA, 4 µL 5× PrimeScript RT Mix, and water to 20 µL",
          "title": ""
        },
        {
          "instruction": "Run program: 37 °C for 15 min, 85 °C for 5 s, and 4 °C hold",
          "title": ""
        },
        {
          "instruction": "Dilute resulting cDNA to 100 µL",
          "title": ""
        },
        {
          "instruction": "Store at −20 °C",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Prepare qPCR Reaction Mix",
      "instruction": "Set up the SYBR Green reaction in triplicates and include non-template controls (NTCs).",
      "substeps": [
        {
          "instruction": "Prepare 10 µL reaction mix: 5 µL SYBR Mix, 1 µL cDNA, 0.5 µL of each primer, and 3 µL water",
          "title": ""
        },
        {
          "instruction": "Set up triplicates and NTCs",
          "title": ""
        },
        {
          "instruction": "Seal and centrifuge the plate",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Run qPCR Thermal Cycling",
      "instruction": "Select the cycling program based on the primer melting temperature (Tm).",
      "substeps": [
        {
          "instruction": "For Tm ≥ 60 °C (Option A): 50 °C 2 min; 95 °C 2 min; 40× (95 °C 15 s, 60 °C 1 min)",
          "title": ""
        },
        {
          "instruction": "For Tm < 60 °C (Option B): 50 °C 2 min; 95 °C 2 min; 40× (95 °C 15 s, 55–60 °C 15 s, 72 °C 1 min)",
          "title": ""
        },
        {
          "instruction": "Perform Melt Curve analysis: 95 °C 15 s; 60 °C 1 min; slow ramp to 95 °C",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
