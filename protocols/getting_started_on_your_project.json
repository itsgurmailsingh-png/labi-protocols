  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Login to HPC and access cluster",
      "instruction": "Open a terminal and connect to the HPC, then SSH to the ocelote cluster.",
      "substeps": [
        {
          "instruction": "ssh hpcocelote",
          "title": ""
        },
        {
          "instruction": "ssh hpc ocelote",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Create class project directory",
      "instruction": "Make a directory for the class project, replacing \"username\" with your own user name.",
      "substeps": [
        {
          "instruction": "mkdir /rsgrps/bh_class/username",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Enter user directory",
      "instruction": "Change into the directory you just created (replace \"username\" accordingly).",
      "substeps": [
        {
          "instruction": "cd /rsgrps/bh_class/username",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Create fastq directories and enter",
      "instruction": "Create two directories for fastq files, then move into the fastq directory.",
      "substeps": [
        {
          "instruction": "mkdir fastqcd fastq",
          "title": ""
        },
        {
          "instruction": "cd fastq",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Create SRR list file",
      "instruction": "Create a plain‑text file named list that contains one SRR accession per line.",
      "substeps": [
        {
          "instruction": "nano list   # type each SRR identifier and save",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Create and edit download script",
      "instruction": "Create the job script get‑fastq.sh and insert the PBS directives and download commands exactly as shown.",
      "substeps": [
        {
          "instruction": "nano get-fastq.sh   # paste the following content:",
          "title": ""
        },
        {
          "instruction": "#!/bin/bash",
          "title": ""
        },
        {
          "instruction": "#PBS -W group_list=bh_class",
          "title": ""
        },
        {
          "instruction": "#PBS -q windfall",
          "title": ""
        },
        {
          "instruction": "#PBS -l select=1:ncpus=6:mem=12gb",
          "title": ""
        },
        {
          "instruction": "#PBS -l walltime=48:00:00",
          "title": ""
        },
        {
          "instruction": "#PBS -l cput=48:00:00",
          "title": ""
        },
        {
          "instruction": "#PBS -M username@email.arizona.edu",
          "title": ""
        },
        {
          "instruction": "#PBS -m bea",
          "title": ""
        },
        {
          "instruction": "module load unsupported",
          "title": ""
        },
        {
          "instruction": "module load nirav/sratools",
          "title": ""
        },
        {
          "instruction": "echo \"my job_id is: ${PBS_JOBID}\"",
          "title": ""
        },
        {
          "instruction": "FASTQ_DIR=\"/rsgrps/bh_class/username/fastq\"",
          "title": ""
        },
        {
          "instruction": "export FASTQ_DIR",
          "title": ""
        },
        {
          "instruction": "cd $FASTQ_DIR",
          "title": ""
        },
        {
          "instruction": "for file in `cat list`; do",
          "title": ""
        },
        {
          "instruction": "fastq-dump --outdir $FASTQ_DIR \\",
          "title": ""
        },
        {
          "instruction": "--gzip --skip-technical --readids \\",
          "title": ""
        },
        {
          "instruction": "--dumpbase --split-files --clip $file;",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        },
        {
          "instruction": "# Save and exit nano",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Make script executable",
      "instruction": "Create the script file (if not already present) and set execute permissions.",
      "substeps": [
        {
          "instruction": "touch get-fastq.sh",
          "title": ""
        },
        {
          "instruction": "chmod 755 get-fastq.sh",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Create output/error directories",
      "instruction": "Make directories to capture standard output and error from the job.",
      "substeps": [
        {
          "instruction": "mkdir std-err std-out",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Submit download job to scheduler",
      "instruction": "Submit the script to the PBS scheduler, directing output and error to the directories created above.",
      "substeps": [
        {
          "instruction": "qsub -o std-out -e std-err get-fastq.sh",
          "title": ""
        },
        {
          "instruction": "# Example job ID returned: 815336.head1.cm.cluster",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Check job status",
      "instruction": "Use qstat (optionally grepping for the job ID) to see whether the job is running or finished.",
      "substeps": [
        {
          "instruction": "qstat",
          "title": ""
        },
        {
          "instruction": "qstat | egrep 815336.head1",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
