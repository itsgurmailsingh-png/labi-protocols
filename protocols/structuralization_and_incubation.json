  "steps": [
    {
      "step_id": 0,
      "title": "Prepare and Structuralize ssDNA Library",
      "instruction": "Prepare the ssDNA library by heating and cooling to ensure proper structuralization.",
      "substeps": [
        {
          "instruction": "Add 10 μL of 100 uM ssDNA library to 190 ul of binding buffer.",
          "title": ""
        },
        {
          "instruction": "Incubate at 95 °C for 10 min.",
          "title": ""
        },
        {
          "instruction": "Transfer immediately to an ice-bath to prevent rehybridization (repeat heating for 10 min if transfer is poor).",
          "title": ""
        },
        {
          "instruction": "Incubate at 4 ºC for 10 min.",
          "title": ""
        },
        {
          "instruction": "Temper the library at room temperature for 10 min.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Incubate Library with Cells",
      "instruction": "Combine the structuralized library with cells and incubate under agitation.",
      "substeps": [
        {
          "instruction": "Resuspend 100 μL of 1 x 10^3 cells in a 1.5 ml Eppendorf tube.",
          "title": ""
        },
        {
          "instruction": "Add the library aptamer to the tube.",
          "title": ""
        },
        {
          "instruction": "Place the tube in a thermoblock set to 40 ºC and incubate with agitation for 1h.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
