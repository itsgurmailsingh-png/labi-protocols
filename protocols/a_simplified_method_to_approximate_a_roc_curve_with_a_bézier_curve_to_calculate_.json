  "materials": [
    "To start with it is recommended to set",
    "T0 = (0, 1) (vertical line) and"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Define t variable",
      "instruction": "For each empirical ROC point compute t_xy = (x + y) / 2.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Choose Bézier endpoints",
      "instruction": "Select the ROC endpoints P0 = (x0, y0) and P3 = (x3, y3). Rescale t to the interval 0‑1 using t_xy = [ (x - x0) / (x3 - x0) + (y - y0) / (y3 - y0) ] / 2.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Select shape point",
      "instruction": "Find the empirical ROC point closest to the upper‑left corner (maximal Youden index J = Se + Sp – 1); designate it as the shape point S(u) and record its t value as u.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Set endpoint tangents",
      "instruction": "Define tangent vectors at the endpoints: T0 = (g0, h0) at P0 and T3 = (g3, h3) at P3. Initialise with T0 = (0, 1) (vertical) and T3 = (1, 0) (horizontal); later adjust g0 and h3 to improve the fit.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Compute control points P1 and P2",
      "instruction": "Calculate shape parameters α and β and then the control points P1 and P2:",
      "substeps": [
        {
          "instruction": "Compute a = (1‑u)^2 · (1 + 2u) and b = u^2 · (3 ‑ 2u).",
          "title": ""
        },
        {
          "instruction": "Compute Δ = determinant | g0 g3; h0 h3 |.",
          "title": ""
        },
        {
          "instruction": "Compute α = determinant | xu ‑ a·x0 ‑ b·x3 g3; yu ‑ a·y0 ‑ b·y3 h3 | × u × (1‑u)^2 × Δ.",
          "title": ""
        },
        {
          "instruction": "Compute β = determinant | xu ‑ a·x0 ‑ b·x3 g0; yu ‑ a·y0 ‑ b·y3 h0 | × u^2 × (1‑u) × Δ.",
          "title": ""
        },
        {
          "instruction": "Set P1 = (α/3)·T0 + P0 and P2 = (β/3)·T3 + P3.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Calculate LR(t) slopes",
      "instruction": "For any t ∈ [0,1] compute the likelihood‑ratio slope LR(t) as:\nLR(t) = [P1y·(1‑2t) – (P1y‑P2y)·(2t‑3t^2) + P3y·t^2 – P0y·(1‑t)^2] / [P1x·(1‑2t) – (P1x‑P2x)·(2t‑3t^2) + P3x·t^2 – P0x·(1‑t)^2].",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
