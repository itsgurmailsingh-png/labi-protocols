{
  "protocol_id": "demultiplexing_nanopore_reads_with_last",
  "parent_protocol_id": null,
  "version_count": 1,
  "title": "Demultiplexing Nanopore Reads with LAST",
  "author": "David A Eccles",
  "doi": "dx.doi.org/10.17504/protocols.io.14egnxw4zl5d/v8",
  "source_name": "protocols_io",
  "source_url": "https://www.protocols.io/view/demultiplexing-nanopore-reads-with-last-ch35t8q6",
  "citation": "dx.doi.org/10.17504/protocols.io.14egnxw4zl5d/v8",
  "license": "CC-BY 4.0",
  "license_verified": true,
  "license_url": "",
  "license_note": "Confirmed via CrossRef DOI metadata: dx.doi.org/10.17504/protocols.io.14egnxw4zl5d/v8",
  "peer_reviewed": false,
  "stats": {
    "views": 0,
    "runs": 0,
    "bookmarks": 0,
    "comments": 0
  },
  "quality_score": 4.0,
  "category": "Genomics & Sequencing",
  "estimated_time_mins": 54,
  "materials": [
    "FASTQ files",
    "FASTA file",
    "substitution matrix",
    "Perl script"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Combine reads into gzipped file",
      "instruction": "Concatenate all FASTQ files in the directory ../called_all/ and compress them into reads_all.fastq.gz. Use the pipe viewer for progress (pv) or replace it with cat if pv is unavailable.",
      "substeps": [
        {
          "instruction": "pv ../called_all/*.fastq | gzip > reads_all.fastq.gz   # replace pv with cat if needed",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Create barcode FASTA variable",
      "instruction": "Make sure a FASTA file containing the barcode sequences (including adapters) is available (e.g., barcode_full_PBK004.fa) and store its name in a shell variable.",
      "substeps": [
        {
          "instruction": "barcodeFile=\"barcode_full_PBK004.fa\"",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Build LAST database with RY4",
      "instruction": "Create a LAST database from the barcode FASTA using the RY4 seeding scheme; this generates seven auxiliary files.",
      "substeps": [
        {
          "instruction": "lastdb -uRY4 -R01 ${barcodeFile} ${barcodeFile}",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Generate substitution matrix",
      "instruction": "Train a substitution matrix for barcode mapping with last‑train, using the barcode FASTA and the combined reads file. Include the recommended scoring parameters.",
      "substeps": [
        {
          "instruction": "# optional scoring parameters (shown in the original text)",
          "title": ""
        },
        {
          "instruction": "#last -Q 1",
          "title": ""
        },
        {
          "instruction": "#last -t4.22004",
          "title": ""
        },
        {
          "instruction": "#last -a 16",
          "title": ""
        },
        {
          "instruction": "#last -A 15",
          "title": ""
        },
        {
          "instruction": "#last -b 4",
          "title": ""
        },
        {
          "instruction": "#last -B 5",
          "title": ""
        },
        {
          "instruction": "#last -S 1",
          "title": ""
        },
        {
          "instruction": "last-train -Q 1 -P 10 ${barcodeFile} reads_all.fastq.gz > bc.mat",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Map reads to barcodes with LAST",
      "instruction": "Run LAST in split mode with the custom matrix to assign each read to a barcode, producing a gzipped two‑column file (barcode → read‑ID). Adjust stringency with the -D option if desired.",
      "substeps": [
        {
          "instruction": "lastal --split -p bc.mat -P 10 ${barcodeFile} > barcode_assignments.txt.gz   # default -D 1e6",
          "title": ""
        },
        {
          "instruction": "lastal --split -D 1e5 -p bc.mat -P 10 ${barcodeFile} > barcode_assignments.txt.gz   # more permissive",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Demultiplex reads by barcode",
      "instruction": "Create an output directory and use fastx-fetch.pl to extract reads for each barcode, also writing read lengths. By default only uniquely assigned reads are kept; add -chimeric to duplicate chimeric reads.",
      "substeps": [
        {
          "instruction": "mkdir -p demultiplexed",
          "title": ""
        },
        {
          "instruction": "fastx-fetch.pl -lengths -demultiplex barcode_assignments.txt.gz \\",
          "title": ""
        },
        {
          "instruction": "-prefix 'demultiplexed/reads' barcode_counts.txt",
          "title": ""
        },
        {
          "instruction": "# To also output chimeric reads:",
          "title": ""
        },
        {
          "instruction": "fastx-fetch.pl -lengths -demultiplex -chimeric barcode_assignments.txt.gz \\",
          "title": ""
        },
        {
          "instruction": "-prefix 'demultiplexed/reads' barcode_counts.txt",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Plot read‑length QC",
      "instruction": "Feed the length files generated in the previous step to the R script length_plot.r to produce a multi‑page PDF (Sequence_curves.pdf) with various length‑distribution plots.",
      "substeps": [
        {
          "instruction": "length_plot.r demultiplexed/lengths_*.txt.gz",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Optional: run bundled fastq‑dental script",
      "instruction": "Execute the provided Perl wrapper to perform the whole workflow in one command and obtain a summary count table.",
      "substeps": [
        {
          "instruction": "./fastq-dental.pl -barcode barcode_full_PBK004.fa -mat bc.mat reads_all.fastq.gz",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
