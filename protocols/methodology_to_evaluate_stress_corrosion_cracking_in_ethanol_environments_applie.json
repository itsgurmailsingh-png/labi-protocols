  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Fabricate welded pipe specimens",
      "instruction": "Join API 5 L X70 steel pipe sections (609.6 mm external diameter, 20.6 mm wall thickness) by circumferential multi‑pass welding using ER70S‑3 electrodes for the TIG root pass and E8010‑G coated electrodes for filler and finish passes; employ a single half‑V bevel groove as shown in Fig. 1 and machine the welded joint into fatigue‑crack‑growth (FCG) and slow‑strain‑rate (SSR) specimens that expose the heat‑affected zone (HAZ), weld metal (WM) and base metal (BM) for subsequent testing.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare synthetic ethanolic solution",
      "instruction": "Make a fuel‑grade ethanol test solution containing 3.75 vol % ethanol‑free gasoline, 1 vol % deionized water, 0.5 vol % methanol, 56 mg L⁻¹ acetic acid, 32 mg L⁻¹ sodium chloride, and balance anhydrous ethanol (99.8 % P.A.) following the procedure below.",
      "substeps": [
        {
          "instruction": "Obtain ethanol‑free gasoline: mix common gasoline with distilled water 1:1, shake vigorously to form two phases, then drain off the aqueous (ethanol + water) phase.",
          "title": ""
        },
        {
          "instruction": "Dissolve NaCl in deionized water; add acetic acid and methanol and stir until fully dissolved.",
          "title": ""
        },
        {
          "instruction": "Add the resulting aqueous mixture to the required volume of anhydrous ethanol and shake to mix.",
          "title": ""
        },
        {
          "instruction": "Add the ethanol‑free gasoline to the ethanol mixture and mechanically agitate until a homogeneous solution is obtained.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
