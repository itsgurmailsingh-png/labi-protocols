  "steps": [
    {
      "step_id": 0,
      "title": "Coat 96-well plate",
      "instruction": "Coat a 96-well plate with Matrigel and incubate.",
      "substeps": [
        {
          "instruction": "Add 50 μl Matrigel per well.",
          "title": ""
        },
        {
          "instruction": "Incubate at 37 °C for 1 hour.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare wells for picking",
      "instruction": "Replace Matrigel with growth medium and Rock Inhibitor.",
      "substeps": [
        {
          "instruction": "Aspirate Matrigel from the wells.",
          "title": ""
        },
        {
          "instruction": "Replace with 50 µL mTesR1 supplemented with 10 μM Rock Inhibitor.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Pick individual clones",
      "instruction": "Transfer individual clones into unique wells using a p20 pipette.",
      "substeps": [
        {
          "instruction": "Pick individual clones and place them into unique wells.",
          "title": ""
        },
        {
          "instruction": "Use a new pipette tip for each clone.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Incubate clones",
      "instruction": "Incubate the plate at 37 °C overnight.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
