  "steps": [
    {
      "step_id": 0,
      "title": "Import Qiskit libraries and configure account",
      "instruction": "Import the required Qiskit modules and, if needed, load your IBM Quantum account.",
      "substeps": [
        {
          "instruction": "from qiskit import QuantumRegister, ClassicalRegister, QuantumCircuit, execute, Aer, IBMQ",
          "title": ""
        },
        {
          "instruction": "from qiskit.compiler import transpile, assemble",
          "title": ""
        },
        {
          "instruction": "from qiskit.tools.jupyter import *",
          "title": ""
        },
        {
          "instruction": "from qiskit.visualization import *",
          "title": ""
        },
        {
          "instruction": "from numpy import pi",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Create quantum and classical registers",
      "instruction": "Define a one‑qubit quantum register, a one‑bit classical register, and combine them into a circuit.",
      "substeps": [
        {
          "instruction": "qreg_q = QuantumRegister(1, 'q')",
          "title": ""
        },
        {
          "instruction": "creg_c = ClassicalRegister(1, 'c')",
          "title": ""
        },
        {
          "instruction": "circuit = QuantumCircuit(qreg_q, creg_c)",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Set input vector values",
      "instruction": "Assign the two input features for the XOR problem.",
      "substeps": [
        {
          "instruction": "x1 = 0.0",
          "title": ""
        },
        {
          "instruction": "x2 = 1.0",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Define trainable parameters",
      "instruction": "Hard‑code the parameters that solve the XOR problem on the Bloch sphere.",
      "substeps": [
        {
          "instruction": "theta1 = pi",
          "title": ""
        },
        {
          "instruction": "theta2 = pi",
          "title": ""
        },
        {
          "instruction": "alpha = -pi/2",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Build parametrized quantum circuit",
      "instruction": "Construct the circuit that encodes the inputs and parameters, then measure the qubit.",
      "substeps": [
        {
          "instruction": "circuit.reset(qreg_q[0])",
          "title": ""
        },
        {
          "instruction": "circuit.h(qreg_q[0])",
          "title": ""
        },
        {
          "instruction": "circuit.rz(x1 * theta1 + alpha, qreg_q[0])",
          "title": ""
        },
        {
          "instruction": "circuit.rx(x2 * theta2 + alpha, qreg_q[0])",
          "title": ""
        },
        {
          "instruction": "circuit.measure(qreg_q[0], creg_c[0])",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Select simulation backend",
      "instruction": "Choose the Aer simulator (or optionally a real device such as ibmqx2) for execution.",
      "substeps": [
        {
          "instruction": "sim = Aer.get_backend('aer_simulator')",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Assemble circuit for execution",
      "instruction": "Convert the circuit into a Qobj with 1024 shots.",
      "substeps": [
        {
          "instruction": "qobj = assemble(circuit, shots=1024)",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Run experiment and retrieve results",
      "instruction": "Execute the assembled job on the selected backend and obtain the measurement counts.",
      "substeps": [
        {
          "instruction": "result = sim.run(qobj).result()",
          "title": ""
        },
        {
          "instruction": "counts = result.get_counts()",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Visualize measurement outcomes",
