  "steps": [
    {
      "step_id": 0,
      "title": "Prepare 95% Ethanol Solution",
      "instruction": "Prepare a 95% ethanol solution in a 15 mL centrifuge tube.",
      "substeps": [
        {
          "instruction": "Add 14.25 mL ethanol to the tube.",
          "title": ""
        },
        {
          "instruction": "Add 0.75 mL autoclaved deionized water.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare 5 mM ATRA Stock Solution",
      "instruction": "Prepare a 5 mM stock solution of All-trans-retinoic acid (ATRA), ensuring the process is done with lights off due to light sensitivity.",
      "substeps": [
        {
          "instruction": "Weigh out 5 mg ATRA.",
          "title": ""
        },
        {
          "instruction": "Transfer 3330 µL of the prepared 95% EtOH solution to another 15 mL centrifuge tube.",
          "title": ""
        },
        {
          "instruction": "Add the 5 mg ATRA to the 3330 µL 95% EtOH solution.",
          "title": ""
        },
        {
          "instruction": "Vortex mix the solution.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Aliquot and Store ATRA Stock",
      "instruction": "Aliquot the ATRA stock solution and store at 4 °C for up to 6 weeks.",
      "substeps": [
        {
          "instruction": "Create 10 aliquots, each containing 62 µL (intended for 10 batches of 30 mL media using 60 µL each to reach a final concentration of 10 μM).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Prepare 20x L-glutamine Stock Solution",
      "instruction": "Prepare a 20x L-glutamine stock solution (80 mM) for a final desired concentration of 4 mM.",
      "substeps": [
        {
          "instruction": "Aliquot 15 mL NBM into a 15 mL centrifuge tube.",
          "title": ""
        },
        {
          "instruction": "Add l-glutamine to the NBM.",
          "title": ""
        },
        {
          "instruction": "Vortex mix the solution.",
          "title": ""
        },
        {
          "instruction": "Aliquot the solution into 10 aliquots of 1.5 mL each.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Store L-glutamine Aliquots",
      "instruction": "Store the 20x L-glutamine aliquots at -20 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Prepare Components for Media Mixing",
      "instruction": "Prepare the necessary components immediately before changing the media in the flask to prevent degradation.",
      "substeps": [
        {
          "instruction": "Warm 30 mL NBM in a water bath.",
          "title": ""
        },
        {
          "instruction": "Thaw one 50x B-27 supplement aliquot.",
          "title": ""
        },
        {
          "instruction": "Thaw one 20x l-glutamine supplement aliquot.",
          "title": ""
        }
      ],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Combine Differentiation Media",
      "instruction": "In a biosafety cabinet, combine the following components in a 50 mL tube:",
      "substeps": [
        {
          "instruction": "29.34 mL Neurobasal Medium",
          "title": ""
        },
        {
          "instruction": "600 µL 50x B-27 Supplement",
          "title": ""
        },
        {
          "instruction": "1.5 mL 20x l-glutamine Stock Solution",
          "title": ""
        },
        {
