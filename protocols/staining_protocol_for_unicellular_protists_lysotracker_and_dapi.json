      "timers": []
    },
    {
      "step_id": 1,
      "title": "Wash cells",
      "instruction": "Perform two washes of the cells using 1XPBS.",
      "substeps": [
        {
          "instruction": "Wash cells with 1XPBS (1/2).",
          "title": ""
        },
        {
          "instruction": "Wash cells with 1XPBS (2/2).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Resuspend cells",
      "instruction": "Resuspend the cells in 1mL of 1xPBS.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Stain with Lysotracker",
      "instruction": "Stain cells with Lysotracker dye at a 1/1000 dilution (1 uL of dye for a 1mL final volume of cells).",
      "substeps": [
        {
          "instruction": "Incubate for 20 minutes at room temperature, protecting the sample from light.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Stain with DAPI",
      "instruction": "Stain cells with DAPI dye at a 1/1000 dilution.",
      "substeps": [
        {
          "instruction": "Incubate for 5 minutes at room temperature, protecting the sample from light.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Wash and resuspend cells",
      "instruction": "Wash the stained cells and prepare for mounting.",
      "substeps": [
        {
          "instruction": "Wash with 1xPBS (1/2).",
          "title": ""
        },
        {
          "instruction": "Wash with 1xPBS (2/2).",
          "title": ""
        },
        {
          "instruction": "Centrifuge at 1000g for 5 minutes.",
          "title": ""
        },
        {
