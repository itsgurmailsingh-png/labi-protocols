      "title": "Fix cells with PFA",
      "instruction": "Fix 1mL of cells by adding PFA drop by drop with careful mixing to reach a final concentration of 2% PFA.",
      "substeps": [
        {
          "instruction": "Incubate cells for 4 minutes at room temperature.",
          "title": ""
        },
        {
          "instruction": "Centrifuge at 1000g for 5 minutes.",
          "title": ""
        }
      ],
