  "steps": [
    {
      "step_id": 0,
      "title": "Prepare lysis mixture",
      "instruction": "Add 10 g sediment sample, 6 mL 0.33 M sodium hydroxide, and 3 mL Tris‑EDTA (pH 8) into a 50 mL tube.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Lyse and incubate",
      "instruction": "Vortex the tube for 1 minute, then incubate at 65 °C for 50 minutes.",
      "substeps": [
        {
          "instruction": "Vortex 1 minute",
          "title": ""
        },
        {
          "instruction": "Incubate at 65 °C for 50 minutes",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Cool and centrifuge",
      "instruction": "Allow the sample to cool to room temperature, then centrifuge at 15 000 × g for 1 hour.",
      "substeps": [
        {
          "instruction": "Cool to room temperature",
          "title": ""
        },
        {
          "instruction": "Centrifuge at 15 000 × g for 1 hour",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Transfer supernatant and neutralize",
      "instruction": "Transfer 7.5 mL of supernatant to a new 50 mL tube and add 7.5 mL 1 M Tris‑HCl (pH 6.7) to neutralize.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Precipitate DNA",
      "instruction": "Add 1.5 mL 3 M sodium acetate (pH 5.2) and 30 mL molecular‑grade 100 % ethanol, then incubate at –20 °C for less than 1 hour.",
      "substeps": [
        {
          "instruction": "Add 1.5 mL 3 M sodium acetate (pH 5.2)",
          "title": ""
        },
        {
          "instruction": "Add 30 mL molecular‑grade 100 % ethanol",
          "title": ""
        },
        {
          "instruction": "Incubate at –20 °C for < 1 hour",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Pellet DNA",
      "instruction": "Centrifuge at 10 000 × g for 1 hour, discard the supernatant, and retain the precipitated pellet.",
      "substeps": [
        {
          "instruction": "Centrifuge at 10 000 × g for 1 hour",
          "title": ""
        },
        {
          "instruction": "Discard supernatant",
          "title": ""
        },
        {
          "instruction": "Retain pellet",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Purify DNA",
      "instruction": "Extract the pellet using the DNeasy PowerSoil DNA Isolation Kit (0.25–0.5 g pellet per extraction) following the manufacturer’s instructions, pool the resulting DNA eluates; DNA is now ready for downstream applications.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
