  "steps": [
    {
      "step_id": 0,
      "title": "Initiate Differentiation",
      "instruction": "Aspirate E8 medium from cells (previously seeded according to standardized single cell seeding protocol) and replace with E6 medium.",
      "substeps": [
        {
          "instruction": "Add 2 mL of E6 medium per well on day 0",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Maintain E6 Treatment",
      "instruction": "Perform daily medium changes using E6 medium.",
      "substeps": [
        {
          "instruction": "Add 2 mL of E6 medium per well every day",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Induce Endothelial Differentiation",
      "instruction": "On day 4 of E6 treatment, replace medium with EC medium supplemented with bFGF and RA.",
      "substeps": [
        {
          "instruction": "Aspirate existing medium",
          "title": ""
        },
        {
          "instruction": "Add 2 mL of EC medium containing basic fibroblast growth factor (bFGF) and 10 µM RA to each well",
          "title": ""
        },
        {
          "instruction": "Do not change medium during the expansion phase",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Subculture BBB Cells",
      "instruction": "On day 6, subculture the differentiated BBB cells onto plates and Transwell filters.",
      "substeps": [
        {
          "instruction": "Follow the 'Protocol for Subculture of Differentiated Blood-Brain Barrier Endothelial Cells onto Plates and Filters by Emma Neal'",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
