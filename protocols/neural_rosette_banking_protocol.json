  "steps": [
    {
      "step_id": 0,
      "title": "Prepare 2x Serum-Free Neural Freezing Medium",
      "instruction": "Prepare a 2x stock of serum-free neural freezing medium and store at 4 °C for up to 4 weeks.",
      "substeps": [
        {
          "instruction": "Add 10 mL of sterile DMSO to 40 mL of sterile KOSR in a 50 mL conical tube.",
          "title": ""
        },
        {
          "instruction": "Mix by inverting 3-4 times.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare Neural Rosette Clusters",
      "instruction": "Aspirate the supernatant from the 15 mL conical tube containing one well of neural rosette clusters.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Freeze Neural Rosette Clusters",
      "instruction": "Combine the clusters with induction and freezing media and aliquot into cryovials.",
      "substeps": [
        {
          "instruction": "Add 1.5 mL of neural induction media and 1.5 mL of 2x neural freezing medium to the single well collection of neural rosette clusters.",
          "title": ""
        },
        {
          "instruction": "Gently mix the solution.",
          "title": ""
        },
        {
          "instruction": "Distribute 1 mL of the mixture into sterile cryovials.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Store Cryovials",
      "instruction": "Perform a staged cooling process for long-term storage.",
      "substeps": [
        {
          "instruction": "Store cryovials at -80 °C for at least 48 hours.",
          "title": ""
        },
        {
          "instruction": "Transfer cryovials to liquid nitrogen for long-term storage.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
