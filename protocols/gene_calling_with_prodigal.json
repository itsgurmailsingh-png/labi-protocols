  "steps": [
    {
      "step_id": 0,
      "title": "Log in to HPC",
      "instruction": "Open a terminal and SSH to the HPC, then change to the ocelote node.",
      "substeps": [
        {
          "instruction": "$ ssh hpc",
          "title": ""
        },
        {
          "instruction": "$ ocelote",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Enter class directory",
      "instruction": "Change to your class directory, replacing *username* with your own user name.",
      "substeps": [
        {
          "instruction": "$ cd /rsgrps/bh_class/username",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Create PBS script",
      "instruction": "Create a new file named **run-interactive.sh** and paste the following PBS directives, replacing *netid* with your own email address:",
      "substeps": [
        {
          "instruction": "#!/bin/bash",
          "title": ""
        },
        {
          "instruction": "#PBS -W group_list=bh_class",
          "title": ""
        },
        {
          "instruction": "#PBS -q windfall",
          "title": ""
        },
        {
          "instruction": "#PBS -l select=1:ncpus=2:mem=4gb",
          "title": ""
        },
        {
          "instruction": "#PBS -l walltime=24:00:00",
          "title": ""
        },
        {
          "instruction": "#PBS -l cput=24:00:00",
          "title": ""
        },
        {
          "instruction": "#PBS -M netid@email.arizona.edu   # replace netid",
          "title": ""
        },
        {
          "instruction": "#PBS -m bea",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Submit script interactively",
      "instruction": "Submit the script to the scheduler in interactive mode.",
      "substeps": [
        {
          "instruction": "$ qsub -I run-interactive.sh",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Return to class directory",
      "instruction": "When the interactive job starts, change back to your class directory.",
      "substeps": [
        {
          "instruction": "$ cd /rsgrps/bh_class/username",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Navigate to assembly folder",
      "instruction": "Change to the directory that contains **final_contigs.fa** (it may be *assembly* or another folder such as *megahit-out*).",
      "substeps": [
        {
          "instruction": "$ cd /rsgrps/bh_class/username/assembly",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Run Prodigal gene calling",
      "instruction": "Execute Prodigal on *final_contigs.fa* and write the outputs to a *prodigal* sub‑directory in your class folder. Use either absolute or relative paths as shown.",
      "substeps": [
        {
          "instruction": "$ prodigal -i /path/to/final_contigs.fa -o /rsgrps/bh_class/username/prodigal/gene_calls -a /rsgrps/bh_class/username/prodigal/proteins.faa -d /rsgrps/bh_class/username/prodigal/nucleotides.fna",
          "title": ""
        },
        {
          "instruction": "$ prodigal -i final_contigs.fa -o ../prodigal/gene_calls -a ../prodigal/proteins.faa -d ../prodigal/nucleotides.fna",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Verify gene call files",
      "instruction": "Enter the *prodigal* directory and confirm that the gene call file was created.",
      "substeps": [
        {
          "instruction": "$ cd /rsgrps/bh_class/username/prodigal",
          "title": ""
        },
        {
          "instruction": "$ head gene_calls",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Count detected ORFs",
      "instruction": "Use Unix commands or a short script to count the number of ORFs (genes) in *gene_calls* and create a table summarising the count.",
      "substeps": [
        {
          "instruction": "# Example using grep:",
          "title": ""
        },
        {
          "instruction": "grep -c '^>' gene_calls   # number of ORFs",
          "title": ""
        },
        {
          "instruction": "# Save the result to a table as needed",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
