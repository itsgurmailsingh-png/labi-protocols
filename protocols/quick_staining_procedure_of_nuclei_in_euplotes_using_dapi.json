      "step_id": 0,
      "title": "Fix Euplotes cells",
      "instruction": "Mix concentrated Euplotes cells (preferably from a completely starved culture to avoid autofluorescence from bacteria/algae) with 70% Ethanol in a 1:1 ratio.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Stain with DAPI",
      "instruction": "Add DAPI (0.01 mg/ml) to the mixture in a 1:10 ratio and incubate for 15 minutes at room temperature.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
