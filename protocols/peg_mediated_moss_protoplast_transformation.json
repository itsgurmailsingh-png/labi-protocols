.... 1mL Stock D....................................................................................... 1mL Stock AT...................................................................................... 1mL Stock TE...................................................................................... 100µL D-Mannitol (Sigma)..................................................................... 12g (6%) Agar............................................................................................ 0.4g (0.4%) dH 2 O.......................................................................................... QSP 100mL Autoclave Add CaCl2 to 10mM at the final concentration just before use...... 2mL Mannitol 8% D-Mannitol (Sigma)..................................................................... 32g dH 2 O.......................................................................................... QSP 400mL Autoclave Driselase from Basidiomycetes >10% (Sigma D9515).................... 100mg in 10ml 8% mannitol note: solution may be prepared, aliquoted and stored @ -20°C before start or prepared fresh (Step 2) PEG stock solution ...................................................................... 300µL/transformation MaMg stock solution ...................................................................150µL/transformation"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare Equipment and Reagents",
      "instruction": "Set up the initial environment and prepare the enzyme solution.",
      "substeps": [
        {
          "instruction": "Turn on waterbath to 45°C.",
          "title": ""
        },
        {
          "instruction": "Flame forceps in the laminar flowhood.",
          "title": ""
        },
        {
          "instruction": "Prepare 1% driselase solution in 8% mannitol: weigh 100mg driselase into the cap of a 15ml falcon tube, add 10mL 8% mannitol in the flow hood, mix by shaking, wrap in foil, and leave for 15 minutes at room temperature.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare Transformation Reagents",
      "instruction": "Defrost and aliquot the MaMg and PEG solutions.",
      "substeps": [
        {
          "instruction": "Defrost MaMg (150µL/transformation) and PEG (300µL/transformation) in the 45°C waterbath.",
          "title": ""
        },
        {
          "instruction": "For each transformation, prepare one 2mL sterile microtube and one 10mL round-bottom tube.",
          "title": ""
        },
        {
          "instruction": "Aliquot 150µL MaMg per microtube and 300µL PEG per round-bottom tube.",
          "title": ""
        },
        {
          "instruction": "Centrifuge the PEG round-bottom tubes for 1 minute at 2000rpm to sink the liquid to the bottom.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Prepare Driselase Solution",
      "instruction": "Sterilize the driselase solution for use.",
      "substeps": [
        {
          "instruction": "Centrifuge the 1% driselase solution for 2 minutes at 2000rpm.",
          "title": ""
        },
        {
          "instruction": "Filter sterilize the supernatant using a 0.45µM filter and 10mL syringe, then transfer to a sterile 50mL falcon tube.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Isolate Protoplasts",
      "instruction": "Digest protonemal tissue to release protoplasts.",
      "substeps": [
        {
          "instruction": "Scrape protonemal tissue (max 4-5 days old) from approx. 5-6 plates with a spatula and transfer into the driselase/mannitol solution.",
          "title": ""
        },
        {
          "instruction": "Leave at room temperature with occasional gentle stirring for approx. 1 hour (do not exceed 1hr 30min) until filamentous tissue is invisible.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Purify Protoplasts",
      "instruction": "Filter and wash the protoplast suspension.",
      "substeps": [
        {
          "instruction": "Carefully place the protoplast suspension onto a 100µm filter, collect protoplasts in a sterile petri dish, and transfer to a 50mL falcon tube (wrap in foil).",
          "title": ""
        },
        {
          "instruction": "If using a Pipetboy, set to the slowest speed and let the solution run gently along the tube.",
          "title": ""
        },
        {
          "instruction": "Spin down at 700rpm for 4 minutes (acceleration: 2, brake: 0, swing rotor centrifuge).",
          "title": ""
        },
        {
          "instruction": "Remove most of the supernatant, resuspend the pellet with the remaining volume to loosen, then top up with 10mL 8% mannitol.",
          "title": ""
        },
        {
          "instruction": "Repeat the centrifugation and resuspension steps twice more.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Determine Protoplast Density",
      "instruction": "Count protoplasts using a Neubauer counting chamber before the final centrifugation.",
      "substeps": [
        {
          "instruction": "Set aside a 100µL aliquot of the suspension.",
          "title": ""
        },
        {
          "instruction": "Pipette 10µL of suspension with a cut-yellow tip onto the Neubauer counting chamber and count cells in 5 big squares.",
          "title": ""
        },
        {
          "instruction": "Calculate concentration: (number of cells x 10,000) / (number of squares).",
          "title": ""
        },
        {
          "instruction": "Total protoplasts in 10mL = ((number of cells x 10,000) / 5) x 10.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Adjust Protoplast Concentration",
      "instruction": "Resuspend protoplasts to the required density for transformation.",
      "substeps": [
        {
          "instruction": "Resuspend protoplasts in 8% mannitol to a density of 3.2 million (M) cells/mL (2x the required transformation density of 1.6M cells/mL).",
          "title": ""
        },
        {
          "instruction": "Measure the approximate volume of the protoplast suspension using a 1mL pipette and add 8% mannitol to reach the final volume needed for 2M cells/mL (Note: text mentions both 3.2M and 2M as targets; follow the specific volume calculation for the desired density).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Perform DNA Transformation",
      "instruction": "Combine DNA, MaMg, and protoplasts, then treat with PEG.",
      "substeps": [
        {
          "instruction": "Set pipettes: P1000 to 350µL, P200 to 150µL (cut tip), and P20 to the DNA volume (e.g., 10µL).",
          "title": ""
        },
        {
          "instruction": "Pipette DNA into the 2mL microtube containing MaMg.",
          "title": ""
        },
        {
          "instruction": "Pipette 150µL of protoplast suspension into the same 2mL microtube.",
          "title": ""
        },
        {
          "instruction": "Using blue tips, gently mix the MaMg+DNA+protoplast suspension by pipetting up and down twice.",
          "title": ""
        },
        {
          "instruction": "Transfer the mix to the 10mL round-bottom tube containing PEG, letting it run along the tube gently, and mix by tapping the tube 10 times.",
          "title": ""
        },
        {
          "instruction": "Repeat for each transformation.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Heat-Shock and Cool",
      "instruction": "Apply thermal stress to the protoplast mixture.",
      "substeps": [
        {
          "instruction": "Place tubes in the 45°C waterbath for exactly 5 minutes.",
          "title": ""
        },
        {
          "instruction": "Remove tubes and cool in room temperature water for 10 minutes.",
          "title": ""
        },
        {
          "instruction": "Switch off the waterbath and room lights if too bright.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Dilute PEG Mixture",
      "instruction": "Gradually dilute the mixture with 8% mannitol over 30 minutes to 1 hour.",
      "substeps": [
        {
          "instruction": "Perform 6-7 dilution steps, mixing gently by tilting the tubes.",
          "title": ""
        },
        {
          "instruction": "Step 1: Add 300µL 8% mannitol, wait 7 minutes.",
          "title": ""
        },
        {
          "instruction": "Step 2: Add 600µL 8% mannitol, wait 7 minutes. Repeat once.",
          "title": ""
        },
        {
          "instruction": "Step 3: Add 1mL 8% mannitol, wait 7 minutes. Repeat once.",
          "title": ""
        },
        {
          "instruction": "Final Step: Add 8% mannitol to fill the tube and mix by tilting.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Settle and Prepare Media",
      "instruction": "Allow protoplasts to settle and prepare the recovery media.",
      "substeps": [
        {
          "instruction": "Leave diluted protoplasts on the bench for one hour to sink.",
          "title": ""
        },
        {
          "instruction": "Add sterile CaCl2 to PRM-L and PRM-B to reach a final concentration of 10mM (2mL CaCl2 per 100mL PRM).",
          "title": ""
        },
        {
          "instruction": "Prepare 4 PRM-B plates per transformation and store at room temperature.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 11,
      "title": "Initial Recovery Incubation",
      "instruction": "Transfer protoplasts to PRM-L for overnight incubation.",
      "substeps": [
        {
          "instruction": "Spin down protoplasts at 700rpm for 4 minutes (acceleration: 2, brake: 0).",
          "title": ""
        },
        {
          "instruction": "Remove supernatant.",
          "title": ""
        },
        {
          "instruction": "Wet a 5cm Petri-dish with 5mL PRM-L, then add 5mL PRM-L to each tube, mix by pipetting once, and pour the suspension into the 5cm Petri-dish.",
          "title": ""
        },
        {
          "instruction": "Seal with Parafilm, place in a black cardboard box, and incubate at 23°C in the dark overnight.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 12,
      "title": "Secondary Recovery and Plating",
      "instruction": "Transfer protoplasts to PRM-T and plate onto PRM-B.",
      "substeps": [
        {
          "instruction": "Add CaCl2 to sterile PRM-T to reach 10mM final concentration (2mL CaCl2 per 100mL PRM-T).",
          "title": ""
        },
        {
          "instruction": "Dispense 10.5mL PRM-T into 50mL Falcon tubes per transformation and cool in a 45°C waterbath for 1 hour.",
          "title": ""
        },
        {
          "instruction": "Pour the protoplast suspension from the Petri-dishes into round-bottom tubes.",
          "title": ""
        },
        {
          "instruction": "Spin down at 700rpm for 4 minutes (acceleration: 2, brake: 0).",
          "title": ""
        },
        {
          "instruction": "Remove supernatant, add PRM-T, mix by pipetting up and down once, and pour onto PRM-B plates overlaid with cellophane (2.5mL per plate, 4 plates per transformation).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 13,
      "title": "Incubation and Selection",
      "instruction": "Incubate and transfer colonies to selective media.",
      "substeps": [
        {
          "instruction": "Incubate plates at 23°C under 16hr light conditions.",
          "title": ""
        },
        {
          "instruction": "After 5-7 days, transfer cellophane disks with protoplasts to BCDAT medium with appropriate antibiotic.",
          "title": ""
        },
        {
          "instruction": "14 days after transformation, transfer to BCDAT without antibiotics for at least 7 days.",
          "title": ""
        },
        {
          "instruction": "21 days after transformation, isolate individual colonies on BCDAT medium with appropriate antibiotic.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
