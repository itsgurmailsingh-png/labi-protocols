  "category": "Bioinformatics",
  "estimated_time_mins": 66,
  "materials": [
    "## Pick the representative sequences. mothur&#34;#unique.seqs(fasta=vagina/02.processing.data/vagina.trim.fasta)&#34;",
    "## Pick the representative sequences. mothur\"#unique.seqs(fasta=vagina/02.processing.data/vagina.trim.fasta)\""
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Convert BAM to FASTQ",
      "instruction": "Run bam2fastq to convert the raw BAM file to a FASTQ file.",
      "substeps": [
        {
          "instruction": "bam2fastq -o vagina/01.trim.data/16_s1.fq ../rawdata/RFEMpxjMAADGAAPGM-47.bam",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Trim low-quality sequences and generate group files",
      "instruction": "Trim poly‑A/T, ambiguous bases and low‑quality regions, reverse‑complement the reads, create a group file, and concatenate trimmed FASTA and QUAL files.",
      "substeps": [
        {
          "instruction": "mothur \"#trim.seqs(fasta=vagina/01.trim.data/16_s1.fa, qfile=vagina/01.trim.data/16_s1.qual, minlength=200, maxambig=1, maxhomop=10, qwindowaverage=25, qwindowsize=50, processors=8)\"",
          "title": ""
        },
        {
          "instruction": "mothur \"#reverse.seqs(fasta=vagina/01.trim.data/16_s1.trim.fasta, qfile=vagina/01.trim.data/16_s1.trim.qual)\"",
          "title": ""
        },
        {
          "instruction": "perl ../creat.group.pl vagina/01.trim.data/16_s1.trim.rc.fasta 16_s1 >> /vagina/02.processing.data/vagina.groups",
          "title": ""
        },
        {
          "instruction": "cat vagina/01.trim.data/16_s1.trim.rc.fasta >> vagina/02.processing.data/vagina.trim.fasta",
          "title": ""
        },
        {
          "instruction": "cat vagina/01.trim.data/16_s1.trim.rc.qual >> vagina/02.processing.data/vagina.trim.qual",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Filter high-quality sequences and summarize",
      "instruction": "Screen sequences for high scores, filter, make them unique, and generate a summary report.",
      "substeps": [
        {
          "instruction": "mothur \"#screen.seqs(fasta=vagina/02.processing.data/vagina.trim.unique.align, name=vagina/02.processing.data/vagina.trim.names, group=vagina/02.processing.data/vagina.groups, optimize=start-end, criteria=90, processors=8)\"",
          "title": ""
        },
        {
          "instruction": "mothur \"#filter.seqs(fasta=vagina/02.processing.data/vagina.trim.unique.good.align, vertical=T, trump=., processors=8)\"",
          "title": ""
        },
        {
          "instruction": "mothur \"#unique.seqs(fasta=vagina/02.processing.data/vagina.trim.unique.good.filter.fasta, name=vagina/02.processing.data/vagina.trim.good.names)\"",
          "title": ""
        },
        {
          "instruction": "rm vagina/02.processing.data/vagina.trim.unique.good.align vagina/02.processing.data/vagina.trim.unique.align",
          "title": ""
        },
        {
          "instruction": "mothur \"#summary.seqs(fasta=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.fasta, name=vagina/02.processing.data/vagina.trim.unique.good.filter.names)\" > vagina/02.processing.data/vagina.trim.unique.good.filter.unique.fasta.summary.log",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Pre‑cluster and remove chimeric sequences",
      "instruction": "Pre‑cluster sequences, detect chimeras with UCHIME, remove chimeric reads, and produce a summary of the cleaned dataset.",
      "substeps": [
        {
          "instruction": "mothur \"#pre.cluster(fasta=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.fasta, name=vagina/02.processing.data/vagina.trim.unique.good.filter.names, group=vagina/02.processing.data/vagina.good.groups, diffs=2)\"",
          "title": ""
        },
        {
          "instruction": "mothur \"#chimera.uchime(fasta=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.fasta, name=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.names, group=vagina/02.processing.data/vagina.good.groups, processors=8)\"",
          "title": ""
        },
        {
          "instruction": "mothur \"#remove.seqs(accnos=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.devono.uchime.accnos, fasta=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.fasta, name=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.names, group=vagina/02.processing.data/vagina.good.groups)\"",
          "title": ""
        },
        {
          "instruction": "mothur \"#summary.seqs(fasta=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.pick.fasta, name=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.pick.names)\" > vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.pick.fasta.summary.log",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Classify sequences using Greengenes reference",
      "instruction": "Create symbolic links to Greengenes reference files and classify the sequences against them.",
      "substeps": [
        {
          "instruction": "ln -s ../database/greengenes/gg_13_5_99.fasta vagina/02.processing.data/gg_13_5_99.fasta",
          "title": ""
        },
        {
          "instruction": "ln -s ../database/greengenes/gg_13_5_99.gg.tax vagina/02.processing.data/gg_13_5_99.gg.tax",
          "title": ""
        },
        {
          "instruction": "mothur \"#classify.seqs(fasta=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.pick.fasta, template=vagina/02.processing.data/gg_13_5_99.fasta, taxonomy=vagina/02.processing.data/gg_13_5_99.gg.tax, cutoff=50, processors=8)\"",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Remove mitochondrial and chloroplast reads",
      "instruction": "Delete any sequences assigned to mitochondria, cyanobacteria‑chloroplast, or unknown taxa.",
      "substeps": [
        {
          "instruction": "mothur \"#remove.lineage(fasta=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.pick.fasta, name=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.pick.names, group=vagina/02.processing.data/vagina.good.pick.groups, taxonomy=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.pick.gg.wang.taxonomy, taxon=Mitochondria-Cyanobacteria_Chloroplast-unknown)\"",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Build OTU table and assign taxonomy",
      "instruction": "Cluster sequences into OTUs at 97% similarity, format the OTU table, compute taxonomy statistics, create shared files, classify OTUs, and generate a summary of singletons.",
      "substeps": [
        {
          "instruction": "python ../bin/pick_otus.py -i vagina/03.otu.data/vagina.final.uclu.fasta -o vagina/03.otu.data",
          "title": ""
        },
        {
          "instruction": "perl ../bin/OTU_format_trans.pl vagina/03.otu.data/vagina.final.uclu_otus.txt vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.pick.pick.names 0.03 > vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.pick.pick.an.list",
          "title": ""
        },
        {
          "instruction": "perl ../bin/tags_taxonomy.stat.v2.pl vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.pick.pick.names vagina/02.processing.data/vagina.good.pick.pick.groups vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.pick.gg.wang.pick.taxonomy.pick vagina/03.otu.data/vagina.raw.data.info",
          "title": ""
        },
        {
          "instruction": "mothur \"#make.shared(list=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.pick.pick.an.list, group=vagina/02.processing.data/vagina.good.pick.pick.groups, label=0.03)\"",
          "title": ""
        },
        {
          "instruction": "mothur \"#classify.otu(list=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.pick.pick.an.list, name=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.pick.pick.names, taxonomy=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.pick.gg.wang.pick.taxonomy.pick, label=0.03)\"",
          "title": ""
        },
        {
          "instruction": "mothur \"#summary.single(shared=vagina/02.processing.data/vagina.trim.unique.good.filter.unique.precluster.pick.pick.an.shared, groupmode=t)\"",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Convert FASTQ to FASTA and quality files",
      "instruction": "Generate FASTA and QUAL files from the original FASTQ.",
      "substeps": [
        {
          "instruction": "perl ../fq2qual.pl vagina/01.trim.data/16_s1.fq vagina/01.trim.data/16_s1",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Remove primer sequences from FASTQ",
      "instruction": "Trim primer sequences using the provided primer file.",
      "substeps": [
        {
          "instruction": "perl ../iontorrent/re-primers.pl ../v4-v5_primers.fa 2 vagina/01.trim.data/16_s1.fq",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Align sequences to SILVA reference and summarize",
      "instruction": "Align the trimmed sequences to the SILVA bacterial reference and produce a summary report.",
      "substeps": [
        {
          "instruction": "mothur \"#align.seqs(fasta=vagina/02.processing.data/vagina.trim.unique.fasta, reference=../bin/16s/database/silva.bacteria.fasta, processors=8)\"",
          "title": ""
        },
        {
          "instruction": "mothur \"#summary.seqs(fasta=vagina/02.processing.data/vagina.trim.unique.align, name=vagina/02.processing.data/vagina.trim.names)\" > vagina/02.processing.data/vagina.trim.unique.align.summary.log",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
