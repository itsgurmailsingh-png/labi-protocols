  "steps": [
    {
      "step_id": 0,
      "title": "Create binary segmented images",
      "instruction": "Convert each photograph of the volcaniclastic particles into a binary image where the particles are filled white and the invisible matrix is black.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Install and launch FabricS software",
      "instruction": "Download the free FabricS program (MATLAB‑based, Windows 7 or higher) and start it on a compatible computer.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Import segmented images",
      "instruction": "In FabricS’s File section, load the binary image(s); you may import a single image or a whole set of images.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Adjust particle‑size parameters",
      "instruction": "In the Process section, set the minimum particle size and the elongation threshold that define which particles will be included in the analysis.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Run shape‑fabric analysis",
      "instruction": "Press the Fabric button to compute particle orientation, iso‑orientation degree, P‑value and generate rose diagrams; FabricS automatically applies circular‑statistics (e.g., Rayleigh test).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Export analysis results",
      "instruction": "Use the Export section to save the orientation data, statistical values and rose diagrams to files for further interpretation.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
