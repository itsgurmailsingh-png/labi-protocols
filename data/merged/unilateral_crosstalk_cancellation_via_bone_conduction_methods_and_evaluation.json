  "steps": [
    {
      "step_id": 0,
      "title": "Prepare participant and sensors",
      "instruction": "Recruit seven normal‑hearing participants (5 M, 2 F, ages 21‑32), perform otoscopic examination, obtain written informed consent, fit each subject with audiometric bone transducers, place a probe microphone in the left ear canal and an accelerometer on the left mastoid as the target cancellation sites, and schedule testing sessions (≈1.5 h per sensor location) across two days.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Estimate impulse responses",
      "instruction": "Acquire the impulse responses of the bone‑conduction paths needed for later crosstalk‑compensation filter design.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Estimate CTC filter",
      "instruction": "Compute the crosstalk‑compensation (CTC) filter from the measured impulse responses using the adaptive algorithm described for low‑frequency zone‑of‑quiet generation.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Verify CTC filter performance",
      "instruction": "Assess the effectiveness of the CTC filter at the chosen sensor location (probe microphone or mastoid) by measuring residual sound levels to confirm creation of a zone of quiet.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Measure thresholds with adaptive 3IFC",
      "instruction": "Using a custom Python IPyWidgets GUI, run a 2‑down/1‑up three‑interval forced‑choice (3IFC) procedure for each test frequency and condition (with or without crosstalk cancellation): start the pure‑tone level at –20 dB re 1 V RMS, present three audio intervals (one contains the pure tone, all contain noise) and let the subject select the interval via a button; after two consecutive correct responses decrease the level by 4 dB, after an incorrect response increase by 4 dB; after four reversals reduce the step size to 2 dB; continue until a total of 12 reversals are obtained; calculate the threshold by averaging the intensity values of the last eight reversals; repeat for all frequencies tested.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Conduct earplug depth occlusion test",
      "instruction": "Evaluate three earplug insertion depths—shallow (~6 mm), mid‑depth (~12 mm), and deep (18–24 mm)—to quantify the occlusion effect: use the Resonance R17A‑BC audiometer with the same bone transducers, measure thresholds in the left ear while masking the right ear with a Radioear DD45 headset delivering narrow‑band noise (‑24 dB/oct slope) centred on the test frequency; test octave frequencies from 250 Hz to 4000 Hz starting at 1000 Hz; begin with a clearly audible tone (~30 dB), decrease intensity in 10 dB steps until inaudible, then increase in 5 dB steps until audible again, employing a bracketing procedure; record the lowest intensity detected in at least two of three presentations as the threshold; repeat the procedure for each earplug depth while keeping bone transducer positioning constant; each participant requires ≈20–30 min.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
