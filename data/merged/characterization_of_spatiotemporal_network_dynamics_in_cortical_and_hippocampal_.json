  "steps": [
    {
      "step_id": 0,
      "title": "Obtain analysis scripts",
      "instruction": "Download the MATLAB analysis script (analyze_calcium_imaging.m), the example visualization script (example_visualization.m), and the example processed data file (STAR_Protoc_example_mat.mat) from Zenodo at https://zenodo.org/records/18763819 (STAR_Protoc 1.0.0).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Set up MATLAB environment",
      "instruction": "Open MATLAB and add all subfolders of the CaImAn6 and CVX9 toolboxes to the MATLAB search path so the scripts can access required functions.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Run calcium‑imaging analysis",
      "instruction": "Navigate in MATLAB to the folder containing analyze_calcium_imaging.m and execute the command >analyze_calcium_imaging to start the network‑analysis pipeline. The expected runtime is about 5 min per video.",
      "substeps": [
        {
          "instruction": "When the script prompts, select the previously generated processed.mat files that contain the calcium‑imaging traces.",
          "title": ""
        },
        {
          "instruction": "Adjust script parameters as needed: set frame_period (default 0.3875 s) and max_lag (default 13) based on the temporal resolution and down‑sampling of your recordings.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Review analysis output",
      "instruction": "The script appends results directly to each selected .mat file. Load the .mat files in MATLAB to access the following variables: burstiness, firing_rate_hz, P_spike, R, R_pvalue, R_significant, global_synchrony_timeseries, global_synchrony_index, coherence_matrix, and spectral_coherence_index.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
