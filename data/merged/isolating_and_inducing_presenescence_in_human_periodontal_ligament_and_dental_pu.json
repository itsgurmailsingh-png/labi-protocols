  "steps": [
    {
      "step_id": 0,
      "title": "Clinical examination and tooth selection",
      "instruction": "Perform a thorough clinical examination of each candidate tooth to confirm it is free of cavities, restorations, periodontal disease, and any trauma such as clenching or bruxism. Prefer impacted or unerupted teeth, typically third molars removed for orthodontic treatment. Collect tooth specimens from a total of six patients, then select three of those specimens that provide the most precise cellular characterization based on the antibodies to be employed.",
      "substeps": [
        {
          "instruction": "Examine each tooth for cavities, restorations, periodontal disease, and trauma (e.g., clenching, bruxism).",
          "title": ""
        },
        {
          "instruction": "Prioritize impacted or unerupted teeth, usually third molars extracted for orthodontic reasons.",
          "title": ""
        },
        {
          "instruction": "Collect specimens from six patients.",
          "title": ""
        },
        {
          "instruction": "Choose three specimens that give the most precise cellular characterization according to the planned antibody panel.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Patient screening and consent",
      "instruction": "Complete an anamnesis form and obtain written informed consent from each patient. Exclude any individuals who smoke, consume alcohol, or have systemic disorders.",
      "substeps": [
        {
          "instruction": "Fill out the anamnesis questionnaire for each patient.",
          "title": ""
        },
        {
          "instruction": "Obtain the patient’s signed informed consent.",
          "title": ""
        },
        {
          "instruction": "Screen out patients who smoke, consume alcohol, or have systemic diseases.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Separate tissue samples before isolation",
      "instruction": "When isolating both periodontal ligament and dental pulp from the same patient, keep the two tissue samples physically separated throughout the isolation process to prevent cross‑contamination. The described methodology is suitable for both tissue types.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
