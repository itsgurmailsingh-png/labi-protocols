  "materials": [
    "Target sequence of shRNA:NameSequencesshNC5′-TTCTCCGAACGTGTCACGT-3’shOTUB2#15′-TCCCACTACAACATCCTTT-3’shOTUB2#25′-AGATGGATACCGCCCTGAA-3’shOTUB2#35′-TGGTGGAACTGGTAGAGAA-3’"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Perform bioinformatics expression analysis",
      "instruction": "Access the TIMER (http://timer.cistrome.org) and GEPIA (http://gepia.cancer-pku.cn/) databases to query OTUB2 expression in esophageal carcinoma and compare it to normal esophageal epithelium; then use the GeneMANIA database (http://genemania.org/) to examine the interaction network between OTUB2 and YAP1/TAZ (WWTR1).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Culture ESCC and epithelial cell lines",
      "instruction": "Obtain human ESCC cell lines KYSE30, KYSE150, KYSE450 and the esophageal epithelial line SHEE from the Shanghai Cell Bank; maintain all lines in Dulbecco’s Modified Eagle Medium (DMEM, Gibco) supplemented with 10 % fetal bovine serum (BI) at 37 °C in a humidified incubator with 5 % CO₂.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Identify high‑OTUB2‑expressing line",
      "instruction": "Harvest protein lysates from KYSE30, KYSE150, and KYSE450 cells and perform western blotting to detect OTUB2 levels; select the cell line showing the highest OTUB2 expression for subsequent lentiviral knock‑down experiments.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Lentiviral shRNA transfection for OTUB2 knockdown",
      "instruction": "Synthesize the following shRNA oligonucleotides (Shanghai Genechem Co., Ltd.) and a non‑targeting shNC control: shNC 5′‑TTCTCCGAACGTGTCACGT‑3′; shOTUB2#15 5′‑TCCCACTACAACATCCTTT‑3′; shOTUB2#25 5′‑AGATGGATACCGCCCTGAA‑3′; shOTUB2#35 5′‑TGGTGGAACTGGTAGAGAA‑3′. Package each shRNA into lentivirus, transduce the selected ESCC line, and evaluate knock‑down efficiency by western blot; retain the shRNA construct that yields the greatest reduction in OTUB2 for all downstream functional assays.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Assess apoptosis by flow cytometry",
      "instruction": "Seed ESCC cells at 5 × 10⁵ cells per well in 6‑well plates and incubate for 48 h at 37 °C; collect the cells, stain them with the Annexin V‑FITC apoptosis detection kit (BD Biosciences, USA) according to the manufacturer’s protocol, and analyze stained cells on a flow cytometer to quantify apoptotic populations.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
