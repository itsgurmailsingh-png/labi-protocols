  "steps": [
    {
      "step_id": 0,
      "title": "Prepare OP50 + M9 stock",
      "instruction": "Generate a 100 mg/mL OP50 bacterial suspension in M9 buffer for downstream nuclei isolation.",
      "substeps": [
        {
          "instruction": "Pick a single OP50 colony into a sterile 1 L Erlenmeyer flask containing 100 mL Luria Broth; incubate overnight with shaking at 37 °C.",
          "title": ""
        },
        {
          "instruction": "Transfer the overnight culture evenly into three sterile, pre‑weighed 50 mL centrifuge tubes.",
          "title": ""
        },
        {
          "instruction": "Centrifuge the tubes at 4000 × g for 5 min; carefully remove and discard the supernatant.",
          "title": ""
        },
        {
          "instruction": "Re‑weigh each tube to determine the mass of the bacterial pellet.",
          "title": ""
        },
        {
          "instruction": "Resuspend each pellet in M9 buffer (stored at room temperature, stable up to 1 year) to achieve a final concentration of 100 mg/mL OP50 + M9.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare nuclei dissociation reagents",
      "instruction": "Assemble all reagents needed for the nuclei dissociation step on the day of the experiment.",
      "substeps": [
        {
          "instruction": "Label all required tubes.",
          "title": ""
        },
        {
          "instruction": "Dilute DAPI (or Hoechst) stain from a 2.5 mg/mL stock (stored at 4 °C, stable up to 1 month) to the working concentration needed for staining.",
          "title": ""
        },
        {
          "instruction": "Prepare Modified FA buffer as described by Jonge et al., 2020; store at 4 °C for up to 2 weeks and add protease and RNase inhibitors fresh before use.",
          "title": ""
        },
        {
          "instruction": "Make RNase‑free 1× PBS by diluting commercial 10× PBS with DEPC‑treated water (see key resources) to a final volume of 2 mL per condition.",
          "title": ""
        },
        {
          "instruction": "Prepare 1 mL of RNase‑free water containing protease‑inhibitor tablet(s) according to the manufacturer’s instructions; keep on ice and use the same day.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
