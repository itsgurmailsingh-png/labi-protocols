      "step_id": 0,
      "title": "Prepare Tris-HCl Buffer",
      "instruction": "Prepare a buffer with a pH range of 7.2 to 9.0 using Tris(hydroxymethyl)aminomethane and hydrochloric acid.",
      "substeps": [
        {
          "instruction": "Mix 50 mL of 0.1 M Tris(hydroxymethyl)aminomethane (12.1 g L-1; M.W.: 121.0 g mol-1) with the indicated volume of 0.1 M Hydrochloric acid.",
          "title": ""
        },
        {
          "instruction": "Adjust the final volume to 200 mL using deionized water.",
          "title": ""
        },
        {
          "instruction": "Adjust the final pH using a sensitive pH meter.",
          "title": ""
        }
