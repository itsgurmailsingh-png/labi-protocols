  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Gather system components",
      "instruction": "Collect all hardware and software items: mechanical module (Nikon Eclipse TE2000 inverted microscope, two Narishige MM‑89 positioning micromanipulators, Nikon/Narishige MO‑188 hydraulically driven high‑precision micromanipulator, DANAHER CTP12ELF10MMA00 stepper motor, P70530 stepper driver, UMI 772 distribution board, PCI 7330 dual‑axis motion controller), electrical module (WPI FO223a amplifier, PCI 6220 A/D‑D/A acquisition board), a PC computer, Windows operating system, and LabVIEW object‑oriented programming software (National Instruments).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Assemble mechanical module",
      "instruction": "Mount the Nikon Eclipse TE2000 inverted microscope on a stable platform; attach two Narishige MM‑89 positioning micromanipulators—one to hold the reference electrode and the other to hold the measuring electrode; couple the second micromanipulator to the Nikon/Narishige MO‑188 hydraulically driven high‑precision micromanipulator; connect the x‑ and y‑axis knobs of the MO‑188 to a custom‑made retainer that is fixed to the axis of the DANAHER CTP12ELF10MMA00 stepper motor.",
      "substeps": [
        {
          "instruction": "Mount microscope on workbench.",
          "title": ""
        },
        {
          "instruction": "Attach reference‑electrode micromanipulator (Narishige MM‑89).",
          "title": ""
        },
        {
          "instruction": "Attach measuring‑electrode micromanipulator (Narishige MM‑89).",
          "title": ""
        },
        {
          "instruction": "Couple second micromanipulator to MO‑188 hydraulic micromanipulator.",
          "title": ""
        },
        {
          "instruction": "Connect MO‑188 knobs to custom retainer on stepper motor axis.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Wire stepper motor and controller",
      "instruction": "Electrically connect the DANAHER stepper motor to the P70530 stepper driver; link the driver to the UMI 772 distribution board; connect the distribution board to the PCI 7330 dual‑axis motion controller; power the stepper motor and driver from an isolated UPS separate from the amplification lines.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Set up signal acquisition hardware",
      "instruction": "Connect the WPI FO223a amplifier to the PCI 6220 A/D‑D/A acquisition board; plug both the PCI 7330 motion controller and the PCI 6220 board into the PC computer; ensure the PC runs Windows (initially Windows XP Second Edition) and LabVIEW (initially version 8.6) or compatible newer versions (Windows 7, LabVIEW 11).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Install and configure LabVIEW control",
      "instruction": "Program the LabVIEW object‑oriented environment to control both signal acquisition and micromanipulator movement; test the software with the assembled hardware; consult Table 1 for the full list of compatible operating systems and LabVIEW versions.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
