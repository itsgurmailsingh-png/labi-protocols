  "steps": [
    {
      "step_id": 0,
      "title": "Prepare cold pipette tips and ECM",
      "instruction": "Place a box of sterile 1–10 µL pipette tips in a refrigerator at +4 °C. Defrost ECM aliquots at +4 °C before starting. Note that ECM is liquid at –20 °C and solidifies when the temperature rises above +4 °C. Ensure you have 1 µL of liquid ECM available for each injection.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Harvest and count tumor cells",
      "instruction": "Passage the tumor cells using the standard dissociation protocol. Count the cells and assess viability, aiming for >90 % viable cells. Plan for 2 × 10⁴–5 × 10⁴ cells per 1 µL injection (5 × 10⁴ cells were used for LN‑229). Prepare excess to cover dead volume; for example, for 20 injections collect 1.1 × 10⁶ cells in a sterile 1.5 mL Eppendorf tube. 3D structures (spheroids, organoids) can be injected after empirical size testing, and different syringes or tips should be evaluated. ECM can be omitted, but additional caution is required to retain cells in the slice.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Pellet cells by centrifugation",
      "instruction": "Transfer the cell suspension to a centrifuge tube and spin for 3 min at 300 × g at 22 °C. Discard the supernatant as completely as possible and aspirate any remaining liquid with a 10–200 µL pipette.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Resuspend pellet in ice‑cold ECM",
      "instruction": "Resuspend the cell pellet in pure ice‑cold ECM to obtain 1 µL of suspension per injection containing the desired cell number. Verify that the ECM is homogeneous and free of air bubbles. For 20 injections, add 20 µL ECM on ice. Keep all material pre‑cooled; work quickly but precisely to maintain ECM in the liquid state.",
      "substeps": [
        {
          "instruction": "Check ECM homogeneity on ice.",
          "title": ""
        },
        {
          "instruction": "Avoid introduction of air bubbles while mixing.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Maintain suspension on ice until injection",
      "instruction": "Keep the ECM‑cell suspension on ice throughout the injection procedure. Use cold pipette tips for injection to prevent ECM solidification before integration into the brain slice.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
