  "materials": [
    "Anti-laminin-2 antibody",
    "Rb pAb to GFP",
    "Anti-myosin 4",
    "Alexa Fluor 488 goat anti-mouse IgG",
    "Alexa Fluor 594 goat anti-rat IgG",
    "DAPI",
    "Proteinase K",
    "HCR probe hybridization buffer",
    "Goat serum",
    "Skim milk powder",
    "16% formaldehyde solution",
    "PBS",
    "Bovine serum albumin",
    "Triton X-100",
    "SP8 laser confocal microscope",
    "Timing: 2 days"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Block sections",
      "instruction": "Incubate tissue sections in PBS‑MT for 1 hour on a rocking platform at 25 rpm, in the dark, at 4 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare primary antibody mix",
      "instruction": "Make a 500 µL primary solution in PBS‑MT containing the following per sample: Laminin (Rat IgG) 1:200 (2.5 µL), GFP (Rabbit IgG) 1:200 (2.5 µL), DAPI 1:10 000 (0.5 µL). Add the same solution to the stained sample; add DAPI only to the negative‑control slide.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Incubate primary antibodies",
      "instruction": "Place the slides with primary solution (or DAPI‑only control) on a rocking platform at 25 rpm, in the dark, at 4 °C for 16 hours.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "First PBS‑MT wash",
      "instruction": "Wash each section three times with 1 mL PBS‑MT, each wash lasting 1 hour on a rocking platform at 25 rpm, in the dark, at 4 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Prepare secondary antibody mix",
      "instruction": "Prepare a 500 µL secondary solution in PBS‑MT per sample containing: Goat anti‑Rat IgG Alexa Fluor 594 1:500 (2 µL), Goat anti‑Rabbit IgG Alexa Fluor 488 1:500 (2 µL), DAPI 405 1:1000 (1 µL). Apply the solution to both the stained sample and the negative‑control slide.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Incubate secondary antibodies",
      "instruction": "Incubate the slides with secondary solution on a rocking platform at 25 rpm, in the dark, at 4 °C for 16 hours (overnight incubation is permissible).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Second PBS‑MT wash and ECi prep",
      "instruction": "Wash each section three times with 1 mL PBS‑MT, each wash lasting 1 hour on a rocking platform at 25 rpm, in the dark, at 4 °C. While washing, bring Ethyl Cinnamate (ECi) to 19 °C–22 °C for the subsequent step.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
