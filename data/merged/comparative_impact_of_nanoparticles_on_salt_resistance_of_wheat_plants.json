  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Store wheat seeds",
      "instruction": "Obtain Triticum aestivum L “Qobustan” seeds from the Institute of Botany, place them in moisture‑proof polyethylene bags, and store at 10 °C for 10 days before starting the experiment.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Set up hydroponic NP treatments",
      "instruction": "Prepare hydroponic containers for five nanoparticle conditions (Fe3O4, ZnO, Al2O3, CuO, and a no‑NP control) each under two sub‑conditions: non‑saline water and 0.6 % NaCl solution. Add the appropriate nanoparticle (sourced from SOCAR) to the designated containers, sow the stored seeds, and grow the seedlings for 15 days, maintaining the hydroponic environment throughout.",
      "substeps": [
        {
          "instruction": "Fill containers with either distilled water (non‑saline) or 0.6 % NaCl solution.",
          "title": ""
        },
        {
          "instruction": "Add the specific nanoparticle (Fe3O4, ZnO, Al2O3, CuO) to the corresponding containers; leave one set without nanoparticles as control.",
          "title": ""
        },
        {
          "instruction": "Sow the wheat seeds into each container.",
          "title": ""
        },
        {
          "instruction": "Maintain hydroponic conditions for 15 days.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Assess seedling morphology",
      "instruction": "After 15 days, select healthy seedlings (no lesions or pathogens) from each treatment group. Measure shoot leaf length with a ruler and count the number of root shoots per seedling. Record all measurements.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Monitor shoot growth",
      "instruction": "For each treatment (nanoparticle ± saline), continue measuring shoot length daily for 5 to 6 days using a ruler, noting any changes in growth.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Extract photosynthetic pigments",
      "instruction": "Cut each seedling into small pieces. Weigh 100 mg of green leaf tissue per sample, add 5 ml of 96.6 % acetone, and grind with a pestle. Add an additional 20 ml acetone to reach a total volume of 25 ml. Filter the homogenate through a fresh filter for each sample and keep the filtrate in the dark for 30 minutes before spectrophotometric measurement.",
      "substeps": [
        {
          "instruction": "Cut seedlings into small pieces.",
          "title": ""
        },
        {
          "instruction": "Weigh 100 mg of green leaf tissue.",
          "title": ""
        },
        {
          "instruction": "Add 5 ml of 96.6 % acetone and grind with a pestle.",
          "title": ""
        },
        {
          "instruction": "Add 20 ml more acetone to bring the volume to 25 ml.",
          "title": ""
        },
        {
          "instruction": "Filter the extract using a new filter for each sample.",
          "title": ""
        },
        {
          "instruction": "Incubate the filtrate in the dark for 30 minutes before analysis.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
