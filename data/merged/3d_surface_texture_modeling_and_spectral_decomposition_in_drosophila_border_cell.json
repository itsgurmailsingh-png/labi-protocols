  "steps": [
    {
      "step_id": 0,
      "title": "Prepare reagents and buffers",
      "instruction": "Aliquot 150 µL dissection media per 2 mL tube, keep at ~25 °C for current dissections and store extra at 4 °C; make 0.4 % PBST (PBS + Triton X‑100); prepare fresh 4 % PFA in PBS, 500 µL per genotype.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Dissect ovaries and isolate egg chambers",
      "instruction": "Dissect ~5 fattened female flies per genotype in 150 µL dissection media, remove ovaries, separate from other tissues and cuticle, pull ovarioles from the muscle sheath, discard stages ≥12, and transfer stage‑9 egg chambers into 600 µL Eppendorf tubes (one tube per genotype).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Fix egg chambers",
      "instruction": "Remove dissection media, add 500 µL 4 % PFA to each tube, rock on a covered rocker for 15 min, then discard the fixative.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Wash with PBST",
      "instruction": "Perform three washes with 500 µL 0.4 % PBST each, rocking on a covered rocker for 15 min per wash; keep samples covered with foil to avoid light exposure.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Primary antibody incubation",
      "instruction": "Add primary antibodies diluted in 200 µL 0.4 % PBST to each tube, incubate on a shaker at 4 °C for 12–16 h protected from light.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Wash after primary",
      "instruction": "Perform three 15‑min washes with 0.4 % PBST on a covered rocker at 4 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Secondary antibody incubation",
      "instruction": "Add secondary antibodies (and any dyes) diluted in 200 µL 0.4 % PBST, incubate on a covered rocker at 4 °C for 12–16 h protected from light.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Wash after secondary",
      "instruction": "Perform three 15‑min washes with 0.4 % PBST on a covered rocker at 4 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Mount and store samples",
      "instruction": "Remove all liquid, add ~60 µL Vectashield mounting medium to each tube, seal, and store at 4 °C; samples may be kept up to one month before mounting.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Quantify texture and analyze data",
      "instruction": "Analyze at least three clusters per category using the spectral‑decomposition script; compare low‑order mode (l = 1) versus high‑order mode (l > 6) against control with one‑sided t‑tests; alternative tests can be added in MATLAB or by exporting raw data to GraphPad Prism.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
