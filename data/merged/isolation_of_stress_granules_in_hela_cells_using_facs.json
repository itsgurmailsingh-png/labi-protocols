  "steps": [
    {
      "step_id": 0,
      "title": "Extract RNA and prepare library",
      "instruction": "Process the isolated stress‑granule (SG) and input samples for RNA extraction and downstream sequencing library preparation.",
      "substeps": [
        {
          "instruction": "Top up each SG or input sample to a total volume of 50 µL using B0 buffer.",
          "title": ""
        },
        {
          "instruction": "Add 10 µL Proteinase K and incubate at 42 °C for 40 min in a thermal mixer set to 500 rpm.",
          "title": ""
        },
        {
          "instruction": "De‑crosslink the mixture by incubating at 65 °C for 40 min without shaking.",
          "title": ""
        },
        {
          "instruction": "Purify RNA with the Oligo Clean & Concentrator Kit (Zymo Research, D4060); elute the RNA in 20 µL RNase‑ and DNase‑free water.",
          "title": ""
        },
        {
          "instruction": "To the eluted RNA, add 1 µL Turbo DNase and 2 µL 10× Turbo DNase buffer, then incubate at 37 °C for 10 min.",
          "title": ""
        },
        {
          "instruction": "Perform a second clean‑up using the Oligo Clean & Concentrator Kit. The purified RNA is now ready for sequencing.",
          "title": ""
        },
        {
          "instruction": "Library preparation is performed using the Illumina Stranded Total RNA with Ribo‑Zero Plus protocol.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
