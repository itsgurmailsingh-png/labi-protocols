  "steps": [
    {
      "step_id": 0,
      "title": "Seed cells in culture flask",
      "instruction": "Seed approximately 3 × 10⁶ cells in appropriate growth medium in a T175 flask or a 15 cm dish.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Incubate cells for one week",
      "instruction": "Place the flask/dish in a stationary incubator set to 37 °C with 5 % CO₂ and grow the cells for about 1 week without changing the medium.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Harvest conditioned medium",
      "instruction": "Collect the conditioned medium, centrifuge, optionally filter, and store at –20 °C.",
      "substeps": [
        {
          "instruction": "Collect the conditioned medium into a Falcon tube suitable for centrifugation.",
          "title": ""
        },
        {
          "instruction": "Centrifuge at 500 g for 5 min.",
          "title": ""
        },
        {
          "instruction": "Transfer the supernatant to a new tube and discard the pellet.",
          "title": ""
        },
        {
          "instruction": "Optional: filter the supernatant through a 0.45 µm sterile filter.",
          "title": ""
        },
        {
          "instruction": "Store the processed medium at –20 °C until further use.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Copy fluorescence data to analysis software",
      "instruction": "Copy the raw fluorescence columns from the Excel file into the chosen analysis software.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Import data into GraphPad Prism",
      "instruction": "Open a new project in GraphPad Prism, define the number of replicates, and paste the data in XY table format with replicates in adjacent columns.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Plot mean fluorescence vs time",
      "instruction": "Create an XY plot of mean fluorescence versus time; the software will display error bars automatically.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Calculate fluorescence ratios",
      "instruction": "In GraphPad Prism, select New Analysis → Results → ‘Remove baseline and column math’ to compute fluorescence ratios, normalizing as desired.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Plot bar chart of ratios",
      "instruction": "Copy the calculated ratios and standard deviations into a new table and generate a bar chart.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Conduct two-way ANOVA on endpoint data",
      "instruction": "Arrange endpoint fluorescence values with crRNAs in rows and samples/targets/concentrations in columns, then select New Analysis → Results → ‘two-way ANOVA (or mixed model)’ and add pair‑wise comparisons to display p‑values.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
