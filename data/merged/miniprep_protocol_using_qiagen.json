  "steps": [
    {
      "step_id": 0,
      "title": "Resuspend Bacterial Cells",
      "instruction": "Resuspend pelleted bacterial cells in 250 μl Buffer P1 and transfer the suspension to a microcentrifuge tube.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Lyse Cells",
      "instruction": "Add 250 μl Buffer P2 to the tube and mix thoroughly.",
      "substeps": [
        {
          "instruction": "Invert the tube 4–6 times to mix.",
          "title": ""
        },
        {
          "instruction": "Do not vortex to avoid shearing genomic DNA.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Neutralize Lysate",
      "instruction": "Add 350 μl Buffer N3 and mix immediately and thoroughly.",
      "substeps": [
        {
          "instruction": "Invert the tube 4–6 times.",
          "title": ""
        }
      ],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Clear Lysate",
      "instruction": "Centrifuge the mixture for 10 min at 13,000 rpm (~17,900 x g) in a table-top microcentrifuge to form a compact white pellet.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Bind DNA to Column",
      "instruction": "Apply 800 μl of the supernatant from the previous centrifugation step to the QIAprep 2.0 spin column.",
      "substeps": [
        {
          "instruction": "Centrifuge for 30–60 s.",
          "title": ""
        },
        {
          "instruction": "Discard the flow-through.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Wash Column with Buffer PB",
      "instruction": "Wash the QIAprep 2.0 spin column using Buffer PB.",
      "substeps": [
        {
          "instruction": "Add 0.5 ml Buffer PB.",
          "title": ""
        },
        {
          "instruction": "Centrifuge for 30–60 s.",
          "title": ""
        },
        {
          "instruction": "Discard the flow-through.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Wash Column with Buffer PE",
      "instruction": "Wash the QIAprep 2.0 spin column using Buffer PE.",
      "substeps": [
        {
          "instruction": "Add 0.75 ml Buffer PE.",
          "title": ""
        },
        {
          "instruction": "Centrifuge for 30–60 s.",
          "title": ""
        },
        {
          "instruction": "Discard the flow-through.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Remove Residual Wash Buffer",
      "instruction": "Centrifuge the column at full speed for an additional 1 min to remove any remaining wash buffer.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Elute DNA",
      "instruction": "Elute the DNA from the QIAprep 2.0 column.",
      "substeps": [
        {
          "instruction": "Place the column in a clean 1.5 ml microcentrifuge tube.",
          "title": ""
        },
        {
          "instruction": "Add 50 μl Buffer EB to elute the DNA.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
