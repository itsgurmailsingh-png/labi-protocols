  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare aniline solution",
      "instruction": "Make 100 mL of aniline solution at the desired initial concentration (20, 40, 60, 80, or 120 mg L⁻¹) by weighing the appropriate amount of aniline and dissolving it in deionized water.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Adjust solution pH",
      "instruction": "Set the solution pH to the target value (3, 5, 7, 9, or 11) using 0.1 mol L⁻¹ HCl or 0.1 mol L⁻¹ NaOH and confirm the pH with a MIT65 pH meter.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Add hydrogen peroxide",
      "instruction": "Introduce hydrogen peroxide to the solution to reach the required concentration (0.01, 0.04, or 0.07 mol L⁻¹).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Ultrasonic treatment",
      "instruction": "Transfer the 100 mL sample to an ElMA‑Germany ultrasonic bath, set to 240 W power and 50 Hz frequency, and expose it for the chosen contact time (15, 30, 45, 60, or 90 min).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Measure residual aniline",
      "instruction": "Determine the remaining aniline concentration with a Shimadzu CE‑1021‑UK UV–Vis spectrophotometer and calculate removal efficiency using R (%) = (C₀ − C_f) / C₀ × 100.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
