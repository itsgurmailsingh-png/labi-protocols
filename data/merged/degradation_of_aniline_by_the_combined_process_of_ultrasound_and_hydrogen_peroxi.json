  "title": "Degradation of aniline by the combined process of ultrasound and hydrogen peroxide (US/H2O2)",
  "author": "Rahdar, Igwegbe, et al.",
  "doi": "10.1016/j.mex.2019.02.033",
  "source_name": "methodsx",
