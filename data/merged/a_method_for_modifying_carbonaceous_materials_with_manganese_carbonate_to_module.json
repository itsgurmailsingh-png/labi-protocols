  "version_count": 1,
  "title": "A method for modifying carbonaceous materials with manganese carbonate to module the formation of singlet oxygen via activation with Peroxymonosulfate",
  "author": "Mosquera-Olano, Quimbaya, et al.",
  "doi": "10.1016/j.mex.2025.103252",
