  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare plant powders",
      "instruction": "Collect banana pseudo‑stem (BPS) from Urabá, Colombia, peel potato (PP) from Pasto, Nariño, and coconut shell (BSC) from Valle del Cauca; dry each material at room temperature for 24 h, grind with a manual mill, and sieve, retaining the fine powder that passes through mesh No. 40.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Pyrolyze biomass to biochar",
      "instruction": "Weigh 40 g of each dried powder, place in a muffle furnace (Mueller & Krempel) and pyrolyze under nitrogen flow of 124.8 mL min⁻¹ at 500 °C for 2 h to obtain the carbonized biochar (BPS, BPP, or BSC).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Impregnate biochar with MnCO₃",
      "instruction": "Mix the biochar with manganese carbonate (MnCO₃) at a mass ratio of 1 : 1 (biochar : MnCO₃) and stir/stand for 12 h to allow impregnation.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Heat impregnated material",
      "instruction": "Transfer the MnCO₃‑impregnated biochar to the furnace and heat at 800 °C for 1 h, producing the Mn‑modified carbonaceous material (BPS‑Mn, BPP‑Mn, or BSC‑Mn).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Wash and dry final product",
      "instruction": "Wash the heated material with water (details not specified) to remove residual salts, then dry the washed material at 105 °C for 24 h.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
