  "steps": [
    {
      "step_id": 0,
      "title": "Configure VNA and insert sample",
      "instruction": "Connect the waveguide to the vector network analyzer (VNA) as shown in Fig. 1. Place the material whose electrical parameters are to be determined (micro‑absorbing material or Al6061 laminate) inside the waveguide.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Measure intrinsic impedances of layers",
      "instruction": "Using the VNA, record the intrinsic impedance of each layer. For free space use η0 = 120π Ω. For the metal‑matrix conductor (Al6061) calculate ηM = (1 + j) π f μ σ, where σ and μ are the conductivity and permeability of Al6061. Determine ηA for the absorbing material in the same manner if required.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Obtain transmission and reflection coefficients",
      "instruction": "Measure the transmission coefficient and the reflection coefficients at each interface with the VNA. Compute the transmission coefficient p using p = 16 η0 ηA ηM / [(η0+ηA)(ηA+ηM)(ηM+η0)]. Compute the reflection coefficients q1 and q2 with q1 = (ηA−η0)(ηA−z(M)) / [(ηA+η0)(ηA+z(M))] and q2 = (ηM−ηA)(ηM−η0) / [(ηM+ηA)(ηM+η0)], where z(M) is defined in the next step.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Calculate interface impedance z(M)",
      "instruction": "Calculate the impedance to the right of the absorber‑metal‑matrix interface using\nz(M) = ηM [ η0 cosh(γM tM) + ηM sinh(γM tM) ] / [ ηM cosh(γM tM) + η0 sinh(γM tM) ],\nwhere tM is the thickness of the metal‑matrix layer and γM = (1 + j) π f μM σM (μM and σM are the permeability and conductivity of Al6061).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Determine total transmission coefficient",
      "instruction": "Combine the measured and calculated parameters to obtain the total transmission coefficient across the laminate:\nT = p [ (1 − q1 e^{−2γA tA}) (1 − q2 e^{−γM tM}) ]^{−1} e^{−γA tA − γM tM},\nwhere γA and tA are the propagation constant and thickness of the absorbing layer, respectively.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Compute shielding effectiveness",
      "instruction": "Calculate the shielding effectiveness in decibels using S = −20 log10(T) dB. Report S as the total shielding effectiveness of the multilayer laminate.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
