  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Excise tissue samples",
      "instruction": "Excise tissue samples from the selected beetle parts, weighing approximately 5–10 mg, using sterile scalpels and tweezers.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Transfer tissues to tubes",
      "instruction": "Transfer the excised tissues into sterile microcentrifuge tubes.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Freeze tissues rapidly",
      "instruction": "Rapidly freeze the tissues in liquid nitrogen.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Mechanically rupture tissues",
      "instruction": "Conduct mechanical rupture of the frozen tissues using a sterile mortar and pestle.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Add chloroform to lysate",
      "instruction": "Add 500 µL of chloroform to the lysates.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Mix by inversion",
      "instruction": "Gently invert the tubes to mix for about 10 minutes.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Centrifuge lysate",
      "instruction": "Centrifuge at 12,000 rpm for 15 minutes at room temperature.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Collect aqueous phase",
      "instruction": "Carefully transfer the aqueous phase containing DNA into a new microcentrifuge tube.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Run agarose gel electrophoresis",
      "instruction": "Check PCR products by electrophoresis on a 1.2 % agarose gel prepared in 0.5× TBE buffer.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
