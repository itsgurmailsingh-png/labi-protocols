  "steps": [
    {
      "step_id": 0,
      "title": "Prepare mean expression matrix",
      "instruction": "For each tissue and each time point, calculate the mean of the processed count values across replicates to obtain a matrix of average expression (Tij) for every gene i in every tissue j.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Calculate tissue fraction",
      "instruction": "For each gene i and tissue j, compute Tissuefraction_ij = Tij ÷ ( Σ_{j=1}^{n} Tij ), where n is the total number of tissues.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Compute tissue specificity score",
      "instruction": "For each gene i, set TissueSpecificityScore_i = max{ Tissuefraction_ij } across all tissues j. This highest tissue fraction represents the gene’s tissue‑specific score.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Rank lncRNAs by specificity",
      "instruction": "Rank all lncRNAs in decreasing order of their TissueSpecificityScore_i. In R, use the order function with the argument decreasing = T.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Define specific and control lncRNAs",
      "instruction": "Select the top 20 % of the ranked lncRNAs as tissue‑specific lncRNAs and the bottom 20 % as control lncRNAs.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
