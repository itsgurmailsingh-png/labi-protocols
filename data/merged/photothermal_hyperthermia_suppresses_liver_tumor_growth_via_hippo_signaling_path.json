  "steps": [
    {
      "step_id": 0,
      "title": "Culture HCC cells",
      "instruction": "Thaw and expand Huh7 and HepG2 hepatocellular carcinoma cell lines in DMEM supplemented with 10 % fetal bovine serum, incubate at 37 °C with 5 % CO₂; routinely test for mycoplasma (negative).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Lentiviral infection and puromycin selection",
      "instruction": "Seed 2 × 10⁵ target cells, add 1 × 10⁶ lentiviral transducing units together with polybrene (1 µg ml⁻¹), incubate to allow infection, then replace medium and select stable YAP‑overexpressing clones with puromycin (2 µg ml⁻¹) for approximately 5 days.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Fix and stain cells for cell‑cycle analysis",
      "instruction": "Collect 1 × 10⁶ treated cells by trypsinization, centrifuge, fix in 70 % cold ethanol; after a second spin, resuspend in 0.5 ml propidium‑iodide (PI) staining buffer containing RNase A (200 mg ml⁻¹) and PI (50 µg ml⁻¹), incubate at 37 °C for 30 min in the dark, then analyse DNA content by FACScan cytometry.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Stain cells for apoptosis",
      "instruction": "After hyperthermia, harvest cells, wash twice with cold PBS, resuspend 1 × 10⁵ cells in 200 µl binding buffer with 10 µl Annexin‑V‑FITC and 5 µl PI, incubate 10 min in the dark, and analyse by FACScan cytometry.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Immunofluorescence for YAP",
      "instruction": "Incubate cells in petri dishes at 43 °C for 1 h, then fix at 4 °C for 15 min with 4 % paraformaldehyde; block with normal goat serum for 30 min, incubate with anti‑YAP primary antibody (1:200) at 4 °C overnight, wash, incubate with Alexa Fluor 594‑conjugated goat anti‑rabbit IgG (H+L) (Proteintech) for 2 h at room temperature, stain nuclei with DAPI, mount with 80 % glycerol/PBS, and image using a laser‑scanning confocal microscope (FV1000, Olympus) with FV10‑ASW 4.0 software.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
