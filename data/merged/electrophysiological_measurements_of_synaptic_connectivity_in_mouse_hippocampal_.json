  "steps": [
    {
      "step_id": 0,
      "title": "Prepare ACSF stock solution",
      "instruction": "Dissolve the following reagents in Milli‑Q water to a final volume of 2 L, then adjust pH to 7.25–7.30 and osmolarity to 305 mOsm; store at 4 °C and prepare fresh at least weekly.",
      "substeps": [
        {
          "instruction": "Weigh and add 14.6 g NaCl (final 125.0 mM).",
          "title": ""
        },
        {
          "instruction": "Weigh and add 0.3727 g KCl (final 2.5 mM).",
          "title": ""
        },
        {
          "instruction": "Weigh and add 0.3119 g NaH₂PO₄ (final 1.3 mM).",
          "title": ""
        },
        {
          "instruction": "Weigh and add 4.2005 g NaHCO₃ (final 25.0 mM).",
          "title": ""
        },
        {
          "instruction": "Weigh and add 9.0080 g D‑(+)-Glucose (final 25.0 mM).",
          "title": ""
        },
        {
          "instruction": "Add MgCl₂·6H₂O to achieve a final concentration of 1.0 mM using the 1 M MgCl₂ stock (amount not listed).",
          "title": ""
        },
        {
          "instruction": "Add CaCl₂·2H₂O to achieve a final concentration of 2.0 mM using the 1 M CaCl₂ stock (amount not listed).",
          "title": ""
        },
        {
          "instruction": "Adjust the solution to pH 7.25–7.30 with acid/base as needed.",
          "title": ""
        },
        {
          "instruction": "Measure osmolarity and adjust to 305 mOsm if necessary.",
          "title": ""
        },
        {
          "instruction": "Aliquot or store the solution at 4 °C; discard after one week.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare slicing medium",
      "instruction": "Dissolve the listed reagents in Milli‑Q water to a final volume of 2 L, store at 4 °C and make fresh at least weekly.",
      "substeps": [
        {
          "instruction": "Weigh and add 10.1686 g NaCl (final 87.0 mM).",
          "title": ""
        },
        {
          "instruction": "Weigh and add 0.3727 g KCl (final 2.5 mM).",
          "title": ""
        },
        {
          "instruction": "Weigh and add 0.3119 g NaH₂PO₄ (final 1.3 mM).",
          "title": ""
        },
        {
          "instruction": "Weigh and add 4.2005 g NaHCO₃ (final 25.0 mM).",
          "title": ""
        },
        {
          "instruction": "Weigh and add 9.0080 g D‑(+)-Glucose (final 25.0 mM).",
          "title": ""
        },
        {
          "instruction": "Weigh and add 1.345 g sucrose (final 75.0 mM).",
          "title": ""
        },
        {
          "instruction": "Add MgCl₂·6H₂O to reach 7.0 mM using the 1 M MgCl₂ stock (amount not listed).",
          "title": ""
        },
        {
          "instruction": "Add CaCl₂·2H₂O to reach 0.5 mM using the 1 M CaCl₂ stock (amount not listed).",
          "title": ""
        },
        {
          "instruction": "Store the medium at 4 °C; discard after one week.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Prepare 1 M MgCl₂ stock",
      "instruction": "Dissolve 10.165 g MgCl₂·6H₂O in Milli‑Q water and bring the volume to 50 mL; store at 4 °C and prepare fresh at least every two months.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Prepare 1 M CaCl₂ stock",
      "instruction": "Dissolve 7.3505 g CaCl₂·2H₂O in Milli‑Q water and bring the volume to 50 mL; store at 4 °C and prepare fresh at least every two months.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Prepare internal pipette solution",
      "instruction": "Dissolve the following reagents in Milli‑Q water to a final volume of 20 mL, adjust pH to 7.2–7.3 with ~200 µL 1 M KOH, set osmolarity to 290 mOsm, aliquot 500 µL into 1.5 mL tubes, and store at –80 °C; prepare fresh every six months.",
      "substeps": [
        {
          "instruction": "Weigh and add 8.182 mg NaCl (final 7.0 mM).",
          "title": ""
        },
        {
          "instruction": "Weigh and add 3.804 mg EGTA (final 0.5 mM).",
          "title": ""
        },
        {
          "instruction": "Weigh and add 47.66 mg HEPES (final 10.0 mM).",
          "title": ""
        },
        {
          "instruction": "Weigh and add 63.2 mg K‑gluconate (final 135.0 mM).",
          "title": ""
        },
        {
          "instruction": "Weigh and add 20.28 mg Mg‑ATP (final 2.0 mM).",
          "title": ""
        },
        {
          "instruction": "Weigh and add 3.139 mg Na₂‑GTP (final 0.3 mM).",
          "title": ""
        },
        {
          "instruction": "Weigh and add 68 mg phosphocreatine di(tris) (final 0.9 mM).",
          "title": ""
        },
        {
          "instruction": "Adjust pH to 7.2–7.3 with approximately 200 µL of 1 M KOH.",
          "title": ""
        },
        {
          "instruction": "Verify osmolarity and adjust to 290 mOsm if needed.",
          "title": ""
        },
        {
          "instruction": "Aliquot 500 µL portions into 1.5 mL tubes and freeze at –80 °C.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
