  "steps": [
    {
      "step_id": 0,
      "title": "Prepare Matrigel aliquots",
      "instruction": "Thaw Matrigel® Growth Factor Reduced (GFR) Basement Membrane Matrix at 4 °C overnight, keep tubes and the Matrigel bottle on ice, aliquot 682 µL (~10 mg/mL) into 1.5 mL microcentrifuge tubes, and store the aliquots at –30 °C (stable up to 6 months).",
      "substeps": [
        {
          "instruction": "Thaw the Matrigel bottle at 4 °C overnight.",
          "title": ""
        },
        {
          "instruction": "Cool 1.5 mL microcentrifuge tubes on ice or in an ice‑cold thermal block.",
          "title": ""
        },
        {
          "instruction": "Transfer the Matrigel bottle from the refrigerator to ice to prevent premature gelation.",
          "title": ""
        },
        {
          "instruction": "Aliquot 682 µL of Matrigel per tube (approximately 10 mg/mL).",
          "title": ""
        },
        {
          "instruction": "Store the aliquoted tubes at –30 °C; aliquots remain usable for up to 6 months.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
