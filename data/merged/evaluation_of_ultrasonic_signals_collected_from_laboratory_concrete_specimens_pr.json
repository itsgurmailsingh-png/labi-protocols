  "steps": [
    {
      "step_id": 0,
      "title": "Collect ultrasonic signals during loading",
      "instruction": "Increase the compressive load on the concrete specimen from experimental time t = 0 min at a constant rate of 50 N s⁻¹ (equivalent to 0.005 N mm⁻² s⁻¹). Record an ultrasonic signal every 10 s, which corresponds to a stress increase of 0.05 N mm⁻² (0.1 % of the specimen’s compressive strength of 42.9 MPa) between successive signals, until failure. Example stress values: 0 N mm⁻² at 0 min, 3 N mm⁻² at 10 min, 18 N mm⁻² at 60 min.",
      "substeps": [
        {
          "instruction": "Set loading machine to 50 N s⁻¹.",
          "title": ""
        },
        {
          "instruction": "Start timer at t = 0 min.",
          "title": ""
        },
        {
          "instruction": "Every 10 s, trigger the ultrasonic transducer and store the raw waveform.",
          "title": ""
        },
        {
          "instruction": "Log the corresponding compressive stress (e.g., 0, 3, 18 N mm⁻²).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Preprocess signals with frequency filtering",
      "instruction": "Apply band‑pass frequency filters to each recorded raw signal, creating two independent data sets:",
      "substeps": [
        {
          "instruction": "Filter A: 10 kHz – 150 kHz.",
          "title": ""
        },
        {
          "instruction": "Filter B: 40 kHz – 150 kHz.",
          "title": ""
        },
        {
          "instruction": "Store the filtered waveforms for later CWI analysis.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Select time window for correlation",
      "instruction": "Define a time window [t₁, t₂] within each preprocessed signal that excludes the direct (ballistic) arrival and noisy portions; this window will be used for all correlation calculations.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Compute stretched‑signal correlation for each α",
      "instruction": "For a series of stretching factors α, linearly stretch (or compress) the reference waveform and calculate the correlation coefficient CC(α) with the perturbed waveform over the chosen window:",
      "substeps": [
        {
          "instruction": "Stretch the reference: u_pre(t·(1+α)).",
          "title": ""
        },
        {
          "instruction": "Compute numerator: ∫_{t₁}^{t₂} u_pre(t·(1+α))·ũ_pre(t) dt.",
          "title": ""
        },
        {
          "instruction": "Compute denominator: √[∫_{t₁}^{t₂} u_pre²(t·(1+α)) dt] × √[∫_{t₁}^{t₂} ũ_pre²(t) dt].",
          "title": ""
        },
        {
          "instruction": "Calculate CC(α) = numerator / denominator.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Find optimal stretching factor α",
      "instruction": "Vary α in small increments (resolution to be chosen) and identify the value α_opt that maximizes CC(α). Record the maximum correlation as CC_max.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Calculate relative velocity change Δv/v",
      "instruction": "Set Δv/v = α_opt (since α = Δv/v). Positive Δv/v indicates a velocity increase; negative Δv/v indicates a decrease.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Determine decorrelation DCr",
      "instruction": "Compute the remaining decorrelation DCr = 1 – CC_max; DCr quantifies inhomogeneity or the appearance of new scatterers.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Select reference scheme and cumulate α",
      "instruction": "Choose a reference approach based on the magnitude of CC_max:",
      "substeps": [
        {
          "instruction": "Fixed reference: If CC_max stays above 0.7 for all signals, compare every signal to the initial reference and report Δv/v directly.",
          "title": ""
        },
        {
          "instruction": "Stepwise reference: If CC_max falls below 0.7, use each signal as the reference for the next one. Compute α_n for each adjacent pair and cumulate using α_c,n = α_n (for n = 1) or α_c,n = (α_c,n‑1 + 1)(α_n + 1) – 1 (for n > 1).",
          "title": ""
        },
        {
          "instruction": "Moving reference (auto CWI): Update the reference only when CC_max drops below a chosen threshold (e.g., 0.7). Record each update and recompute Δv/v relative to the new reference; note that CC values themselves are not accumulated.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Report Δv/v, CCmax, and DCr",
      "instruction": "For each time point, output the relative velocity change (Δv/v or cumulated Δv/v), the maximum correlation coefficient (CC_max), and the decorrelation (DCr). If a moving reference was used, indicate the moments when the reference was updated.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Generate synthetic reference waveform (optional)",
      "instruction": "If an illustrative synthetic reference is desired, generate a damped sinusoid with the following parameters:",
      "substeps": [
        {
          "instruction": "Sampling rate: 10 MHz.",
          "title": ""
        },
        {
          "instruction": "Total duration: 2048 μs.",
          "title": ""
        },
        {
          "instruction": "Central frequency: 60 kHz.",
          "title": ""
        },
        {
          "instruction": "Exponential decay rate: –10 000 μs⁻¹.",
          "title": ""
        },
        {
          "instruction": "Amplitude modulation depth: 0.3.",
          "title": ""
        },
        {
          "instruction": "Smoothness parameter for modulation: 100.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
