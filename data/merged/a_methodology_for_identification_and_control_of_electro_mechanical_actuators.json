  "category": "Other",
  "estimated_time_mins": 6,
  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Connect plant to DAQ",
      "instruction": "Attach the electro‑mechanical actuator (e.g., induction motor or vehicle drive motor) to the computer through a data acquisition (DAQ) card and connect any speed sensor (tachometer) so that the plant output can be streamed to the computer.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Apply identification pulse and record response",
      "instruction": "Generate a short voltage pulse that approximates an impulse, apply it to the plant via the DAQ, and record the plant output at the specified sampling rate.",
      "substeps": [
        {
          "instruction": "Induction motor: output a 5 V pulse of 0.15 s duration; sample the speed signal at 0.05 sample / s.",
          "title": ""
        },
        {
          "instruction": "Vehicle drive motor: output a pulse signal (duration as required) through the DAQ and record the speed response.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Estimate transfer function",
      "instruction": "Use the recorded input‑output data in a recursive least‑squares (RLS) algorithm to identify a discrete‑time transfer function that best fits the plant dynamics.",
      "substeps": [
        {
          "instruction": "Induction motor: obtain a 6th‑order model; H(z)=0.1z⁶−0.066z⁵−0.2893z⁴+0.4615z³+0.2238z²+0.04004z⁶−0.7z⁵−0.6037z⁴+0.06655z³+0.3929z²−0.06332z+0.00384 (coefficients as reported).",
          "title": ""
        },
        {
          "instruction": "Vehicle drive motor: obtain a 3rd‑order model; H(z)=0.0012262zz³−2.3438z²+1.8739z−0.52036 (coefficients as reported).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Design controller in simulation",
      "instruction": "Replace the physical plant with the identified transfer function inside Simulink, choose a controller structure, tune its parameters, and verify performance with simulated reference signals.",
      "substeps": [
        {
          "instruction": "Induction motor: select a PID controller; set P = 3.8, I = 0.002, D = 0.5; test with a trapezoidal speed profile.",
          "title": ""
        },
        {
          "instruction": "Vehicle drive motor: select a proportional controller; tune to achieve overshoot < 10 % and settling time < 0.2 s; achieved overshoot = 8 % and settling time = 0.1 s.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Implement controller on real plant (HIL)",
      "instruction": "Reconnect the plant to the computer, run the controller code on the PC (or equivalent hardware), apply the previously tuned parameters, and perform online fine‑tuning as needed.",
      "substeps": [
        {
          "instruction": "Induction motor: run the PID controller from the computer; verify that motor speed follows the desired reference signal as shown in the experimental results.",
          "title": ""
        },
        {
          "instruction": "Vehicle drive motor: run the proportional controller via the DAQ and Simulink block diagram; introduce a disturbance by holding the wheel during steady state and confirm that the controller maintains speed at 25 RPM.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
