  "steps": [
    {
      "step_id": 0,
      "title": "Deduplicate FASTA sequences",
      "instruction": "Use fassort and fasuniq from the FAST Analysis of Sequences Toolbox to remove duplicate sequences from the spike and HE FASTA files, concatenating identifiers of identical sequences with a double underscore '__'.",
      "substeps": [
        {
          "instruction": "Run `fassort -s 192_HE_6_14_22.fasta | fasuniq --concat='__' > unique_HE_6_14_22.fasta`",
          "title": ""
        },
        {
          "instruction": "Run `fassort -s 192_Spike_6_14_22.fasta | fasuniq --concat='__' > unique_Spike_6_14_22.fasta`",
          "title": ""
        },
        {
          "instruction": "Run `fassort -s 345_Sequences_Bovine_HE_only.fasta | fasuniq --concat='__' > unique_345_Sequences_Bovine_HE_only.fasta`",
          "title": ""
        },
        {
          "instruction": "Run `fassort -s BetaCoronaVirus_HE_GE_1255_BP_BlastMatch_Bovine_HE_Consensus.fasta | fasuniq --concat='__' > unique_BetaCoronaVirus_HE_GE_1255_BP_BlastMatch_Bovine_HE_Consensus.fasta`",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Strip description text from FASTA headers",
      "instruction": "Remove all description text following the sequence ID in the FASTA headers using sed to create compact identifiers.",
      "substeps": [
        {
          "instruction": "Run `sed '/^>/ s/ .*//' unique_HE_6_14_22.fasta > unique_HE_6_14_22.SEQID_Only.fasta`",
          "title": ""
        },
        {
          "instruction": "Run `sed '/^>/ s/ .*//' unique_Spike_6_14_22.fasta > unique_Spike_6_14_22.SEQID_Only.fasta`",
          "title": ""
        },
        {
          "instruction": "Run `sed '/^>/ s/ .*//' 192_Genomes_Final_6_14_22.fasta > 192_Genomes_Final_6_14_22.SEQID_Only.fasta`",
          "title": ""
        },
        {
          "instruction": "Run `sed '/^>/ s/ .*//' unique_345_Sequences_Bovine_HE_only.fasta > unique_345_Sequences_Bovine_HE_only.SEQID_Only.fasta`",
          "title": ""
        },
        {
          "instruction": "Run `sed '/^>/ s/ .*//' unique_BetaCoronaVirus_HE_GE_1255_BP_BlastMatch_Bovine_HE_Consensus.fasta > unique_BetaCoronaVirus_HE_GE_1255_BP_BlastMatch_Bovine_HE_Consensus_SeqID_Only.fasta`",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Align BCV genomes",
      "instruction": "Align 192 BCV genomes using MAFFT with the globalpair method, maxiterate 1000, and reorder enabled, testing two different substitution matrices.",
      "substeps": [
        {
          "instruction": "For PAM (JTT) 200: `nohup mafft --thread 25 --globalpair --maxiterate 1000 --jtt 200 --reorder 192_Genomes_Final_6_14_22.SEQID_Only.fasta > 192_Genomes_Final_6_14_22.SEQID_Only.jtt_200.globalpair.afa_out &`",
          "title": ""
        },
        {
          "instruction": "For PAM (JTT) 100: `nohup mafft --thread 30 --globalpair --maxiterate 1000 --jtt 100 --reorder 192_Genomes_Final_6_14_22.SEQID_Only.fasta > 192_Genomes_Final_6_14_22.jtt_100.globalpair.SEQID_Only.afa_out &`",
          "title": ""
        },
        {
          "instruction": "Split the resulting .afa_out files into separate .afa (alignment) and .out (STDOUT) files using a text editor.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Align Spike sequences",
      "instruction": "Align unique Spike sequences using MAFFT with globalpair, maxiterate 1000, and reorder enabled, testing two different substitution matrices.",
      "substeps": [
        {
          "instruction": "For PAM (JTT) 200: `nohup mafft --thread 15 --globalpair --maxiterate 1000 --jtt 200 --reorder unique_Spike_6_14_22.SEQID_Only.fasta > unique_Spike_6_14_22.SEQID_Only.jtt_200.globalpair.afa_out &`",
          "title": ""
        },
        {
          "instruction": "For PAM (JTT) 100: `nohup mafft --thread 15 --globalpair --maxiterate 1000 --jtt 100 --reorder unique_Spike_6_14_22.SEQID_Only.fasta > unique_Spike_6_14_22.SEQID_Only.jtt_100.globalpair.afa_out &`",
          "title": ""
        },
        {
          "instruction": "Split the resulting .afa_out files into separate .afa and .out files.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Align HE sequences",
      "instruction": "Align unique HE sequences using MAFFT with globalpair, maxiterate 1000, and reorder enabled, testing two different substitution matrices.",
      "substeps": [
        {
          "instruction": "For PAM (JTT) 200: `nohup mafft --thread 15 --globalpair --maxiterate 1000 --jtt 200 --reorder unique_HE_6_14_22.SEQID_Only.fasta > unique_HE_6_14_22.SEQID_Only.jtt_200.globalpair.afa_out`",
          "title": ""
        },
        {
          "instruction": "For PAM (JTT) 100: `nohup mafft --thread 15 --globalpair --maxiterate 1000 --jtt 100 --reorder unique_HE_6_14_22.SEQID_Only.fasta > unique_HE_6_14_22.SEQID_Only.jtt_100.globalpair.afa_out`",
          "title": ""
        },
        {
          "instruction": "Split the resulting .afa_out files into separate .afa and .out files.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Align additional BCV HE sequences",
      "instruction": "Align additional unique BCV HE sequences using MAFFT with the PAM (JTT) 100 substitution matrix, globalpair, maxiterate 1000, and reorder enabled.",
      "substeps": [
        {
          "instruction": "Run `nohup mafft --thread 25 --globalpair --maxiterate 1000 --jtt 100 --reorder unique_345_Sequences_Bovine_HE_only.SEQID_Only.fasta > unique_345_Sequences_Bovine_HE_only.SEQID_Only.jtt_100.globalpair.afa_out &`",
          "title": ""
        },
        {
          "instruction": "Run `nohup mafft --thread 15 --globalpair --maxiterate 1000 --jtt 100 --reorder unique_BetaCoronaVirus_HE_GE_1255_BP_BlastMatch_Bovine_HE_Consensus_SeqID_Only.fasta > unique_BetaCoronaVirus_HE_GE_1255_BP_BlastMatch_Bovine_HE_Consensus_SeqID_Only.jtt_100.globalpair.afa_out`",
          "title": ""
        },
        {
          "instruction": "Split the resulting .afa_out files into separate .afa and .out files.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Generate Phylogenetic Trees",
      "instruction": "Generate RAxML trees for the aligned genomes, spike, and HE sequences (T8, N2000).",
      "substeps": [
        {
          "instruction": "Generate trees for HE (jtt_100 and jtt_200)",
          "title": ""
        },
        {
          "instruction": "Generate trees for Spike (jtt_100 and jtt_200)",
          "title": ""
        },
        {
          "instruction": "Generate trees for unique 345 HE sequences (jtt_100)",
          "title": ""
        },
        {
          "instruction": "Generate trees for BetaCoronaVirus HE Consensus sequences",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Extract and filter HE consensus sequences",
      "instruction": "Extract the consensus HE sequence from the MAFFT aligned 192 whole genomes and perform a BLAST search to identify related sequences.",
      "substeps": [
        {
          "instruction": "Extract consensus HE sequence using Geneious Discontiguous MegaBLAST (input: HE_realigned_consensus_sequence.fasta).",
          "title": ""
        },
        {
          "instruction": "Perform Discontiguous MegaBLAST against GenBank nt database with E-value of E-20.",
          "title": ""
        },
        {
          "instruction": "Filter the 844 resulting hits to 714 by requiring at least 98.4% (1255 bp) coverage of the query HE sequence to create BetaCoronaVirus_HE_GE_1255_BP_BlastMatch_Bovine_HE_Consensus.fasta.",
          "title": ""
        },
        {
          "instruction": "Filter this file for sequences containing 'bovine coronavirus' in the description field to produce 345_Sequences_Bovine_HE_only.fasta.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
