    },
    {
      "step_id": 3,
      "title": "(Optional) Install development version from GitHub",
      "instruction": "Clone the development repository, enter its directory, and install it in editable mode.",
      "substeps": [
        {
          "instruction": "git clone https://github.com/DavidFernandezBonet/Network_Spatial_Coherence.git",
          "title": ""
        },
        {
          "instruction": "cd Network_Spatial_Coherence",
          "title": ""
        },
        {
          "instruction": "pip install -e .",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Configure fast Gram matrix analysis",
      "instruction": "Set validation arguments to disable full Gram matrix, network dimension, and spatial constant calculations and enable fast Gram‑matrix computation.",
      "substeps": [
        {
          "instruction": "args.spatial_coherence_validation[\"gram_matrix\"] = False",
          "title": ""
        },
        {
          "instruction": "args.spatial_coherence_validation[\"network_dimension\"] = False",
          "title": ""
        },
        {
          "instruction": "args.spatial_coherence_validation[\"spatial_constant\"] = False",
          "title": ""
        },
        {
          "instruction": "args.spatial_coherence_validation[\"fast_gram_matrix\"] = True",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "(Optional) Enable sampled Gram computations",
      "instruction": "Activate multiple sampled Gram‑matrix estimation and specify 10 samples of size 1000 each.",
      "substeps": [
        {
          "instruction": "args.spatial_coherence_validation[\"sample_gram_matrix_multiple\"][\"enabled\"] = True",
          "title": ""
        },
        {
          "instruction": "args.spatial_coherence_validation[\"sample_gram_matrix_multiple\"][\"num_samples\"] = 10",
          "title": ""
        },
        {
          "instruction": "args.spatial_coherence_validation[\"sample_gram_matrix_multiple\"][\"sample_size\"] = 1000",
