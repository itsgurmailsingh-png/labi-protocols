  "steps": [
    {
      "step_id": 0,
      "title": "Activate SPE cartridge",
      "instruction": "Prepare the SOLA‑μ plate for peptide binding by sequentially conditioning it with methanol and buffers, centrifuging after each addition.",
      "substeps": [
        {
          "instruction": "Place the SOLA‑μ plate in a 96‑well waste plate.",
          "title": ""
        },
        {
          "instruction": "Add 200 µL LC/MS‑grade methanol.",
          "title": ""
        },
        {
          "instruction": "Centrifuge at 450 × g for 1 min at room temperature; discard the flow‑through.",
          "title": ""
        },
        {
          "instruction": "Add 200 µL Buffer B.",
          "title": ""
        },
        {
          "instruction": "Centrifuge at 450 × g for 1 min at room temperature; discard the flow‑through.",
          "title": ""
        },
        {
          "instruction": "Add 200 µL Buffer C.",
          "title": ""
        },
        {
          "instruction": "Centrifuge at 450 × g for 1 min at room temperature; discard the flow‑through.",
          "title": ""
        },
        {
          "instruction": "Repeat the Buffer C wash (add 200 µL Buffer C, centrifuge as above).",
          "title": ""
        },
        {
          "instruction": "Store Buffer C at 18 °C–24 °C for up to 3 months.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Load digested peptides onto SPE",
      "instruction": "Transfer acid‑ified peptide digests onto the activated SPE plate and centrifuge to bind peptides.",
      "substeps": [
        {
          "instruction": "Transfer digested peptides (200–1,000 µL per well) using low‑retention tips to the 96‑well SOLA plate (process in batches as needed).",
          "title": ""
        },
        {
          "instruction": "Centrifuge at 450 × g for 1 min at 18 °C–24 °C; discard the flow‑through each time.",
          "title": ""
        },
        {
          "instruction": "If desired, store half of the sample at –80 °C for future analysis.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Wash SPE with Buffer A",
      "instruction": "Remove residual contaminants by washing the bound peptides with Buffer A.",
      "substeps": [
        {
          "instruction": "Add 200 µL Buffer A.",
          "title": ""
        },
        {
          "instruction": "Centrifuge at 450 × g for 1 min at 18 °C–24 °C; discard the flow‑through.",
          "title": ""
        },
        {
          "instruction": "Repeat the Buffer A wash (add 200 µL Buffer A, centrifuge as above).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Elute peptides from SPE",
      "instruction": "Recover the purified peptides by eluting them with Buffer D into a LoBind PCR plate.",
      "substeps": [
        {
          "instruction": "Place the washed SOLA plate into a clean LoBind 96‑well PCR plate.",
          "title": ""
        },
        {
          "instruction": "Add 30 µL Buffer D.",
          "title": ""
        },
        {
          "instruction": "Centrifuge at 450 × g for 1 min at 18 °C–24 °C.",
          "title": ""
        },
        {
          "instruction": "Add a second 30 µL of Buffer D.",
          "title": ""
        },
        {
          "instruction": "Centrifuge again at 450 × g for 1 min at 18 °C–24 °C (final eluate volume = 60 µL).",
          "title": ""
        },
        {
          "instruction": "Store Buffer D at 18 °C–24 °C for up to 3 months.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Seal and store peptide eluates",
      "instruction": "Prepare the eluates for long‑term storage and downstream LC‑MS analysis.",
      "substeps": [
        {
          "instruction": "Seal the LoBind PCR plate containing the 60 µL eluates with a new adhesive cover.",
          "title": ""
        },
        {
          "instruction": "Optional: measure peptide concentration using either the Pierce Quantitative Colorimetric Peptide Assay or a NanoDrop at A205.",
          "title": ""
        },
        {
          "instruction": "Store the sealed plate at –80 °C.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Determine peptide concentration",
      "instruction": "Quantify peptide amount prior to LC‑MS using UV absorbance.",
      "substeps": [
        {
          "instruction": "Measure absorbance at 280 nm with a NanoPhotometer N60 (or equivalent spectrophotometer).",
          "title": ""
        },
        {
          "instruction": "Calculate concentration using the instrument’s software or standard curve.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
