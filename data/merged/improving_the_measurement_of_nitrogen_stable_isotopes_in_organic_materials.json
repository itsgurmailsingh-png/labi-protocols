      "timers": []
    },
    {
      "step_id": 1,
      "title": "Set column temperature",
      "instruction": "Maintain the 5 Å molsieve column at 40 °C throughout the measurement.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Run measurement and verify",
      "instruction": "Run the GC analysis of the bark sample using the modified setup; confirm that any CO peak is separated from the N₂ peak and record the δ¹⁵N value (expected ≈0.5 mUr).",
