  "steps": [
    {
      "step_id": 0,
      "title": "Prepare 33°C RPMI Media",
      "instruction": "Prepare no more than needed (typically 500 mL) of RPMI‑1640 medium for 33 °C culture. To each 500 mL, add approximately 9 % fetal bovine serum, 1× ITS‑A, 2.5 µg/mL gentamycin, and 5 U/mL interferon‑γ. Store the completed media at 4 °C for up to one month. Interferon‑γ stock is made at 250 U/µL in 1× PBS containing 0.1 % BSA, filter‑sterilized and stored at –20 °C for up to 6 months.",
      "substeps": [
        {
          "instruction": "Measure 500 mL RPMI‑1640 into a sterile bottle.",
          "title": ""
        },
        {
          "instruction": "Add ~9 % (v/v) fetal bovine serum.",
          "title": ""
        },
        {
          "instruction": "Add 1× ITS‑A supplement.",
          "title": ""
        },
        {
          "instruction": "Add gentamycin to a final concentration of 2.5 µg/mL.",
          "title": ""
        },
        {
          "instruction": "Add interferon‑γ to a final concentration of 5 U/mL.",
          "title": ""
        },
        {
          "instruction": "Mix gently, label, and store at 4 °C (max 1 month).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Thaw Frozen YAMC Cell Aliquots",
      "instruction": "Retrieve YAMC cell vials from liquid‑nitrogen storage. Loosen caps (do not fully remove) to vent nitrogen while maintaining sterility. Cells are frozen in 33 °C media containing 10 % DMSO; never from 39 °C conditions. Aim for 1 × 10⁶ – 5 × 10⁶ cells per 1 mL vial.",
      "substeps": [
        {
          "instruction": "Locate the vial in the liquid‑nitrogen dewar.",
          "title": ""
        },
        {
          "instruction": "Loosen the cap enough to allow gas release, keeping the cap partially on.",
          "title": ""
        },
        {
          "instruction": "Confirm the vial contains 33 °C media with 10 % DMSO.",
          "title": ""
        }
      ],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Warm Cells in 37°C Water Bath",
      "instruction": "Float the thawing vial in a 37 °C water bath for 2 minutes, then remove and pat the outside dry with a sterile tissue.",
      "substeps": [
        {
          "instruction": "Place the vial in a 37 °C water bath for exactly 2 min.",
          "title": ""
        },
        {
          "instruction": "Remove the vial and gently pat the exterior dry with a sterile wipe.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Plate Cells in Collagen‑Coated Dish",
      "instruction": "Transfer the entire volume of thawed cells and media into 10 mL of pre‑warmed 33 °C RPMI media placed on a collagen‑coated 10 cm tissue‑culture dish.",
      "substeps": [
        {
          "instruction": "Pre‑warm 10 mL of the prepared 33 °C RPMI media.",
          "title": ""
        },
        {
          "instruction": "Add the whole content of the vial to the 10 mL media on the collagen‑coated dish.",
          "title": ""
        },
        {
          "instruction": "Gently swirl to ensure even distribution.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Incubate and Replace Media Post‑Adherence",
      "instruction": "Place the dish in a 33 °C incubator with 5 % CO₂. After cells adhere (16–24 h), aspirate the media and replace with fresh 33 °C RPMI to remove residual DMSO.",
      "substeps": [
        {
          "instruction": "Incubate the dish at 33 °C, 5 % CO₂.",
          "title": ""
        },
        {
          "instruction": "After 16–24 h, check for cell adherence.",
          "title": ""
        },
        {
          "instruction": "Aspirate the existing media carefully.",
          "title": ""
        },
        {
          "instruction": "Add fresh 33 °C RPMI media (same composition as prepared).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
