  "materials": [
    "RPMI 1640 media",
    "Fetal bovine serum",
    "Gentamycin",
    "Interferon gamma",
    "Polybrene",
    "Puromycin",
    "Hygromycin",
    "RNeasy Mini Kit",
    "High Capacity cDNA Reverse Transcription Kit",
    "iQ SYBR Green qPCR Master Mix",
    "TaqMan probe",
