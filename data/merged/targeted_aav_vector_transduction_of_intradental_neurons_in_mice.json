  "protocol_id": "targeted_aav_vector_transduction_of_intradental_neurons_in_mice",
  "parent_protocol_id": null,
  "version_count": 1,
  "title": "Targeted AAV Vector Transduction of Intradental Neurons in Mice",
  "author": "Liu, Chang, et al.",
  "doi": "10.1016/j.xpro.2026.104424",
  "source_name": "star_protocols",
