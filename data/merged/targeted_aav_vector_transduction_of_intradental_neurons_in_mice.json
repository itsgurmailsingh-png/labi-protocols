  "quality_score": 9.0,
  "category": "Neuroscience",
  "estimated_time_mins": 60,
  "materials": [
    "AAV6.2-iCre (7.2×10E12 vg/mL)",
    "Silk Fibroin (50 mg/mL)",
    "Isofluorane",
    "Flowable Composite",
    "Ophthalmic ointment",
    "Digital Camera Software",
    "Olympus SZX7 Stereo Dissecting microscope",
    "Olympus FV3000 Confocal Microscope",
    "SomnoSuite® Low-Flow Anesthesia System",
    "Delanie Electric Nail Drill",
    "Black braided silk suture",
    "Eppendorf Research Plus Pipette",
    "Mini Centrifuge",
    "Surgical tweezers",
    "Laboratory tape",
    "Timing: 1 min (steps 20–25)"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Attach suture to retractors",
      "instruction": "Attach the black braided suture to the lateral retractors.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare silk fibroin aliquots",
      "instruction": "Prepare silk fibroin at 50 mg/mL in 50 µL aliquots and store them at –80 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Prepare AAV aliquots",
      "instruction": "Prepare AAV6.2‑iCre at 7.2×10¹² vg/mL in 2.5 µL aliquots and store them at –80 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Thaw reagents on ice",
      "instruction": "Thaw 2.5 µL aliquots of silk fibroin (50 mg/mL) and AAV6.2‑iCre (7.2×10¹² vg/mL) on ice; keep the thawed silk fibroin at 4 °C (stable for 1 month) and the thawed AAV at 4 °C (stable for 1 week).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Mix AAV with silk fibroin",
      "instruction": "Combine equal volumes of the viral vector and silk fibroin at a 1:1 ratio, mix gently, spin down, and keep the mixture on ice.",
      "substeps": [
        {
          "instruction": "Pipette silk fibroin into the viral vector.",
          "title": ""
        },
        {
          "instruction": "Pipette up and down gently to mix.",
          "title": ""
        },
        {
          "instruction": "Spin down the mixture in a mini‑centrifuge at maximum speed (RCF ≈ 2,000 × g).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Eject composite bead",
      "instruction": "Eject a 0.5–1 mm diameter bead of dental composite onto a working surface.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Pick up paper point",
      "instruction": "Use forceps to pick up an endodontic paper point.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Load composite onto point",
      "instruction": "Collect a small amount of flowable composite (approximately the size of a pin head) on the tip of the endodontic paper point.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Cover preparation with composite",
      "instruction": "Place the composite‑loaded paper point onto the tooth preparation and cover the pulp horns with the composite.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Remove excess composite",
      "instruction": "Use a clean endodontic paper point to remove any excess composite and prevent over‑loading of the restoration material.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Light‑cure composite",
      "instruction": "Light‑cure the composite for 10 seconds, keeping the curing light at an adequate distance from the tooth to avoid heating.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 11,
      "title": "Turn off anesthesia",
      "instruction": "Turn off the anesthesia machine.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 12,
      "title": "Remove retractors",
      "instruction": "Gently remove the lateral retractors from the mouse.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 13,
      "title": "Detach retraction cord",
      "instruction": "Detach the retraction cord from the mandibular incisors.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 14,
      "title": "Detach composite from incisors",
      "instruction": "Detach any remaining composite from the upper incisors.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 15,
      "title": "Remove nose cone",
      "instruction": "Remove the nose cone from the mouse.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 16,
      "title": "Confirm recovery",
      "instruction": "Ensure the mouse is awake, recovered in a clean cage, and then return it to its home cage.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 17,
      "title": "Verify labeling after 3 weeks",
      "instruction": "Three weeks post‑application, perform trigeminal ganglion (TG) screening to visualize the TG surface and verify AAV labeling efficiency; note that expression may be detectable earlier but should be empirically determined.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
