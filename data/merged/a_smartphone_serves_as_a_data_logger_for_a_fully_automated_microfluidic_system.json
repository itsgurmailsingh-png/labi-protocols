  "steps": [
    {
      "step_id": 0,
      "title": "Prepare 0.01 M fluorescein solution",
      "instruction": "Dissolve 0.33231 g fluorescein in deionized distilled water and bring the final volume to 1 L to obtain a 0.01 mol/L solution.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare 0.001 M fluorescein stock",
      "instruction": "Dissolve 0.09407 g fluorescein sodium salt in deionized distilled water, adjusting the volume to achieve a 0.001 mol/L concentration (use appropriate volume).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Store solutions in dark",
      "instruction": "Keep both solutions in a dark environment, covering the containers with aluminum foil to prevent photo‑degradation; prepare fresh solutions for each calibration run.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Assemble microfluidic system",
      "instruction": "Connect the smartphone, Arduino UNO, pumps, microfluidic chip, flow cell, and computer as shown in the system diagram; ensure all tubing is primed.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Configure Arduino control via Excel",
      "instruction": "On a laptop running Excel 2016, set up the macro that sends volume and timing commands to the Arduino microcontroller to drive the pumps.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Load fluorescein into chip channels",
      "instruction": "Using the Arduino‑controlled pumps, inject the prepared fluorescein solution into the first two channels of the microfluidic chip; subsequently add deionized water to the second channel as programmed.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Fill flow cell and detect signal",
      "instruction": "Allow the flow cell to fill with fluorescein; the photocell sensor will detect the fluorescence signal as the dye passes.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Record and analyze fluorescence peaks",
      "instruction": "The smartphone’s custom app records the sensor signal; acquire three successive peak heights, calculate their mean, and use this value to determine fluorescein concentration.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
