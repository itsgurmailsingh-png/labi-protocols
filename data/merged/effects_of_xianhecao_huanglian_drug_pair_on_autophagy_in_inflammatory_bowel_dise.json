  "steps": [
    {
      "step_id": 0,
      "title": "Fix colon tissues in paraformaldehyde",
      "instruction": "Extract colon tissue samples, rinse briefly with PBS, and immerse them in 4 % paraformaldehyde solution for a minimum of 24 hours at room temperature.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Dehydrate and embed tissues, cut sections",
      "instruction": "Dehydrate the fixed tissues through an ethanol gradient, embed in paraffin, and cut 5 µm thick sections using a microtome.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Perform H&E staining and microscopy",
      "instruction": "Stain the sections with the standard hematoxylin‑eosin (H&E) protocol, seal the slides, and examine colon architecture under a light microscope.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Conduct PAS staining for goblet cells",
      "instruction": "Apply the established Periodic Acid‑Schiff (PAS) staining procedure to evaluate goblet cell numbers and mucus secretion.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Execute IHC staining on colon sections",
      "instruction": "Process paraffin‑embedded sections for immunohistochemistry as follows:",
      "substeps": [
        {
          "instruction": "Deparaffinize sections using xylene and descending ethanol series.",
          "title": ""
        },
        {
          "instruction": "Perform antigen retrieval (method as per laboratory standard).",
          "title": ""
        },
        {
          "instruction": "Inhibit endogenous peroxidase activity.",
          "title": ""
        },
        {
          "instruction": "Block non‑specific binding (sealing).",
          "title": ""
        },
        {
          "instruction": "Incubate overnight at 4 °C with primary antibodies diluted in PBS: Muc2 (1:2000), Occludin (1:250), ZO‑1 (1:1000), Claudin‑1 (1:250).",
          "title": ""
        },
        {
          "instruction": "Apply appropriate secondary antibodies.",
          "title": ""
        },
        {
          "instruction": "Develop with DAB chromogen.",
          "title": ""
        },
        {
          "instruction": "Counterstain nuclei with hematoxylin.",
          "title": ""
        },
        {
          "instruction": "Dehydrate slides, mount using neutral glue, and allow to dry.",
          "title": ""
        },
        {
          "instruction": "Observe stained sections under a microscope.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Culture NCM460 and LOVO cells",
      "instruction": "Obtain NCM460 intestinal epithelial cells and LOVO colon cancer cells (Wuhan Procell). Culture NCM460 in RPMI‑1640 and LOVO in Ham’s F‑12 K medium, each supplemented with 10 % fetal bovine serum and 1 % penicillin/streptomycin, and incubate at 37 °C with 5 % CO₂.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Serum‑starve cells before experiments",
      "instruction": "Replace growth medium with serum‑free medium and incubate cells for 24 hours prior to any treatment.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Induce inflammatory model with LPS",
      "instruction": "Add lipopolysaccharide (LPS) to both cell lines at a final concentration of 10 µg mL⁻¹ and incubate to establish an IBD‑like inflammatory condition.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Treat cells with medicated serum dose series",
      "instruction": "Replace medium with culture medium containing Xianhecao‑Huanglian drug‑pair medicated serum at 0 %, 10 %, 20 %, 30 %, 40 %, or 50 % (v/v) and incubate for 24 hours to assess cell survival.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Test 20 % serum with AG490 and LPS",
      "instruction": "For the specific experiment, add 20 % medicated serum to cells, then after 2 hours add AG490 (alone or in combination with the serum). Following AG490 addition, stimulate cells with 10 µg mL⁻¹ LPS for 24 hours at 37 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Analyze data statistically",
      "instruction": "Perform each condition in at least three independent replicates; present results as mean ± standard deviation. Compare groups using one‑way ANOVA followed by Tukey’s post‑hoc test. Conduct analyses with GraphPad Prism version 9.5.0, considering p < 0.05 as statistically significant.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
