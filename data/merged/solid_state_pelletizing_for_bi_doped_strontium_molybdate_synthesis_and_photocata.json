  "category": "Chemistry & Synthesis",
  "estimated_time_mins": 42,
  "materials": [
    "crucible",
    "mortar",
    "pestle",
    "ethanol",
    "muffle furnace",
    "desiccator",
    "magnetic stirrer",
    "glass tumbler",
    "substrate",
    "(1)SrCO3+Bi2O3+MoO3→Sr1−3xBi2xΦxMoO4+CO2"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare Rhodamine B solution",
      "instruction": "Dissolve Rhodamine B in deionized water to obtain a 10 mg L⁻¹ solution and make up the volume to 200 mL in a double‑layer glass tumbler.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Add photocatalyst and adjust pH",
      "instruction": "Add 0.2 g of the Sr₁₋₃ₓBi₂ₓΦₓMoO₄ photocatalyst (x = 0.15 for the optimal test) to the RhB solution and adjust the suspension pH to 3.0 using dilute acid or base as needed.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Establish adsorption equilibrium",
      "instruction": "Place the tumbler on a magnetic stirrer set to approximately 400 rpm and stir the suspension for about 30 min at room temperature.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Set up irradiation system",
      "instruction": "Position a 350 W Philips HPL‑N lamp (emits at 365 nm, photon energy ≈ 4 eV) above the tumbler, connect a water‑recirculation cooling system to maintain the reaction temperature at 40.0 ± 1 °C, and start the corundum air‑diffuser aeration system to supply excess oxygen.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Irradiate and collect time‑point samples",
      "instruction": "Turn on the UV lamp and irradiate the suspension for a total of 30 min, withdrawing aliquots at 1, 2, 5, 10, 15, 20 and 30 min.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Filter withdrawn samples",
      "instruction": "Immediately filter each collected aliquot through a suitable membrane filter to remove the catalyst particles, then seal the filtrate in clean test tubes.",
      "substeps": [],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Measure absorbance",
      "instruction": "Record the UV‑Vis absorbance of each filtered sample at 554 nm using a Unico 2800 spectrophotometer.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Calculate decolorization percentage",
      "instruction": "Using the initial absorbance (A₀) and the absorbance at each time point (Aₜ), compute the decolorization D = [(A₀ − Aₜ)/A₀] × 100 % for each sample.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Perform catalyst reuse cycles (optional)",
      "instruction": "After the first run with x = 0.15, recover the catalyst by filtration, dry it, and repeat the degradation assay under the same conditions for a second and third cycle to evaluate possible adsorption effects.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
