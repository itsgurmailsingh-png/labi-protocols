  "steps": [
    {
      "step_id": 0,
      "title": "Prepare tissue homogenate",
      "instruction": "Wash excised liver with 0.9 % (w/v) NaCl solution, homogenize in cold 1.15 % (w/v) KCl using a glass homogenizer, filter the homogenate and dilute 1 : 500 with 50 mM PBS.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Add hydrogen peroxide",
      "instruction": "Add 2 ml of hydrogen peroxide to each test tube (sample) and to each standard tube.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Add sample or water",
      "instruction": "Add 1 ml of the catalase‑containing sample to the test tube and 1 ml of distilled water to the standard tube.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Incubate reaction",
      "instruction": "Vortex the tubes briefly and incubate at 37 °C for 2 min.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Quench with ammonium molybdate",
      "instruction": "Withdraw 500 µl from each incubated tube and transfer to a clean tube containing 300 µl ammonium molybdate; mix well.",
      "substeps": [
        {
          "instruction": "Withdraw 500 µl aliquot",
          "title": ""
        },
        {
          "instruction": "Add to tube with 300 µl ammonium molybdate",
          "title": ""
        },
        {
          "instruction": "Mix thoroughly",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Add pyrogallol red",
      "instruction": "Add 3 ml pyrogallol red reagent (1 mmol L⁻¹, pH 7.0) to each tube, mix, and record the zero time as the moment the total PGR volume has been added.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Measure absorbance decay",
      "instruction": "Within 30 s transfer an appropriate volume of the reaction mixture to a cuvette, record the decrease in absorbance at 545 nm against a distilled‑water blank every few seconds for 0.5–4.5 min after the start of the PGR‑H₂O₂ reaction.",
      "substeps": [
        {
          "instruction": "Transfer reaction mixture to cuvette within 30 s",
          "title": ""
        },
        {
          "instruction": "Record absorbance at 545 nm against blank from 0.5 to 4.5 min",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
