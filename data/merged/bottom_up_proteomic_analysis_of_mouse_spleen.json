  "steps": [
    {
      "step_id": 0,
      "title": "Prepare all required buffers",
      "instruction": "Make all essential buffers and solutions fresh on the day of sample preparation, using analytical‑grade reagents and ultrapure water; include a protease inhibitor cocktail in the tissue‑extract buffers, and wear protective gloves, lab coat, and face mask when handling SDS‑ and iodoacetamide‑containing solutions.",
      "substeps": [
        {
          "instruction": "Allocate 3–5 h for buffer preparation.",
          "title": ""
        },
        {
          "instruction": "Ensure sufficient volume of each solution for homogenization, protein quantification, digestion, cleanup, LC, and MS.",
          "title": ""
        },
        {
          "instruction": "Use only LC‑MS‑compatible, analytical‑grade chemicals and ultrapure water.",
          "title": ""
        },
        {
          "instruction": "Add a commercially available protease inhibitor cocktail to all initial tissue‑extract buffers.",
          "title": ""
        },
        {
          "instruction": "Wear protective gloves, laboratory coat, and face mask during preparation of SDS and iodoacetamide buffers.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Run Progenesis QI analysis",
      "instruction": "Process the LC‑MS raw files in Progenesis QI (Waters) to generate a normalized, statistically validated peptide‑level dataset for comparative abundance profiling.",
      "substeps": [
        {
          "instruction": "Allocate 6–48 h for the entire data‑analysis workflow.",
          "title": ""
        },
        {
          "instruction": "Import all raw MS files into Progenesis QI.",
          "title": ""
        },
        {
          "instruction": "Perform automatic run alignment to align all LC‑MS runs to a chosen reference file.",
          "title": ""
        },
        {
          "instruction": "Execute automatic peak picking and matching across all aligned runs to create an aggregate dataset containing peak information from every sample.",
          "title": ""
        },
        {
          "instruction": "Apply the generated peptide map to each individual sample, achieving 100 % peak matching with no missing values.",
          "title": ""
        },
        {
          "instruction": "Normalize peptide‑ion abundances across samples to enable quantitative comparison between wild‑type and mutant (mdx‑4cv) spleen extracts.",
          "title": ""
        },
        {
          "instruction": "Generate clustering visualizations (e.g., wild‑type in purple, mdx‑4cv in orange) based on significantly changing peptides.",
          "title": ""
        },
        {
          "instruction": "Identify peptides of interest using an ANOVA significance threshold of p ≤ 0.05.",
          "title": ""
        },
        {
          "instruction": "Export MS/MS spectra for the significant peptides and identify them with Proteome Discoverer 2.2.",
          "title": ""
        },
        {
          "instruction": "Re‑import the identification results into Progenesis QI to review peptide ions used for protein quantification.",
          "title": ""
        },
        {
          "instruction": "Determine proteins of interest using the same ANOVA p ≤ 0.05 criterion.",
          "title": ""
        },
        {
          "instruction": "Review quality‑control metrics before finalizing the list of significant proteins, covering:",
          "title": ""
        },
        {
          "instruction": "• Sample‑preparation metrics (e.g., missed cleavages).",
          "title": ""
        },
        {
          "instruction": "• Instrument metrics (e.g., column performance, MS configuration).",
          "title": ""
        },
        {
          "instruction": "• Experiment metrics (e.g., outlier proteins/peptides).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
