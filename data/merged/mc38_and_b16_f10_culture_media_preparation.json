      "step_id": 0,
      "title": "Prepare MC38 and B16-F10 Culture Media",
      "instruction": "Prepare the culture media by supplementing DMEM with FBS and penicillin-streptomycin, then filtering for sterility.",
      "substeps": [
        {
          "instruction": "Working in the hood, remove 50 ml of DMEM from a 500 ml bottle (HyClone™ Dulbecco's High Glucose Modified Eagles Medium).",
          "title": ""
        },
        {
          "instruction": "Add 50 ml FBS (Fetal Plus) (10%) and 5 ml penicillin-streptomycin (1%) to the remaining 450 ml DMEM.",
          "title": ""
        },
        {
          "instruction": "Sterile filter the mixture into a 500 ml 0.22 filter bottle.",
          "title": ""
        },
        {
          "instruction": "Store the prepared media at 4 °C.",
          "title": ""
        }
      ],
      "is_critical": false,
