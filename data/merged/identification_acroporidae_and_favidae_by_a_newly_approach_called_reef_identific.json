  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Select sampling sites purposively",
      "instruction": "Apply a purposive sampling strategy to pre‑determine the reef locations and specific coral colonies that will be recorded, as decided by the researchers.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Record underwater video of reef sides",
      "instruction": "At each selected site, deploy an underwater camera and record video of every side of the reef for approximately 2 minutes (±2 min) per side, ensuring thorough coverage of all orientations.",
      "substeps": [
        {
          "instruction": "Position the camera to capture the first side of the reef.",
          "title": ""
        },
        {
          "instruction": "Start recording and maintain a steady view for ~2 min.",
          "title": ""
        },
        {
          "instruction": "Rotate or move the camera to record the next side, repeating until all sides are captured.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Transfer video files to computer",
      "instruction": "After field collection, download all recorded video files to a computer for subsequent processing with the RIKA‑R3DI workflow.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Generate 3D imagery and analyze visually",
      "instruction": "Import the videos into the RIKA‑R3DI (Reef Identification Application Knowhow‑Reconstructed by 3D Imagery) software, reconstruct 3D models, and perform visual‑engineering analysis focusing on corallite formation, corallite size, and coral colour.",
      "substeps": [
        {
          "instruction": "Open RIKA‑R3DI and load the video files.",
          "title": ""
        },
        {
          "instruction": "Run the 3D reconstruction module to create a 3‑dimensional view.",
          "title": ""
        },
        {
          "instruction": "Examine the 3D model for corallite morphology, size, and coloration.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Identify coral genera using references",
      "instruction": "Compare the observed 3D features with the Coral Book Finder and Coral of the World guides to assign coral genera and estimate their percentage cover.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
