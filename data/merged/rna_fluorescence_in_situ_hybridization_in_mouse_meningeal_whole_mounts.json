    "Opal 520 Reagent Pack",
    "Opal 570 Reagent Pack",
    "Opal 690 Reagent Pack",
    "RNAscope 3-Plex Positive Control Probe-MmACD",
    "RNAscope 3-Plex Negative Control Probe-MmACD",
    "RNAscope probe-Mm-Pecam1ACD",
    "RNAscope probe-Mm-Aif1-C3ACD",
    "RNAscope probe-Mm-Cx3cr1ACD",
    "10% Neutral Buffered Formalin",
