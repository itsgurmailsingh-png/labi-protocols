  "steps": [
    {
      "step_id": 0,
      "title": "Practice meninges extraction",
      "instruction": "After overnight fixation, split each calvaria down the midline with a razor blade to create two pieces, then practice extracting and mounting the meninges to ensure high‑quality samples with preserved structure.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Harvest and fix calvaria overnight",
      "instruction": "Euthanize the mouse, perfuse transcardially with 10 mL sterile saline containing heparin (100 U/mL) followed by 6 mL 10 % neutral‑buffered formalin; cut away fur and skin, make a transverse cut between the eye sockets, then cut posteriorly along the skull sides, lift off the calvaria with attached meninges, and fix the calvaria in 10 % neutral‑buffered formalin overnight at room temperature in a 15 mL conical tube.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Extract fixed meninges",
      "instruction": "Prepare a 24‑well plate with two wells containing 1 mL PBS each; briefly rinse the fixed calvaria in PBS, keep it moist with ~100 µL PBS, and under a stereomicroscope loosen the meninges around the perimeter and peel them off starting at the olfactory bulb toward the midline, then from the cerebellum to the olfactory bulbs; place the extracted meninges in the first PBS well, shake 5 min at 70 rpm, transfer to the second well and shake another 5 min at 70 rpm; keep the meninges in PBS no longer than 1 h at room temperature.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Mount meninges onto slides",
      "instruction": "Place ~100 µL PBS in the center of a microscope slide, add the washed meninges, gently spread them with fine forceps, remove excess liquid with a pipette and then with a paper tissue, and dry the preparation on a flat surface overnight at room temperature.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Dry and wash mounted meninges",
      "instruction": "The next day, dip the dried meninges about 10 times in distilled water, then dry them either at 42 °C for 24 h or at room temperature for at least 3 days; dried slides can be stored in a dry place at room temperature for up to 1 year.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Quantify RNA signal in images",
      "instruction": "Capture fluorescence images, optionally deconvolve them with Huygens software, then use Fiji/ImageJ to threshold the appropriate channel and run ‘Analyze Particles’ for low/medium expression genes; for high‑expression targets follow ACD’s guidelines for quantification.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
