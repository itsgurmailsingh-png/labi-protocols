  "steps": [
    {
      "step_id": 0,
      "title": "Load required R packages",
      "instruction": "Load SingCellaR and all additional R packages needed for AUCell and DAseq analyses.",
      "substeps": [
        {
          "instruction": "library(SingCellaR)",
          "title": ""
        },
        {
          "instruction": "library(AUCell)",
          "title": ""
        },
        {
          "instruction": "library(ggplot2)",
          "title": ""
        },
        {
          "instruction": "library(DAseq)",
          "title": ""
        },
        {
          "instruction": "source('./utilis.R')",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Load integrated SingCellaR object",
      "instruction": "Load the previously generated integrated SingCellaR object saved in step 52.",
      "substeps": [
        {
          "instruction": "load(file = \"./Human_HSPC_All.SingCellaR.rdata\")",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Build AUCell gene rankings",
      "instruction": "Create a ranked gene list from the expression matrix using AUCell's ranking function and save the rankings object.",
      "substeps": [
        {
          "instruction": "set.seed(2021)",
          "title": ""
        },
        {
          "instruction": "exprMatrix human_HSPCs_cells_rankings",
          "title": ""
        },
        {
          "instruction": "save(human_HSPCs_cells_rankings, file = \"./Human_HSPC_rankings.AUCells.rdata\")",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Calculate AUCell scores",
      "instruction": "Compute AUCell enrichment scores for each cell using the rankings generated in the previous step and save the scores object.",
      "substeps": [
        {
          "instruction": "set.seed(2021)",
          "title": ""
        },
        {
          "instruction": "human_HSPCs.AUCells.score",
          "title": ""
        },
        {
          "instruction": "save(human_HSPCs.AUCells.score, file = \"./human_HSPCs.AUCells.score.rdata\")",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Visualize AUCell scores on UMAP",
      "instruction": "Overlay AUCell scores for a chosen gene signature on the UMAP embedding, optionally limiting the display to a specific cluster and applying a score cutoff.",
      "substeps": [
        {
          "instruction": "plot_umap_label_by_AUCell_score(",
          "title": ""
        },
        {
          "instruction": "Human_HSPC,",
          "title": ""
        },
        {
          "instruction": "AUCell_gene_set_name = \"HSPC_MPP\",",
          "title": ""
        },
        {
          "instruction": "AUCell_score = human_HSPCs.AUCells.score,",
          "title": ""
        },
        {
          "instruction": "selected.limited.clusters = \"cl1\",",
          "title": ""
        },
        {
          "instruction": "IsLimitedAUCscoreByClusters = TRUE,",
          "title": ""
        },
        {
          "instruction": "AUCell_cutoff = 0.15",
          "title": ""
        },
        {
          "instruction": ")",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Differential abundance testing with DAseq",
      "instruction": "Run pairwise DAseq comparisons between two tissue groups (eFL vs. FL) to identify differentially abundant cell populations and save the plot.",
      "substeps": [
        {
          "instruction": "run_DAseq_comparison(",
          "title": ""
        },
        {
          "instruction": "Human_HSPC,",
          "title": ""
        },
        {
          "instruction": "groupA = \"eFL\",",
          "title": ""
        },
        {
          "instruction": "groupB = \"FL\",",
          "title": ""
        },
        {
          "instruction": "labels.1 = c(\"eFL_1\",\"eFL_2\"),",
          "title": ""
        },
        {
          "instruction": "labels.2 = c(\"FL_1\",\"FL_2\"),",
          "title": ""
        },
        {
          "instruction": "path = \"./\",",
          "title": ""
        },
        {
          "instruction": "outputname = \"eFL_vs_FL.pdf\"",
          "title": ""
        },
        {
          "instruction": ")",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Force‑directed graph analysis (FDG)",
      "instruction": "Generate a force‑directed graph layout using supervised Harmony embeddings and visualize trajectories by clustering and by multiple lineage gene sets.",
      "substeps": [
        {
          "instruction": "library(SingCellaR)  # load package (if not already loaded)",
          "title": ""
        },
        {
          "instruction": "load(file = \"./Human_HSPC_All.SingCellaR.rdata\")  # load integrated object",
          "title": ""
        },
        {
          "instruction": "runFA2_ForceDirectedGraph(",
          "title": ""
        },
        {
          "instruction": "Human_HSPC,",
          "title": ""
        },
        {
          "instruction": "useIntegrativeEmbeddings = TRUE,",
          "title": ""
        },
        {
          "instruction": "integrative_method = \"supervised_harmony\",",
          "title": ""
        },
        {
          "instruction": "knn.metric = \"euclidean\",",
          "title": ""
        },
        {
          "instruction": "n.dims.use = 40,",
          "title": ""
        },
        {
          "instruction": "n.neighbors = 5,",
          "title": ""
        },
        {
          "instruction": "n.seed = 35,",
          "title": ""
        },
        {
          "instruction": "fa2_n_iter = 1000",
          "title": ""
        },
        {
          "instruction": ")",
          "title": ""
        },
        {
          "instruction": "plot_forceDirectedGraph_label_by_clusters(Human_HSPC, show_method = \"louvain\")",
          "title": ""
        },
        {
          "instruction": "plot_forceDirectedGraph_label_by_multiple_gene_sets(",
          "title": ""
        },
        {
          "instruction": "Human_HSPC,",
          "title": ""
        },
        {
          "instruction": "gmt.file = \"./Human_genesets/human.signature.genes.v1.gmt\",",
          "title": ""
        },
        {
          "instruction": "show_gene_sets = c(\"Erythroid\",\"Myeloid\",\"Lymphoid\",\"Megakaryocyte\"),",
          "title": ""
        },
        {
          "instruction": "custom_color = c(\"red\",\"cyan\",\"orange\",\"purple\"),",
          "title": ""
        },
        {
          "instruction": "isNormalizedByHouseKeeping = FALSE,",
          "title": ""
        },
        {
          "instruction": "edge.size = 0,",
          "title": ""
        },
        {
          "instruction": "edge.color = \"#FFFFFF\",",
          "title": ""
        },
        {
          "instruction": "vertex.size = 0.2,",
          "title": ""
        },
        {
          "instruction": "showEdge = FALSE,",
          "title": ""
        },
        {
          "instruction": "showLegend = TRUE",
          "title": ""
        },
        {
          "instruction": ")",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Diffusion map analysis",
      "instruction": "Create a diffusion map layout using supervised Harmony embeddings and visualize trajectories by clustering and by multiple lineage gene sets.",
      "substeps": [
        {
          "instruction": "library(SingCellaR)",
          "title": ""
        },
        {
          "instruction": "library(destiny)",
          "title": ""
        },
        {
          "instruction": "load(file = \"./Human_HSPC_All.SingCellaR.rdata\")",
          "title": ""
        },
        {
          "instruction": "runDiffusionMap(",
          "title": ""
        },
        {
          "instruction": "Human_HSPC,",
          "title": ""
        },
        {
          "instruction": "useIntegrativeEmbeddings = TRUE,",
          "title": ""
        },
        {
          "instruction": "integrative_method = \"supervised_harmony\",",
          "title": ""
        },
        {
          "instruction": "n.dims.use = 40,",
          "title": ""
        },
        {
          "instruction": "n.seed = 10",
          "title": ""
        },
        {
          "instruction": ")",
          "title": ""
        },
        {
          "instruction": "plot_diffusionmap_label_by_clusters(Human_HSPC, show_method = \"louvain\")",
          "title": ""
        },
        {
          "instruction": "plot_diffusionmap_label_by_multiple_gene_sets(",
          "title": ""
        },
        {
          "instruction": "Human_HSPC,",
          "title": ""
        },
        {
          "instruction": "gmt.file = \"./Human_genesets/human.signature.genes.v1.gmt\",",
          "title": ""
        },
        {
          "instruction": "show_gene_sets = c(\"Erythroid\",\"Myeloid\",\"Lymphoid\",\"Megakaryocyte\",\"Endothelial_cells\"),",
          "title": ""
        },
        {
          "instruction": "custom_color = c(\"red\",\"cyan\",\"orange\",\"purple\",\"green\"),",
          "title": ""
        },
        {
          "instruction": "isNormalizedByHouseKeeping = FALSE",
          "title": ""
        },
        {
          "instruction": ")",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Monocle3 trajectory analysis",
      "instruction": "Prepare Monocle3 inputs from the integrated SingCellaR object, construct a CellDataSet, and visualize trajectories and pseudotime on UMAP and FDG embeddings.",
      "substeps": [
        {
          "instruction": "library(SingCellaR)",
          "title": ""
        },
        {
          "instruction": "library(monocle3)",
          "title": ""
        },
        {
          "instruction": "library(ggplot2)",
          "title": ""
        },
        {
          "instruction": "library(ComplexHeatmap)",
          "title": ""
        },
        {
          "instruction": "library(circlize)",
          "title": ""
        },
        {
          "instruction": "library(RColorBrewer)",
          "title": ""
        },
        {
          "instruction": "source('./utilis.R')",
          "title": ""
        },
        {
          "instruction": "load(file = \"./Human_HSPC_All.SingCellaR.rdata\")",
          "title": ""
        },
        {
          "instruction": "# Prepare Monocle3 inputs (expression matrix, cell metadata, gene annotation)",
          "title": ""
        },
        {
          "instruction": "cells.used <- umi_used.umi  # placeholder for raw counts matrix",
          "title": ""
        },
        {
          "instruction": "expression_matrix <- cells.used",
          "title": ""
        },
        {
          "instruction": "cell_metadata <- rownames(cell_metadata)",
          "title": ""
        },
        {
          "instruction": "gene_annotation <- colnames(gene_annotation)",
          "title": ""
        },
        {
          "instruction": "cds <- new_cell_data_set(",
          "title": ""
        },
        {
          "instruction": "expression_data = expression_matrix,",
          "title": ""
        },
        {
          "instruction": "cell_metadata = cell_metadata,",
          "title": ""
        },
        {
          "instruction": "gene_metadata = gene_annotation",
          "title": ""
        },
        {
          "instruction": ")",
          "title": ""
        },
        {
          "instruction": "# Add embeddings from SingCellaR",
          "title": ""
        },
        {
          "instruction": "cds@int_colData@listData$reducedDims$Aligned <- Human_HSPC@SupervisedHarmony.embeddings",
          "title": ""
        },
        {
          "instruction": "cds@int_colData@listData$reducedDims$UMAP <- Human_HSPC@umap.result",
          "title": ""
        },
        {
          "instruction": "cds@clusters$UMAP$clusters <- Human_HSPC@clusters$UMAP$clusters",
          "title": ""
        },
        {
          "instruction": "cds@int_colData@listData$root.nodes <- NULL  # set later if needed",
          "title": ""
        },
        {
          "instruction": "save(cds, file = \"./Human_HSPC_monocle3.rdata\")",
          "title": ""
        },
        {
          "instruction": "# Visualize trajectory paths on UMAP",
          "title": ""
        },
        {
          "instruction": "plot_cells(",
          "title": ""
        },
        {
          "instruction": "cds,",
          "title": ""
        },
        {
          "instruction": "group_label_size = 5,",
          "title": ""
        },
        {
          "instruction": "color_cells_by = \"louvain_cluster\",",
          "title": ""
        },
        {
          "instruction": "show_trajectory_graph = TRUE,",
          "title": ""
        },
        {
          "instruction": "label_roots = TRUE,",
          "title": ""
        },
        {
          "instruction": "label_cell_groups = TRUE,",
          "title": ""
        },
        {
          "instruction": "label_groups_by_cluster = TRUE,",
          "title": ""
        },
        {
          "instruction": "label_leaves = FALSE,",
          "title": ""
        },
        {
          "instruction": "label_branch_points = FALSE",
          "title": ""
        },
        {
          "instruction": ")",
          "title": ""
        },
        {
          "instruction": "# Visualize pseudotime on UMAP",
          "title": ""
        },
        {
          "instruction": "plot_cells(",
          "title": ""
        },
        {
          "instruction": "cds,",
          "title": ""
        },
        {
          "instruction": "color_cells_by = \"pseudotime\",",
          "title": ""
        },
        {
          "instruction": "show_trajectory_graph = FALSE,",
          "title": ""
        },
        {
          "instruction": "label_roots = TRUE,",
          "title": ""
        },
        {
          "instruction": "label_cell_groups = FALSE,",
          "title": ""
        },
        {
          "instruction": "label_leaves = FALSE,",
          "title": ""
        },
        {
          "instruction": "label_branch_points = FALSE,",
          "title": ""
        },
        {
          "instruction": "graph_label_size = 1.5,",
          "title": ""
        },
        {
          "instruction": "group_label_size = 4,",
          "title": ""
        },
        {
          "instruction": "cell_size = 1.5",
          "title": ""
        },
        {
          "instruction": ")",
          "title": ""
        },
        {
          "instruction": "# Remove endothelial cell cluster (cl17) before FDG pseudotime plot",
          "title": ""
        },
        {
          "instruction": "sc.clusters <- subset(cds, clusters != \"cl17\")",
          "title": ""
        },
        {
          "instruction": "fa2.used <- sc.clusters",
          "title": ""
        },
        {
          "instruction": "fa2.dat <- as.data.frame(fa2.used@int_colData@listData$reducedDims$FA2)",
          "title": ""
        },
        {
          "instruction": "ggplot(data = fa2.dat, aes(x = FDG1, y = FDG2)) +",
          "title": ""
        },
        {
          "instruction": "geom_point(size = 0.05, aes(color = pseudotime)) +",
          "title": ""
        },
        {
          "instruction": "scale_color_viridis_c(name = 'Pseudotime', option = \"C\") +",
          "title": ""
        },
        {
          "instruction": "theme_classic() +",
          "title": ""
        },
        {
          "instruction": "xlab(\"FDG1\") + ylab(\"FDG2\")",
          "title": ""
        },
        {
          "instruction": "# Extract expression of selected genes along pseudotime",
          "title": ""
        },
        {
          "instruction": "# (example for erythroid genes GATA1 and KLF1)",
          "title": ""
        },
        {
          "instruction": "expr.Ery <- extract_expression_along_pseudotime(cds, genes = c(\"GATA1\",\"KLF1\"))",
          "title": ""
        },
        {
          "instruction": "plot_genes(data = expr.Ery, genes = \"GATA1\")",
          "title": ""
        },
        {
          "instruction": "plot_genes(data = expr.Ery, genes = \"KLF1\")",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
