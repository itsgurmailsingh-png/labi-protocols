{
  "protocol_id": "on_load_measurement_method_for_the_reliability_of_distribution_transformers",
  "parent_protocol_id": null,
  "version_count": 1,
  "title": "On-load measurement method for the reliability of distribution transformers",
  "author": "Adesina, Abdulkareem, et al.",
  "doi": "10.1016/j.mex.2020.101089",
  "source_name": "methodsx",
