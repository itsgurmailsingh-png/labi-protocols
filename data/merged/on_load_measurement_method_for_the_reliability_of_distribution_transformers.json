  "category": "Other",
  "estimated_time_mins": 150,
  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Pre‑inspect selected substation",
      "instruction": "Visit the chosen overloaded or troublesome distribution‑transformer substation and verify the source of supply, condition of high‑tension and low‑tension lines, overall neatness, proper connections of cables, lugs, bushings, earthing, feeder pillar, and confirm availability of the 33 kV or 11 kV feeder that feeds the transformer.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Confirm fault‑free energized network",
      "instruction": "Ensure the DT substation is on line, fault‑free, and receiving electricity supply.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Connect Fluke 435 to transformer",
      "instruction": "Attach one section of the Fluke 435 Power Quality and Energy Analyzer (PQEA) to the low‑voltage bushings at the secondary terminals of the on‑line DT.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Connect Fluke 435 to feeder",
      "instruction": "Attach the other section of the Fluke 435 to the incomer cable terminals at the feeder‑pillar side of the substation.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Calibrate measurement duration and interval",
      "instruction": "Calibrate the Fluke 435: set the experiment duration time (T) and the recording interval (t). For case study 1 (500 kVA) use T = 50 min for voltage, current and frequency measurements and T = 60 min for apparent power, reactive power and power‑factor measurements, with t = 10 min; for case study 2 (300 kVA) use T = 60 min (1 hour) with t = 10 min.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Ground transformer and analyzer",
      "instruction": "Provide a proper grounding connection for both the distribution transformer and the Fluke 435 (POAE) machine.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Set measurement parameters",
      "instruction": "On the Fluke 435, program the following parameters to be logged: RMS voltage (single‑phase and three‑phase), RMS current, frequency, apparent power, reactive power, active power, and power factor.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Take conventional clamp‑on readings",
      "instruction": "Using a Fluke 355 clamp‑on ammeter, manually measure voltage and current on each low‑voltage cable between the DT secondary bushings and the feeder pillar for later comparison with the PQEA data.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Power on the analyzer",
      "instruction": "Switch ON the Fluke 435 (PQEA) after all connections are verified.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Record data for set duration",
      "instruction": "Allow the Fluke 435 to remain ON for the calibrated duration time (T) while it automatically records the selected parameters at each interval (t).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Disconnect and transport equipment",
      "instruction": "When the duration T elapses, disconnect the PQEA equipment and transport it to the laboratory/office for further processing.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 11,
      "title": "Download and analyze results",
      "instruction": "Using a personal computer, download the recorded data from the PQEA at the 10‑minute interval, then create graphs of each parameter (voltage, current, frequency, powers, power factor) using Microsoft Excel.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
