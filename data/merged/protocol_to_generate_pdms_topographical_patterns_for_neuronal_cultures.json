  "materials": [
    "Rabbit anti-GFAP antibody",
    "Chicken anti-MAP2 antibody",
    "GCaMP6s Ca2+ sensor",
    "SYLGARD 184 Silicone Elastomer Base",
    "SYLGARD 184 Silicone Elastomer Curing Agent",
    "SU8 3050 resin",
    "Trichloro(1H,1H,2H,2H-perfluorooctyl)silane",
    "Nitric acid 65%",
    "Laminin",
    "Poly-D-lysine hydrobromide",
    "Fetal bovine serum",
    "MEM Eagle’s minimum essential medium",
    "Glutamax",
    "Gentamicin",
    "Inverted microscope equipped for fluorescence",
    "Timing: 3–4 h"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Place resin mold on petri dish",
      "instruction": "Place the 80 × 80 mm² resin master mold onto a sterile, plastic circular Petri dish (145 mm diameter).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare PDMS mixture",
      "instruction": "Mix PDMS elastomer base and curing agent at a 10:1 weight ratio (60 mg/cm² elastomer, 6 mg/cm² curing agent) using enough total mass to fully cover the mold.",
      "substeps": [
        {
          "instruction": "Pour the elastomer base with a disposable plastic pipette into a sterile disposable container (e.g., a 90 mm‑diameter × 20 mm‑height petri dish) and weigh it.",
          "title": ""
        },
        {
          "instruction": "Add the curing agent and thoroughly mix; use a slow pipetting motion or filter‑tip pipettor to avoid drawing the viscous elastomer into the pipette.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Degas PDMS mixture",
      "instruction": "Place the container with liquid PDMS on a pre‑cleaned vacuum chamber and apply 60 Torr vacuum for 15 minutes to remove bubbles.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Release vacuum and check bubbles",
      "instruction": "Slowly release the vacuum, inspect the mixture, and if surface bubbles remain, direct an air stream from a new Pasteur pipette onto them; if many bubbles persist, repeat the degassing step with higher vacuum pressure and/or longer time.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Pour PDMS over mold",
      "instruction": "Slowly pour the degassed PDMS over the resin mold on a flat surface to obtain an even layer; aim for a final PDMS thickness of about 0.5 mm (adjust poured mass accordingly).",
      "substeps": [
        {
          "instruction": "Optionally prepare a control cast by pouring PDMS directly onto a sterile plastic Petri dish for a flat surface.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Degas after pouring",
      "instruction": "Repeat the vacuum degassing (60 Torr, 15 min) and bubble‑removal steps to eliminate bubbles introduced during pouring.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Cure PDMS in oven",
      "instruction": "Place the Petri dish containing the resin mold and PDMS in an oven set to 70 °C and cure for 1 hour.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Cool and unmold PDMS",
      "instruction": "Allow the cured PDMS to cool to room temperature, then gently peel it off the resin mold to obtain the patterned PDMS cast.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Cut PDMS disc",
      "instruction": "Using a clean scalpel or a puncher of the desired diameter (e.g., 6 mm), cut out a PDMS disc; the patterned PDMS is now ready to be attached to a glass coverslip.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
