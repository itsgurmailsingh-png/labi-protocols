  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare methyl red stock solution",
      "instruction": "Weigh 0.1 g of methyl red dye (C15H15N3O2, M.wt 269.304 g·mol⁻¹, Sigma‑Aldrich, ≥99 %) and dissolve in a small volume of distilled water; transfer the solution to a 100 mL volumetric flask and dilute to the mark with distilled water to obtain a 1000 mg·L⁻¹ stock solution.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Make calibration standards",
      "instruction": "Using a micropipette, accurately pipette 0.5 mL, 0.75 mL, 1 mL, 1.25 mL, 1.5 mL, 1.75 mL, and 2 mL of the 1000 mg·L⁻¹ stock into separate 5 mL volumetric flasks and dilute each to the mark with distilled water to produce standard solutions of 100, 150, 200, 250, 300, 350, and 400 mg·L⁻¹, respectively.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Calibrate spectrophotometer (comparative)",
      "instruction": "Turn on the spectrophotometer, set the wavelength appropriate for methyl red (as per instrument manual), and calibrate the instrument using distilled water as the blank before measuring any standard solutions.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Measure standards with LED‑LDR device",
      "instruction": "Place each calibration standard in the sample cell (cuvette) so that the white LED light passes through the solution onto the light‑dependent resistor (LDR); record the resistance reading displayed on the multimeter in kilohms (kΩ) for each concentration.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Convert resistance to absorbance",
      "instruction": "Using the modified Beer–Lambert relation, calculate absorbance for each sample as Abs = log(R_sample / R_blank), where R_blank is the resistance measured with distilled water (blank) and R_sample is the resistance of the colored solution.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
