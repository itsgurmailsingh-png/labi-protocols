  "materials": [
    "Polyethylene glycol diacrylate",
    "Diphenyl(2,4,6-trimethylbenzoyl)phosphine oxide",
    "3-(trimethoxysilyl)propyl methacrylate",
    "DEACM-phosphoramidite",
    "E1-O-dimethoxytrityl-propyl-disulfide",
    "Polyethylene glycol thiol",
    "Triethylamine acetate",
    "Trifluoroacetic acid",
    "Saturated ammonium hydroxide",
    "Anhydrous acetonitrile",
    "Glen-Pak DNA purification column",
    "tris(2-carboxyethyl)phosphine hydrochloride",
    "Glacial acetic acid",
    "Ethanol",
    "Sodium chloride",
    "Timing: 1–2 days"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Add salt to DNA solution",
      "instruction": "Add 1 mL of 100 mg/mL sodium chloride solution to the deprotected oligonucleotides suspended in 1 mL of H₂O, yielding a final volume of 2 mL.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Condition purification cartridge",
      "instruction": "Condition a Glen‑Pak DNA purification cartridge by passing 0.5 mL acetonitrile followed by 1 mL of 2.0 M triethylamine acetate through the cartridge.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Load DNA onto cartridge",
      "instruction": "Connect a Luer‑Lok syringe to the top of the cartridge and inject the 2 mL oligonucleotide/salt mixture; repeat injections until the entire mixture has passed through.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Rinse cartridge with acetonitrile/salt",
      "instruction": "Rinse the cartridge with 2 mL of 5 % (v/v) acetonitrile prepared in 100 mg/mL sodium chloride solution.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Detritylate DNA",
      "instruction": "Pass 2 mL of 2 % (v/v) trifluoroacetic acid through the cartridge to remove the 5′ trityl protecting group.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Rinse with water",
      "instruction": "Rinse the cartridge with 2 mL deionized water.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Elute DNA",
      "instruction": "Inject 1 mL of 50 % (v/v) acetonitrile in deionized water containing 0.5 % (v/v) ammonium hydroxide; collect the eluate in a 15 mL Falcon tube. Repeat the injection to ensure complete recovery.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Freeze and lyophilize",
      "instruction": "Freeze the collected eluate, then place the frozen sample in a lyophilizer for 24–48 h.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Reconstitute and store DNA",
      "instruction": "Reconstitute the lyophilized DNA in 1 mL deionized water and store the solution at –80 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Determine concentration and adjust",
      "instruction": "Measure absorbance at 260 nm with a UV‑Vis spectrometer and calculate concentration using C(μM)=A260 × DF × 10⁶ / E. If the concentration is below 200 μM, lyophilize again and reconstitute with a smaller volume of water to reach 200 μM.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Reduce disulfide to thiol",
      "instruction": "Add 50 μL of 100 μM tris(2‑carboxyethyl)phosphine hydrochloride (TCEP) to 950 μL of DNA solution, shake for 5 min, then add 50 μL of 1X PBS to complete disulfide reduction.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
