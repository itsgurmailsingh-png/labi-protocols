  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Measure sieve weight and assemble apparatus",
      "instruction": "Weigh the steel sieve and record the value as W1. Assemble two filter adapters, the steel sieve, a 75 mm glass funnel, and a size‑7 rubber stopper onto a 1000 mL Buchner flask, then connect the flask to the diaphragm vacuum pump.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Weigh hydrogel powder and hydrate",
      "instruction": "Using an analytical balance, place approximately 0.02 g potassium polyacrylate or 0.01 g sodium polyacrylate powder on the balance and record as W0. Transfer the powder into a 50 mL conical‑bottom centrifuge tube containing 20 mL deionized water, close the tube, and shake by hand (or place on a rocker if the prescribed swelling time t exceeds 3 min) to ensure full contact with the liquid.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Vacuum‑filter swollen gel onto sieve",
      "instruction": "After the prescribed swelling time t, turn on the vacuum pump, pour the swollen sample from the centrifuge tube onto the steel sieve through filter adaptor size 3, allow the vacuum to remove excess water, then switch off the pump.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Weigh sieve with absorbed gel",
      "instruction": "Remove the steel sieve with the retained gel, place it on the analytical balance, and record its weight as W2.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Calculate swelling capacity",
      "instruction": "Compute the swelling capacity at time t using St = (W2 − W1 − W0) / W0.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
