  "materials": [
    "SU8-GM1075 photoresist",
    "SU8 developer",
    "Isopropanol",
    "Trichloro(1H,1H,2H,2H-perfluorooctyl-)-silane",
    "Sylgard 184 Silicone 1 kg Elastomer Kit",
    "DMEM/F-12, no glutamine",
    "Neurobasal (NB) medium",
    "Accutase",
    "Bovine serum albumin (BSA)",
    "N-2 supplement (100X)",
    "B-27 supplement (50X)",
    "GlutaMAX",
    "Penicillin-Streptomycin (P-S)",
    "2-Mercaptoethanol",
    "Nitrogen spray gun",
    "Timing: ∼1 week",
    "Timing: 1 day"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Coat dish with gelatin",
      "instruction": "Coat a culture dish (e.g., 60 mm Cellbind) with 0.1 % gelatin for at least 20 min; select a dish size that matches the intended cell number (500 k cells per tube).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Thaw and resuspend ESCs",
      "instruction": "Thaw a frozen stock of mouse embryonic stem cells and resuspend the cells in 10 mL warm N2B27 medium.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Centrifuge cell suspension",
      "instruction": "Centrifuge the resuspended cells at 218 × g for 4 min using a benchtop centrifuge.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Plate cells in maintenance medium",
      "instruction": "Resuspend the cell pellet in N2B27 + 2i + LIF medium and plate the cells onto the gelatin‑coated culture dish.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Incubate cells",
      "instruction": "Incubate the plated cells at 37 °C, 5 % CO₂; replace with fresh N2B27 + 2i + LIF medium daily.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Split colonies to avoid overgrowth",
      "instruction": "When compact colonies with clear boundaries appear (typically after 2–3 days), split the cells to prevent colonies from touching and merging, which would cause spontaneous differentiation.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Maintain cells before assay",
      "instruction": "Continue culturing the cells in N2B27 + 2i + LIF medium for at least 1 week before using them in the differentiation assay.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Fabricate silicon wafer mold",
      "instruction": "Prepare a silicon wafer coated with SU8 photoresist, expose it to UV light through a photomask to activate the desired pattern, bake the wafer to solidify the pattern, develop the wafer to dissolve unexposed SU8, and finally coat the wafer with a hydrophobic silane layer to prevent PDMS adhesion during stencil production.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
