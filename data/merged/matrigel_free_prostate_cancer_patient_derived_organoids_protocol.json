  "steps": [
    {
      "step_id": 0,
      "title": "Prepare digestion mix",
      "instruction": "Prepare fresh digestion mix (15 min). Optionally make batches of five non‑resuspended mixes in a 50 mL Falcon tube and store at 4 °C if enzymes are stable. Weigh and combine 19 U Dispase and 5 000 U Collagenase IV in a 50 mL Falcon tube, resuspend in 10 mL aDMEM, filter through a 0.22 µm filter, then add 10 µg DNase I and 10 µL of 1 mM Y‑27632.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Collect organoids for scRNA‑seq",
      "instruction": "Remove dead cells and harvest intact organoids (1–3 h). Inspect the organoid culture plate under brightfield microscopy to confirm organoid formation. Using a wide‑bore pipette tip (e.g., P1000), carefully transfer organoids to a new Falcon tube, avoiding single cells that remain at the well bottom. Re‑inspect the plate to ensure no organoids remain; repeat the transfer if substantial groups are left.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Dissociate organoids and prepare single‑cell suspension",
      "instruction": "Dissociate the collected organoids using the same enzymatic protocol applied during organoid passaging, then process the cells for single‑cell RNA sequencing.",
      "substeps": [
        {
          "instruction": "Centrifuge cells or organoids at 350 g for 5 min in spinning buckets.",
          "title": ""
        },
        {
          "instruction": "Apply the enzymatic digestion (as prepared in Step 1) to dissociate organoids.",
          "title": ""
        },
        {
          "instruction": "Transfer the resulting cell suspension into ice‑cold PBS containing 1 % BSA.",
          "title": ""
        },
        {
          "instruction": "Count the cells.",
          "title": ""
        },
        {
          "instruction": "Optional: If overall viability is 2,000 cells post‑processing).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
