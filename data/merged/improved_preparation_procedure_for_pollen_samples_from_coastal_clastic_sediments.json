  "steps": [
    {
      "step_id": 0,
      "title": "Collect and transfer sediment samples",
      "instruction": "Extract sediment from the core at designated intervals and transfer to test tubes.",
      "substeps": [
        {
          "instruction": "Scrape the surface clean or take material from inside the core to minimize contamination.",
          "title": ""
        },
        {
          "instruction": "Pack sediment into a 1 ml measuring spoon.",
          "title": ""
        },
        {
          "instruction": "Transfer the sediment to a numbered Nalgene test tube.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Eliminate carbonates and add marker",
      "instruction": "Treat the sediment with HCl and an exotic marker to dissolve carbonates.",
      "substeps": [
        {
          "instruction": "Add 5 ml of 10% HCl to each test tube and stir thoroughly.",
          "title": ""
        },
        {
          "instruction": "Add 1 Lycopodium tablet (exotic marker) to each test tube.",
          "title": ""
        },
        {
          "instruction": "Allow the tablets to dissolve.",
          "title": ""
        },
        {
          "instruction": "Add another 5 ml of HCl to fill the test tube.",
          "title": ""
        },
        {
          "instruction": "Soak the sediments in HCl overnight.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Centrifuge and decant samples",
      "instruction": "Process the samples the following day to remove the acid solution.",
      "substeps": [
        {
          "instruction": "Centrifuge the samples.",
          "title": ""
        },
        {
          "instruction": "Decant the supernatant.",
          "title": ""
        },
        {
          "instruction": "Record the process in the laboratory notebook.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
