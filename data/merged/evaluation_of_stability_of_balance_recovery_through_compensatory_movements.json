      "timers": []
    },
    {
      "step_id": 1,
      "title": "Show video and give instructions",
      "instruction": "Have participants watch a video of a person responding to balance perturbations, then explain that the task is to recover balance after support‑base displacements while maintaining the initial posture; arm and leg movements may be used, and safety ropes should only be grasped if balance cannot be recovered (considered a near fall).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Set initial posture on platform",
      "instruction": "Place the participant on the platform in Romberg stance: feet oriented forward and touching each other, arms relaxed hanging beside the trunk, palms lightly touching the upper legs, with a reduced mediolateral support base; have the participant gaze at a frontal spot positioned at eye height.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Program perturbation timing",
      "instruction": "Trigger each perturbation randomly between 2 s and 5 s after a verbal prompt to prevent temporal anticipation.",
