  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Create Human‑Exoskeleton Model",
      "instruction": "Edit the base human model in OpenSim to incorporate the exoskeleton geometry and joint definitions, producing a combined human‑exoskeleton model.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Integrate OpenSim with MATLAB",
      "instruction": "Set up a MATLAB‑OpenSim interface (e.g., using the OpenSim API) so that MATLAB can call OpenSim functions and exchange data, enabling simulation of the exoskeleton’s effect on the human model.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Acquire Motion‑Capture Data",
      "instruction": "Record the subject’s movement using a motion‑capture system to generate experimental kinematic data for that individual.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Compute Muscle Controls with CMC",
      "instruction": "Import the motion‑capture data into OpenSim and run the Computed Muscle Control (CMC) tool to calculate muscle activation and control values for the subject.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Run Closed‑Loop Human‑Exoskeleton Simulation",
      "instruction": "Use the muscle control results from the previous step as inputs to a closed‑loop simulation in OpenSim (via MATLAB) that includes the exoskeleton model; implement the desired controller within the simulation to generate actuator control parameters.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Extract Simulation Parameters",
      "instruction": "Following sections 5.1 and 5.2 of Khamar and Edrisi [9], use the MATLAB‑OpenSim interface to retrieve the required kinetic and kinematic parameters from the simulation output.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Validate Model with Experimental Test",
      "instruction": "Build the knee exoskeleton model, run the simulation with the controller parameters, then perform an experimental test on the subject; compare the simulated outcomes with the experimental measurements to confirm model accuracy.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
