  "steps": [
    {
      "step_id": 0,
      "title": "Prepare fresh colchicine solution",
      "instruction": "On day 1 of the experiment, make a fresh colchicine solution that will be used for the overnight incubation of planarians.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare karyotyping reagents",
      "instruction": "Before starting day 2, prepare all reagents required for karyotyping (e.g., fixatives, stains) fresh.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Soak planarians in colchicine",
      "instruction": "Incubate selected planarians in colchicine solution to freeze mitotic neoblasts.",
      "substeps": [
        {
          "instruction": "Select control and/or experimental planarians of similar size that are no greater than 1 cm in length and place them into a 6 cm petri dish.",
          "title": ""
        },
        {
          "instruction": "Remove the 1× Montjuic saltwater from the dish and replace it with 4–5 mL of colchicine solution.",
          "title": ""
        },
        {
          "instruction": "Allow the planarians to incubate for 12–16 h in the dark, ensuring the incubation period does not exceed 16 h to avoid colchicine‑induced toxicity.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
