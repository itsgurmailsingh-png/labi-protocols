  "steps": [
    {
      "step_id": 0,
      "title": "Fix cells with PFA",
      "instruction": "Fix 1mL of cells by adding PFA drop by drop with careful mixing to reach a final concentration of 2% PFA.",
      "substeps": [
        {
          "instruction": "Incubate cells for 4 minutes at room temperature.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Wash and resuspend cells",
      "instruction": "Remove PFA and prepare cells for staining.",
      "substeps": [
        {
          "instruction": "Centrifuge at 1000g for 5 minutes.",
          "title": ""
        },
        {
          "instruction": "Wash cells twice with 1XPBS.",
          "title": ""
        },
        {
          "instruction": "Resuspend cells in 1mL 1xPBS.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Stain with MitoTracker",
      "instruction": "Apply MitoTracker dye to the cells at room temperature while protecting from light.",
      "substeps": [
        {
          "instruction": "Add 1mM mitotracker dye.",
          "title": ""
        },
        {
          "instruction": "Incubate for 10 minutes.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Stain with DAPI",
      "instruction": "Apply DAPI dye to the cells at room temperature while protecting from light.",
      "substeps": [
        {
          "instruction": "Add 1/1000 DAPI dye.",
          "title": ""
        },
        {
          "instruction": "Incubate for 5 minutes.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Final wash and resuspension",
      "instruction": "Remove excess dyes from the cells.",
      "substeps": [
        {
          "instruction": "Wash twice with 1xPBS.",
          "title": ""
        },
        {
          "instruction": "Centrifuge at 1000g for 5 minutes.",
          "title": ""
        },
        {
          "instruction": "Resuspend with 1xPBS.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Mount slide",
      "instruction": "Mount the slide for observation.",
