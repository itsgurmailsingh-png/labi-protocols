  "steps": [
    {
      "step_id": 0,
      "title": "Coat plates with Poly-L-Ornithine",
      "instruction": "Coat 3 wells of a 6-well plate with 1 mL Poly-L-Ornithine (PLO).",
      "substeps": [
        {
          "instruction": "Incubate for 02:00:00 or overnight in a humidified incubator.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Rinse wells",
      "instruction": "Aspirate the PLO and rinse the wells 3 times with DMEM/F12.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Apply laminin coating",
      "instruction": "Dilute laminin to a final concentration of 10 μg/mL in cold DMEM/F12 and add 1 mL of the solution to each PLO-coated well.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Incubate laminin",
      "instruction": "Incubate the plates for 02:00:00 or overnight in a humidified incubator.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
