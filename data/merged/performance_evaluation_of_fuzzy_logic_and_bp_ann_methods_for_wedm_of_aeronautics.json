  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare WEDM machine and materials",
      "instruction": "Set up the Electronica sprint‑cut (Electra‑Elplus 40A DLX) CNC wire EDM machine. Install a 0.25 mm diameter plane brass wire as the electrode. Fill the work chamber with deionized water as the dielectric and keep the water temperature constant at 25 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Define machining parameter levels",
      "instruction": "Assign the three levels for each of the six input variables as follows: Pulse‑on time (Ton): 0.4 µs, 0.8 µs, 1.2 µs; Pulse‑off time (Toff): 0.9 µs, 1.3 µs, 2.2 µs; Peak current (IP): 130 A, 160 A, 190 A; Spark‑gap reference voltage (SV): 365 V, 880 V; Wire tension (WT): 1020 g, 1260 g, 1500 g; Wire feed (WF): 6 m/min, 8 m/min, 10 m/min. Also consider the three one‑way interactions Ton × Toff, Ton × IP and Toff × IP.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Create experimental layout with Taguchi L27",
      "instruction": "Use the Taguchi method to generate an L27 orthogonal array that incorporates the three levels of the six variables and the three specified interactions, resulting in 27 distinct experimental runs.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Run each experiment and replicate",
      "instruction": "For each of the 27 runs, program the WEDM machine with the corresponding Ton, Toff, IP, SV, WT and WF settings. Perform the cutting of Udimet‑L605 alloy, then repeat the same run two additional times to obtain three replicates, giving a total of 81 experiments.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Measure surface roughness and waviness",
      "instruction": "Using a surfcom roughness and waviness tester, measure the surface roughness (SR) and waviness (Wa) of each machined piece. Take measurements on three sides of the workpiece, with three readings per side (nine readings total). Calculate the average of the nine readings to obtain the final SR and Wa values for that piece.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
