  },
  "quality_score": 6.0,
  "category": "Cell Biology",
  "estimated_time_mins": 30,
  "materials": [
    "Rabbit polyclonal anti-STAG1",
    "Mouse monoclonal anti-STAG2",
    "Mouse monoclonal anti-Rad21",
    "Rabbit polyclonal anti-MCM3",
    "Cy3-Donkey anti-Rabbit",
    "Alexa Fluor 488-Donkey anti-Mouse",
    "Pacific Blue",
    "TO-PRO-3 Iodide",
    "DharmaFECT 1 Transfection Reagent",
    "Opti-MEM I Reduced Serum Medium",
    "Igepal CA-630",
    "PMSF",
    "Formaldehyde solution",
    "Na2HPO4",
    "KCl",
    "mock transfected. Condition",
    "STAG1 KD. Condition",
    "STAG2 KD. Condition",
    "Timing: 1.5 h"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Thaw and plate cells",
      "instruction": "Thaw frozen cells and plate them according to standard culture conditions before any treatment.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Perform siRNA transfection",
      "instruction": "Transfect cells with siRNA using the DharmaFECT protocol to achieve knock‑down of the proteins of interest (mock, STAG1 KD, STAG2 KD, or NIPBL KD).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Extract soluble nuclear components",
      "instruction": "Add 1 mL extraction buffer to each pellet of 2 × 10⁶ cells, pipet up and down without bubbles, incubate 5 min on ice.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Fix nuclei with formaldehyde",
      "instruction": "Add 27 µL of 37 % formaldehyde (to obtain 1 % final concentration) to the suspension and incubate 1 h on ice.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Quench fixation and collect nuclei",
      "instruction": "Fill the tube with PBS‑1 % FBS to stop the reaction, centrifuge 5 min at 0.2 RCF, 4 °C, pour off supernatant, and resuspend the nuclei in the remaining PBS‑1 % FBS.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Transfer and wash nuclei",
      "instruction": "Transfer the nuclei to a 1.5 mL Eppendorf tube, centrifuge 5 min at 0.8 RCF, 25 °C, and remove all supernatant with a micropipettor.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Incubate with staining buffer",
      "instruction": "Add staining buffer to the nuclei: 50 µL for control samples or 125 µL for barcoded samples, and incubate 5 min at 25 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Add primary antibody",
      "instruction": "Add an equal volume of primary‑antibody solution (same volume as staining buffer) at the required concentration (accounting for 1:2 dilution) and incubate 1 h at 25 °C in the dark (final volume 100 µL for controls, 250 µL for barcoded samples).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Wash after primary antibody",
      "instruction": "Fill the tube with PBS‑1 % FBS, centrifuge 5 min at 0.8 RCF, 25 °C, and remove the supernatant with a micropipettor.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Add secondary antibody",
      "instruction": "Add secondary‑antibody solution (100 µL for controls, 250 µL for barcoded samples) and incubate 30 min at 25 °C in the dark.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Wash after secondary antibody",
      "instruction": "Fill the tube with PBS‑1 % FBS, centrifuge 5 min at 0.8 RCF, 25 °C, and remove the supernatant with a micropipettor.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 11,
      "title": "Final resuspension and staining",
      "instruction": "Resuspend each pellet in 0.5 mL PBS (FBS‑free) containing 1 µM ToPro3 and 1 µg/mL RNase A; incubate 30 min at 25 °C in the dark or store overnight at 4 °C before analysis.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
