  "protocol_id": "analysis_of_chromatin_bound_proteins_using_chromoflow_flow_cytometry",
  "parent_protocol_id": null,
  "version_count": 1,
  "title": "Analysis of Chromatin-Bound Proteins Using Chromoflow Flow Cytometry",
  "author": "Alonso-Gil, Losada",
  "doi": "10.1016/j.xpro.2023.102568",
  "source_name": "star_protocols",
