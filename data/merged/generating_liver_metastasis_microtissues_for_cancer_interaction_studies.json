{
  "protocol_id": "generating_liver_metastasis_microtissues_for_cancer_interaction_studies",
  "parent_protocol_id": null,
  "version_count": 1,
  "title": "Generating Liver Metastasis Microtissues for Cancer Interaction Studies",
  "author": "Lamprou, Krotenberg Garcia, et al.",
  "doi": "10.1016/j.xpro.2024.103575",
  "source_name": "star_protocols",
  "source_url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC11787675/",
