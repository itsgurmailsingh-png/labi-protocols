  "quality_score": 4.5,
  "category": "Cell Biology",
  "estimated_time_mins": 42,
  "materials": [
    "Reduced Growth Factor Basement Membrane Extract Type 2 (BME2)",
    "12-well untreated polystyrene plates",
    "round U-bottom plates",
    "glass Pasteur pipets",
    "centrifuges",
    "antibodies",
    "Collagenase A",
    "Dispase II",
    "DNase I",
    "TrypLE express enzyme",
    "DPBS",
    "Advanced DMEM/F12",
    "HEPES",
    "GlutaMAX",
    "Penicillin/streptomycin",
    "Bovine serum albumin (BSA)",
    "Timing: 3–4 days"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare reagents and equipment",
      "instruction": "Thaw Reduced Growth Factor Basement Membrane Extract Type 2 (BME2) on ice or at 4 °C for 8–16 h; ensure availability of 12‑well untreated polystyrene plates for organoid culture and round U‑bottom plates for microtissue formation; prepare all buffers and media as described in the Materials and Equipment section; fire‑polish glass Pasteur pipet tips with a Bunsen burner (one pipet per culture, with spares); pre‑cool centrifuges to 4 °C. Alternatives such as Matrigel or Collagen may be used, but may require extra washes.",
      "substeps": [
        {
          "instruction": "Thaw BME2 on ice/4 °C (8–16 h).",
          "title": ""
        },
        {
          "instruction": "Gather 12‑well untreated plates and round U‑bottom plates.",
          "title": ""
        },
        {
          "instruction": "Prepare buffers/media per protocol.",
          "title": ""
        },
        {
          "instruction": "Fire‑polish glass Pasteur pipet tips.",
          "title": ""
        },
        {
          "instruction": "Pre‑cool centrifuges to 4 °C.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Fix microtissues",
      "instruction": "In each well of a 96‑well U‑bottom plate, carefully remove 50 µL of medium, add 50 µL fixation solution without touching the microtissue, incubate 30–35 min at 18–25 °C protected from light, verify integrity, discard broken microtissues, then remove fixation solution and wash twice with 100 µL PBS0.",
      "substeps": [
        {
          "instruction": "Remove 50 µL medium.",
          "title": ""
        },
        {
          "instruction": "Add 50 µL fixation solution.",
          "title": ""
        },
        {
          "instruction": "Incubate 30–35 min at 18–25 °C, protected from light.",
          "title": ""
        },
        {
          "instruction": "Check microtissue integrity; discard damaged ones.",
          "title": ""
        },
        {
          "instruction": "Aspirate fixation solution.",
          "title": ""
        },
        {
          "instruction": "Wash twice with 100 µL PBS0.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Block and permeabilize",
      "instruction": "After fixation, microtissues may be stored in PBS0 for 2–3 weeks at 4 °C protected from light; then aspirate PBS0, add 75 µL blocking solution, and incubate 8–16 h at 4 °C protected from light.",
      "substeps": [
        {
          "instruction": "Optional storage: PBS0, 2–3 weeks, 4 °C, dark.",
          "title": ""
        },
        {
          "instruction": "Aspirate PBS0.",
          "title": ""
        },
        {
          "instruction": "Add 75 µL blocking solution.",
          "title": ""
        },
        {
          "instruction": "Incubate 8–16 h at 4 °C, dark.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Primary antibody incubation",
      "instruction": "Remove blocking solution, add 75 µL primary antibodies diluted in blocking solution, protect from light and incubate 12–16 h at 4 °C.",
      "substeps": [
        {
          "instruction": "Aspirate blocking solution.",
          "title": ""
        },
        {
          "instruction": "Add 75 µL primary antibody mix.",
          "title": ""
        },
        {
          "instruction": "Incubate 12–16 h at 4 °C, dark.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Wash after primary antibody",
      "instruction": "Wash three times with 150 µL washing solution at 18–25 °C, each wash lasting at least 5 min (can be extended).",
      "substeps": [
        {
          "instruction": "Wash 1: 150 µL washing solution, 5 min, 18–25 °C.",
          "title": ""
        },
        {
          "instruction": "Wash 2: repeat.",
          "title": ""
        },
        {
          "instruction": "Wash 3: repeat.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Secondary antibody incubation",
      "instruction": "Add 75 µL secondary antibodies (optionally with DAPI or Phalloidin) diluted in blocking solution, protect from light and incubate 12–16 h at 4 °C. This step can be extended 2–3 days if needed.",
      "substeps": [
        {
          "instruction": "Add 75 µL secondary antibody mix.",
          "title": ""
        },
        {
          "instruction": "Incubate 12–16 h at 4 °C, dark (extendable up to 3 days).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Final washes and PBS",
      "instruction": "Wash twice with 150 µL washing buffer at 18–25 °C for 5 min each, then add 150 µL PBS0. Perform all liquid exchanges gently to avoid aspirating the microtissues.",
      "substeps": [
        {
          "instruction": "Wash 1: 150 µL washing buffer, 5 min, 18–25 °C.",
          "title": ""
        },
        {
          "instruction": "Wash 2: repeat.",
          "title": ""
        },
        {
          "instruction": "Add 150 µL PBS0.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Mount microtissues on slides",
      "instruction": "Label a 25 × 65 mm microscope slide and clean with Kimwipes; apply 3–4 pairs of 0.05 mm double‑sided iSpacers vertically on the dry slide, peeling protective liners as illustrated; ensure full adhesion. Aspirate PBS0 from each well, add 15 µL RapiClear clearing solution, immediately transfer the microtissue (suspended in RapiClear) with a pre‑cut P200 tip into the iSpacer confinement, add an extra drop of RapiClear on top, repeat for all microtissues. Place a 24 × 50 mm No. 1.5 coverslip over the iSpacers, press edges, remove excess solution with Kimwipes, seal edges with clear nail polish, and circle the microtissue position on the slide.",
      "substeps": [
        {
          "instruction": "Label and clean slide.",
          "title": ""
        },
        {
          "instruction": "Apply 3–4 pairs of iSpacers vertically, peel first liner.",
          "title": ""
        },
        {
          "instruction": "Confirm iSpacers adhere fully.",
          "title": ""
        },
        {
          "instruction": "Aspirate PBS0 from well.",
          "title": ""
        },
        {
          "instruction": "Add 15 µL RapiClear to well.",
          "title": ""
        },
        {
          "instruction": "Transfer microtissue with pre‑cut P200 tip into iSpacer.",
          "title": ""
        },
        {
          "instruction": "Add extra RapiClear drop on top.",
          "title": ""
        },
        {
          "instruction": "Repeat for all wells.",
          "title": ""
        },
        {
          "instruction": "Place 24 × 50 mm No. 1.5 coverslip.",
          "title": ""
        },
        {
          "instruction": "Press edges gently.",
          "title": ""
        },
        {
          "instruction": "Remove excess solution.",
          "title": ""
        },
        {
          "instruction": "Seal with clear nail polish.",
          "title": ""
        },
        {
          "instruction": "Circle microtissue position on slide.",
          "title": ""
        }
      ],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Image microtissues",
      "instruction": "Store mounted slides in a light‑protective case at 4 °C for 2–3 days, then image using a confocal microscope with a high NA 20×–25× dry objective. Acquire Z‑stacks covering the full microtissue thickness (100–300 µm) with a slice thickness of ~5 µm. Because the microtissue exceeds a single field of view, use tiling (e.g., 6 × 6) and stitch the tiles to obtain a complete 3‑D reconstruction or Z‑projection.",
      "substeps": [
        {
          "instruction": "Store slides 2–3 days at 4 °C, dark.",
          "title": ""
        },
        {
          "instruction": "Set up confocal with 20×–25× dry objective.",
          "title": ""
        },
        {
          "instruction": "Acquire Z‑stack 100–300 µm depth, 5 µm steps.",
          "title": ""
        },
        {
          "instruction": "Use tiling (6 × 6) to capture whole microtissue.",
          "title": ""
        },
        {
          "instruction": "Stitch tiles and generate 3‑D reconstruction or Z‑projection.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
