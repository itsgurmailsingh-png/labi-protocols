  "steps": [
    {
      "step_id": 0,
      "title": "Organize gene body coverage files",
      "instruction": "Place the output files generated by geneBodyCoverage.pl into a directory (default name ‘coverage’) that will be used as the input directory for SkewC.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Define project and output parameters",
      "instruction": "Choose a project name (default = ‘COV’; this name will appear on PDF outputs) and decide on an output directory for SkewC results (default = ‘skewc’).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Run SkewC gene‑body coverage analysis",
      "instruction": "From the SkewC installation directory, execute the bash script 2_SkewC.sh with the required arguments: project name, input directory, output directory, and alpha value(s). The command template is:\n\n~/SkewC$ bash 2_SkewC.sh $prjname $indir $outdir $alpha\n\nwhere:\n- $prjname = project name (default ‘COV’)\n- $indir = directory containing geneBodyCoverage.pl files (default ‘coverage’)\n- $outdir = directory for SkewC analysis files with index HTML (default ‘skewc’)\n- $alpha = alpha for tclust computation (see below).\n\nTiming: approximately 1–2 minutes for this step.",
      "substeps": [
        {
          "instruction": "Auto‑alpha mode (alpha not defined): the script selects the alpha value with the highest ctlcurves score.\nExample: bash 2_SkewC.sh test input output",
          "title": ""
        },
        {
          "instruction": "User‑specified single alpha (e.g., 0.1): the script runs tclust with the given alpha.\nExample: bash 2_SkewC.sh test input output 0.1",
          "title": ""
        },
        {
          "instruction": "User‑specified multiple alphas (e.g., 0.1 0.2 0.3 0.4): the script runs tclust for each listed alpha.\nExample: bash 2_SkewC.sh test input output 0.1 0.2 0.3 0.4",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
