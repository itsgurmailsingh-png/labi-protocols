  "materials": [
    "Dulbecco’s phosphate-buffered saline",
    "Agarose",
    "Dulbecco’s modified Eagle’s medium/nutrient mix F-12",
    "Fetal bovine serum",
    "Penicillin streptomycin (10,000 U/mL)",
    "Trypsin",
    "CASY Model TT Cell Counter and Analyzer",
    "MAGNETOM Prisma Fit",
    "Software Application “MapIt”",
    "Image J Version 1.51",
    "GraphPad Prism version 10.1.1",
    "Thermo Nunclon Sphera plates",
    "CELLSTAR cell reactor tube",
    "EASYstrainer 100 μM for 50 mL tubes",
    "Plastic box (1 L, 12 × 6 × 10 cm)",
    "Timing: 3–5 days",
    "Timing: 1 day"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Thaw cryopreserved cells",
      "instruction": "Warm cell culture thawing media (10 mL per cryo vial + 8–15 mL for a T75 flask) in a 37 °C water bath, add 10 mL warm media to a 50 mL conical tube, retrieve the cryovial, place it in the water bath, and once almost fully defrosted transfer its contents into the tube.",
      "substeps": [
        {
          "instruction": "Centrifuge the tube for 3 min at 300 × g.",
          "title": ""
        },
        {
          "instruction": "Discard supernatant and resuspend the pellet in 8–15 mL thawing medium.",
          "title": ""
        },
        {
          "instruction": "Transfer the suspension to a T75 flask.",
          "title": ""
        },
        {
          "instruction": "Incubate at 37 °C, 5 % CO₂, normoxia.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Passage cells to expand culture",
      "instruction": "When cultures reach 80–90 % confluency, detach cells with trypsin and re‑seed into a T175 flask.",
      "substeps": [
        {
          "instruction": "Pre‑heat cell culture media, PBS (Ca/Mg‑free), and trypsin to 37 °C.",
          "title": ""
        },
        {
          "instruction": "Remove old media and wash cells with 10 mL PBS (T175).",
          "title": ""
        },
        {
          "instruction": "Add 7 mL trypsin, incubate 5 min at 37 °C, and check detachment microscopically.",
          "title": ""
        },
        {
          "instruction": "Add 7 mL culture media to neutralize trypsin, transfer suspension to a 50 mL conical tube.",
          "title": ""
        },
        {
          "instruction": "Centrifuge 3 min at 300 × g, discard supernatant, and resuspend pellet in 3 mL culture media.",
          "title": ""
        },
        {
          "instruction": "Prepare a T175 flask with 30–50 mL culture media and add 1 mL of the cell suspension.",
          "title": ""
        },
        {
          "instruction": "Incubate at 37 °C, 5 % CO₂, normoxia.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Prepare 1 % agarose gel",
      "instruction": "Make a sterile 1 % agarose solution and autoclave it.",
      "substeps": [
        {
          "instruction": "Dissolve 5 g agarose in 500 mL sterile PBS in an autoclavable 500 mL screw‑top glass bottle.",
          "title": ""
        },
        {
          "instruction": "Autoclave according to the liquid protocol of the available autoclave.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Cast agarose in imaging tube",
      "instruction": "Create a gel‑filled 50 mL conical tube with a central indentation for spheroids.",
      "substeps": [
        {
          "instruction": "Transfer 20 mL liquid agarose into a 50 mL conical tube, avoiding air bubbles.",
          "title": ""
        },
        {
          "instruction": "Insert a 14 mL round‑bottom culture tube to form an ≈2 cm deep indent; fix it with a sterile strainer or parafilm.",
          "title": ""
        },
        {
          "instruction": "Allow the agarose to solidify (if already solid, reheat gently in a microwave, loosely capping the bottle).",
          "title": ""
        },
        {
          "instruction": "Carefully remove the small tube, leaving the indentation.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Load spheroids and add medium",
      "instruction": "Place spheroids into the agarose indentation and fill the tube with pre‑warmed culture medium.",
      "substeps": [
        {
          "instruction": "Transfer 192 single spheroids into the indentation, handling the hot agarose carefully.",
          "title": ""
        },
        {
          "instruction": "Fill the conical tube completely with pre‑warmed cell culture medium (≈35 mL) to fully immerse the sample and avoid air bubbles.",
          "title": ""
        },
        {
          "instruction": "Seal with the standard lid for imaging (or a ventilated lid for prolonged cultivation).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
