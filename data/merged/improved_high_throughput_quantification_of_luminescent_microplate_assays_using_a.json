  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare equipment and buffer",
      "instruction": "Pre‑cool a mortar and pestle with liquid nitrogen. Prepare the homogenization buffer (pH 7.4) containing 20 mM HEPES, 200 mM NaCl, 0.1 mM EDTA, 10 mM NaF, 1 mM Na₃VO₄, 10 mM β‑glycerophosphate, 1 µL/mL protease inhibitor (BioShop Canada Inc., Catalogue #PIC002), and a few crystals of PMSF.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Homogenize muscle tissue",
      "instruction": "Weigh skeletal muscle samples, crush them in the pre‑cooled mortar, and homogenize at a 1:2 w/v ratio in the pre‑chilled homogenization buffer.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Centrifuge homogenate",
      "instruction": "Centrifuge the homogenates at 4 °C, 10,000 × g for 15 minutes.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Collect supernatant and assay protein",
      "instruction": "Collect the supernatant and determine protein concentration using the BioRad protein assay (BioRad Laboratories, Catalogue #5000002).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Normalize protein concentration",
      "instruction": "Adjust each sample to a final concentration of 5 µg/µL using the same homogenization buffer.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Store samples",
      "instruction": "Aliquot and store the adjusted samples at –80 °C until use.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
