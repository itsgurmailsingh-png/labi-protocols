  "steps": [
    {
      "step_id": 0,
      "title": "Prepare urea bath",
      "instruction": "Fill a 30‑L plastic container placed next to the seawater tank with 10 L of urea water (the same solution used in the study).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Transfer hagfish to bath",
      "instruction": "Move each infected hagfish from the seawater tank into the prepared urea‑water container.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Bathe for five minutes",
      "instruction": "Keep the hagfish in the urea‑water bath for exactly 5 min.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Return fish to seawater",
      "instruction": "After the 5‑min exposure, return the hagfish to their original seawater tanks (maintained at 8 °C).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
