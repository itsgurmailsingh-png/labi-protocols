  "steps": [
    {
      "step_id": 0,
      "title": "Prepare 10 mM GR24 5DO stock",
      "instruction": "Dissolve GR24 5DO powder in an organic solvent (choose DMSO, methanol, or anhydrous acetone) to obtain a 10 mM stock solution (MW = 298.29 g·mol⁻¹). Aliquot the stock into small volumes and store at –20 °C; the aliquots remain stable for several years.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Make 1 µM working solution",
      "instruction": "Transfer 1 µL of the 10 mM GR24 5DO stock into a fresh tube containing 10 mL of deionized H₂O, yielding a 1 µM working solution.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Sterile‑filter and use fresh",
      "instruction": "Sterile‑filter the 1 µM working solution. Prepare the working solution immediately before the experiment and use it promptly, because GR24 5DO degrades (~20 % loss after 8 h at 4 °C) in aqueous solution.",
      "substeps": [],
      "is_critical": true,
      "timers": []
    }
  ],
