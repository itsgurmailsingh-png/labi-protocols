  "steps": [
    {
      "step_id": 0,
      "title": "Acquire data (≈1 h)",
      "instruction": "Run the flow cytometer using the configured settings and gating strategy for approximately one hour.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Configure instrument settings",
      "instruction": "Set the MA900 sorter to use 100 µm sorting chips, turn on lasers at 405 nm, 488 nm, 561 nm, and 638 nm, set FSC threshold to 5 %, sensor gain FSC to 3, BSC gain to 33.5 %, and configure fluorescence channels as follows: FL1 (525/50 nm) for BDP‑DBCO with 33 % gain, FL2 (585/30 nm) for Cy3‑DBCO with 36 % gain, FL10 (665/30 nm) for AF647‑DBCO with 40.5 % gain, FL12 (785/60 nm) for FVD780 with 37 % gain.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Set FSC vs BSC scatter plot",
      "instruction": "Create a FSC‑A vs BSC‑A density plot, define Gate A for live K562 cells with FSC‑A values 20–70 ×10⁴ and BSC‑A values 10–40 ×10⁴; exclude events with FSC‑A > 70 ×10⁴ and BSC‑A > 40 ×10⁴ as non‑singlets.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Set FSC‑H vs FSC‑W plot",
      "instruction": "Create a FSC‑H vs FSC‑W density plot, define Gate B to exclude doublets by selecting the region containing 90–100 % of events.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Select live cells (optional)",
      "instruction": "Optionally gate on FVD780‑negative cells to isolate viable cells.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Create fluorescence histograms",
      "instruction": "For each organelle‑selective label, set up a histogram of fluorescence intensity versus events: (a) FL1 (525/50 nm) for BDP‑DBCO (green channel), (b) FL10 (665/30 nm) for AF647‑DBCO (far‑red channel), (c) FL2 (585/30 nm) for Cy3‑DBCO (orange channel).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
