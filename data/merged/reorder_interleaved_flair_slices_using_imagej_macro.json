    {
      "step_id": 3,
      "title": "Verify Slice Count",
      "instruction": "Ensure the selected dataset contains exactly 24 slices; the macro will exit with an error if nSlices is not 24.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Split Stack into Batches",
      "instruction": "The macro automatically splits the original stack into three substacks based on slice ranges.",
      "substeps": [
        {
          "instruction": "Create 'Batch1' from slices 1-8",
          "title": ""
        },
        {
          "instruction": "Create 'Batch2' from slices 9-16",
          "title": ""
        },
        {
          "instruction": "Create 'Batch3' from slices 17-24",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Interleave Slices",
      "instruction": "The macro creates a new 24-slice 32-bit black image titled 'Reordered' and interleaves the slices from the three batches.",
      "substeps": [
        {
          "instruction": "Iterate through slices 1 to 8",
          "title": ""
        },
        {
          "instruction": "For each slice, copy and paste from Batch1, Batch2, and Batch3 sequentially into the 'Reordered' stack at position (slice - 1) * 3 + batch",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Adjust Contrast",
      "instruction": "The macro adjusts the contrast of the 'Reordered' stack.",
      "substeps": [
        {
          "instruction": "Select the middle slice (floor(nSlices/2) + 1)",
          "title": ""
        },
        {
          "instruction": "Run 'Enhance Contrast' with saturated=0.35",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
