  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Apply lesion masks for blinding",
      "instruction": "Overlay lesion masks onto the parcellation images and also onto lesion‑free images to remove any parcellations that fall within lesioned areas, ensuring raters are blind to image type during error identification.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Perform EAGLE‑I visual QC",
      "instruction": "Using the EAGLE‑I method, load each parcellation image, inspect every brain region in turn, decide whether an error is present, classify the error with the predefined codes, and record the classification in the provided EAGLE‑I error‑tracker spreadsheet.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Statistical validation of QC",
      "instruction": "In R version 4.2.2 (2022‑10‑31) within RStudio 2022.12.0+353, (a) run an ordered logistic regression to test whether image type (lesion‑free, lesion‑filled, or lesioned) influences image‑level quality ratings; (b) compute Cronbach’s alpha for each region to assess inter‑rater consistency of region‑level error identification; (c) calculate intraclass correlation coefficients (ICCs) for image‑level quality ratings; consider results significant at p ≤ .05.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
