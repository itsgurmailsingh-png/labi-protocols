  "materials": [
    "epoxy resin bisphenol A-epichlorohydrin",
    "epoxy hardener cycloaliphatic amine",
    "release agent Miracle Gloss mold release wax",
    "woven roving glass fiber",
    "peel-ply",
    "flow media",
    "plastic vacuum bagging",
    "clear hose",
    "spiral warp/tube",
    "T-Connector",
    "sealant tape",
    "vacuum pump",
    "universal testing machine",
    "microscope Dino-Lite Edge",
    "planetary centrifugal mixer",
    "Timing: 10 min",
    "Figure 2Resin inlet and outlet preparation",
    "Timing: 15–30 min",
    "Timing: 30–45 min"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Allocate overall preparation time",
      "instruction": "Set aside approximately 10 min for material preparation, 15–30 min for mold cleaning and lay‑up, and 30–45 min for vacuum‑bag installation and leak testing.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare glass fiber pieces",
      "instruction": "Wear gloves, coat and goggles; keep glass fiber in a closed container at room temperature. Measure the fabric to 25 × 25 cm (allow a 1–2 cm tolerance because the final composite will be trimmed 1 cm from the edge). Apply paper tape to the cut line, cut with scissors, and discard all remnants to prevent leakage.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Cut supporting layers",
      "instruction": "Cut peel‑ply to 30 × 35 cm, flow media to 20 × 25 cm, and the vacuum‑plastic sheet to 40 × 40 cm, keeping the plastic loose so it will not be pulled during vacuum.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Prepare resin inlet/outlet hoses",
      "instruction": "Cut two 50 cm lengths of hose for resin inlet and outlet. Cut a 50 cm spiral tube, divide it into four equal pieces, attach the pieces to a T‑connector, and cover the tube’s sharp edges with paper tape to avoid damaging the vacuum plastic.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Clean mold and apply release agent",
      "instruction": "Scrape the flat glass (or alternative) mold surface with a putty knife. Apply release agent with a clean towel in circular motions: 2–3 coats for a reused mold (or 5 coats for a new mold), waiting 3–5 min between coats.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Lay up reinforcement layers",
      "instruction": "Place two sheets of 0/90° glass fiber onto the prepared mold, then lay the cut peel‑ply over the fibers followed by the flow media. Ensure material gaps of 5–10 cm and remove any fiber or peel‑ply remnants from the mold to avoid leakage.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Install vacuum ports and tubing",
      "instruction": "Position the assembled spiral‑tube sections as resin inlet and outlet, secure them to the mold with seal tape, and attach the vacuum ports.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Seal and install vacuum bag",
      "instruction": "Apply seal tape (double seal tape in critical areas such as hose‑to‑plastic connections and folds) to the vacuum‑plastic sheet, then drape the sheet over the mold starting at the hose section, leaving a small gap so the plastic is not pulled during vacuum.",
      "substeps": [],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Connect vacuum chamber and hose",
      "instruction": "Attach the vacuum port and hose to the vacuum chamber, ensuring the hose remains flexible and does not stress the seal tape.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Check for leaks and achieve vacuum",
      "instruction": "Clamp the inlet hose, turn on the vacuum pump until the bag pressure reaches –1 MPa, hold for 10 min while inspecting for leaks. If no leaks are observed, open the chamber valve and shut off the pump. This step involves dangerous pressurised equipment; verify all seals on the pump and resin trap before operation.",
      "substeps": [
        {
          "instruction": "Clamp inlet hose",
          "title": ""
        },
        {
          "instruction": "Turn on vacuum pump until pressure reaches –1 MPa",
          "title": ""
        },
        {
          "instruction": "Wait 10 min and inspect for leaks",
          "title": ""
        },
        {
          "instruction": "If no leaks, open chamber valve and turn off pump",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
