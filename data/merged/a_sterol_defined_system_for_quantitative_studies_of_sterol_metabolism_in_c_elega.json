{
  "protocol_id": "a_sterol_defined_system_for_quantitative_studies_of_sterol_metabolism_in_c_elega",
  "parent_protocol_id": null,
  "version_count": 1,
  "title": "A sterol-defined system for quantitative studies of sterol metabolism in C. elegans",
  "author": "Trabelcy, Gerchman, et al.",
  "doi": "10.1016/j.xpro.2021.100710",
