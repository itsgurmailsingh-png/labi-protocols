  "steps": [
    {
      "step_id": 0,
      "title": "Establish sterol‑controlled environment",
      "instruction": "Use only brand‑new sterile labware, wear gloves at all times, and avoid any sterol‑containing solutions (e.g., yeast extract, Luria Broth) or eukaryotic contaminants; ensure all reagents, containers and equipment are sterol‑free.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare sterol‑defined C. elegans culture",
      "instruction": "Grow the E. coli food strain in Minimum Essential Medium (MEM), which contains no sterols, and culture synchronized C. elegans larvae in liquid defined medium supplemented solely with the sterol of interest.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Harvest and lyophilize synchronized larvae",
      "instruction": "Collect the synchronized larvae from the liquid culture, pellet them by centrifugation, and dry the pellets in a lyophilizer before lipid extraction.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Saponify worm pellets",
      "instruction": "Subject each dried pellet to three cycles of –80 °C freezing and room‑temperature thawing, add 500 µL analytical‑grade ethanol containing 4 µg coprostanol (internal standard), then add 50 µL freshly prepared 10 N aqueous NaOH; securely cap the tubes (screw‑cap or holder) and incubate at 70 °C for 1 h, followed by a 3‑min incubation at 43 °C.",
      "substeps": [
        {
          "instruction": "Freeze at –80 °C, thaw at room temperature – repeat three times.",
          "title": ""
        },
        {
          "instruction": "Add 500 µL ethanol + 4 µg coprostanol.",
          "title": ""
        },
        {
          "instruction": "Add 50 µL 10 N NaOH.",
          "title": ""
        },
        {
          "instruction": "Seal tubes tightly to prevent ethanol spillover.",
          "title": ""
        },
        {
          "instruction": "Incubate 70 °C for 1 h.",
          "title": ""
        },
        {
          "instruction": "Transfer to 43 °C water bath for 3 min.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Extract lipids with hexane",
      "instruction": "Cool tubes to ~20 °C, add 250 µL ddH₂O, mix, then add 500 µL hexane; cap with parafilm, vortex 1 min, centrifuge at 4,000 g for 5 min, and collect the upper organic phase (~500 µL) into a new 2 mL tube. Repeat the extraction two more times, combining the organic phases. Add 500 µL water, repeat the hexane extraction to wash away carry‑over, carefully aspirate the upper hexane layer, transfer to a GC‑MS glass vial, and dry the solvent with a gentle N₂ stream until a white residue remains, ensuring no water remains.",
      "substeps": [
        {
          "instruction": "Cool to ~20 °C.",
          "title": ""
        },
        {
          "instruction": "Add 250 µL ddH₂O, mix.",
          "title": ""
        },
        {
          "instruction": "Add 500 µL hexane.",
          "title": ""
        },
        {
          "instruction": "Cap with parafilm, vortex 1 min.",
          "title": ""
        },
        {
          "instruction": "Spin 4,000 g 5 min.",
          "title": ""
        },
        {
          "instruction": "Collect ~500 µL upper phase; repeat extraction twice, pooling organic phases.",
          "title": ""
        },
        {
          "instruction": "Add 500 µL water, repeat hexane extraction (wash).",
          "title": ""
        },
        {
          "instruction": "Aspirate upper hexane layer, transfer to glass vial.",
          "title": ""
        },
        {
          "instruction": "Dry with N₂; verify no water droplets or vapor remain.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Derivatize sterols with BSTFA",
      "instruction": "Add 50 µL fresh N,O‑Bis(trimethylsilyl)trifluoroacetamide (BSTFA) to each dried residue, cap with PTFE/silicon caps, incubate at 80 °C for 30 min. Then add 150 µL hexane, mix to dissolve the residue, recap, and proceed immediately to GC‑MS (or store at –20 °C for ≤3 days).",
      "substeps": [
        {
          "instruction": "Add 50 µL fresh BSTFA.",
          "title": ""
        },
        {
          "instruction": "Cap tightly; incubate 80 °C 30 min.",
          "title": ""
        },
        {
          "instruction": "Add 150 µL hexane, mix to dissolve residue.",
          "title": ""
        },
        {
          "instruction": "Cap again; run GC‑MS immediately or store at –20 °C (max 3 days).",
          "title": ""
        }
      ],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Set up GC‑MS instrument program",
      "instruction": "Program the Agilent 7890A GC (Rxi‑5Sil MS column) with oven: start 70 °C, ramp to 250 °C at 20 °C/min, then to 320 °C at 10 °C/min, hold 10 min. Set injector to 280 °C, splitless injection, purge 1 min, inject 2 µL. Carrier helium flow 1 mL/min. Set transfer line 320 °C, ion source 230 °C, detector 150 °C, scan range 40–550 m/z.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Identify and quantify sterols",
      "instruction": "Run each sample, determine retention times using a mix of standards (coprostanol, cholesterol, desmosterol, 7‑dehydrocholesterol, ergosterol, stigmasterol, β‑sitosterol). Confirm identities by fragmentation patterns. Build calibration curves for each sterol by dissolving the pure standard in ethanol over 7.81–125 µg/mL; calculate peak‑area versus concentration equations (see below). Compute extraction efficiency from the internal‑standard peak before and after extraction, then calculate sterol amounts using the appropriate calibration equation, correct for extraction efficiency, and normalize to dry weight. If a peak falls outside the calibration range, dilute or concentrate the sample. For desmosterol/7‑dehydrocholesterol overlap, use ions 372.7 and 373.3 (ratio 0.0042) to separate their contributions.",
      "substeps": [
        {
          "instruction": "Run standards mixture to obtain retention times.",
          "title": ""
        },
        {
          "instruction": "Validate each sterol by its MS fragmentation pattern.",
          "title": ""
        },
        {
          "instruction": "Prepare calibration standards (7.81–125 µg/mL) and record peak areas.",
          "title": ""
        },
        {
          "instruction": "Calibration equations:",
          "title": ""
        },
        {
          "instruction": "• Cholesterol: Y = 5E+07·X – 1E+06 (R² = 0.987)",
          "title": ""
        },
        {
          "instruction": "• Desmosterol: Y = 7E+07·X – 1E+06 (R² = 0.982)",
          "title": ""
        },
        {
          "instruction": "• 7‑dehydrocholesterol: Y = 2E+07·X – 4.7E+05 (R² = 0.969)",
          "title": ""
        },
        {
          "instruction": "• Ergosterol: Y = 2E+07·X – 7.2E+05 (R² = 0.978)",
          "title": ""
        },
        {
          "instruction": "• Stigmasterol: Y = 7E+07·X – 2E+06 (R² = 0.985)",
          "title": ""
        },
        {
          "instruction": "• β‑sitosterol: Y = 5E+07·X – 1E+06 (R² = 0.985)",
          "title": ""
        },
        {
          "instruction": "Calculate extraction efficiency from internal‑standard (coprostanol) peak before/after extraction.",
          "title": ""
        },
        {
          "instruction": "Apply calibration equation to each sterol peak area, correct for extraction efficiency, divide by sample dry weight.",
          "title": ""
        },
        {
          "instruction": "For desmosterol/7‑dehydrocholesterol overlap, sum ions 372.7 + 373.3, multiply by 1/0.0042 to obtain desmosterol‑specific area, subtract from total to get 7‑dehydrocholesterol area.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
