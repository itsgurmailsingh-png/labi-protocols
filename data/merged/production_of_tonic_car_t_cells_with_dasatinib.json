  "steps": [
    {
      "step_id": 0,
      "title": "Isolate PBMCs from buffy coats",
      "instruction": "Dilute whole blood with saline, layer over Lymphoprep, centrifuge without brake, collect the interphase containing PBMCs, wash cells, count them, and either cryopreserve or use fresh for downstream culture.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Activate T cells (day –2)",
      "instruction": "Culture the isolated PBMCs with anti‑CD3 and anti‑CD28 antibodies for 72 h to activate T cells before transduction.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Retroviral transduction (day +1 and +2)",
      "instruction": "Perform spinoculation of the activated T cells with retroviral particles on day +1 and repeat on day +2 to achieve efficient CAR transduction.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Add dasatinib (day +3)",
      "instruction": "Add dasatinib to the culture on day +3 to improve CAR T‑cell production yield and viability.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Harvest and evaluate T cells (day +10)",
      "instruction": "Harvest the CAR T cells on day +10 (or up to day +12) for downstream experiments or freezing, and perform the required phenotypic and functional analyses.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
