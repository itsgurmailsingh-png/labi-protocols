  "materials": [
    "anti-human CD3 antibody",
    "anti-human CD28 antibody",
    "murine fragment antigen-binding-biotin antibody",
    "G4S-AF647 antibody",
    "streptavidin-APC",
    "CD3 monoclonal antibody",
    "CD4 monoclonal antibody",
    "CD8a monoclonal antibody",
    "CD62L monoclonal antibody",
    "CD197 monoclonal antibody",
