  "steps": [
    {
      "step_id": 0,
      "title": "PBS Washes to Remove Cryoprotectant",
      "instruction": "Remove residual cryoprotectant by washing slices in PBS.",
      "substeps": [
        {
          "instruction": "Transfer slices from cryoprotectant to PBS and shake for 15 min.",
          "title": ""
        },
        {
          "instruction": "Replace PBS twice, shaking 15 min each wash.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Block Tissue and Prepare Primary Antibody",
      "instruction": "Block non‑specific binding and ready the primary antibody solution.",
      "substeps": [
        {
          "instruction": "Incubate slices in blocking solution while shaking at 70 rpm for 1 h at ~25 °C.",
          "title": ""
        },
        {
          "instruction": "Prepare primary antibody solution.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Incubate Slices with Primary Antibody",
      "instruction": "Stain slices with c‑Fos primary antibody.",
      "substeps": [
        {
          "instruction": "Incubate slices in primary antibody solution, shaking mildly at 4 °C for 7 days.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Post‑Primary PBS Washes",
      "instruction": "Remove unbound primary antibody with PBS washes.",
      "substeps": [
        {
          "instruction": "Wash slices in PBS, shaking 15 min.",
          "title": ""
        },
        {
          "instruction": "Perform a second PBS wash, shaking 15 min.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Incubate with Secondary Antibody",
      "instruction": "Apply fluorescent secondary antibody (AF 647).",
      "substeps": [
        {
          "instruction": "Incubate slices in secondary antibody (AF 647) solution, shaking at 70 rpm for 2 h at room temperature.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "PBS Wash After Secondary",
      "instruction": "Remove excess secondary antibody.",
      "substeps": [
        {
          "instruction": "Wash slices in PBS for 15 min.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "DAPI Nuclear Staining",
      "instruction": "Stain nuclei with DAPI.",
      "substeps": [
        {
          "instruction": "Incubate slices in DAPI (1:50,000) solution for 5 min.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Mount Slices on Slides",
      "instruction": "Place stained slices onto microscope slides.",
      "substeps": [
        {
          "instruction": "Place slices onto microscope slides.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Dry, Add Mounting Medium, Cover",
      "instruction": "Finalize mounting for imaging.",
      "substeps": [
        {
          "instruction": "Allow slices to dry on slide for 20 min.",
          "title": ""
        },
        {
          "instruction": "Add 1–2 drops mounting medium and seal with a coverslip.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Place Sample on Slide",
      "instruction": "Position tissue on a slide with adequate margins.",
      "substeps": [
        {
          "instruction": "Place tissue sample on a slide, leaving sufficient space between tissue edges and slide borders.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Create Hot‑Glue Walls with Gap",
      "instruction": "Build a chamber around the tissue using hot glue, leaving a small gap.",
      "substeps": [
        {
          "instruction": "Using a hot‑glue gun, build walls up to near tissue height, leaving a 4–5 mm gap and not sealing walls completely.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 11,
      "title": "Apply CSRC Drops to Prevent Bubbles",
      "instruction": "Add clearing solution to avoid bubble formation.",
      "substeps": [
        {
          "instruction": "Apply 1–2 drops of CSRC onto tissue to avoid bubble formation.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 12,
      "title": "Add Final Wall Layer to Tissue Height",
      "instruction": "Complete the chamber walls to match tissue height.",
      "substeps": [
        {
          "instruction": "Add the final layer of hot‑glue walls, matching tissue height.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 13,
      "title": "Seal Slide with Coverslip (Add Extra Glue if Needed)",
      "instruction": "Close the chamber and optionally reinforce for immersion objectives.",
      "substeps": [
        {
          "instruction": "Before glue sets, seal the slide top with a coverslip, ensuring even contact and no holes.",
          "title": ""
        },
        {
          "instruction": "If using an immersion objective, apply an additional hot‑glue layer above the coverslip.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 14,
      "title": "Fill Chamber with CSRC",
      "instruction": "Introduce clearing solution into the chamber.",
      "substeps": [
        {
          "instruction": "Fill the chamber through the gap with CSRC solution.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 15,
      "title": "Seal Gap with Hot Glue",
      "instruction": "Close the chamber completely, eliminating bubbles.",
      "substeps": [
        {
          "instruction": "Seal the gap with hot glue, ensuring no bubbles remain.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
