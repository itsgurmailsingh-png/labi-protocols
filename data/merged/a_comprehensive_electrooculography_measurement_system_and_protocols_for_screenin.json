  "steps": [
    {
      "step_id": 0,
      "title": "Configure Somté system for EOG",
      "instruction": "Set up the Somté ambulatory polysomnography system (Compumedics, Australia) by powering it on, selecting only the EOG channel, disabling all other channels, and configuring acquisition parameters to meet the technical specifications recommended by the American Academy of Sleep Medicine for standard polysomnography.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Record and review EOG signals",
      "instruction": "Using the configured Somté system, record EOG signals while participants perform the standardized eye‑movement tasks, then open the recorded files in the Somté‑provided software to review and export the data for analysis.",
