  "steps": [
    {
      "step_id": 0,
      "title": "Set up speaker/Chladni system",
      "instruction": "Mount a 5.5 in diameter speaker 3 mm below the underside of the plate (measured from the top of the plate peripheral), connect it to a BOGEN Classic C60 60 W RMS amplifier, wear acoustic earmuffs, and evenly sprinkle cake sprinkles onto the plate surface. Set the speaker to emit approximately 40 W (nominal 50 W, maximum 120 W, 8 Ω) sine‑wave tones and sweep the frequency range up to about 1200 Hz. Use an EXTECH HD600 datalogging sound‑level meter to monitor acoustic intensity; record the frequency at which the meter shows a local maximum and the sprinkles form a clear Chladni pattern as the natural frequency. Note that frequencies above 1200 Hz are uncomfortable for the operator and may require additional sound insulation.",
      "substeps": [
        {
          "instruction": "Place the speaker 3 mm below the plate underside.",
          "title": ""
        },
        {
          "instruction": "Connect the speaker to the BOGEN Classic C60 60 W RMS amplifier.",
          "title": ""
        },
        {
          "instruction": "Put on acoustic earmuffs before powering the speaker.",
          "title": ""
        },
        {
          "instruction": "Sprinkle cake sprinkles uniformly over the plate.",
          "title": ""
        },
        {
          "instruction": "Set speaker output to ~40 W (nominal 50 W, max 120 W, 8 Ω).",
          "title": ""
        },
        {
          "instruction": "Sweep sine‑wave frequencies up to ~1200 Hz.",
          "title": ""
        },
        {
          "instruction": "Monitor acoustic intensity with the EXTECH HD600 sound‑level meter.",
          "title": ""
        },
        {
          "instruction": "Identify the natural frequency when the meter peaks and a Chladni pattern appears.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Set up impulse‑hammer/accelerometer system",
      "instruction": "Glue two PCB PIEZOTRONICS Model 352C22 accelerometers to the plate surface using a hot‑glue gun, securing them with removable sealant applied by a sealant gun. Connect the accelerometers to a PCB PIEZOTRONICS Model 482C Series signal conditioner, then to a NI USB‑6212 multifunction I/O DAQ device and computer. Position the accelerometers as close as possible to the antinodes of the six lowest modes while avoiding nodes (see Fig. 16). Impact the plate orthogonal to its surface with a KISTLER Model 9928 impulse hammer, maintaining an impact force between 25 N and 65 N (measured by the hammer’s built‑in load cell). Record both impact force and accelerometer response, then process the signals with the Least‑Squares Complex Exponential (LSCE) algorithm, optimizing the data‑window size for clean results. Ensure the impact force never exceeds the level that would detach the plate from the removable sealant.",
      "substeps": [
        {
          "instruction": "Apply removable sealant to the plate‑frame joint.",
          "title": ""
        },
        {
          "instruction": "Use a hot‑glue gun to attach two PCB PIEZOTRONICS Model 352C22 accelerometers to the plate surface.",
          "title": ""
        },
        {
          "instruction": "Connect accelerometers to the PCB PIEZOTRONICS Model 482C Series signal conditioner.",
          "title": ""
        },
        {
          "instruction": "Route the conditioner output to the NI USB‑6212 DAQ and computer.",
          "title": ""
        },
        {
          "instruction": "Place accelerometers near antinodes of the six lowest modes, avoiding nodes.",
          "title": ""
        },
        {
          "instruction": "Impact the plate with the KISTLER Model 9928 hammer, keeping the hammer orthogonal to the surface.",
          "title": ""
        },
        {
          "instruction": "Maintain impact force between 25 N and 65 N as read from the hammer’s load cell.",
          "title": ""
        },
        {
          "instruction": "Record impact force and accelerometer signals.",
          "title": ""
        },
        {
          "instruction": "Process signals using the LSCE algorithm and adjust the recording window size for optimal cleanliness.",
          "title": ""
        },
        {
          "instruction": "Avoid forces that could separate the plate from the sealant.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
