  "category": "Biochemistry & In Vitro",
  "estimated_time_mins": 72,
  "materials": [
    "A 3 mg/ml sample of bovine serum albumin (BSA) (Sigma Aldrich) in PBS buffer was prepared using a phosphate buffered saline tablet (Sigma) with 200 mL of ultrapure deionized water and filtered with 100 nm and 20 nm filters. For each thermal ramp a new aliquot was prepared from the same stock solution.",
    "For chemical compatibility measurements, 200 kDa polystyrene standard was dispersed in toluene (Sigma)."
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare BSA stock solution",
      "instruction": "Dissolve bovine serum albumin (Sigma Aldrich) to a concentration of 3 mg/mL in PBS prepared by dissolving one phosphate‑buffered saline tablet (Sigma) in 200 mL ultrapure deionized water, then filter the solution sequentially through 100 nm and 20 nm filters; use a fresh aliquot from this stock for each thermal ramp.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare polystyrene standard",
      "instruction": "Disperse the 200 kDa polystyrene standard (Sigma) in toluene to the desired concentration for chemical‑compatibility measurements.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Prepare silica sample",
      "instruction": "Disperse a 38 nm silica sample (TM‑50 Ludox) in ultrapure water for verification of UV‑resin thermal stability.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Load samples into capillaries",
      "instruction": "Using tweezers, pick up a ZSU1002 capillary by one end, dip the opposite end into the sample, and allow the liquid to wick up to ~1 cm, which corresponds to ~10 µL (minimum 3 µL required). Load each sample into a fresh capillary; for comparative measurements also load the same sample into clean ZEN2112 low‑volume quartz cuvettes.",
      "substeps": [
        {
          "instruction": "Place loaded capillaries into the ZSU1002 capillary holder as described in reference [2], ensuring the sample lies within the measurement window.",
          "title": ""
        },
        {
          "instruction": "Between measurements, clean cuvettes with Hellmanex, rinse with ultrapure water, and dry with compressed air.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Seal capillary ends with UV resin",
      "instruction": "With the capillary held horizontally, apply a small amount of UV‑curable resin onto the wet tip until it covers the tip and extends ~1 mm up the capillary; then activate the UV light source, holding it close (but not touching) the tip for 5–10 s until the resin hardens. Repeat the resin application and UV curing on the opposite end to prevent evaporation. Finally, wipe excess resin from the capillary with a lint‑free cloth.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Insert sealed capillary for measurement",
      "instruction": "Place the fully sealed capillary into the cell holder, confirming that the sealed sample region aligns with the instrument’s measurement window, and proceed with the DLS temperature‑trend experiment.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
