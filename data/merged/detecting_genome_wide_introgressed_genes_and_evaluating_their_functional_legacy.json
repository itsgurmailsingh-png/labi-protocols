  "materials": [
    "RAD-seq data",
    "D. huoshanense genome",
    "Transcriptomic data of D. catenatum",
    "GATK4 v4.6.2.0",
    "parseVCF.py",
    "windows.py",
    "ncbi-blast-2.14.0",
    "KofamKOALA",
    "MEGA v5.2",
    "FastQC v0.12.1",
    "Agat v0.8.1",
    "Trim_galore v0.6.10",
    "Hisat2 v2.2.1",
    "Samtools v1.20",
    "HTSeq v0.11.3",
    "DESeq2",
    "1.All tests are conducted on a system running the CentOS Linux 7 (Core) operating system with Intel® Xeon® Gold 6348H CPUs operating at 2.30 GHz and supported by 1 TB of RAM.",
    "Timing: 1–2 h",
    "In this protocol, all tests are conducted utilizing software, as detailed in the key resources table, with download links provided for access. It is recommended to store all software files in a designated folder. Additionally, software can be downloaded and installed either manually or through Conda using the default settings (Figure 1).2.Prior to the bioinformatics analysis, install all software specified in the key resources table.Note: Installation instructions for each program are available on their official websites.Figure 1Screenshot displaying the help message of GenomeAnalysisTKThe figure displays the help information for GATK4, including the version, background details, and usage instructions for the package.",
    "Timing: 6 days"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Configure computational hardware",
      "instruction": "Use a workstation running CentOS Linux 7 (Core) equipped with Intel® Xeon® Gold 6348H CPUs at 2.30 GHz and 1 TB of RAM.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Install required bioinformatics software",
      "instruction": "Download and install every program listed in the key resources table, either manually or via Conda using default settings; refer to each program’s official website for installation details.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Install SRA Toolkit and download data",
      "instruction": "Install the SRA Toolkit, then download the publicly available RAD‑seq datasets for Dendrobium catenatum and D. huoshanense and the transcriptomic data of D. catenatum under cadmium stress; store all raw files in a dedicated directory.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Organize raw sequencing files",
      "instruction": "Create a clear folder hierarchy (e.g., /home/[user]/Workfiles/Raw_data/) and place each .bam file (Sample01.realign.bam, Sample02.realign.bam, …, SampleXX.realign.bam) in that directory.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Call variants with GATK HaplotypeCaller",
      "instruction": "Run GATK 4 (v4.6.2.0‑114) HaplotypeCaller on all samples using the D. catenatum reference genome:",
      "substeps": [
        {
          "instruction": "gatk4 HaplotypeCaller \\",
          "title": ""
        },
        {
          "instruction": "-R /home/[user]/Workfiles/SNP_Calling/reference.fasta \\",
          "title": ""
        },
        {
          "instruction": "-O /home/[user]/Workfiles/SNP_Calling/example.raw.vcf \\",
          "title": ""
        },
        {
          "instruction": "-I /home/[user]/Workfiles/Raw_data/Sample01.realign.bam \\",
          "title": ""
        },
        {
          "instruction": "-I /home/[user]/Workfiles/Raw_data/Sample02.realign.bam \\",
          "title": ""
        },
        {
          "instruction": "-I /home/[user]/Workfiles/Raw_data/Sample03.realign.bam \\",
          "title": ""
        },
        {
          "instruction": "… \\",
          "title": ""
        },
        {
          "instruction": "-I /home/[user]/Workfiles/Raw_data/SampleXX.realign.bam",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Select SNPs from raw VCF",
      "instruction": "Extract only SNP records from the raw VCF using GATK SelectVariants:",
      "substeps": [
        {
          "instruction": "gatk4 SelectVariants \\",
          "title": ""
        },
        {
          "instruction": "-select-type SNP \\",
          "title": ""
        },
        {
          "instruction": "-V /home/[user]/Workfiles/SNP_Calling/example.raw.vcf \\",
          "title": ""
        },
        {
          "instruction": "-O /home/[user]/Workfiles/SNP_Calling/example.raw.SNP.vcf",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Filter SNPs and parse VCF",
      "instruction": "Apply hard filters with GATK VariantFiltration, then parse the filtered VCF with the provided Python script:",
      "substeps": [
        {
          "instruction": "gatk4 VariantFiltration \\",
          "title": ""
        },
        {
          "instruction": "-R /home/[user]/Workfiles/SNP_Calling/reference.fasta \\",
          "title": ""
        },
        {
          "instruction": "-V /home/[user]/Workfiles/SNP_Calling/example.raw.SNP.vcf \\",
          "title": ""
        },
        {
          "instruction": "--filter-expression \"QD 60.0 || SOR > 3.0 || MQRankSum\" \\",
          "title": ""
        },
        {
          "instruction": "-O /home/[user]/Workfiles/SNP_Calling/example.filtered.vcf.gz",
          "title": ""
        },
        {
          "instruction": "python parseVCF.py \\",
          "title": ""
        },
        {
          "instruction": "-i /home/[user]/Workfiles/SNP_Calling/example.filtered.vcf.gz \\",
          "title": ""
        },
        {
          "instruction": "--minQual 30 \\",
          "title": ""
        },
        {
          "instruction": "--skipIndels \\",
          "title": ""
        },
        {
          "instruction": "--gtf flag=DP min=3 | gzip > /home/[user]/Workfiles/SNP_Calling/output.example.filtered.vcf.geno.gz",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Generate .geno file",
      "instruction": "The parseVCF.py script produces a .geno file with 22 columns, including CHROM, POS, and unphased genotypes for each individual; missing data are coded as “N” and heterozygous genotypes as “/”.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Perform differential expression analysis",
      "instruction": "Run DESeq2 on the transcriptomic data; the output table must contain eight columns: baseMean, log2FoldChange, lfcSE, stat, p‑value, padj, sig, and an indicator of statistical significance.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Conduct D‑statistic introgression test",
      "instruction": "Prepare four‑taxon input (P1, P2, P3, and outgroup O) ensuring the outgroup shows negligible admixture, then apply the D‑statistic method to assess introgression among the species.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
