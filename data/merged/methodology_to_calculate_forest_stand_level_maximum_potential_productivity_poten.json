{
  "protocol_id": "methodology_to_calculate_forest_stand_level_maximum_potential_productivity_poten",
  "parent_protocol_id": null,
  "version_count": 1,
  "title": "Methodology to calculate forest stand level maximum potential productivity, potential achievable productivity and ecosystem fit",
  "author": "Klock, Vogt, et al.",
  "doi": "10.1016/j.mex.2022.101812",
  "source_name": "methodsx",
  "source_url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9418551/",
  "citation": "10.1016/j.mex.2022.101812",
