  "steps": [
    {
      "step_id": 0,
      "title": "Total RNA isolation (1–2 days)",
      "instruction": "Extract total RNA from the cultured cells, then dissolve, quantify, and store the RNA for downstream tRNA enrichment.",
      "substeps": [
        {
          "instruction": "Grow cells in an appropriate medium and collect them as recommended.",
          "title": ""
        },
        {
          "instruction": "Isolate total RNA using a method suitable for the organism:\n  • For gram‑negative bacteria (e.g., Shewanella glacialimarina TZS‑4T), use TRIzol (or an equivalent reagent) followed by acidic phenol re‑extraction.\n  • For yeast, perform acidic phenol isolation (this yields RNA enriched for tRNA and gives higher yields after tRNA purification).\n  • Commercial column‑based kits may be used provided they retain RNAs longer than 20 nt.\n  • When isolating total RNA from tissue, ensure samples contain no lipids, as lipids interfere with RNA binding to the silica column during later tRNA enrichment, reducing yield.",
          "title": ""
        },
        {
          "instruction": "Dissolve the purified total RNA in RNase‑free water, determine its concentration by measuring absorbance at 260 nm or by a fluorescent method such as Qubit, and store the RNA at –80 °C.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
