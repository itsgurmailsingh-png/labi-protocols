  "steps": [
    {
      "step_id": 0,
      "title": "Prepare input structures and YAML",
      "instruction": "Obtain the positive‑design and negative‑design protein structures in PDB format and the corresponding cDNA sequence, process them for OSPREY K* design, and assemble all required files (structures, sequences, and parameters) into a single YAML design file.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Specify K* positive and negative designs",
      "instruction": "Define the K* design tasks for the positive (inhibitor‑bound) and negative (endogenous‑ligand‑bound) states within the YAML file, indicating which ligand and receptor files correspond to each state.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Run OSPREY K* calculations",
      "instruction": "Execute the OSPREY software to compute provable approximations of the binding constant (Ka) for each mutant in both the positive and negative design states.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Assign mutational probabilities and hotspot scores",
      "instruction": "Process the OSPREY output with RESISTOR to attach mutational signature probabilities (derived from Alexandrov et al.) to each mutation and calculate hotspot scores (the count of sequences where a residue is predicted as a resistance mutation).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Pareto‑optimize and rank mutants",
      "instruction": "Use RESISTOR to perform Pareto optimization over the positive‑design score, negative‑design score, mutational probability, and hotspot score, then assign Pareto ranks to all prospective mutants.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Analyze RESISTOR output",
      "instruction": "Examine the generated Pareto‑ranked list and the low‑energy molecular ensembles to identify likely resistance‑conferring ERK2 mutations for the inhibitor SCH772984 (SCH7).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
