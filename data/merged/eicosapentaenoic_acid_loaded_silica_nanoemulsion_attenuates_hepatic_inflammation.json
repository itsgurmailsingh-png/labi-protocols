  "steps": [
    {
      "step_id": 0,
      "title": "Dissolve TEOS in water",
      "instruction": "Add 5 mL tetraethyl orthosilicate (TEOS) to water and stir magnetically at room temperature for 5 minutes.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare chemphore‑EPA mixture",
      "instruction": "Mix 4 mL chemphore with 25 mL water, then add 15 mL eicosapentaenoic acid (EPA) to this chemphore solution; add the resulting mixture to the TEOS solution.",
      "substeps": [
        {
          "instruction": "Combine 4 mL chemphore with 25 mL water.",
          "title": ""
        },
        {
          "instruction": "Add 15 mL EPA to the chemphore‑water mixture.",
          "title": ""
        },
        {
          "instruction": "Introduce the chemphore‑EPA mixture into the TEOS solution.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Homogenize and confirm emulsification",
      "instruction": "Stir the combined solution vigorously with an ultrasonic homogenizer for 15 minutes; the solution should change from colorless to milky, indicating successful EPA nanoemulsion formation.",
      "substeps": [],
      "is_critical": false,
