  "steps": [
    {
      "step_id": 0,
      "title": "Install SUMO and upgrade pip",
      "instruction": "Upgrade pip3 to a version >19.0 and upgrade setuptools, then install SUMO from PyPI using pip3 install python-sumo. Python 3.6+ is required.",
      "substeps": [
        {
          "instruction": "pip3 install --upgrade pip setuptools",
          "title": ""
        },
        {
          "instruction": "pip3 install python-sumo",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Install R packages and set workdir",
      "instruction": "In R, set the working directory to the folder containing the Xena files (using setwd), then install and load the required R packages.",
      "substeps": [
        {
          "instruction": "install.packages(c(\"devtools\", \"tidyverse\", \"reticulate\", \"survival\", \"survminer\"))",
          "title": ""
        },
        {
          "instruction": "devtools::install_github(\"stephenturner/annotables@v0.1.90\")",
          "title": ""
        },
        {
          "instruction": "library(annotables); library(tidyverse); library(reticulate); library(survival); library(survminer)",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Preprocess miRNA, gene, methylation data",
      "instruction": "Load each pre‑downloaded feature matrix, optionally filter gene data to protein‑coding genes, and write the matrices to tab‑separated files required by SUMO.",
      "substeps": [
        {
          "instruction": "Load miRNA expression data in R and write to \"TCGA.LGG.miRNAexp.tsv\" with write.table(..., sep=\"\\t\", col.names=TRUE, row.names=TRUE).",
          "title": ""
        },
        {
          "instruction": "Load gene expression data in R; optionally limit to protein‑coding genes by joining with GRCh38 annotation and filtering biotype == \"protein_coding\"; then write to \"TCGA.LGG.mRNAexp.tsv\" with write.table(..., sep=\"\\t\", col.names=TRUE, row.names=TRUE).",
          "title": ""
        },
        {
          "instruction": "Load methylation data in R and write to \"TCGA.LGG.met.tsv\" with write.table(..., sep=\"\\t\", col.names=TRUE, row.names=TRUE).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Create multiplex similarity network",
      "instruction": "Run SUMO in \"prepare\" mode on the three pre‑processed files to compute distance‑to‑similarity matrices and store them in a zipped .npz archive.",
      "substeps": [
        {
          "instruction": "sumo prepare TCGA.LGG.mRNAexp.tsv,TCGA.LGG.met.tsv,TCGA.LGG.miRNAexp.tsv prepared.LGG.npz \\",
          "title": ""
        },
        {
          "instruction": "-atol <value>   # increase tolerance to accept sparse miRNA matrix",
          "title": ""
        },
        {
          "instruction": "-method euclidean   # default distance appropriate for log‑normalized counts and M‑values",
          "title": ""
        },
        {
          "instruction": "-k <value> -alpha <value>   # hyper‑parameters controlling similarity distribution",
          "title": ""
        },
        {
          "instruction": "-log DEBUG -logfile prepare.log   # optional logging",
          "title": ""
        },
        {
          "instruction": "-plot similarity_plots/   # optional heat‑map plots",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Detect molecular subtypes with SUMO",
      "instruction": "Run SUMO in \"run\" mode on the prepared .npz file over a range of cluster numbers, specifying output directory and optional algorithmic parameters.",
      "substeps": [
        {
          "instruction": "sumo run prepared.LGG.npz 2,10 LGG \\",
          "title": ""
        },
        {
          "instruction": "-log DEBUG -logfile run.log   # optional logging",
          "title": ""
        },
        {
          "instruction": "-max_iter <value> -tol <value>   # stopping criteria for factorization",
          "title": ""
        },
        {
          "instruction": "-sparsity <eta1>,<eta2>,...   # optional list of sparsity penalties; SUMO selects best",
          "title": ""
        },
        {
          "instruction": "-t <num_threads>   # number of computational threads",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Select optimal cluster number",
      "instruction": "Inspect the generated \"cophenet.png\" and \"pac.png\" plots in LGG/plots and choose the k with CCC > 0.95 and PAC < 0.1; optionally reproduce metric plots in R.",
      "substeps": [
        {
          "instruction": "Open LGG/plots/cophenet.png and LGG/plots/pac.png; look for high cophenetic correlation (≥0.95) and low proportion of ambiguously clustered pairs (<0.1).",
          "title": ""
        },
        {
          "instruction": "Optional R analysis:",
          "title": ""
        },
        {
          "instruction": "library(tidyverse); library(reticulate)",
          "title": ""
        },
        {
          "instruction": "sumo_run_dir <- \"LGG\"",
          "title": ""
        },
        {
          "instruction": "pac_tbl <- np$sumo_run_dir %>% ... # gather PAC values",
          "title": ""
        },
        {
          "instruction": "ccc_tbl <- np$sumo_run_dir %>% ... # gather CCC values",
          "title": ""
        },
        {
          "instruction": "metric_tbl <- left_join(pac_tbl, ccc_tbl, by=c(\"rep\",\"dir_name\")) %>%",
          "title": ""
        },
        {
          "instruction": "separate(dir_name, c(NA,\"k\"), sep=\"k\") %>%",
          "title": ""
        },
        {
          "instruction": "group_by(metric,k) %>% summarise(median_value=median(value), min_value=min(value), max_value=max(value))",
          "title": ""
        },
        {
          "instruction": "ggplot(metric_tbl) + geom_line(aes(x=k, y=median_value, colour=metric, group=metric)) +",
          "title": ""
        },
        {
          "instruction": "geom_ribbon(aes(x=k, ymin=min_value, ymax=max_value, fill=metric), alpha=0.3) + theme_bw()",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Identify subtype biomarkers",
      "instruction": "Run SUMO in \"interpret\" mode using the selected factorization result and the three feature matrices to compute SHAP values for each feature.",
      "substeps": [
        {
          "instruction": "sumo interpret LGG/k5/sumo_results.npz TCGA.LGG.mRNAexp.tsv,TCGA.LGG.met.tsv,TCGA.LGG.miRNAexp.tsv LGG_interpret_k5 \\",
          "title": ""
        },
        {
          "instruction": "-log DEBUG -logfile interpret.log   # optional logging",
          "title": ""
        },
        {
          "instruction": "-max_iter <value> -n_folds <value>   # hyper‑parameter search and cross‑validation",
          "title": ""
        },
        {
          "instruction": "-t <num_threads>",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Downstream analyses of subtypes",
      "instruction": "Perform survival analysis and evaluate top biomarkers using R.",
      "substeps": [
        {
          "instruction": "Load R packages: library(tidyverse); library(survival); library(survminer).",
          "title": ""
        },
        {
          "instruction": "Load sample labels (clusters.tsv) and clinical data; merge on sample ID:",
          "title": ""
        },
        {
          "instruction": "data <- labels %>% select(sample, OS, OS.time) %>% right_join(clinical, by=\"sample\").",
          "title": ""
        },
        {
          "instruction": "Plot Kaplan‑Meier curves:",
          "title": ""
        },
        {
          "instruction": "ggsurvplot(survfit(Surv(OS.time, OS) ~ label, data=data), data=data,",
          "title": ""
        },
        {
          "instruction": "palette=\"npg\", pval=TRUE, ggtheme=theme_bw(), risk.table=TRUE).",
          "title": ""
        },
        {
          "instruction": "Note: test proportional‑hazard assumption with Schoenfeld residuals; consider weighted log‑rank if violated.",
          "title": ""
        },
        {
          "instruction": "Load interpret results and select top features for a chosen subtype:",
          "title": ""
        },
        {
          "instruction": "interpret_tbl <- read_tsv(\"LGG_interpret_k5.tsv\") %>% gather(group, importance, -feature)",
          "title": ""
        },
        {
          "instruction": "top_features <- interpret_tbl %>% filter(group == paste0(\"GROUP_\", selected_label)) %>%",
          "title": ""
        },
        {
          "instruction": "arrange(desc(importance)) %>% top_n(6, importance).",
          "title": ""
        },
        {
          "instruction": "Extract values of top features from the pre‑processed matrices and merge with labels:",
          "title": ""
        },
        {
          "instruction": "for each infile in c(\"TCGA.LGG.mRNAexp.tsv\",\"TCGA.LGG.met.tsv\",\"TCGA.LGG.miRNAexp.tsv\") {",
          "title": ""
        },
        {
          "instruction": "read matrix, reshape to long format (sample, feature, value),",
          "title": ""
        },
        {
          "instruction": "full_join with feature_tbl by c(\"sample\",\"feature\").",
          "title": ""
        },
        {
          "instruction": "}",
          "title": ""
        },
        {
          "instruction": "merged_data <- data %>% left_join(labels, by=\"sample\") %>% left_join(top_features, by=\"feature\").",
          "title": ""
        },
        {
          "instruction": "Perform Kruskal‑Wallis test for each top feature:",
          "title": ""
        },
        {
          "instruction": "test_feature <- merged_data %>% mutate(group = ifelse(label == selected_label, \"TARGET\", \"OTHER\"))",
          "title": ""
        },
        {
          "instruction": "pvals <- test_feature %>% group_by(feature) %>% summarise(pval = kruskal.test(value ~ group)$p.value).",
          "title": ""
        },
        {
          "instruction": "Plot feature values across subtypes:",
          "title": ""
        },
        {
          "instruction": "merged_data %>% separate(group, c(NA,\"group\"), sep=\"_\") %>%",
          "title": ""
        },
        {
          "instruction": "mutate(group = as.numeric(group), selected_group = as.factor(label==group), label = as.factor(label)) %>%",
          "title": ""
        },
        {
          "instruction": "ggplot(aes(x=label, y=value, fill=selected_group, colour=selected_group)) +",
          "title": ""
        },
        {
          "instruction": "geom_violin(alpha=0.3) +",
          "title": ""
        },
        {
          "instruction": "geom_text(data=distinct(merged_data, feature, group, importance, pval),",
          "title": ""
        },
        {
          "instruction": "aes(x=-Inf, y=-Inf, label=paste0(\"p‑value \", ifelse(pval>0.0001, round(pval,4), \"<0.0001\"))),",
          "title": ""
        },
        {
          "instruction": "hjust=-0.05, vjust=-0.5, size=4) +",
          "title": ""
        },
        {
          "instruction": "facet_wrap(~paste(feature, \"(importance:\", round(importance,3), \")\"), scales=\"free\") +",
          "title": ""
        },
        {
          "instruction": "theme_bw(base_size=12) + theme(legend.position=\"null\") + labs(y=\"feature value\", x=\"subtype\").",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
