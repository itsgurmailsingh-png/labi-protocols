{
  "protocol_id": "integrative_subtyping_of_lower_grade_gliomas_using_the_sumo_pipeline",
  "parent_protocol_id": null,
  "version_count": 1,
  "title": "Integrative Subtyping of Lower-Grade Gliomas Using the SUMO Pipeline",
  "author": "Sienkiewicz, Ratan",
