  "steps": [
    {
      "step_id": 0,
      "title": "Prepare culture media for cell lines",
      "instruction": "Make the following complete media formulations, using the indicated base medium and supplements, and keep the media sterile until use.",
      "substeps": [
        {
          "instruction": "HeLa cells: Eagle’s Minimal Essential Medium (MEM) (Gibco, Karlsruhe, Germany) + 5 % fetal calf serum (FCS) + 0.02 M HEPES + 1 % non‑essential amino acids (NEAA) + 1 % penicillin/streptomycin (P/S).",
          "title": ""
        },
        {
          "instruction": "HEK293T cells: DMEM High glucose (Biowest, Darmstadt, Germany) + 10 % FCS + 1 % P/S + 1 % L‑glutamine + 1 % Na‑pyruvate.",
          "title": ""
        },
        {
          "instruction": "Murine colorectal carcinoma lines (Colon‑26, CT‑26Luc) and human colorectal cancer lines DLD‑1, Colo320, Colo205, Colo680H: RPMI‑1640 (c.c.pro, Oberdorla, Germany) + 10 % FCS + 1 % P/S + 1 % L‑glutamine + 2 % Na‑pyruvate (for CT‑26Luc add 1 % NEAA).",
          "title": ""
        },
        {
          "instruction": "Caco‑2 cells: DMEM High glucose (Biowest) + 10 % FCS + 1 % P/S + 1 % L‑glutamine + 1 % NEAA + 2 % Na‑pyruvate.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Fix and process tissues for histopathology",
      "instruction": "Preserve harvested tissues for microscopic analysis by fixation, embedding, sectioning, and H&E staining.",
      "substeps": [
        {
          "instruction": "Fix tissues in 4 % paraformaldehyde (Carl Roth).",
          "title": ""
        },
        {
          "instruction": "Embed fixed tissues in paraffin.",
          "title": ""
        },
        {
          "instruction": "Cut paraffin blocks into 5 µm‑thick sections.",
          "title": ""
        },
        {
          "instruction": "Stain sections with hematoxylin and eosin (H&E) to visualize inflammation and tissue destruction.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Analyze data statistically",
      "instruction": "Perform all statistical calculations with GraphPad Prism version 8.2, reporting results as mean ± SEM and applying the appropriate tests.",
      "substeps": [
        {
          "instruction": "For cell‑culture experiments, use a two‑tailed unpaired Student’s t‑test.",
          "title": ""
        },
        {
          "instruction": "For in‑vivo experiments, use the Mann‑Whitney U‑test.",
          "title": ""
        },
        {
          "instruction": "Consider differences significant when p < 0.05.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
