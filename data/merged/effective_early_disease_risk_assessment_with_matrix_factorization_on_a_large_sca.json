  "steps": [
    {
      "step_id": 0,
      "title": "Set up software environment",
      "instruction": "Install MATLAB R2016a and download LibSVM version 3.22. Ensure the LibSVM MATLAB interface (libsvmread, libsvmwrite) and the command‑line tools (grid.py, svm‑train.exe) are on the system path.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Load patient‑diagnosis matrix",
      "instruction": "Load the pre‑converted patient‑diagnosis disease matrix (size N × M) that is stored in LibSVM format at C:\\SVM_data\\200.libsvm.txt using the MATLAB command libsvmread. The command returns a label vector and an instance matrix named “inst”.",
      "substeps": [
        {
          "instruction": "[label, inst] = libsvmread('C:\\SVM_data\\200.libsvm.txt');",
          "title": ""
        },
        {
          "instruction": "[label, inst] = libsvmread('C:\\SVM_data\\200.libsvm.txt');   // command shown twice in the original text",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Generate NMF‑based matrix",
      "instruction": "Set the factorization rank to 200, fix the random seed to 1, run MATLAB’s nnmf with the multiplicative‑update algorithm, convert the result to a sparse matrix, and write it to LibSVM format at C:\\NMF_Based_matrix\\200.libsvm. The whole sequence is executed twice in the source document.",
      "substeps": [
        {
          "instruction": "numOfR = 200;",
          "title": ""
        },
        {
          "instruction": "rng(1);",
          "title": ""
        },
        {
          "instruction": "[nmfbasedmatrix, H] = nnmf(inst, numOfR, 'algorithm','mult');",
          "title": ""
        },
        {
          "instruction": "nmfbasedmatrixS = sparse(nmfbasedmatrix);",
          "title": ""
        },
        {
          "instruction": "libsvmwrite('C:\\NMF_Based_matrix\\200.libsvm', label, nmfbasedmatrixS);",
          "title": ""
        },
        {
          "instruction": "// repeat the same block once more as in the original protocol",
          "title": ""
        },
        {
          "instruction": "numOfR = 200;",
          "title": ""
