        {
          "instruction": "rng(1);",
          "title": ""
        },
        {
          "instruction": "[nmfbasedmatrix, H] = nnmf(inst, numOfR, 'algorithm','mult');",
          "title": ""
        },
        {
          "instruction": "nmfbasedmatrixS = sparse(nmfbasedmatrix);",
