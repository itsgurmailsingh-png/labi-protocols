  "steps": [
    {
      "step_id": 0,
      "title": "Generate FLI1 vs SLFN11 scatter plot",
      "instruction": "On the CellMinerCDB web app, open the Univariate Analysis tab, set both x‑ and y‑Axis Data Type to \"exp\", choose FLI1 as the x‑axis identifier and SLFN11 as the y‑axis identifier, then run the analysis to produce a scatter plot. The resulting plot should display a Pearson correlation of 0.61 with a p‑value of 5.1e‑07.",
      "substeps": [
        {
          "instruction": "Open the Univariate Analysis tab.",
          "title": ""
        },
        {
          "instruction": "Set x‑Axis Data Type = \"exp\".",
          "title": ""
        },
        {
          "instruction": "Set y‑Axis Data Type = \"exp\".",
          "title": ""
        },
        {
          "instruction": "Select FLI1 for the x‑axis identifier.",
          "title": ""
        },
        {
          "instruction": "Select SLFN11 for the y‑axis identifier.",
          "title": ""
        },
        {
          "instruction": "Execute the analysis to generate the scatter plot.",
          "title": ""
        },
        {
          "instruction": "Verify that the plot shows Pearson r = 0.61 and p‑value = 5.1e‑07.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Assess multivariate models (alternative)",
      "instruction": "Using the Multivariate Analysis tab, specify the desired input data in the left‑side panel (e.g., a single data package containing gene expression and drug response), then run the multivariate model to evaluate predictions such as drug activity based on gene expression.",
      "substeps": [
        {
          "instruction": "Open the Multivariate Analysis tab.",
          "title": ""
        },
        {
          "instruction": "In the left‑side panel, select the input data package to use.",
          "title": ""
        },
        {
          "instruction": "Configure any model parameters as needed.",
          "title": ""
        },
        {
          "instruction": "Run the multivariate analysis to obtain model results.",
          "title": ""
        }
      ],
