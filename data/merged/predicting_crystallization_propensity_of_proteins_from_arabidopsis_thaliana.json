  "steps": [
    {
      "step_id": 0,
      "title": "Classify A. thaliana protein predictions",
      "instruction": "The prediction of whether an A. thaliana protein could be crystallized was compared with what happened in realty. When an A. thaliana protein was predicted to be crystallized and was crystallized in reality, this prediction was classified as true positive (TP). When an A. thaliana protein was predicted to be not crystallized and was not crystallized in reality, this prediction was classified as true negative (TN). When an A. thaliana protein was predicted to be crystallized but was not crystallized in reality, this prediction was classified as false positive (FP). When an A. thaliana protein was predicted to be not crystallized but was crystallized in reality, this prediction was classified as false negative (FN). Thereafter, accuracy, sensitivity, and specificity can be computed as follows:Accuracy = (TP + TN) / (TP + FP + TN + FN) × 100Sensitivity = (TP) / (TP + FN) × 100Specificity = (TN) / (TN + FP) × 100",
      "substeps": [
        {
          "instruction": "Classify prediction as true positive (TP) if predicted crystallized and crystallized in reality.",
          "title": ""
        },
        {
          "instruction": "Classify prediction as true negative (TN) if predicted not crystallized and not crystallized in reality.",
          "title": ""
        },
        {
          "instruction": "Classify prediction as false positive (FP) if predicted crystallized but not crystallized in reality.",
          "title": ""
        },
        {
          "instruction": "Classify prediction as false negative (FN) if predicted not crystallized but crystallized in reality.",
          "title": ""
        },
        {
          "instruction": "Compute accuracy as (TP + TN) / (TP + FP + TN + FN) × 100.",
          "title": ""
        },
        {
          "instruction": "Compute sensitivity as TP / (TP + FN) × 100.",
          "title": ""
        },
        {
          "instruction": "Compute specificity as TN / (TN + FP) × 100.",
          "title": ""
        }
      ],
