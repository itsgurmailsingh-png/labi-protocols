  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Fragment carbonate sample to 2–5 mm",
      "instruction": "Weigh 100 g of carbonate rock and crush it into fragments sized between 2 mm and 5 mm, taking care not to damage microfossils.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Place fragments in labeled beakers",
      "instruction": "Transfer the crushed fragments into clean glass beakers and label each beaker clearly.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Prepare acetic acid solutions",
      "instruction": "Make six acid–water mixtures: 100 % acetic acid (0 % water), 90 % acid/10 % distilled water, 80 % acid/20 % water, 70 % acid/30 % water, 60 % acid/40 % water, and 50 % acid/50 % water. Ensure the liquid level is at least 2 cm above the sample surface in each beaker.",
      "substeps": [
        {
          "instruction": "Mix 100 % acetic acid with 0 % distilled water.",
          "title": ""
        },
        {
          "instruction": "Mix 90 % acetic acid with 10 % distilled water.",
          "title": ""
        },
        {
          "instruction": "Mix 80 % acetic acid with 20 % distilled water.",
          "title": ""
        },
        {
          "instruction": "Mix 70 % acetic acid with 30 % distilled water.",
          "title": ""
        },
        {
          "instruction": "Mix 60 % acetic acid with 40 % distilled water.",
          "title": ""
        },
        {
          "instruction": "Mix 50 % acetic acid with 50 % distilled water.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Submerge samples for prescribed durations",
      "instruction": "Add the appropriate acid solution to each beaker and let the samples sit: for 50 %–80 % acid, leave overnight (minimum 10–15 h); for 90 % acid, leave for 5 h; for 100 % acid, leave for 2 h.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Wet‑sieve disaggregated material",
      "instruction": "After the reaction time, pour each sample through a stack of stainless‑steel sieves with mesh sizes 1.00 mm, 0.50 mm, and 0.063 mm, collecting the material that passes each mesh.",
      "substeps": [
        {
          "instruction": "Sieve through 1.00 mm mesh.",
          "title": ""
        },
        {
          "instruction": "Sieve the retained fraction through 0.50 mm mesh.",
          "title": ""
        },
        {
          "instruction": "Collect the final residue that passes the 0.063 mm mesh.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Dry fine residue at 40–50 °C",
      "instruction": "Place the 0.063 mm residue on a hot plate and dry it at 40 °C–50 °C until completely dry.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Transfer residues and assess recovery",
      "instruction": "Move the dried residues to labeled small vials, then under a binocular stereo microscope sort foraminiferal specimens, weigh the >63 µm residue, and pick 300 specimens per sample for further analysis.",
      "substeps": [
        {
          "instruction": "Transfer dried residue to labeled vials.",
          "title": ""
        },
        {
          "instruction": "Sort specimens using a binocular stereo microscope.",
          "title": ""
        },
        {
          "instruction": "Weigh the residue that is larger than 63 µm.",
          "title": ""
        },
        {
          "instruction": "Pick and count 300 specimens from each sample.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Rank specimen preservation quality",
      "instruction": "Examine dissolved, partially dissolved, and undissolved specimens, count them, and assign a preservation rank from 1 (well‑preserved) to 5 (poorly preserved).",
      "substeps": [
        {
          "instruction": "Identify dissolved, partially dissolved, and undissolved specimens.",
          "title": ""
        },
        {
          "instruction": "Count each category.",
          "title": ""
        },
        {
          "instruction": "Assign a preservation rank (1‑5) based on wall condition and matrix attachment.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Photograph representative specimens",
      "instruction": "Capture images of selected specimens using a Nikon‑1500 camera attached to a microscope.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
