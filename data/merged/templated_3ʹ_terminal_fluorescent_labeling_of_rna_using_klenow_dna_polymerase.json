  "steps": [
    {
      "step_id": 0,
      "title": "Prepare DNA template (and capture oligo)",
      "instruction": "Design and synthesize a DNA template of at least 17 nucleotides complementary to the 3ʹ end of the target RNA; for highly structured RNAs (e.g., HIV RRE) also design a DNA capture oligonucleotide that binds near the terminal region to disrupt secondary structure. Use the DNA template at a concentration at least 2‑fold higher than the RNA (up to 10‑fold excess may be tested).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Anneal RNA with oligonucleotides",
      "instruction": "Mix the RNA with the DNA template (and capture oligo, if required) in Klenow reaction buffer. Heat the mixture at 65 °C for 5 minutes, then allow it to cool slowly to room temperature over 30 minutes to promote hybridization.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Add Klenow and modified nucleotide",
      "instruction": "To the annealed mixture add Klenow DNA polymerase and amino‑allyl‑dUTP (AAdUTP) as described in the preceding section of the method, then incubate under the conditions recommended for the n+1 addition (temperature and time as previously defined).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Analyze labeling by denaturing gel",
      "instruction": "Run the reaction products on a 6 % denaturing polyacrylamide gel. Stain the gel with ethidium bromide and image the RNA band using a UV transilluminator (e.g., Bio‑Rad Gel‑Doc). Subsequently image the same gel with a Cy3 filter on a fluorescence imager (e.g., Amersham Typhoon) to detect the attached cyanine dye. Overlay the two images to confirm co‑localization of RNA and fluorescence, indicating successful labeling.",
      "substeps": [
        {
          "instruction": "Prepare 6 % denaturing PAGE gel.",
          "title": ""
        },
        {
          "instruction": "Load samples and run electrophoresis.",
          "title": ""
        },
        {
          "instruction": "Stain gel with ethidium bromide.",
          "title": ""
        },
        {
          "instruction": "Capture UV image of ethidium‑stained gel.",
          "title": ""
        },
        {
          "instruction": "Capture fluorescence image using Cy3 filter.",
          "title": ""
        },
        {
          "instruction": "Overlay images to assess labeling efficiency.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Purify labeled RNA (optional)",
      "instruction": "If dye aggregates are observed, excise the correctly sized RNA band from the gel and recover the RNA by standard gel‑extraction methods to obtain pure labeled RNA.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
