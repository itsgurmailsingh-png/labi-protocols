  "steps": [
    {
      "step_id": 0,
      "title": "Install devtools package",
      "instruction": "If the devtools package is not already installed in your R environment, install it from CRAN.",
      "substeps": [
        {
          "instruction": "run install.packages(\"devtools\")",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Install PLSgrowth from GitHub",
      "instruction": "Use devtools to download and install the PLSgrowth package directly from its GitHub repository.",
      "substeps": [
        {
          "instruction": "run devtools::install_github(\"MrZMG/PLSgrowth\")",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Load PLSgrowth library",
      "instruction": "Load the newly installed PLSgrowth package into the current R session.",
      "substeps": [
        {
          "instruction": "run library(PLSgrowth)",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Define measurement model",
      "instruction": "Create a measurement‑model object (sat_mm) that specifies all reflective constructs and the higher‑order growth composite.",
      "substeps": [
        {
          "instruction": "sat_mm <- constructs(",
          "title": ""
        },
        {
          "instruction": "reflective(\"SAT1\", multi_items(\"SA1\", c(1, 3, 4))),",
          "title": ""
        },
        {
          "instruction": "reflective(\"SAT2\", multi_items(\"SA2\", c(1, 3, 4))),",
          "title": ""
        },
        {
          "instruction": "reflective(\"SAT3\", multi_items(\"SA3\", c(1, 3, 4))),",
          "title": ""
        },
        {
          "instruction": "reflective(\"PSYCO\", multi_items(\"SPWB3\", c(2, 3, 6))),",
          "title": ""
        },
        {
          "instruction": "reflective(\"SOC\",   multi_items(\"SSWB3\", c(2, 4))),",
          "title": ""
        },
        {
          "instruction": "reflective(\"Income\", single_item(\"STINC11\")),",
          "title": ""
        },
        {
          "instruction": "higher_composite(\"GROWTH\", c(\"SAT1\", \"SAT2\", \"SAT3\"))",
          "title": ""
        },
        {
          "instruction": ")",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Define structural model",
      "instruction": "Create a structural‑model object (sat_sm) that links the time‑invariant predictors to the growth composite.",
      "substeps": [
        {
          "instruction": "sat_sm <- relationships(",
          "title": ""
        },
        {
          "instruction": "paths(from = \"PSYCO\",  to = \"GROWTH\"),",
          "title": ""
        },
        {
          "instruction": "paths(from = \"Income\", to = \"GROWTH\"),",
          "title": ""
        },
        {
          "instruction": "paths(from = \"SOC\",    to = \"GROWTH\")",
          "title": ""
        },
        {
          "instruction": ")",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Estimate integrated PLS‑SEM LGCM",
      "instruction": "Run the custom pls_growth function with the data set, measurement model, structural model, and specified missing‑data handling options.",
      "substeps": [
        {
          "instruction": "sat_pls <- pls_growth(",
          "title": ""
        },
        {
          "instruction": "data = data,",
          "title": ""
        },
        {
          "instruction": "measurement_model = sat_mm,",
          "title": ""
        },
        {
          "instruction": "structural_model   = sat_sm,",
          "title": ""
        },
        {
          "instruction": "missing            = mean_replacement,",
          "title": ""
        },
        {
          "instruction": "include_tvcs       = FALSE,",
          "title": ""
        },
        {
          "instruction": "missing_value      = FALSE",
          "title": ""
        },
        {
          "instruction": ")",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Bootstrap path coefficients",
      "instruction": "Perform bootstrap resampling on the fitted model to obtain significance tests for the path coefficients, using a fixed random seed.",
      "substeps": [
        {
          "instruction": "boot <- bootstrap_model(seminr_model = sat_pls, seed = 123)",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
