  "steps": [
    {
      "step_id": 0,
      "title": "Verify housing meets welfare criteria",
      "instruction": "Ensure the monkey housing environment strictly fulfills the animal welfare criteria described in the laws or guidelines of your country.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Consult relevant animal care guidelines",
      "instruction": "Review the Guide for the Care and Use of Laboratory Animals (https://grants.nih.gov/grants/olaw/guide-for-the-care-and-use-of-laboratory-animals.pdf), the NC3Rs non‑human primate accommodation, care, and use guidelines (https://nc3rs.org.uk/non-human-primate-accommodation-care-and-use), and the Japan Neuroscience Society Guidelines for the Care and Use of Nonhuman Primates (https://www.jnss.org/en/animal_primates).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Obtain institutional animal use approval",
      "instruction": "Secure approval from your institutional animal‑experimentation committee, confirming the research plan complies with local guidelines; in this study approval was granted by the Committees for Animal Experiments at the Graduate School of Medicine, Kyoto University.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Screen monkeys for TB and measles",
      "instruction": "Because macaques are highly susceptible to tuberculosis, perform chest X‑ray examinations and/or interferon‑gamma release tests to confirm they are TB‑free, and verify that measles antibody levels are sufficiently high.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Perform B‑virus and SRV antibody checks",
      "instruction": "Test all monkeys for B‑virus and simian retrovirus (SRV) antibodies; if an animal has been housed for longer than 1 year, schedule regular health examinations that include tuberculin, dysentery, and salmonella tests.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Acclimate newly received animals",
      "instruction": "After quarantine, allow a period of acclimation for newly received monkeys before initiating experimental procedures.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Habituate monkeys to chair",
      "instruction": "Use a monkey chair for behavioral recordings and habituate each monkey to the chair, following the appropriate guidelines and selecting suitable environments and methods for your facility.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Begin experimental protocol",
      "instruction": "Once all preceding conditions are satisfied, start the experimental protocol described in the paper.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
