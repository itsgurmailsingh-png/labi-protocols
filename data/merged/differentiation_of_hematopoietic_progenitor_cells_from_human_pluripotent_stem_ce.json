  "materials": [
    "E8 medium",
    "Matrigel-coated plates",
    "differentiation medium",
    "anti-human CD34 antibody",
    "anti-human CD43 antibody",
    "anti-human CD45 antibody",
    "anti-human CD7 antibody",
    "anti-human CD5 antibody",
    "Vitronectin",
    "D-(+)-Trehalose dihydrate",
    "TrypLE select enzyme",
    "Fetal bovine serum (FBS)",
    "Penicillin-streptomycin (P/S)",
    "Corning Matrigel hESC-qualified matrix",
    "CD34 MicroBeads, human",
    "FlowJo v.10"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Thaw Essential 8 supplement",
      "instruction": "Thaw one vial (10 mL) of Essential 8 supplement at 4 °C for at least 12 hours.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare E8 medium",
      "instruction": "Add the thawed Essential 8 supplement to 500 mL of Essential 8 basal medium, aliquot the mixture into 50 mL centrifuge tubes, filter each aliquot through a 0.22 µm filter, and store the filtered E8 medium at 4 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Thaw Matrigel",
      "instruction": "Thaw one vial of Matrigel (5 mL) at 4 °C for at least 12 hours.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Make Matrigel‑E8 aliquots",
      "instruction": "Mix 5 mL of thawed Matrigel with 10 mL of pre‑chilled E8 medium, aliquot 1 mL of this mixture into pre‑chilled 1.5 mL Eppendorf tubes, and store the tubes at –20 °C (yields 15 tubes).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Coat plates with Matrigel",
      "instruction": "Place one 1 mL Matrigel‑E8 aliquot on ice, dilute it with 29 mL of pre‑chilled E8 medium, and use 1 mL of the resulting solution to coat each well of five 6‑well plates (1 mL per well). Antibiotics may be added to the E8 medium if desired.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Incubate coated plates",
      "instruction": "Incubate the Matrigel‑coated plates at +20 °C for at least 30 minutes. After incubation, plates can be used immediately or stored at 4 °C for up to one week (if stored, equilibrate to +20 °C for ≥30 min before use).",
      "substeps": [],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Equilibrate media and plates",
      "instruction": "Before use, equilibrate both the Matrigel‑coated plates and the E8 medium to +20 °C for 30 minutes.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
