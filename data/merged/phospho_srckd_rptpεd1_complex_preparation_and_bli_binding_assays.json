  "materials": [
    "complete protease inhibitor cocktail tablets",
    "Superdex 200 increase 10/300 column",
    "Superdex 75 increase 10/300 column",
    "Ni-NTA agarose",
    "Amicon ultra centrifugal filter (MWCO, 10 kDa)",
    "ATP",
    "LB medium",
    "Ni-NTA biosensor tips",
    "chitin resin",
    "6His-Src kinase domain",
    "pET9a-His-MBP-rPTPεD1 domain",
    "Escherichia Coli BL21",
    "GraphPad Prism",
    "AKTA purifier",
    "Beckman Avanti J25"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Mix phospho‑SrcKD with rPTPεD1",
      "instruction": "Combine phosphorylated SrcKD with a 0.5 M molar excess of purified rPTPεD1 and incubate for 10–30 min at 25 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Pre‑equilibrate SEC column",
      "instruction": "Equilibrate a Superdex 200 Increase 10/300 column with SEC buffer (≤50 mM NaCl) at 4 °C before chromatography.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Inject sample onto SEC",
      "instruction": "Load 500 µL of the incubation mixture onto the AKTA purifier and run the column at a flow rate of 0.5 mL min⁻¹.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Separate complex by SEC",
      "instruction": "Collect the elution profile at 4 °C; the phospho‑SrcKD:rPTPεD1 complex elutes at ~14.7 mL, whereas un‑complexed proteins elute at ~15.6 mL (≈1 mL shift).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Confirm complex formation",
      "instruction": "Validate the phospho‑SrcKD:rPTPεD1 complex using elution volume, SDS‑PAGE, and analytical ultracentrifugation (AUC).",
      "substeps": [
        {
          "instruction": "a) Verify the SEC peak appears at 14.7 mL (≈1 mL earlier than the 15.6 mL peak of individual proteins).",
          "title": ""
        },
        {
          "instruction": "b) Run SDS‑PAGE on the collected fractions; the complex should show two bands corresponding to rPTPεD1 and phospho‑SrcKD.",
          "title": ""
        },
        {
          "instruction": "c) Perform AUC; individual SrcKD and rPTPεD1 show an S20,w ≈3, while the complex mixture shows an additional peak with S20,w >4.",
          "title": ""
        },
        {
          "instruction": "d) Ensure the SEC buffer contains ≤50 mM NaCl; higher NaCl (100–150 mM) causes dissociation of the complex.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
