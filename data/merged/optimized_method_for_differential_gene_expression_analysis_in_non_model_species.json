  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Combine raw read files",
      "instruction": "Concatenate all cleaned forward reads into a single file named all_R1.fastq and all cleaned reverse reads into all_R2.fastq.",
      "substeps": [
        {
          "instruction": "cat clean*_R1.fastq > all_R1.fastq",
          "title": ""
        },
        {
          "instruction": "cat clean*_R2.fastq > all_R2.fastq",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "De novo transcriptome assembly with Trinity",
      "instruction": "Run Trinity (Docker version recommended) on the combined read files using fastq input, full cleanup, and output the assembly as Trinity_reference.",
      "substeps": [
        {
          "instruction": "Trinity --seqType fq --left all_R1.fastq --right all_R2.fastq --full_cleanup --output Trinity_reference",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Build Bowtie2 index for the assembly",
      "instruction": "Create a Bowtie2 index from the Trinity assembly FASTA file.",
      "substeps": [
        {
          "instruction": "bowtie2-build Trinity_reference.fasta out_bowtie2_index",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Align reads to the assembly with Bowtie2",
      "instruction": "Map the combined forward and reverse reads to the Bowtie2 index using sensitive local mode, saving the SAM output and logging the run.",
      "substeps": [
        {
          "instruction": "bowtie2 -x out_bowtie2_index -1 all_R1.fastq -2 all_R2.fastq --sensitive --local -S out.sam 2>&1 | tee result_bowtie2.log",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Assess assembly quality with BUSCO",
      "instruction": "If Bowtie2 alignment rate is ≥70 %, run BUSCO in transcriptome mode using the embryophyta lineage; interpret BUSCO results, noting that homology values >80 % indicate good assembly quality.",
      "substeps": [
        {
          "instruction": "busco -m transcriptome -l embryophyta -i Trinity_reference.fasta -o output_busco",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
