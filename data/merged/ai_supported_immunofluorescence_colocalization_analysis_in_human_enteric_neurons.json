  "steps": [
    {
      "step_id": 0,
      "title": "Create water‑repellent barrier",
      "instruction": "Draw a water‑repellent barrier around each tissue section on the microscope slide using an ImmEdge Pen.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Wash tissues to remove OCT",
      "instruction": "Wash the sections with cold phosphate‑buffered saline (PBS) for 5 minutes to dissolve the OCT compound.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Permeabilize tissues with Triton X‑100",
      "instruction": "Incubate the sections in 0.25 % Triton X‑100 prepared in PBS for 50 minutes at room temperature (21–23 °C).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Block non‑specific binding",
      "instruction": "Incubate the sections with 10 % normal donkey serum in PBS for 1 hour at room temperature (21–23 °C) to block non‑specific staining.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Incubate primary antibodies",
      "instruction": "Prepare a solution of primary antibodies in cold 5 % donkey serum containing 0.5 % Triton X‑100: hypoxia‑inducible factor‑1α (HIF1A) at 1.66 µg mL⁻¹ (1:300) and nitric oxide synthase‑1 (NOS1) at 0.66 µg mL⁻¹ (1:300). Apply to the sections and incubate for 12 hours at 4 °C. (Donkey serum can be stored at 4 °C for ≥3 months; prepare fresh 5 % solution each time.)",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Wash after primary incubation",
      "instruction": "Remove the primary‑antibody solution by suction and wash the sections with PBS for 15 minutes at room temperature (21–23 °C).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Incubate secondary antibodies",
      "instruction": "Prepare secondary‑antibody solution in cold 5 % donkey serum containing 0.5 % Triton X‑100: Alexa Fluor 647 anti‑rabbit IgG and Alexa Fluor 488 anti‑mouse IgG, each at 4.44 µg mL⁻¹ (1:450). Incubate the sections for 1 hour at room temperature (21–23 °C).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Wash after secondary incubation",
      "instruction": "Gently aspirate the secondary‑antibody solution and wash the sections with PBS for 15 minutes at room temperature (21–23 °C).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Stain nuclei with DAPI",
      "instruction": "Incubate the sections with DAPI at a 1:300 dilution for 1 hour at room temperature (21–23 °C). (Neurons may require the full hour for adequate nuclear staining.)",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Rinse sections with ultrapure water",
      "instruction": "Rinse each section once with ultrapure water to remove residual salts.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Mount sections with antifade medium",
      "instruction": "Mount the sections using VECTASHIELD HardSet Antifade Mounting Medium.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 11,
      "title": "Seal coverslip with nail polish",
      "instruction": "Seal the coverslip in place with non‑fluorescent lacquer nail polish.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 12,
      "title": "Segment and quantify fluorescence in NIS‑Elements",
      "instruction": "Using Nikon NIS‑Elements, load the confocal image stack and: adjust frame brightness and contrast; perform background subtraction; run a GA3 workflow to segment enteric neurons; extract the volume of NOS1‑positive neurons and the summed fluorescence intensity of HIF1A puncta.",
      "substeps": [
        {
          "instruction": "Adjust image brightness and contrast",
          "title": ""
        },
        {
          "instruction": "Perform background subtraction",
          "title": ""
        },
        {
          "instruction": "Run GA3 workflow to segment neurons",
          "title": ""
        },
        {
          "instruction": "Extract NOS1+ neuron volume and HIF1A puncta intensity",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
