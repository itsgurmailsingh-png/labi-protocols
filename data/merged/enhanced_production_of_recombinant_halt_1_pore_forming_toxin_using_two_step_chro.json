  "steps": [
    {
      "step_id": 0,
      "title": "Prepare 5x Native Purification Buffer",
      "instruction": "Prepare 200 mL of 5x Native Purification Buffer (pH 8.0) containing 100 mM Sodium Phosphate Monobasic, Sodium Phosphate Dibasic, and 1.5 M Sodium Chloride.",
      "substeps": [
        {
          "instruction": "Add 1.36 mL of 1 M Sodium Phosphate Monobasic (NaH2PO4), 18.64 mL of 1 M Sodium Phosphate Dibasic (Na2HPO4), and 17.53 g of Sodium Chloride to 80 mL of MilliQ water.",
          "title": ""
        },
        {
          "instruction": "Adjust the pH to 8.0 using NaOH or HCl.",
          "title": ""
        },
        {
          "instruction": "Top up the volume to 200 mL with MilliQ water.",
          "title": ""
        },
        {
          "instruction": "Autoclave the buffer and store at room temperature.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Purify rHALT-1 via Chromatography",
      "instruction": "Perform a two-step purification of rHALT-1 using affinity chromatography followed by ion-exchange chromatography.",
      "substeps": [
        {
          "instruction": "Use a Peristaltic Pump P-1 (Cytiva, USA) to maintain a constant flow rate of 1.5 mL/min through the columns.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
