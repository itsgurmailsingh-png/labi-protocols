  "steps": [
    {
      "step_id": 0,
      "title": "Organize raw data",
      "instruction": "Sort the recorded fEPSP files by recording channel and by stimulus intensity, creating separate folders or data structures for each combination.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Mark evoked response points",
      "instruction": "Using the provided MATLAB GUI, manually select the start (baseline) and the peak of each evoked fEPSP waveform.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Calculate slope and amplitude",
      "instruction": "For each marked trace, compute the amplitude as the voltage difference between baseline and peak, and compute the slope between 20 % and 90 % of the peak amplitude.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Visualize analysis results",
      "instruction": "Generate plots of the calculated amplitudes and slopes across stimuli and channels using the MATLAB visualization tools.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Statistical comparison of groups",
      "instruction": "Analyze the compiled amplitude and slope data with a two‑way ANOVA followed by Sidak’s multiple‑comparisons test; report significance at p < 0.05 and display error bars as SEM.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
