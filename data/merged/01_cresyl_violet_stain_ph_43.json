  "steps": [
    {
      "step_id": 0,
      "title": "Prepare Water",
      "instruction": "Measure and pour 500 mL of water into a glass beaker.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Aliquot Cresyl Violet Acetate",
      "instruction": "Aliquot 0.5 g of cresyl violet acetate into the glass beaker.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Dissolve Cresyl Violet",
      "instruction": "Stir the mixture of H2O and cresyl violet acetate at 100 °C until cresyl violet is dissolved. Allow the solution to come to room temperature.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Adjust pH",
      "instruction": "Test the pH of the solution and add glacial acetic acid dropwise until the desired pH 4.3 is achieved.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Filter Cresyl Violet Solution",
      "instruction": "Pour the contents of the 0.1% Cresyl Violet solution through a sterile membrane filter into a light sensitive jar and close the lid.",
      "substeps": [],
      "is_critical": false,
