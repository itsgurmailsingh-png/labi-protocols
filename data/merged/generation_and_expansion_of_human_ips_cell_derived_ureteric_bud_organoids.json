  "steps": [
    {
      "step_id": 0,
      "title": "Detach hiPSCs with EDTA/PBS",
      "instruction": "Treat adherent hiPSC cultures with EDTA/PBS, watching under a brightfield microscope, and stop the incubation when cells show clearly defined bright edges (typically ≤5 min).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Plate hiPSCs at pre‑differentiation density",
      "instruction": "Count the detached cells and seed them at 2.5 × 10⁴ cells cm⁻² into two wells of a 4‑well culture plate (or equivalent wells of a 24‑well plate). Add 500 µL Stem Fit AK02N medium per well containing 10 µM Y‑27632 (ROCK inhibitor) and 0.125 µg cm⁻² iMatrix‑511 silk. Aim for 30–40 % confluency during pre‑differentiation; both confluency and initial colony size must be considered to avoid spontaneous differentiation.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Incubate pre‑differentiation culture",
      "instruction": "Place the plate in a humidified incubator set to 37 °C with 5 % CO₂ and culture for 24 h.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
