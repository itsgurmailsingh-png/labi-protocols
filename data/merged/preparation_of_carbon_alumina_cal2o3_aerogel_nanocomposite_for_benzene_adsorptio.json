  "steps": [
    {
      "step_id": 0,
      "title": "Prepare Novolac sol (Sol A)",
      "instruction": "Dissolve 15 g Novolac resin in 85 mL 2‑propanol, then sonicate at 20 kHz for 30 min at room temperature.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare Al2O3 sol (Sol B)",
      "instruction": "Mix 24.1 g aluminum chloride hexahydrate, 81 g deionized water, 41.4 g absolute ethyl alcohol, and 58 g propylene oxide until homogeneous.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Combine sols and ultrasonicate",
      "instruction": "Mix Sol A and Sol B thoroughly, maintain a Novolac : Al2O3 molar ratio of 4 : 1, and expose the mixture to ultrasound for 30 min.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Transfer mixture to Falcon tube",
      "instruction": "Pour the uniform solution into a Falcon tube, ensuring an interlayer distance of 3 cm.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Autoclave treatment",
      "instruction": "Place the tube inside a high‑pressure autoclave containing a low amount of 2‑propanol, heat at 105 °C for 5 h, then cool to room temperature.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Dry and dessicate gel",
      "instruction": "Dry the resulting gel at ambient temperature for 48 h, then dessicate at 120 °C for an additional 48 h.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "First carbonization and granulation",
      "instruction": "Carbonize the aerogel nanocomposite at 500 °C for 2 h under nitrogen flow of 10 mL min⁻¹; afterwards grind and sieve the material to 20–40 mesh.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Second carbonization (conversion to C/Al2O3)",
      "instruction": "Heat the granulated N/Al2O3 composite aerogel at 1000 °C for 3 h under nitrogen flow of 10 mL min⁻¹ to obtain the C/Al2O3 aerogel nanocomposite.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
