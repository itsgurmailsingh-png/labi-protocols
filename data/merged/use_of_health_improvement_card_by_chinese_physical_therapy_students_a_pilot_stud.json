      "title": "Recruit Participants",
      "instruction": "Recruit physical therapy students from two universities in Shanghai, China.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Collect Initial Health Data",
      "instruction": "Have students complete the 2-page Chinese version of the Health Improvement Card (HIC) and record physical measurements.",
      "substeps": [
        {
          "instruction": "Collect self-reported height and weight.",
          "title": ""
        },
        {
          "instruction": "Measure waist circumference and blood pressure.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Assess Initial Perceptions",
      "instruction": "Administer a questionnaire regarding the perceptions of the use and usefulness of the HIC.",
      "substeps": [
        {
          "instruction": "Have students rate 7 statements using a 4-point Likert scale.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Practice HIC Administration",
      "instruction": "Have students act as health professionals by administering the HIC to a friend or relative.",
      "substeps": [
        {
          "instruction": "Invite a friend or relative to complete the HIC.",
          "title": ""
        },
        {
          "instruction": "Return completed HICs to the investigators within one week.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Collect Feedback on Administration",
      "instruction": "Administer a second questionnaire to obtain feedback on the experience of administering the HIC.",
      "substeps": [
        {
          "instruction": "Have students answer three open-ended questions regarding positive aspects and challenges encountered during the process.",
          "title": ""
        }
      ],
