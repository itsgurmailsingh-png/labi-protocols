  "estimated_time_mins": 72,
  "materials": [
    "MATLAB R2022a or newer",
    "MATLAB files for simulation",
    "Timing: 2–5 min",
    "Timing: 10–20 min"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Launch MorphoGrad configuration GUI",
      "instruction": "Start MATLAB and launch the MorphoGrad graphical user interface by executing the command morphograd.gui.ConfigBuilder(). This configuration step typically takes 2–5 min.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Select simulation dimensionality",
      "instruction": "In the Setup tab of the GUI, choose whether the simulation will be one‑dimensional or two‑dimensional.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Define domain geometry and cell size",
      "instruction": "Open the Domain tab. • For 1D simulations: enter the total domain length L and the start and end positions of the source region; the remaining length becomes the patterning domain. • For 2D simulations: additionally specify the tissue width in the y‑direction and provide distinct cell diameters for the x‑ and y‑directions. The source may be placed at any x‑position but must fully span the y‑direction. Ensure that the patterning length, source length, and (in 2D) tissue width are integer multiples of the chosen cell diameters so the domain can be discretized into whole cells. This step also takes roughly 2–5 min.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Choose or define reaction equation",
      "instruction": "Open the Equation tab. Select a preset equation or enter a custom reaction term. Preset options: a) Linear decay with production: DΔC + p H(x) – d C = 0. b) Nonlinear decay with production: DΔC + p H(x) – d C^n = 0, where n > 1. If no preset matches, type a valid MATLAB expression for the reaction term R(C,x,y;params) following the syntax rules below. Setting up the equations usually requires 10–20 min.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Enter custom reaction syntax",
      "instruction": "When defining a custom term: • Use variables C, x, y (or C(x), C(x,y)). • Multiply source‑only terms by the Heaviside function H. • Vectorize the expression with element‑wise operators (.*, ./, .^). • Allowed MATLAB functions include sqrt, exp, log, log10, sin, cosh. • Do not use reserved identifiers C, x, y, D, α, n, H, or C_ref as parameter names. • For highly nonlinear equations (n ≫ 1), provide an appropriate initial guess or increase the solver error tolerance.",
      "substeps": [],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Run stochastic gradient ensemble",
      "instruction": "Execute the simulation to generate an ensemble of independent stochastic gradient realizations (using the GUI run button or appropriate command). Each cell’s parameters are sampled from log‑normal distributions as defined in the toolbox settings.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Compute positional error and statistics",
      "instruction": "For each realization, determine the readout position where the morphogen concentration crosses a chosen threshold Cθ. Collect all readout positions across the ensemble and calculate the positional error as the standard deviation σx = std(xθ,i). Optionally compute additional summary statistics such as mean readout position, coefficient of variation, and standard error.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
