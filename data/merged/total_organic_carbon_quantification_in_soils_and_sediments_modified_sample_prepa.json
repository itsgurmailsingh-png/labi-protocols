  "steps": [
    {
      "step_id": 0,
      "title": "Weigh sample into vial",
      "instruction": "Weigh the required amount of soil or sediment sample directly into a 40 mL glass vial.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Add 1 N HCl",
      "instruction": "Add 5 mL of 1 N HCl to the vial to acidify the sample.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Swivel and heat",
      "instruction": "Swivel the vial, place it in an IKA dry‑block heater set to 60 °C and incubate for 60 min, swiveling again after 30 min and at the end of the hour. The 5 mL 1 N HCl corresponds to ≈0.18 g concentrated HCl, which can dissolve ≈240 mg CaCO₃ and ≈220 mg CaMg[CO₃]₂ for the chosen sample weights.",
      "substeps": [
        {
          "instruction": "Swivel vial at start of incubation",
          "title": ""
        },
        {
          "instruction": "Heat at 60 °C for 60 min",
          "title": ""
        },
        {
          "instruction": "Swivel after 30 min",
          "title": ""
        },
        {
          "instruction": "Swivel after 60 min (end of incubation)",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Add ultrapure water",
      "instruction": "After the acid treatment, add 25 mL ultrapure water (conductivity ≤ 0.055 µS cm⁻¹) to each vial.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Add magnetic stir bar",
      "instruction": "Insert a magnetic stir bar into each vial and stir to obtain a homogeneous suspension for subsequent sample uptake.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
