  "steps": [
    {
      "step_id": 0,
      "title": "Merge lane BAM files (optional)",
      "instruction": "If sequencing data are split across multiple lanes, merge the corresponding BAM files into a single BAM per sample using samtools merge or an equivalent tool; this step is optional and was not required for the dataset used in this protocol.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Name‑sort and fix‑mate paired‑end reads",
      "instruction": "For each *.uns file in $HOME_PATH/bam, sort reads by name with samtools sort -n using 16 threads and 4 GB memory, then fix mate information with samtools fixmate -m, producing a *_fixmate.bam file.",
      "substeps": [
        {
          "instruction": "Set BAM_PATH=$HOME_PATH/bam and CORES=16.",
          "title": ""
        },
        {
          "instruction": "Loop over each $BAM_PATH/*.uns file.",
          "title": ""
        },
        {
          "instruction": "Extract SAMPLE name from the filename (remove the .uns extension).",
          "title": ""
        },
        {
          "instruction": "Echo \"Processing $SAMPLE\" for logging.",
          "title": ""
        },
        {
          "instruction": "Run: $SAMTOOLS_PATH/samtools sort -n -@ $CORES -m 4G $BAM_PATH/${SAMPLE}.uns | $SAMTOOLS_PATH/samtools fixmate -m - $BAM_PATH/${SAMPLE}_fixmate.bam.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Coordinate‑sort and mark duplicates",
      "instruction": "For each *_fixmate.bam file, sort reads by genomic coordinates with samtools sort, mark duplicate reads with samtools markdup, and index the final *.bam file.",
      "substeps": [
        {
          "instruction": "Set BAM_PATH=$HOME_PATH/bam and CORES=16.",
          "title": ""
        },
        {
          "instruction": "Loop over each $BAM_PATH/*_fixmate.bam file.",
          "title": ""
        },
        {
          "instruction": "Extract SAMPLE name from the filename (remove the _fixmate.bam suffix).",
          "title": ""
        },
        {
          "instruction": "Echo \"Processing $SAMPLE\" for logging.",
          "title": ""
        },
        {
          "instruction": "Run: $SAMTOOLS_PATH/samtools sort -@ $CORES -m 4G $BAM_PATH/${SAMPLE}_fixmate.bam | $SAMTOOLS_PATH/samtools markdup - $BAM_PATH/${SAMPLE}.bam.",
          "title": ""
        },
        {
          "instruction": "Index the final BAM: $SAMTOOLS_PATH/samtools index $BAM_PATH/${SAMPLE}.bam.",
          "title": ""
        }
      ],
      "is_critical": false,
