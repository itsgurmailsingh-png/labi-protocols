  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Design sensor node schematic",
      "instruction": "Create the sensor‑node schematic in Fritzing using a Node MCU (ESP32) powered by a battery; include TX, RX and GPIO pins and colour‑code connections for easy breadboard layout.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Assemble sensor node hardware",
      "instruction": "Place the components from the schematic on a breadboard (or miniaturise on a PCB) according to the colour‑coded pins, connect the battery, and verify all connections.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Design sink node schematic",
      "instruction": "Create the sink‑node schematic in Fritzing (unlimited power supply) with the same ESP32 module, TX/RX pins and a Secure Digital (SD) card interface for data logging.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Assemble sink node hardware",
      "instruction": "Build the sink node on a breadboard or PCB following the schematic, connect it to a stable power source, and attach the SD‑card module.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Program nodes with Arduino IDE",
      "instruction": "Open the Arduino IDE, select the COM3 port, upload firmware that reads RSSI values from the ESP32 radio and writes the readings to the SD card on the sink node.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Measure RSSI versus distance",
      "instruction": "Place the sensor node and sink node at a chosen distance d (starting with no obstacles) and record the RSSI value; repeat for increasing distances up to 300 m and optionally with obstacles, logging each measurement on the SD card.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Prepare MATLAB simulation parameters",
      "instruction": "In MATLAB, set the AI‑DRM simulation parameters as follows: 110 sensor nodes, packet size 1024 bits, simulation area 100 × 100 m², communication range 30 m, sink coordinators 50 and 120, traffic pattern CBR, and run for 2000 rounds.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Execute Dynamic Radio Power Consumption Algorithm",
      "instruction": "For each transmission event, apply Algorithm 1:",
      "substeps": [
        {
          "instruction": "1. Calculate the Euclidean distance d between the transmitting sensor and its neighbour.",
          "title": ""
        },
        {
          "instruction": "2. If d ≤ Max_Tx_Range, compute PTX using the Free‑Space Path model.",
          "title": ""
        },
        {
          "instruction": "3. If PTX ≤ Max_PTX and PTX ≥ Min_PTX, accept PTX as the transmission power; otherwise, declare the destination out of range.",
          "title": ""
        },
        {
          "instruction": "4. Compute sensor‑node energy consumption:",
          "title": ""
        },
        {
          "instruction": "• total_energy_consumption = 0",
          "title": ""
        },
        {
          "instruction": "• idle_energy = IdlePower × IdleTime; add to total",
          "title": ""
        },
        {
          "instruction": "• sensing_energy = SensingPower × SensingTime; add to total",
          "title": ""
        },
        {
          "instruction": "• PTX_energy = PTX_power × PTX_time; add to total",
          "title": ""
        },
        {
          "instruction": "• PRX_energy = PTX_power × PRX_time; add to total",
          "title": ""
        },
        {
          "instruction": "• total_energy_consumption += data_size × 0.01",
          "title": ""
        },
        {
          "instruction": "5. Accumulate WSN‑wide energy:",
          "title": ""
        },
        {
          "instruction": "• WSN_total_energy_consumption = Σ total_energy_consumption[i] for all nodes i",
          "title": ""
        },
        {
          "instruction": "• Multiply by rerouting factor 1.2 and overhead factor 0.5 as needed:",
          "title": ""
        },
        {
          "instruction": "◦ WSN_total_energy_consumption ×= WSN.rerouting_factor (1.2)",
          "title": ""
        },
        {
          "instruction": "◦ WSN_total_energy_consumption ×= WSN.overhead_energy (0.5)",
          "title": ""
        },
        {
          "instruction": "6. End the algorithm for the current round.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Collect and analyse simulation results",
      "instruction": "After completing 2000 rounds, extract from MATLAB the number of alive nodes, cluster‑head (CH) formations, residual energy percentages, throughput and packet‑drop ratios; compare these metrics with the ARORA and EACHS‑B2SPNN protocols as shown in the article figures.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
