  "steps": [
    {
      "step_id": 0,
      "title": "Manipulate tin capsules with miau redux",
      "instruction": "Use the miau redux autosampler to open, position, and close tin capsules for each sample, performing only the capsule‑manipulation task while leaving powder handling to the analyst.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Transfer powder manually",
      "instruction": "Manually transfer the sample powder into the opened tin capsule using appropriate tools (e.g., spatula, antistatic device), because the automated system does not perform powder transfer.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Weigh appropriate sample mass",
      "instruction": "Place the capsule on the microbalance and weigh the sample to the target amount: about 1 mg for animal tissues, feathers, and some precipitates; ≥50 mg for sandy sediments; larger amounts (e.g., whole‑filter mass) for filter samples, adjusting as needed for the material type (plant/animal tissue, mud, sand, rock, filter, precipitate).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
