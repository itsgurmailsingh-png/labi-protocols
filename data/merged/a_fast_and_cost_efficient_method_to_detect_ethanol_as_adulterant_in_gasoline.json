  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare potassium dichromate solution",
      "instruction": "In a fume cupboard, place the solid potassium (Kr2Cr2O7) (referred to as potassium dichloromethane in the text) into a beaker, add 900 ml of water, and stir with a spatula until fully dissolved.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Add sulfuric acid to solution",
      "instruction": "Add an equimolar amount of 1 mol sulfuric acid to the potassium dichromate solution and stir until the mixture is homogeneous.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Cut filter paper to size",
      "instruction": "Cut filter paper into the desired shape and size for strips; the quantity used is optional.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Soak paper strips in indicator solution",
      "instruction": "Immerse the cut paper strips in the potassium dichromate–sulfuric acid solution and let them soak for about 1 hour to allow adequate absorption.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Retrieve and dry indicator paper",
      "instruction": "After the 1‑hour soak, carefully remove the strips with a spatula to avoid tearing, then air‑dry them, ensuring the drying time does not exceed 24 hours.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Test indicator paper with ethanol‑adulterated fuel",
      "instruction": "Dip a dried indicator strip into fuel suspected of containing ethanol; observe any colour change on the strip, which indicates the presence of ethanol.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
