  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Clean quartz tube",
      "instruction": "Obtain a quartz tube from a toaster‑oven heating unit, remove the internal cable and plastic cap, place the tube in an ultrasonic cleaner filled with water to one‑quarter of the cleaner’s volume, optionally add a cleaning agent and repeat the cleaning cycle as needed, then dry the tube completely.",
      "substeps": [
        {
          "instruction": "Remove tube from heating unit.",
          "title": ""
        },
        {
          "instruction": "Take out cable and plastic cap.",
          "title": ""
        },
        {
          "instruction": "Fill ultrasonic cleaner with water to ¼ of its total volume.",
          "title": ""
        },
        {
          "instruction": "Immerse tube; add cleaning agent if desired.",
          "title": ""
        },
        {
          "instruction": "Run ultrasonic cleaning; repeat if necessary.",
          "title": ""
        },
        {
          "instruction": "Dry the tube thoroughly.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Seal one tube end",
      "instruction": "Using a blowtorch, seal one end of the cleaned and dried quartz tube.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Weigh and load powders",
      "instruction": "Measure the required mass of each powder with a digital weighing scale, then place the powders into the open end of the tube that already has one end sealed; for composite materials adjust the ratio according to stoichiometry (e.g., 17.5 mg Ag mixed with 17.5 mg TiO₂).",
      "substeps": [
        {
          "instruction": "Weigh each component on a digital scale.",
          "title": ""
        },
        {
          "instruction": "Load the powders into the open end of the sealed‑one‑end tube.",
          "title": ""
        },
        {
          "instruction": "Adjust component ratios as needed for stoichiometric calculations (example: 17.5 mg Ag + 17.5 mg TiO₂).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
