      "title": "Prepare Vitamin Solution",
      "instruction": "Dissolve the specified vitamins in distilled water (dH2O) to create a vitamin supplement solution.",
      "substeps": [
        {
          "instruction": "Measure <100 mL dH2O into a bottle.",
          "title": ""
        },
        {
          "instruction": "Add 2 mg biotin.",
          "title": ""
        },
        {
          "instruction": "Add 2 mg folic acid.",
          "title": ""
        },
        {
          "instruction": "Add 10 mg pyridoxine-HCl.",
          "title": ""
        },
        {
          "instruction": "Add 5 mg riboflavin.",
          "title": ""
        },
        {
          "instruction": "Add 5 mg thiamine.",
          "title": ""
        },
        {
          "instruction": "Add 5 mg nicotinic acid.",
          "title": ""
        },
        {
          "instruction": "Add 5 mg pantothenic acid.",
          "title": ""
        },
        {
          "instruction": "Add 0.1 mg cyanocobalamin.",
          "title": ""
        },
        {
          "instruction": "Add 5 mg p-aminobenzoic acid.",
          "title": ""
        }
