      "step_id": 0,
      "title": "Process blood tubes",
      "instruction": "Centrifuge blood tubes using the laboratory’s standard centrifugation protocol and aliquot the resulting plasma into appropriate containers.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare standard curve plate",
      "instruction": "Set up a 96‑well plate containing the indocyanine green (ICG) standard series according to the detailed concentrations provided in the protocol.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Measure ICG absorbance",
      "instruction": "Using a standard plate reader, measure the absorbance of each well at 805 nm (the ICG wavelength).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Plot concentration curves",
      "instruction": "Generate both the standard calibration curve and the plasma ICG decay curve from the absorbance data.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Extrapolate plasma volume",
      "instruction": "Extend the plasma decay curve to determine the plasma ICG concentration at time zero and calculate plasma volume from this extrapolated value.",
      "substeps": [],
      "is_critical": false,
