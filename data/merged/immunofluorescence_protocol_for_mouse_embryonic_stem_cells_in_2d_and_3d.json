  "materials": [
    "Rat monoclonal alpha tubulin antibody",
    "Rabbit polyclonal NuMa antibody",
    "AlexaFluor 488 donkey anti-rabbit",
    "AlexaFluor 647 donkey anti-rat",
    "Gelatin from porcine skin",
    "Laminin",
    "Accutase™",
    "6% formaldehyde solution",
    "Dulbecco’s phosphate buffered saline (DPBS)",
    "Bovine serum albumin (BSA)",
    "Trichloroacetic acid (TCA)",
