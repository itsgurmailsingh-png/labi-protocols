  "steps": [
    {
      "step_id": 0,
      "title": "Prepare cell culture media",
      "instruction": "Prepare the appropriate medium for the cells: for naïve mESC use 2i/LIF medium containing two inhibitors (Erk1/2 and GSK3) plus Leukemia Inhibitory Factor; for cells exiting naïve pluripotency use N2B27 medium as described in the Smith lab protocol.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Select plating substrate",
      "instruction": "Choose the coating for the culture dish: option 1 – gelatin (maintains 3‑D colony organization but is harder to image); option 2 – laminin (supports 2‑D growth and easier imaging).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Plate cells and culture",
      "instruction": "Plate the mouse embryonic stem cells on the chosen substrate and culture for 48 h (scale linearly for 24 h, 36 h, 72 h, or 96 h; do not exceed 96 h).",
      "substeps": [],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Choose staining variant",
      "instruction": "Decide which staining workflow to follow: standard protocol for most proteins (e.g., α‑Tubulin and actin with Phalloidin) or cortical‑protein variant for targets such as NuMA (e.g., α‑Tubulin and NuMA).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Prepare N2 supplement",
      "instruction": "Combine the following reagents to make 104.2 mL of N2 supplement: 1 g apotransferrin (final 8.79 mg/mL), 10 mL water, 92.5 mL DMEM/Ham's F‑12, 10 mL BSA (0.66 % w/v), 120 µL sodium selinate solution (3 µM), 1,200 µL putrescine solution (1.688 mg/mL), and 390 µL progesterone solution (2.08 µg/mL). Store the completed N2 at –80 °C for up to 2 years.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
