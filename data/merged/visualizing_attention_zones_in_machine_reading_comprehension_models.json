  "steps": [
    {
      "step_id": 0,
      "title": "Clone source code repository",
      "instruction": "Download the MRC analysis code by cloning the GitHub repository.",
      "substeps": [
        {
          "instruction": "Run: `git clone https://github.com/ymcui/mrc-model-analysis`",
          "title": ""
        },
        {
          "instruction": "Change directory into the cloned folder: `cd mrc-model-analysis`",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare SQuAD dataset",
      "instruction": "Download the SQuAD v1.1 training and development JSON files and organize them in a new folder.",
      "substeps": [
        {
          "instruction": "Create a folder for the data: `mkdir squad`",
          "title": ""
        },
        {
          "instruction": "Download the training set: `wget https://rajpurkar.github.io/SQuAD-explorer/dataset/train-v1.1.json`",
          "title": ""
        },
        {
          "instruction": "Download the development set: `wget https://rajpurkar.github.io/SQuAD-explorer/dataset/dev-v1.1.json`",
          "title": ""
        },
        {
          "instruction": "Move both JSON files into the new folder: `mv train-v1.1.json dev-v1.1.json squad/`",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Download and unzip BERT model",
      "instruction": "Obtain the English BERT‑base‑cased pretrained model (~400 MB), unzip it, and note its contents.",
      "substeps": [
        {
          "instruction": "Download the zip archive: `wget https://storage.googleapis.com/bert_models/2018_10_18/cased_L-12_H-768_A-12.zip` (requires ~400 MB disk space)",
          "title": ""
        },
        {
          "instruction": "Unzip the archive: `unzip cased_L-12_H-768_A-12.zip`",
          "title": ""
        },
        {
          "instruction": "The resulting directory `cased_L-12_H-768_A-12/` contains:",
          "title": ""
        },
        {
          "instruction": "- `bert_model.ckpt.meta`",
          "title": ""
        },
        {
          "instruction": "- `bert_model.ckpt.index`",
          "title": ""
        },
        {
          "instruction": "- `bert_model.ckpt.data-00000-of-00001`",
          "title": ""
        },
        {
          "instruction": "- `vocab.txt`",
          "title": ""
        },
        {
          "instruction": "- `bert_config.json`",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Copy model files to Cloud Storage (TPU only)",
      "instruction": "If using TPU, upload the BERT model files to a Google Cloud Storage bucket; otherwise skip this step.",
      "substeps": [
        {
          "instruction": "Run: `gsutil -m cp cased_L-12_H-768_A-12/* gs://temp-bucket/bert`",
          "title": ""
        },
        {
          "instruction": "Note: The bucket path `gs://temp-bucket` is used for illustration; replace with your own bucket as needed.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
