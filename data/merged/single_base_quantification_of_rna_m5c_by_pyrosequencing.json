  "steps": [
    {
      "step_id": 0,
      "title": "Shock‑freeze and lyse cells",
      "instruction": "Prepare cell lysate for RNA extraction.",
      "substeps": [
        {
          "instruction": "Shock‑freeze the plate in liquid nitrogen for 1–2 min.",
          "title": ""
        },
        {
          "instruction": "Place the plate on ice.",
          "title": ""
        },
        {
          "instruction": "Add 350 µL QIAzol per well and collect lysate.",
          "title": ""
        },
        {
          "instruction": "Transfer lysates into two 1.5 mL tubes and mix by pipetting.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Shear lysate with QIAshredder",
      "instruction": "Pass lysate through QIAshredder and spin.",
      "substeps": [
        {
          "instruction": "Load lysates onto a QIAshredder spin column.",
          "title": ""
        },
        {
          "instruction": "Centrifuge for 2 min at >10,000 rpm (full speed) at room temperature.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Incubate lysate",
      "instruction": "Let lysate sit before phase separation.",
      "substeps": [
        {
          "instruction": "Incubate on bench top for 3–5 min at room temperature.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Add chloroform and mix",
      "instruction": "Introduce chloroform to separate phases.",
      "substeps": [
        {
          "instruction": "Add 70 µL chloroform, close tube, shake for 15 s.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Incubate after chloroform",
      "instruction": "Allow phases to separate.",
      "substeps": [
        {
          "instruction": "Incubate 2–3 min at room temperature on bench top.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Centrifuge for phase separation",
      "instruction": "Pellet aqueous and organic phases.",
      "substeps": [
        {
          "instruction": "Centrifuge at 12,000 g for 30 min at 4 °C.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Collect aqueous phase",
      "instruction": "Recover RNA‑containing layer.",
      "substeps": [
        {
          "instruction": "Transfer ~200 µL aqueous phase to a new tube.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Precipitate RNA with ethanol",
      "instruction": "Add ethanol to aqueous phase.",
      "substeps": [
        {
          "instruction": "Add 1 volume (~200 µL) 70 % ethanol.",
          "title": ""
        },
        {
          "instruction": "Mix by pipetting.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Load sample onto RNeasy column",
      "instruction": "Bind RNA to silica membrane.",
      "substeps": [
        {
          "instruction": "Transfer up to 700 µL of the mixture onto an RNeasy spin column.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Bind RNA to column",
      "instruction": "Centrifuge to retain RNA on membrane.",
      "substeps": [
        {
          "instruction": "Centrifuge 15 s at >8,000 g (>10,000 rpm).",
          "title": ""
        },
        {
          "instruction": "Discard flow‑through; keep column in collection tube.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Wash column with RW1",
      "instruction": "Remove contaminants with Buffer RW1.",
      "substeps": [
        {
          "instruction": "Add 700 µL Buffer RW1.",
          "title": ""
        },
        {
          "instruction": "Centrifuge 15 s at >8,000 g (>10,000 rpm).",
          "title": ""
        },
        {
          "instruction": "Discard flow‑through; keep column.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 11,
      "title": "First RPE wash",
      "instruction": "Wash column with Buffer RPE.",
      "substeps": [
        {
          "instruction": "Add 500 µL Buffer RPE.",
          "title": ""
        },
        {
          "instruction": "Centrifuge 15 s at >8,000 g (>10,000 rpm).",
          "title": ""
        },
        {
          "instruction": "Discard flow‑through.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 12,
      "title": "Second RPE wash",
      "instruction": "Repeat RPE wash for thorough cleaning.",
      "substeps": [
        {
          "instruction": "Add 500 µL Buffer RPE.",
          "title": ""
        },
        {
          "instruction": "Centrifuge 2 min at >8,000 g (>10,000 rpm).",
          "title": ""
        },
        {
          "instruction": "Discard flow‑through.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 13,
      "title": "Dry column",
      "instruction": "Eliminate residual ethanol.",
      "substeps": [
        {
          "instruction": "Centrifuge column at full speed for 1 min.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 14,
      "title": "Elute RNA",
      "instruction": "Recover purified RNA.",
      "substeps": [
        {
          "instruction": "Place column in a new 1.5 mL tube.",
          "title": ""
        },
        {
          "instruction": "Add 40 µL RNase‑free water directly onto membrane.",
          "title": ""
        },
        {
          "instruction": "Incubate 1 min at room temperature.",
          "title": ""
        },
        {
          "instruction": "Centrifuge 1 min at >8,000 g (>10,000 rpm) to collect eluate.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 15,
      "title": "Quantify and store RNA",
      "instruction": "Assess concentration and preserve sample.",
      "substeps": [
        {
          "instruction": "Measure RNA concentration.",
          "title": ""
        },
        {
          "instruction": "Store total RNA at –80 °C.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
