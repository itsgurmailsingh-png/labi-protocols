  "materials": [
    "RNaseZap RNase decontamination solution",
    "Liquid nitrogen",
    "RNeasy MinElute cleanup kit",
    "QIAshredder",
    "DNA-free DNA removal kit",
    "SuperScript III reverse transcriptase kit",
    "RNAseOUT",
    "GoTaq hot start green master mix",
    "EZ RNA Methylation kit",
    "PyroMark Q48 magnetic beads",
    "PyroMark Q48 absorber strips",
    "dNTP mix (10 mM each)",
