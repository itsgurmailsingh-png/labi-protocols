  "quality_score": 2.0,
  "category": "Animal Models",
  "estimated_time_mins": 48,
  "materials": [
    "D-Luciferin, potassium salt",
    "isoflurane",
    "PBS 1×",
    "0.25% Trypsin-EDTA 1×",
    "DMEM",
    "Fetal bovine serum (FBS)",
    "B16F10-luciferase cell line",
    "HPAC-luciferase cell line",
    "Mouse: C57BL/6",
    "Mouse: NCG",
    "Vevo® 2100 Imaging System",
    "Ultrasound gel",
    "U-100 insulin syringes (31G)",
    "Electric shaver",
    "Cotton-tipped applicators",
    "Timing: 30 min",
    "Timing: 1 h"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare tumor cell culture",
      "instruction": "Thaw B16F10‑luc or HPAC‑luc cells, culture in the appropriate medium (DMEM + 10 % FBS for B16F10‑luc; DMEM/F12 (1:1) + 10 % FBS for HPAC‑luc) at 37 °C, 5 % CO₂, and grow to ~80 % confluency before injection (≈5–7 days).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Perform fur removal and anesthesia",
      "instruction": "Prepare a depilatory station, induce anesthesia, and remove abdominal fur at least 24 h before injection.",
      "substeps": [
        {
          "instruction": "Turn on heated platform and set to 37 °C; ensure isoflurane supply (5 % in O₂ at 5 L min⁻¹ for induction, 2.5 % in O₂ at 5 L min⁻¹ for maintenance) and check tubing/leaks; place an absorbent blue pad on the platform and gather electric shaver, unscented depilatory cream, PBS, metal spatula, Kimwipes, and cotton‑tipped applicators.",
          "title": ""
        },
        {
          "instruction": "Induce anesthesia: transfer one mouse to the induction chamber, anesthetize per institutional protocol, apply ophthalmic ointment if anesthesia >5 min, then move mouse to the pre‑heated platform with nose‑cone delivery.",
          "title": ""
        },
        {
          "instruction": "Remove fur: shave anterior abdomen (costal margin to mid‑abdomen) with electric shaver; apply a dime‑sized amount of depilatory cream using a cotton applicator, wait ~2 min, gently scrape off cream and fur with a metal spatula, wipe excess cream with a lightly moistened Kimwipe, pat dry with a dry Kimwipe, and return mouse to a heated recovery cage. Repeat for each mouse.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Set up ultrasound imaging station",
      "instruction": "Prepare the imaging and injection workstation, verify anesthesia connections, and arrange equipment for ultrasound‑guided injection.",
      "substeps": [
        {
          "instruction": "Review tubing connections between anesthetic chamber and delivery cone; confirm sufficient isoflurane and oxygen (same concentrations as above).",
          "title": ""
        },
        {
          "instruction": "Turn on the Vevo® physiological controller, set platform temperature to 37 °C, and place the ultrasound gel bottle on the platform to warm the gel.",
          "title": ""
        },
        {
          "instruction": "Assemble instruments on an absorbent pad under the Vevo® station: toothed forceps, 31‑gauge insulin syringes, cotton‑tipped applicators, and alcohol wipes.",
          "title": ""
        },
        {
          "instruction": "Mount a linear high‑frequency probe (e.g., MicroScan™ transducer) on the imaging station, orient the probe indicator toward the mouse’s left side, and position the ultrasound screen ergonomically so the injector can view the needle entry without turning the head.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Prepare cells for injection",
      "instruction": "Wash, count, and resuspend tumor cells in chilled PBS at the required concentration, keeping them on ice until injection.",
      "substeps": [
        {
          "instruction": "Detach adherent cells using 0.25 % trypsin, then count viable cells.",
          "title": ""
        },
        {
          "instruction": "Centrifuge the suspension at 450 × g for 5 min at 4 °C; discard supernatant.",
          "title": ""
        },
        {
          "instruction": "Resuspend cells in chilled PBS and repeat centrifugation and PBS wash two more times (total of three PBS washes) to remove residual FBS.",
          "title": ""
        },
        {
          "instruction": "Resuspend the washed cells in chilled PBS to the desired concentration and keep on ice. Recommended injection volume is 30 µL per mouse.",
          "title": ""
        },
        {
          "instruction": "For B16F10‑luc: use 8–10 × 10⁵ cells mL⁻¹ (2.5 × 10⁴ cells in 30 µL). For HPAC‑luc: use 3–4 × 10⁷ cells mL⁻¹ (1 × 10⁶ cells in 30 µL).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
