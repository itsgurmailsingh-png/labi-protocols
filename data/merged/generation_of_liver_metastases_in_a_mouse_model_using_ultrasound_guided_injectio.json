  "protocol_id": "generation_of_liver_metastases_in_a_mouse_model_using_ultrasound_guided_injectio",
  "parent_protocol_id": null,
  "version_count": 1,
  "title": "Generation of liver metastases in a mouse model using ultrasound-guided injection",
  "author": "Labora, Lee, et al.",
  "doi": "10.1016/j.xpro.2023.102163",
  "source_name": "star_protocols",
