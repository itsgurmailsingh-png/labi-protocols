  "category": "Neuroscience",
  "estimated_time_mins": 42,
  "materials": [
    "Laminin",
    "Poly(ethyleneimine) solution (PEI)",
    "Dulbecco’s modified Eagle’s medium (DMEM)",
    "Embryonic stem cell FBS",
    "Nonessential amino acids (100×)",
    "Sodium pyruvate 100 mM",
    "2-Mercaptoethanol",
    "Penicillin/streptomycin (5,000 U/ml)",
    "Murine leukemia inhibitory factor (LIF)",
    "DMEM/F12, GlutaMAX supplement",
    "B-27 supplement (50×) without vitamin A",
    "N-2 Supplement (100×)",
    "Neurobasal medium",
    "L-glutamine 100×",
    "MycoSPY Master Mix",
    "Timing: 7 weeks"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Culture mESC lines on laminin",
      "instruction": "Culture E14 mouse embryonic stem cells (mESC) on laminin‑coated dishes and WT‑B1 mESCs on mitomycin‑treated MEF feeder layers in ES medium.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Plate mESCs at low density",
      "instruction": "The day before differentiation, plate the mESC lines at low density on laminin‑coated dishes.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Switch to DDM medium with B27",
      "instruction": "The day after plating, culture the cells in DDM medium supplemented with B27‑without‑vitamin‑A as previously reported.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Add DMH1‑HCl (1 µM) days 0‑8",
      "instruction": "From day 0 to day 8 of culture, supplement the DDM medium with the dorsomorphin analog DMH1‑HCl at a final concentration of 1 µM (replace cyclopamine).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Plate neuroprogenitors on PEI/laminin chips",
      "instruction": "At 12 days of 2D in‑vitro corticogenesis, plate E14 or WT‑B1 neuroprogenitor cells on Accura chips (3Brain) coated with 0.1 mg ml⁻¹ poly‑ethylene‑imine (PEI) and 33 µg ml⁻¹ laminin, following the manufacturer’s instructions.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Differentiate to DIV 21 then extend culture",
      "instruction": "Differentiate the cells until day‑in‑vitro 21 (DIV 21), then maintain them in complete Neurobasal medium for an additional 21 days. The entire in‑vitro corticogenesis protocol spans approximately 7 weeks.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Maintain culture conditions and medium",
      "instruction": "During differentiation keep cultures at 37 °C in a 5 % CO₂ atmosphere; filter the complete Neurobasal medium with a 0.22 µm bottle‑top filter, store the filtered medium at 4 °C, and use it within 1 week.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Test for mycoplasma regularly",
      "instruction": "Control the samples regularly to exclude mycoplasma contamination, e.g., by using the MycoSPY kit.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Freeze cells for storage",
      "instruction": "To store cells, supplement ES medium with 10 % DMSO, freeze the suspension at –80 °C overnight, then transfer to –196 °C for long‑term storage.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Analyze HD‑MEA data with spikeNburst/nicespike",
      "instruction": "Using the exported data from the 3Brain HD‑MEA system (4,096 electrodes), run spike sorting, burst detection, and synchrony analyses with the spikeNburst and nicespike graphical user interfaces, applying the parameters described in the protocol’s tables.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
