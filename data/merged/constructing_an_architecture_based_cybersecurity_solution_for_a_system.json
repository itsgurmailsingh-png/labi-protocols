  "steps": [
    {
      "step_id": 0,
      "title": "Manage cybersecurity with framework",
      "instruction": "Multidimensionality and complexity of cybersecurity problems can be managed with an architecture-based framework [3]. Models for describing a system and its security goals become a powerful tool for constructing the security requirements and controls for a system, with strong support for a systemic, comprehensive, and scalable security solution.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Method details",
      "instruction": "This work describes detailed aspects of the methodology proposed in [3] to construct a security solution, with the following steps:A.Obtaining Organization Policies.B.Defining the System Representation.C.Defining Security Objectives.D.Defining the Security Representation.E.Identifying and Assessing Risks.F.Establishing Security Requirements.G.Defining and Implementing Security Controls.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Execute security process",
      "instruction": "This methodology allows to execute a security process for a system. The security process starts by collecting the business policy altogether with organization goals to define the high-level security objectives. The security objectives and the system representation are used to obtain a security representation for the risk assessment. The risk analysis produces security requirements to be enforced with security controls in the final step. Fig. 1 shows a conceptual map describing the methodology to be explained.Fig. 1Architecture-based Cybersecurity Methodology. Source: [3].Fig. 1:",
      "substeps": [
        {
          "instruction": "Collect the business policy together with organization goals to define the high-level security objectives.",
          "title": ""
        },
        {
          "instruction": "Use the security objectives and the system representation to obtain a security representation for the risk assessment.",
          "title": ""
        },
        {
          "instruction": "Perform risk analysis to produce security requirements to be enforced with security controls in the final step.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
