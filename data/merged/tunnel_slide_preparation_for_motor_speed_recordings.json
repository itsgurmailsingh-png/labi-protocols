  "steps": [
    {
      "step_id": 0,
      "title": "Prepare Materials",
      "instruction": "Gather 22x40 mm coverslips and standard microscope slides.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Apply Adhesive Tape",
      "instruction": "Secure two pieces of Scotch sticky tape perpendicularly on the microscope slide.",
      "substeps": [
        {
          "instruction": "Ensure the separation between the tapes is approximately 3-4mm.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Assemble Tunnel Slide",
      "instruction": "Trim the tape and attach the coverslip to create the tunnel.",
      "substeps": [
        {
          "instruction": "Cut excess tape off using a razor.",
          "title": ""
        },
        {
          "instruction": "Place the coverslip gently onto the slide.",
          "title": ""
        },
        {
          "instruction": "Use pipette tips to push the coverslip down gently to remove air.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Position Slide for Use",
      "instruction": "Flip the tunnel slide so the coverslip is at the bottom and the tunnel entries are accessible.",
      "substeps": [],
      "is_critical": false,
