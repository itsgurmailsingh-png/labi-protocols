  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Simulate DXCCII schematic in PSPICE",
      "instruction": "Draw the DTMOS‑based DXCCII schematic (Fig. 5) and run a PSPICE simulation using the 0.18 µm CMOS technology node to evaluate circuit performance.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Apply ±0.2 V supply and set aspect ratios",
      "instruction": "Power the circuit with a ±0.2 V supply and assign the transistor width‑to‑length (W/L) ratios given in Table 1; the simulated circuit consumes 1.58 µW.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Configure component values for Chua circuit",
      "instruction": "Set the synthetic‑inductor equivalent to 90 mH by using R = 1 kΩ and C3 = 19 nF. Use C1 = 10 pF, C2 = 100 pF, R1 = 1.8 kΩ, R2 = 2.9 kΩ, and R3 = 22 kΩ. Include the previously described Chua diode. Run the simulation and record the chaotic waveforms VC1, VC2, and iL.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Sweep RA to generate attractors",
      "instruction": "Vary the resistor RA to the values 1300 Ω, 1500 Ω, 1600 Ω, 1700 Ω, 1800 Ω, and 2230 Ω. For each RA value observe the resulting chaotic attractor (large limit‑cycle, double‑scroll, Rossler‑type, I‑periodic) as shown in Figures 13–18.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
