  "peer_reviewed": false,
  "stats": {
    "views": 0,
    "runs": 0,
    "bookmarks": 0,
    "comments": 0
  },
  "quality_score": 2.0,
  "category": "Cell Biology",
  "estimated_time_mins": 30,
  "materials": [
    "rabbit anti-EZH2 antibody",
    "Goat anti-Rabbit IgG Alexa Fluor 488",
    "Goat anti-Rabbit IgG Alexa Fluor 647",
    "RPMI 1640 medium",
    "Optimem",
    "Pen/Strep",
    "PBS",
    "TrypLE Select Enzyme",
    "DAPI",
    "Phalloidin Alexa Fluor 647",
    "ProLong Gold Antifade Mountant",
    "BSA Fraction V",
    "Paraformaldehyde",
    "Triton X 100",
    "Lipofectamine RNAiMAX",
    "Timing: 2–3 days"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Seed cells for photolabeling",
      "instruction": "Seed approximately 4.5 × 10⁵ BoM‑1833 cells in 1 mL complete medium with Penicillin‑Streptomycin per one‑well chamber slide, then incubate at 37 °C, 5 % CO₂ until ~80 % confluency the next day.",
      "substeps": [
        {
          "instruction": "Seed ~4.5 × 10⁵ cells in 1 mL medium per slide.",
          "title": ""
        },
        {
          "instruction": "Incubate 37 °C, humidified, 5 % CO₂ overnight.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Fix, permeabilize, and block cells",
      "instruction": "Fix cells with 2.4 % paraformaldehyde, permeabilize with 0.5 % Triton X‑100, then block with 3 % BSA in PBS‑Triton on a seesaw shaker.",
      "substeps": [
        {
          "instruction": "Incubate cells with 2.4 % paraformaldehyde, static, 10 min at 20‑25 °C.",
          "title": ""
        },
        {
          "instruction": "Rinse twice with 1× PBS.",
          "title": ""
        },
        {
          "instruction": "Permeabilize with 1× PBS + 0.5 % Triton X‑100, static, 10 min at 20‑25 °C.",
          "title": ""
        },
        {
          "instruction": "Wash three times with 1× PBS.",
          "title": ""
        },
        {
          "instruction": "Block with 3 % BSA in 1× PBS + 0.5 % Triton X‑100 on seesaw shaker (15 rpm) for 1 h at 20‑25 °C.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Apply SynLight‑Rich labeling kit",
      "instruction": "Perform the SynLight‑Rich™ Kit blocking steps on a seesaw shaker before Microscoop photolabeling.",
      "substeps": [
        {
          "instruction": "Incubate cells with 1 mL Block 1 on seesaw shaker (15 rpm) for 30 min at 20‑25 °C.",
          "title": ""
        },
        {
          "instruction": "Rinse three times with 1× PBS + 0.1 % Triton X‑100.",
          "title": ""
        },
        {
          "instruction": "Incubate cells with 1 mL Block 2 on seesaw shaker (15 rpm) for 15 min.",
          "title": ""
        },
        {
          "instruction": "Rinse three times with 1× PBS + 0.1 % Triton X‑100.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Immunofluorescence staining for EZH2",
      "instruction": "Stain fixed cells with anti‑EZH2 primary and Alexa 647 secondary antibodies using gentle agitation, then store.",
      "substeps": [
        {
          "instruction": "Incubate with rabbit anti‑EZH2 (1:500 in 3 % BSA, 1× PBS + 0.1 % Triton X‑100) for 4 h at 20‑25 °C on seesaw shaker (15 rpm).",
          "title": ""
        },
        {
          "instruction": "Wash three times with 1× PBS + 0.1 % Triton X‑100, 5 min each.",
          "title": ""
        },
        {
          "instruction": "Incubate with anti‑rabbit Alexa Fluor 647 secondary (1:500 in 3 % BSA, 1× PBS + 0.1 % Triton X‑100) for 2 h at 20‑25 °C in the dark on seesaw shaker (15 rpm).",
          "title": ""
        },
        {
          "instruction": "Wash three times with 1× PBS + 0.1 % Triton X‑100, 5 min each.",
          "title": ""
        },
        {
          "instruction": "Rinse three times with 1× PBS.",
          "title": ""
        },
        {
          "instruction": "Store slides in 1× PBS at 4 °C (use within 1–2 weeks; with 0.02–0.1 % sodium azide up to 1 month).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
