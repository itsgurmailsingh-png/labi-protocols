{
  "protocol_id": "in_situ_proteome_analysis_of_prc2_bodies_in_triple_negative_breast_cancer_cells_",
  "parent_protocol_id": null,
  "version_count": 1,
  "title": "In situ proteome analysis of PRC2 bodies in triple-negative breast cancer cells using optoproteomics",
  "author": "Pan, Chang, et al.",
  "doi": "10.1016/j.xpro.2026.104578",
  "source_name": "star_protocols",
  "source_url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC13196511/",
