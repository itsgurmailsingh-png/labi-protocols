  "steps": [
    {
      "step_id": 0,
      "title": "Track neuron fluorescence with NeuroTracker",
      "instruction": "In ImageJ, load the NeuroTracker plugin, enable active behavior tracking settings (animals move during stimulation), and select an integration box that just encloses the neuron soma (typically 4 × 4 px or 6 × 6 px).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Export and load data in MATLAB",
      "instruction": "Save the NeuroTracker output as a text file containing centroid position, integrated fluorescence intensity, and background level for each animal, then run the provided MATLAB script “NeuroTrackerSummary.m” to read, organize, and visualize the neural fluorescence data across individuals or grouped by sleep/wake states.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Calculate normalized fluorescence ΔF/F0",
      "instruction": "For each time point, compute background as the median intensity of an annulus surrounding the neuron, subtract it from the integration‑box intensity to obtain F, define baseline F0 as the average fluorescence of the first 4 s of the trial (pre‑stimulation), and calculate ΔF/F0 = (F – F0)/F0; then average ΔF/F0 across individuals or groups as needed.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Derive metrics for statistical analysis",
      "instruction": "Reduce each trial’s data to quantitative metrics—peak calcium activity, area‑under‑curve (AUC), baseline F0, rise time, and decay time—and use these values for statistical comparisons between sleep states, perturbations, or other experimental groups.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
