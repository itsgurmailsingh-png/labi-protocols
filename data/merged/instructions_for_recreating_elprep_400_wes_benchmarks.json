  "title": "Instructions for recreating elPrep 4.0.0 WES benchmarks",
  "author": "Charlotte Herzeel",
  "doi": "dx.doi.org/10.17504/protocols.io.w65fhg6",
  "source_name": "protocols_io",
  "source_url": "https://www.protocols.io/view/instructions-for-recreating-elprep-4-0-0-wes-bench-w65fhg6",
  "citation": "dx.doi.org/10.17504/protocols.io.w65fhg6",
