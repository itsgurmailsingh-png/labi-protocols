  "license_note": "Confirmed via CrossRef DOI metadata: dx.doi.org/10.17504/protocols.io.w65fhg6",
  "peer_reviewed": false,
  "stats": {
    "views": 0,
    "runs": 0,
    "bookmarks": 0,
    "comments": 0
  },
  "quality_score": 5.5,
  "category": "Genomics & Sequencing",
  "estimated_time_mins": 24,
  "materials": [
    "mdkir elprep-v4.0.0",
    "mv elprep-v4.0.1.tar.gz elprep-v4.0.0",
    "cd elprep-v4.0.0",
    "tar xvf elprep-v4.0.0.tar.gz",
    "PATH=$WORKDIR/elprep-v4.0.0:$PATH",
    "tar xvf bwa-0.7.17.tar.bz2"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Configure hardware and software",
      "instruction": "Prepare a workstation (WORKDIR) with the following specifications: 2 × 18‑core Intel Xeon E5‑2699v3 (Haswell) @ 2.3 GHz, 256 GB RAM, 2 × 400 GB SSD, running Ubuntu 14.04.5 LTS, and ensure elPrep 4.0.1 (or 4.0.0) is available.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Install elPrep 4.0.0",
      "instruction": "Download the elPrep binary tarball from https://github.com/ExaScience/elprep/releases/download/v4.0.0/elprep-v4.0.0.tar.gz, create a directory, rename the archive, extract it, and add it to the PATH.",
      "substeps": [
        {
          "instruction": "wget https://github.com/ExaScience/elprep/releases/download/v4.0.0/elprep-v4.0.0.tar.gz",
          "title": ""
        },
        {
          "instruction": "mkdir elprep-v4.0.0",
          "title": ""
        },
        {
          "instruction": "mv elprep-v4.0.0.tar.gz elprep-v4.0.0/",
          "title": ""
        },
        {
          "instruction": "cd elprep-v4.0.0",
          "title": ""
        },
        {
          "instruction": "tar xvf elprep-v4.0.0.tar.gz",
          "title": ""
        },
        {
          "instruction": "export PATH=$WORKDIR/elprep-v4.0.0:$PATH",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Install BWA 0.7.17",
      "instruction": "Build BWA from source, ensuring GCC 4.8.4 (or newer) is installed.",
      "substeps": [
        {
          "instruction": "Verify GCC version (4.8.4 recommended).",
          "title": ""
        },
        {
          "instruction": "wget https://github.com/lh3/bwa/releases/download/v0.7.17/bwa-0.7.17.tar.bz2",
          "title": ""
        },
        {
          "instruction": "tar xvf bwa-0.7.17.tar.bz2",
          "title": ""
        },
        {
          "instruction": "cd bwa-0.7.17",
          "title": ""
        },
        {
          "instruction": "make",
          "title": ""
        },
        {
          "instruction": "cd $WORKDIR",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Download required data files",
      "instruction": "Obtain FASTQ, BED, reference genome, and known‑variant VCF files from the public repositories using the URLs below.",
      "substeps": [
        {
          "instruction": "wget ftp://ftp-trace.ncbi.nih.gov/giab/ftp/data/NA12878/Garvan_NA12878_HG001_HiSeq_Exome/NIST7035_TAAGGCGA_L001_R1_001.fastq.gz",
          "title": ""
        },
        {
          "instruction": "wget ftp://ftp-trace.ncbi.nih.gov/giab/ftp/data/NA12878/Garvan_NA12878_HG001_HiSeq_Exome/NIST7035_TAAGGCGA_L001_R2_001.fastq.gz",
          "title": ""
        },
        {
          "instruction": "wget ftp://ftp-trace.ncbi.nih.gov/giab/ftp/data/NA12878/Garvan_NA12878_HG001_HiSeq_Exome/nexterarapidcapture_expandedexome_targetedregions.bed.gz",
          "title": ""
        },
        {
          "instruction": "wget ftp://gsapubftp-anonymous@ftp.broadinstitute.org/bundle/hg19/ucsc.hg19.fasta.gz (and associated index files)",
          "title": ""
        },
        {
          "instruction": "If the FTP login fails due to the 25‑user limit, retry until successful.",
          "title": ""
        },
        {
          "instruction": "wget ftp://gsapubftp-anonymous@ftp.broadinstitute.org/bundle/hg19/Mills_and_1000G_gold_standard.indels.hg19.sites.vcf.gz",
          "title": ""
        },
        {
          "instruction": "wget ftp://gsapubftp-anonymous@ftp.broadinstitute.org/bundle/hg19/dbsnp_138.hg19.vcf.gz",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Create reference index",
      "instruction": "Index the hg19 reference FASTA with BWA (≈1 h).",
      "substeps": [
        {
          "instruction": "bwa-0.7.17/bwa index ucsc.hg19.fasta.gz",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Align FASTQ to BAM",
      "instruction": "Map the paired FASTQ files to the reference using BWA‑MEM with 72 threads and a read‑group, pipe the output through elPrep to produce NA12878.bam (≈5 min).",
      "substeps": [
        {
          "instruction": "bwa-0.7.17/bwa mem -t 72 -R '@RG\\tID:Group1\\tLB:lib1\\tPL:illumina\\tSM:sample1' ucsc.hg19.fasta.gz NIST7035_TAAGGCGA_L001_R1_001.fastq.gz NIST7035_TAAGGCGA_L001_R2_001.fastq.gz | elprep /dev/stdin NA12878.bam",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Convert reference to elPrep ELFasta",
      "instruction": "Rename, decompress, and convert the reference FASTA to elPrep ELFasta format (≈1 min).",
      "substeps": [
        {
          "instruction": "cp ucsc.hg19.fasta.gz hg19.fasta.gz",
          "title": ""
        },
        {
          "instruction": "gunzip hg19.fasta.gz",
          "title": ""
        },
        {
          "instruction": "elprep fasta-to-elfasta hg19.fasta ucsc.hg19.elfasta",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Create elSites files from VCFs",
      "instruction": "Decompress each VCF and convert it to elPrep elSites format.",
      "substeps": [
        {
          "instruction": "gunzip dbsnp_138.hg19.vcf.gz",
          "title": ""
        },
        {
          "instruction": "elprep vcf-to-elsites dbsnp_138.hg19.vcf dbsnp_138.hg19.elsites   # ≈1 min",
          "title": ""
        },
        {
          "instruction": "gunzip Mills_and_1000G_gold_standard.indels.hg19.sites.vcf.gz",
          "title": ""
        },
        {
          "instruction": "elprep vcf-to-elsites Mills_and_1000G_gold_standard.indels.hg19.sites.vcf Mills_and_1000G_gold_standard.indels.hg19.elsites   # ≈10 s",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Unzip captured‑region BED file",
      "instruction": "Decompress the BED file containing target regions.",
      "substeps": [
        {
          "instruction": "gunzip nexterarapidcapture_expandedexome_targetedregions.bed.gz",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Run elPrep filter‑mode benchmark",
      "instruction": "Delete any previous output files, then execute elPrep in filter mode with duplicate marking, BQSR, and region filtering (≈5 min, 80 GB RAM).",
      "substeps": [
        {
          "instruction": "rm -f NA12878.filter.*",
          "title": ""
        },
        {
          "instruction": "elprep filter NA12878.bam NA12878.filter.bam \\",
          "title": ""
        },
        {
          "instruction": "--mark-duplicates \\",
          "title": ""
        },
        {
          "instruction": "--mark-optical-duplicates NA12878.filter.metrics \\",
          "title": ""
        },
        {
          "instruction": "--sorting-order coordinate \\",
          "title": ""
        },
        {
          "instruction": "--bqsr NA12878.filter.recal \\",
          "title": ""
        },
        {
          "instruction": "--known-sites Mills_and_1000G_gold_standard.indels.hg19.elsites,dbsnp_138.hg19.elsites \\",
          "title": ""
        },
        {
          "instruction": "--bqsr-reference ucsc.hg19.elfasta \\",
          "title": ""
        },
        {
          "instruction": "--filter-non-overlapping-reads nexterarapidcapture_expandedexome_targetedregions.bed",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Run elPrep sfm‑mode benchmark",
      "instruction": "Delete any previous output files, then execute elPrep in sfm mode with the same options (≈11 min, 22 GB RAM).",
      "substeps": [
        {
          "instruction": "rm -f NA12878.sfm.*",
          "title": ""
        },
        {
          "instruction": "elprep sfm NA12878.bam NA12878.sfm.bam \\",
          "title": ""
        },
        {
          "instruction": "--mark-duplicates \\",
          "title": ""
        },
        {
          "instruction": "--mark-optical-duplicates NA12878.sfm.metrics \\",
          "title": ""
        },
        {
          "instruction": "--sorting-order coordinate \\",
          "title": ""
        },
        {
          "instruction": "--bqsr NA12878.sfm.recal \\",
          "title": ""
        },
        {
          "instruction": "--known-sites Mills_and_1000G_gold_standard.indels.hg19.elsites,dbsnp_138.hg19.elsites \\",
          "title": ""
        },
        {
          "instruction": "--bqsr-reference ucsc.hg19.elfasta \\",
          "title": ""
        },
        {
          "instruction": "--filter-non-overlapping-reads nexterarapidcapture_expandedexome_targetedregions.bed",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
  "media": [],
