  "steps": [
    {
      "step_id": 0,
      "title": "Prepare Required Data and Software",
      "instruction": "Ensure access to ArcGIS software with an advanced license and prepare the necessary input data.",
      "substeps": [
        {
          "instruction": "Obtain surface raster data of digital elevation.",
          "title": ""
        },
        {
          "instruction": "Obtain a shapefile of landslide polygons.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Execute Initial Model Processing",
      "instruction": "Run Model 1 using the ArcGIS ModelBuilder utility to generate the flow accumulation raster.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Visualize Streamlines",
      "instruction": "Configure the flow accumulation raster symbology in the ArcGIS map window to visualize the streamline.",
      "substeps": [
        {
          "instruction": "Add the flow accumulation raster to the map window.",
          "title": ""
        },
        {
          "instruction": "Set primary symbology to 'Classify'.",
          "title": ""
        },
        {
          "instruction": "Set the method to 'Manual Interval'.",
          "title": ""
        },
        {
          "instruction": "Set the number of classes to '2'.",
          "title": ""
        },
        {
          "instruction": "Set the symbol for values less than 1000 to no color (transparent).",
          "title": ""
        },
        {
          "instruction": "Set the symbol for values 1000 and above to a color of the operator's preference (e.g., blue).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Determine Catchment Outlets",
      "instruction": "Create a shapefile containing points that represent the outlets of the study catchments.",
      "substeps": [
        {
          "instruction": "Place catchment outlet points precisely on the visualized streamline of the flow accumulation raster to ensure successful watershed raster creation in Model 2.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Calculate Area Fractions",
      "instruction": "Use the remaining ArcGIS ModelBuilder models to calculate the catchment area (CA), landslide area (LA), and landslide scar area percentage (LCR).",
      "substeps": [
        {
          "instruction": "Run Model 2 to create the watershed raster using the outlet points.",
          "title": ""
        },
        {
          "instruction": "Calculate LCR using the formula: (LA / CA) × 100.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
