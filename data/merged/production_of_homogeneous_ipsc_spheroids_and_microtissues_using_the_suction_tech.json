  "steps": [
    {
      "step_id": 0,
      "title": "Assemble suction device",
      "instruction": "In a biosafety cabinet, autoclave the suction table, O‑ring (MORISEI KAKO), and adapter fitting, then assemble the device as follows:",
      "substeps": [
        {
          "instruction": "Connect the vacuum vessel and Minic S‑II pump to a silicon tube.",
          "title": ""
        },
        {
          "instruction": "Loosen the valve of the vacuum vessel.",
          "title": ""
        },
        {
          "instruction": "Pump air out of the vacuum vessel until the barometer reads –0.05 MPa.",
          "title": ""
        },
        {
          "instruction": "Tighten the valve of the vacuum vessel.",
          "title": ""
        },
        {
          "instruction": "Fit the O‑ring into the adapter fitting.",
          "title": ""
        },
        {
          "instruction": "Insert the fitting adapter into the suction table.",
          "title": ""
        },
        {
          "instruction": "Connect the three‑way stopcock to the suction table.",
          "title": ""
        },
        {
          "instruction": "Connect the silicon tube to the three‑way stopcock.",
          "title": ""
        },
        {
          "instruction": "Turn off the lever on the three‑way stopcock.",
          "title": ""
        },
        {
          "instruction": "Connect the free end of the silicon tube to the vacuum vessel.",
          "title": ""
        },
        {
          "instruction": "Loosen the screw attached to the vacuum vessel.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare porous ceramic substratum",
      "instruction": "Sterile‑transfer the TiO₂ porous ceramic substratum to a 6‑well plate and soak it in culture medium:",
      "substeps": [
        {
          "instruction": "Using sterile tweezers, place the substratum into a well of a 6‑well plate.",
          "title": ""
        },
        {
          "instruction": "Add 150 µL of mTeSR1 medium containing 10 µM Y‑27632, distributing the drop evenly around the substratum so it soaks from the outside.",
          "title": ""
        },
        {
          "instruction": "Place the plate with the substratum in a cell culture incubator.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Prepare hiPSC single‑cell suspension",
      "instruction": "Generate a single‑cell suspension of hiPSCs at 2.5 × 10⁶ cells · mL⁻¹:",
      "substeps": [
        {
          "instruction": "Remove the existing medium from the hiPSC culture dish and rinse the cells with 10 mL D‑PBS (‑).",
          "title": ""
        },
        {
          "instruction": "Add 2 mL TrypLE Select enzyme (1×) to the dish and incubate at 37 °C for 3 min (±10 s).",
          "title": ""
        },
        {
          "instruction": "Detach the cells by gently pipetting with a P1000 micropipette.",
          "title": ""
        },
        {
          "instruction": "Add 10 mL mTeSR1 medium containing 10 µM Y‑27632 and transfer the suspension to a 15 mL conical tube.",
          "title": ""
        },
        {
          "instruction": "Centrifuge the tube for 3 min at 300 × g (±30 s).",
          "title": ""
        },
        {
          "instruction": "Discard the supernatant and resuspend the cell pellet in 2 mL mTeSR1 with 10 µM Y‑27632.",
          "title": ""
        },
        {
          "instruction": "Count the cells and adjust the concentration to 2.5 × 10⁶ cells · mL⁻¹.",
          "title": ""
        },
        {
          "instruction": "Aliquot the suspension into a 1.5 mL tube to achieve the target concentration.",
          "title": ""
        },
        {
          "instruction": "If cell clumps are observed, pass the suspension through a cell strainer to obtain a single‑cell suspension.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
