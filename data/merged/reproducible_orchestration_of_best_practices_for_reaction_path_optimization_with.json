  "steps": [
    {
      "step_id": 0,
      "title": "Prepare consistent endpoint structures",
      "instruction": "Obtain the reactant and product geometry files and ensure a one‑to‑one atom‑to‑atom mapping between them, as required for the two‑stage preparation process.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Create YAML configuration file",
      "instruction": "Write a single YAML configuration file that references the two endpoint files; this file directs the workflow to perform alignment, path generation, and optimization.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Run workflow to generate reaction path",
      "instruction": "Execute the workflow, which automatically carries out (i) geometry minimization, (ii) IRA alignment, (iii) SIDPP path generation, and (iv) hybrid CI‑NEB‑MMF optimization, without further user intervention.",
      "substeps": [
        {
          "instruction": "Minimize each endpoint geometry.",
          "title": ""
        },
        {
          "instruction": "Perform IRA (Iterative Rotational Alignment) of the minimized structures.",
          "title": ""
        },
        {
          "instruction": "Generate an initial path using the SIDPP (String Interpolation with Discrete Path Projection) method.",
          "title": ""
        },
        {
          "instruction": "Refine the path with hybrid CI‑NEB‑MMF (Climbing Image Nudged Elastic Band – Minimum Mode Following) optimization.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Validate HCN→HNC energy profile",
      "instruction": "For the HCN → HNC isomerization, compare the computed barrier of 2.46 eV and product energy of 0.57 eV above the reactant with reference CCSD(T)/cc-pCV5Z values (barrier 2.09 eV, HCN–HNC energy difference 0.65 eV) to confirm the expected single‑barrier topology.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Apply workflow to additional systems",
      "instruction": "Provide endpoint pairs for each of the four additional reactions—alanine dipeptide C7eq → C5 conformational transition, ethylene + butadiene Diels‑Alder cycloaddition, F⁻ + CH₃F SN2 identity reaction, and vinyl alcohol ↔ acetaldehyde tautomerization—then run the same workflow to obtain converged reaction paths.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
