  "steps": [
    {
      "step_id": 0,
      "title": "Prepare Chelator and Salt Solution",
      "instruction": "Combine the following components in a glass-stoppered bottle using distilled or Milli-Q water to a total volume of 250 mL:",
      "substeps": [
        {
          "instruction": "Add 4.65 g of Na2EDTA",
          "title": ""
        },
        {
          "instruction": "Add 3.68 g of Na3 Citrate",
          "title": ""
        },
        {
          "instruction": "Add 2.5 mL of 0.1 M KCl",
          "title": ""
        },
        {
          "instruction": "Add 3.0 g of NaCl (s)",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Add TiCl3",
      "instruction": "Add 7.77 mL of 20% TiCl3 to the combined chelator and salt solution while stirring until a clear purple solution is formed.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Adjust pH",
      "instruction": "Adjust the pH of the solution to 8 using 10 M NaOH.",
      "substeps": [
        {
          "instruction": "Add 10 M NaOH dropwise while stirring to attain pH 8",
          "title": ""
        },
        {
          "instruction": "Let the solution equilibrate for 30-60 minutes",
          "title": ""
        },
        {
          "instruction": "Re-check the pH",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
