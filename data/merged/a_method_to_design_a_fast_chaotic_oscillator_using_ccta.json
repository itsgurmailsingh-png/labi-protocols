  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Simulate diode V‑I characteristics",
      "instruction": "In PSPICE, perform DC sweep analysis of the NR1, NR2, and Chua‑diode circuits using an IC‑based CCTA implementation (cascaded AD844 and Max435). Set resistor values R1 = 13.33 kΩ, R2 = 20 kΩ, supply voltages V1 = +12 V and V2 = ‑12 V; compute the transconductance as gm = 4/R1. R2 determines the supply currents of the Max435.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Implement CCTA CMOS building block",
      "instruction": "Create the CMOS schematic of the CCTA (Fig. 2) using 180 nm technology. Bias the MOSFETs with ±1.25 V supplies; apply a +0.42 V DC bias to the gates of M3, M4, and M5. Set the bias currents I1 = I2 = 40 µA to fix gm. Use the transistor aspect ratios from Table 1:",
      "substeps": [
        {
          "instruction": "PMOS: M1 W=0.3 µm L=0.18 µm; M2 W=0.3 µm L=0.18 µm; M3 W=2.4 µm L=0.18 µm; M4 W=2.4 µm L=0.18 µm; M5 W=16.6 µm L=0.18 µm; M10 W=16.6 µm L=0.36 µm; M11 W=0.67 µm L=0.36 µm.",
          "title": ""
        },
        {
          "instruction": "NMOS: M6 W=0.67 µm L=0.18 µm; M7 W=0.67 µm L=0.18 µm; M8 W=2.4 µm L=0.18 µm; M9 W=2.4 µm L=0.18 µm; M12 W=3.6 µm L=0.36 µm; M13 W=3.6 µm L=0.36 µm.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Assemble full chaotic oscillator",
      "instruction": "Connect the CCTA to the passive network (Fig. 13) with C1 = 0.5 pF, C2 = 5 pF, L = 1.3 µH, R1 = 2.2 kΩ, R3 = 22 kΩ, and a potentiometer R (2 kΩ total) tuned between 1 kΩ and 2 kΩ. Run a transient analysis; for R = 1650 Ω record the chaotic waveforms VC1, VC2, and IL.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Analyze frequency and attractors",
      "instruction": "Perform FFT on VC2 to obtain the dominant oscillation frequency (≈ 37.5 MHz). Vary the variable resistor R to generate different attractors:",
      "substeps": [
        {
          "instruction": "R = 1450 Ω → large limit‑cycle attractor (Fig. 18).",
          "title": ""
        },
        {
          "instruction": "R = 1650 Ω → double‑scroll attractor (Fig. 19).",
          "title": ""
        },
        {
          "instruction": "R = 1800 Ω → Rossler‑type attractor (Fig. 20).",
          "title": ""
        },
        {
          "instruction": "R = 1950 Ω → I‑periodic attractor (Fig. 21).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Monte Carlo robustness assessment",
      "instruction": "Run a Monte Carlo simulation (100 uniform runs) assigning tolerances: R, R1, R3 ± 5 %; C1, C2 ± 7 %; L ± 7 %. Collect VC1 and VC2 waveforms for each run and plot histograms. Observe a mean VC1 of 0.848915 with deviation 0.0442349 (≈ 5.21 %) and a mean VC2 of 0.916029 with deviation 0.0422423 (≈ 4.61 %).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
