  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare soil‑fertilizer mixtures",
      "instruction": "Using air‑dried acidic clay soil from Santander de Quilichao and diammonium phosphate (P2O5) fertilizer, create a series of mixtures where the fertilizer proportion is reduced proportionally from 100 % (sample 1) to 0 % (sample 152) following the procedure of F. Rivadeneira.",
      "substeps": [
        {
          "instruction": "Obtain air‑dried acidic clay soil characteristic of the region.",
          "title": ""
        },
        {
          "instruction": "Obtain diammonium phosphate (P2O5) fertilizer.",
          "title": ""
        },
        {
          "instruction": "Mix soil and fertilizer in a series of ratios, starting with 100 % fertilizer (sample 1) and ending with soil only (sample 152), reducing the fertilizer proportion proportionally for each intermediate sample.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Measure total phosphorus concentration",
      "instruction": "Determine the total phosphorus (P‑Total) in each prepared mixture using the standardized chemical determination methods for soils, recording results for the 12 mixtures listed in Table 2.",
      "substeps": [
        {
          "instruction": "Apply the standard soil chemical analysis protocol to each of the 12 prepared samples.",
          "title": ""
        },
        {
          "instruction": "Measure P‑Total (mg kg⁻¹) for each sample.",
          "title": ""
        },
        {
          "instruction": "Document the concentrations as shown in Table 2 (e.g., 12.571 mg kg⁻¹ for sample 1, 0.001 mg kg⁻¹ for the method detection limit, etc.).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Reduce spectral data via PCA",
      "instruction": "Load the 152 reflectance spectra (each containing 3501 wavelength points) and apply Principal Component Analysis to compress each spectrum to two principal component scores.",
      "substeps": [
        {
          "instruction": "Import the 152 spectra with 3501 wavelengths per spectrum into the analysis environment.",
          "title": ""
        },
        {
          "instruction": "Perform PCA on the full dataset.",
          "title": ""
        },
        {
          "instruction": "Retain the first two principal components, resulting in a dataset of 152 samples with 2 values each.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Train and validate ML models",
      "instruction": "Using MATLAB R2022a, train two machine‑learning algorithms on the PCA‑reduced data, employing an 80 %/20 % train‑test split and 10‑fold cross‑validation for robust evaluation.",
      "substeps": [
        {
          "instruction": "Implement the two chosen algorithms in MATLAB R2022a.",
          "title": ""
        },
        {
          "instruction": "Randomly allocate 80 % of the 152 samples to a training set and the remaining 20 % to a test set.",
          "title": ""
        },
        {
          "instruction": "Within the training set, create 10 folds and perform cross‑validation to tune and assess model performance.",
          "title": ""
        },
        {
          "instruction": "After training, evaluate the final models on the independent test set.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
