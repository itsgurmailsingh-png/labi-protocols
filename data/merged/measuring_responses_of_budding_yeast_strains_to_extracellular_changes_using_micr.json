  "materials": [
    "Dow SYLGARD 184 kit",
    "Trichloro(1H,1H,2H,2H-perfluorooctyl) silane",
    "Complete supplement mixture",
    "Ammonium sulfate",
    "Yeast nitrogen base without amino acids",
    "D-glucose",
    "Bovine serum albumin",
    "Cy5 (sulfo-cyanin carboxylic acid, optional)",
    "Vacuum desiccator chamber",
    "Shaking incubator for liquid cultures",
    "Wide-field epifluorescence microscope",
    "Programmable microfluidic syringe pump",
    "PTFE tubing",
    "Blunt dispensing tips with 45° angle",
    "Biopsy punch 1 mm",
    "Timing: 19–20 h"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Make filtered SC media with BSA",
      "instruction": "Prepare synthetic complete (SC) medium containing 2 % (w/v) glucose and add BSA (concentration not specified); filter the medium through a 0.2 µm filter to ensure sterility and remove particles that could block the microfluidic device.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Inoculate strains into media",
      "instruction": "From each of the five pre‑prepared plates, pick a single colony of the corresponding Saccharomyces cerevisiae strain and inoculate it into 5 mL of the filtered SC + 2 % glucose medium.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Overnight incubation of cultures",
      "instruction": "Incubate the inoculated cultures at 30 °C with shaking for approximately 6 hours (overnight) to allow growth into logarithmic phase.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Dilute cultures to OD 0.1",
      "instruction": "Measure the optical density (OD) of each overnight culture using a GE Ultrospec 10; then dilute each culture into 5 mL of fresh filtered SC + 2 % glucose medium so that the final OD is 0.1, ensuring low cell density and minimal competition for resources.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Final incubation before experiment",
      "instruction": "Incubate the diluted cultures at 30 °C with shaking for 3–4 hours before loading them into the microfluidic device.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
