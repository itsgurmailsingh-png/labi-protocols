  "steps": [
    {
      "step_id": 0,
      "title": "Prepare fluorochrome tyramide solution",
      "instruction": "Create a fluorochrome‑tyramide stock by dissolving, reacting, aliquoting, and storing the Alexa488 succinimidyl ester according to the detailed conditions.",
      "substeps": [
        {
          "instruction": "Dissolve 1 mg (1.6 μmol) Alexa488 succinimidyl ester in 100 μL N,N-dimethylformamide; keep the ester on ice because it is light‑sensitive and prone to hydrolysis.",
          "title": ""
        },
        {
          "instruction": "Add 25.2 μL TYR‑stock to the solution.",
          "title": ""
        },
        {
          "instruction": "Incubate the mixture for 12 h at room temperature (≈20 °C).",
          "title": ""
        },
        {
          "instruction": "Add 874.8 μL absolute ethanol to the incubated mixture.",
          "title": ""
        },
        {
          "instruction": "Make 50 μL aliquots; store at –20 °C (stable for 1 year). Optionally desiccate aliquots in a freeze‑dryer or under vacuum at room temperature and store at –20 °C (stable for years).",
          "title": ""
        },
        {
          "instruction": "For use, reconstitute an aliquot with 50 μL MilliQ water or with N,N-dimethylformamide containing 20 mg/mL 4‑iodophenylboronic acid; keep the reconstituted solution at –20 °C.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare paraformaldehyde fixation solution",
      "instruction": "Prepare a fresh PFA solution of the desired concentration, filter, and store it under the specified conditions while observing safety precautions.",
      "substeps": [
        {
          "instruction": "In a beaker placed in a fume hood, add 70 mL MilliQ water and heat to 60 °C (do not exceed 60 °C).",
          "title": ""
        },
        {
          "instruction": "Add PFA powder to achieve the chosen concentration: 20 g for 20 % (w/v), 15 g for 15 %, or 10 g for 10 %; stir for approximately 1 h until the powder is largely dissolved (PFA dissolution is slow).",
          "title": ""
        },
        {
          "instruction": "Add a few drops of 1 M NaOH to complete dissolution of any remaining powder.",
          "title": ""
        },
        {
          "instruction": "Add 10 mL 10× PBS to the solution.",
          "title": ""
        },
        {
          "instruction": "Check and adjust the pH to about 7.2 if necessary, then bring the final volume to 100 mL with MilliQ water.",
          "title": ""
        },
        {
          "instruction": "Cool the solution to 4 °C, filter it, and store at –20 °C for several weeks or at 4 °C for several days; do not refreeze after defrosting.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
