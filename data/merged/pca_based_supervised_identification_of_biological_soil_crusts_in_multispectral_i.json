  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Load required R packages and define functions",
      "instruction": "In R, load the gatepoints and jpeg packages, then create two functions: plot_jpeg for displaying image objects and plot_PCA for reallocating classification results to image coordinates (code provided in supplementary information).",
      "substeps": [
        {
          "instruction": "library(gatepoints)",
          "title": ""
        },
        {
          "instruction": "library(jpeg)",
          "title": ""
        },
        {
          "instruction": "Define function plot_jpeg(...)",
          "title": ""
        },
        {
          "instruction": "Define function plot_PCA(...)",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Import RGB and NIR images and record dimensions",
      "instruction": "Read the calibrated RGB image (imageRGB.jpg) and the registered NIR image (imageNIR-reg.jpg) with readJPEG, assign them to imgRGB.stat and imgNIR.stat, and store their x‑y dimensions in variable res as the first two elements of dim(imgRGB.stat).",
      "substeps": [
        {
          "instruction": "imgRGB.stat <- readJPEG(\"imageRGB.jpg\")  # load RGB image",
          "title": ""
        },
        {
          "instruction": "imgNIR.stat <- readJPEG(\"imageNIR-reg.jpg\")  # load NIR image",
          "title": ""
        },
        {
          "instruction": "res <- dim(imgRGB.stat)[1:2]",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Construct hypercube and reshape to 1‑D matrix",
      "instruction": "Combine the three channels of the RGB image and the three channels of the NIR image into a 3‑D array named imgMult whose z‑dimension equals the sum of the channel counts of both images; then flatten imgMult to a 2‑D array imgMult.1d with rows equal to res[1]*res[2] and columns equal to (dim(imgRGB.stat)[3] + dim(imgNIR.stat)[3]).",
      "substeps": [
        {
          "instruction": "imgMult <- array(c(imgRGB.stat[,,1:3], imgNIR.stat[,,1:3]), dim = c(res[1], res[2], (dim(imgRGB.stat)[3] + dim(imgNIR.stat)[3])))",
          "title": ""
        },
        {
          "instruction": "imgMult.1d <- array(imgMult, dim = c(res[1]*res[2], (dim(imgRGB.stat)[3] + dim(imgNIR.stat)[3])))",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Perform principal component analysis",
      "instruction": "Run PCA on imgMult.1d with scaling (scale. = TRUE) using prcomp, storing the result in img.PCA; for the example images the first two components explained 9615% of the total variance.",
      "substeps": [
        {
          "instruction": "img.PCA <- prcomp(imgMult.1d, scale. = TRUE)",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Generate PC1‑PC2 density plot and data frame",
      "instruction": "Create a data frame kk2 containing the scores of PC1 and PC2 from img.PCA, then produce a smoothScatter density plot of these two components.",
      "substeps": [
        {
          "instruction": "kk2 <- data.frame(img.PCA$x[,1], img.PCA$x[,2])",
          "title": ""
        },
        {
          "instruction": "smoothScatter(img.PCA$x[,1], img.PCA$x[,2])",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Select spectral features with freehand polygon and visualize",
      "instruction": "Use the fhs function from gatepoints to outline polygons on the PC1‑PC2 scatter (kk2), setting names = FALSE and pch = NA_integer_; points inside polygons are marked TRUE, others FALSE. Close the selection with a right‑click, then display the binary classification with plot_PCA, which renders selected pixels in white and all others in black.",
      "substeps": [
        {
          "instruction": "selectedPoints <- fhs(kk2, names = FALSE, pch = NA_integer_)",
          "title": ""
        },
        {
          "instruction": "plot_PCA(selectedPoints)",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
