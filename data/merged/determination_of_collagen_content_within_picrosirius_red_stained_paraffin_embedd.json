  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Open ZEN Lite software",
      "instruction": "Start ZEN lite 2011 SP1 (version 1.0.1.0); earlier versions have batch‑processing problems.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Open batch processing panel",
      "instruction": "Select the ribbon → Processing → Batch and choose the method “Single file export”.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Set input and output folders",
      "instruction": "Check “Use Input Folder as Output Folder” or browse to choose a different output folder before adding files.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Add ZVI files to batch",
      "instruction": "Click the “+ Add…” button and add all *.zvi files that contain the PSR‑stained sections.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Configure export parameters",
      "instruction": "Mark the first file and set the following parameters: Filetype = jpg (default, Quality = 100 %) **or** tif (highest quality; check “Convert to 8 bit”, Compression = None). Set Resize = 100 %. Check “Apply Display Curve and Channel Color” and “Individual Channels”. Uncheck all other boxes, especially “Create folder”. Note: *.tif files are larger but give the best sensitivity; *.jpg files are smaller and give comparable quantitative results.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Apply parameters to all files",
      "instruction": "With the first file still selected, click “Copy Parameters”. Then mark the second file, press Ctrl + A to select all remaining files, and click “Paste Parameters”. Randomly verify that parameters were copied correctly.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Run the batch export",
      "instruction": "Press the “Run Batch” button. The procedure will generate two channel files per *.zvi file (red channel → *_c1, green channel → *_c2).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Organize exported channel files",
      "instruction": "Move the newly created *_c1 and *_c2 *.jpg or *.tif files to a new folder (e.g., “channels”). Generated channel files do not need permanent storage because they can be re‑extracted from the original *.zvi files if required.",
      "substeps": [],
      "is_critical": true,
      "timers": []
    }
  ],
