  "materials": [
    "Goat anti FOXA2 antibody",
    "Rabbit anti LMX1A antibody",
    "Rabbit anti EN1 antibody",
    "Goat anti OTX2 antibody",
    "Mouse anti TH antibody",
    "Rabbit anti TH antibody",
    "Rabbit anti GIRK2 antibody",
    "Mouse anti-CALB1 antibody",
    "Chicken anti-MAP2 antibody",
    "Cleaved Caspase-3 antibody",
    "Donkey anti-Goat IgG Alexa Fluor 488",
    "Donkey anti-Rabbit IgG Alexa Fluor 568",
    "Donkey anti-Mouse IgG Alexa Fluor 568",
    "TeSR E8",
    "DMEM/F12"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare blocking solution",
      "instruction": "Make a blocking solution containing 5 % donkey serum in PBS with 0.25 % Triton‑X.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Collect MiCOs from EB‑Disk",
      "instruction": "Place the EB‑Disk360 under a stereomicroscope on the flow bench, then use a P1000 pipette to withdraw MiCOs from the microwells; this can be performed at any desired time point for downstream assays such as immunostaining, HPLC, RNA or protein extraction.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Immunostain MiCO sections",
      "instruction": "Perform the following sequential treatments on mounted MiCO sections.",
      "substeps": [
        {
          "instruction": "Permeabilize slides with PBT (0.25 % Triton X in PBS) for 10 min at room temperature (20‑25 °C).",
          "title": ""
        },
        {
          "instruction": "Remove PBT and incubate with blocking solution (5 % donkey serum in PBT) for 1 h at room temperature (20‑25 °C).",
          "title": ""
        },
        {
          "instruction": "Remove blocking solution; draw a circle around each section with a PAP pen, add primary antibodies diluted in blocking solution, and incubate at 4 °C overnight (16‑20 h).",
          "title": ""
        },
        {
          "instruction": "Remove primary antibodies and wash slides 3 × 10 min with PBT.",
          "title": ""
        },
        {
          "instruction": "Block again for 10 min with blocking solution.",
          "title": ""
        },
        {
          "instruction": "Remove blocking solution and incubate with secondary antibodies diluted in blocking solution for 1 h at room temperature (20‑25 °C) in a humid, dark chamber.",
          "title": ""
        },
        {
          "instruction": "Remove secondary antibodies and wash 3 × 10 min with PBT.",
          "title": ""
        },
        {
          "instruction": "Remove PBT and incubate with DAPI (2‑(4‑Amidinophenyl)-6‑indolecarbamidine dihydrochloride) diluted in PBS for 5 min.",
          "title": ""
        },
        {
          "instruction": "Remove DAPI and wash 3 × 5 min with PBS.",
          "title": ""
        },
        {
          "instruction": "Remove PBS, mount slides with coverslips using DABCO.",
          "title": ""
        },
        {
          "instruction": "Allow slides to dry under a fume hood in the dark, then store at 4 °C protected from light.",
          "title": ""
        },
        {
          "instruction": "Image slides using a Zeiss LSM780 confocal microscope.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
