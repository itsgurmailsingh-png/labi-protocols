  "steps": [
    {
      "step_id": 0,
      "title": "Freeze and Prepare Mosquitoes",
      "instruction": "Freeze mosquitoes and separate 1 mosquito per tube. Add 25 uL of fly grinding buffer. Grind mosquitoes with a pestle.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Rinse Pestle",
      "instruction": "Rinse pestle with 25 uL of buffer.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "First Incubation",
      "instruction": "Incubate at 65o C for 30 min 00:30:00.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Add KAc",
      "instruction": "Add 7uL 8M KAc.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Second Incubation",
      "instruction": "Incubate at ice for 30 min 00:30:00.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Centrifuge",
      "instruction": "Centrifuge at max speed for 15 min at RT.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Precipitate DNA",
      "instruction": "Collect supernatant and add 0.7 vol (28 uL over 40 uL) of room temperature of isopropanol (or 1 vol of ice cold 100% EtOH) and incubate for 5 min at room temperature. Centrifuge at RT for 15 min at max speed.",
