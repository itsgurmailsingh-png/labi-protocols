  "steps": [
    {
      "step_id": 0,
      "title": "Grind leaves and add TriZol",
      "instruction": "Grind 100 mg soybean leaves in liquid nitrogen using an autoclaved mortar, transfer the frozen powder to a pre‑autoclaved 1.5 mL microtube and add 1 mL TriZol.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Homogenize sample on ice",
      "instruction": "Homogenize the sample for 5 minutes, keeping the tube in a container on ice.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Add chloroform and mix",
      "instruction": "Add 200 µL chloroform to the sample and mix for 3 minutes.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Centrifuge phase separation",
      "instruction": "Centrifuge at 12 000 rpm, 4 °C for 15 minutes.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Transfer aqueous phase",
      "instruction": "Pipette off 400 µL of the upper aqueous phase and transfer it to a new tube.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Precipitate RNA with isopropanol",
      "instruction": "Add 300 µL ice‑cold isopropanol, mix for 1 minute, then incubate at room temperature for 10 minutes.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Centrifuge RNA pellet",
      "instruction": "Centrifuge at 12 000 rpm, 4 °C for 10 minutes.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Ethanol wash (repeat 3×)",
      "instruction": "Perform ethanol washes of the pellet as described.",
      "substeps": [
        {
          "instruction": "Discard the supernatant and add 1 mL ice‑cold 75 % ethanol while keeping the tube on ice.",
          "title": ""
        },
        {
          "instruction": "Centrifuge at 9 500 rpm, 4 °C for 5 minutes.",
          "title": ""
        },
        {
          "instruction": "Repeat the addition of ethanol and centrifugation two additional times (total three washes).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Air‑dry RNA pellet",
      "instruction": "Dry the pellet at room temperature until no ethanol remains in the microtube.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Resuspend RNA and DNase",
      "instruction": "Dilute the dried pellet in 35 µL RNase‑free water (or water for injections) and treat with DNase.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
