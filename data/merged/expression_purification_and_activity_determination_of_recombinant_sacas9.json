  "protocol_id": "expression_purification_and_activity_determination_of_recombinant_sacas9",
  "parent_protocol_id": null,
  "version_count": 1,
  "title": "Expression, Purification, and Activity Determination of Recombinant SaCas9",
  "author": "Flottmann, Pohl, et al.",
  "doi": "10.1016/j.xpro.2022.101276",
  "source_name": "star_protocols",
