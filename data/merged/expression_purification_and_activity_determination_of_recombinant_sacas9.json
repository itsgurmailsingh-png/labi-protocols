  "quality_score": 4.0,
  "category": "Protein Science",
  "estimated_time_mins": 18,
  "materials": [
    "monoclonal mouse anti SaCas9 antibody",
    "HRP conjugated goat anti mouse Ig antibody",
    "One Shot BL21 Star (DE3) bacteria",
    "kanamycin sulfate",
    "GIPTG",
    "LB-agar",
    "LB-medium",
    "Turbo DNase",
    "lysozyme",
    "proteinase K",
    "Pierce 660 nm Protein Assay Reagent",
    "GeneJET PCR Purification Kit",
    "Trans-Blot Turbo Transfer Pack",
    "western blot substrate",
    "MEGAshortscript T7 Transcription Kit",
    "pET28-SaCas9 plasmid"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Run 8% SDS‑PAGE",
      "instruction": "Prepare an 8% SDS‑PAGE gel and load 50–500 ng of recombinant SaCas9 per lane, then run the gel under standard conditions.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Transfer proteins to membrane",
      "instruction": "Transfer the separated proteins onto a Trans‑Blot Turbo Transfer Pack using the Trans‑Blot Turbo System, following the manufacturer’s instructions.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Block membrane with milk",
      "instruction": "Incubate the membrane in 5% w/v skimmed milk powder dissolved in TBST for 1 hour at 20 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Primary antibody incubation",
      "instruction": "Incubate the blocked membrane with monoclonal mouse anti‑SaCas9 antibody at 0.5 µg/mL in TBST containing 5% w/v skimmed milk powder for 12–16 hours at 4 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Wash membrane after primary",
      "instruction": "Wash the membrane at least five times with TBST.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Secondary antibody incubation",
      "instruction": "Incubate the membrane for 1 hour at 20 °C with HRP‑conjugated polyclonal goat anti‑mouse Ig (dilution 1:5,000) in TBST containing 5% w/v skimmed milk powder.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Wash membrane after secondary",
      "instruction": "Wash the membrane at least five times with TBST.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Detect chemiluminescence",
      "instruction": "Incubate the membrane with WesternBright Quantum HRP substrate according to the manufacturer’s instructions and capture the chemiluminescent signal using an appropriate detection system.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
