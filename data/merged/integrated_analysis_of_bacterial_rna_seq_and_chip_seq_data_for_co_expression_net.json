  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare Linux analysis platform",
      "instruction": "Set up a CentOS Linux workstation with at least 10 × the genome size in RAM, install Conda, and install all required bioinformatics tools (fastqc, bowtie2, samtools, macs2, STAR, htseq, DESeq2) and R packages (ChIPpeakAnno, GenomicFeatures, GenomicRanges).",
      "substeps": [
        {
          "instruction": "Install Miniconda or Anaconda if not present.",
          "title": ""
        },
        {
          "instruction": "conda install -c bioconda fastqc bowtie2 samtools star htseq deseq2",
          "title": ""
        },
        {
          "instruction": "In R, install the packages: BiocManager::install(c('ChIPpeakAnno','GenomicFeatures','GenomicRanges'))",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "ChIP‑seq quality control",
      "instruction": "Run FastQC on the raw ChIP‑seq FASTQ files and inspect the generated reports.",
      "substeps": [
        {
          "instruction": "fastqc -o <output_dir> -t <num_threads> *.gz",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Build Bowtie2 genome index",
      "instruction": "Create a Bowtie2 index for the Pseudomonas syringae genome (FASTA) using 20 threads.",
      "substeps": [
        {
          "instruction": "bowtie2-build --threads 20 Pseudomonas_syringae_genome.fa Pseudomonas_syringae_genome",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Align ChIP‑seq reads",
      "instruction": "Map paired‑end ChIP‑seq reads to the Pseudomonas savastanoi pv. phaseolicola 1448A genome with Bowtie2 (v2.4.5), keeping only uniquely mapped reads.",
      "substeps": [
        {
          "instruction": "bowtie2 -p 20 -x Pseudomonas_syringae_genome -1 R1.fq -2 R2.fq -S Gene_name_batch1.sam",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Convert SAM to filtered BAM",
      "instruction": "Convert the SAM file to BAM, retaining reads with mapping quality ≥255.",
      "substeps": [
        {
          "instruction": "samtools view -q 255 -bS Gene_name_batch1.sam > Gene_name_batch1.bam",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Call ChIP‑seq peaks",
      "instruction": "Use MACS2 to call peaks on the filtered BAM file with the specified parameters.",
      "substeps": [
        {
          "instruction": "macs2 callpeak -t Gene_name_batch1.bam -c Input.batch1.bam -f BAM -g 6264404 -n Gene_name_pval -B -p 1e-5 --nomodel --extsize 75",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Annotate peaks in R",
      "instruction": "Load the peak files and annotate them with ChIPpeakAnno, GenomicFeatures, and GenomicRanges, then write annotation tables.",
      "substeps": [
        {
          "instruction": "library(ChIPpeakAnno)",
          "title": ""
        },
        {
          "instruction": "library(GenomicFeatures)",
          "title": ""
        },
        {
          "instruction": "library(GenomicRanges)",
          "title": ""
        },
        {
          "instruction": "# import peak files into peak_list",
          "title": ""
        },
        {
          "instruction": "for (s in seq_along(peak_list)) {",
          "title": ""
        },
        {
          "instruction": "annotatedPeak <- annotatePeak(peak_list[s], TxDb=txdb, annoDb='org.Ps.eg.db')",
          "title": ""
        },
        {
          "instruction": "df <- as.data.frame(values(annotatedPeak))",
          "title": ""
        },
        {
          "instruction": "write.table(df, file=paste0('1directly_anno/', peak_list[s], '_annotation.txt'),",
          "title": ""
        },
        {
          "instruction": "quote=FALSE, row.names=FALSE, sep='\\t')",
          "title": ""
        },
        {
          "instruction": "}",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "RNA‑seq quality control",
      "instruction": "Run FastQC on the raw RNA‑seq FASTQ files.",
      "substeps": [
        {
          "instruction": "fastqc -o <output_dir> -t <num_threads> *.gz",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Build STAR genome index",
      "instruction": "Generate a STAR index for the P. syringae genome using 20 threads.",
      "substeps": [
        {
          "instruction": "STAR --runMode genomeGenerate --runThreadN 20 --genomeDir STAR_Index_PS --genomeFastaFiles PS_NCBI_genome.fa",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Align RNA‑seq reads with STAR",
      "instruction": "Map paired‑end RNA‑seq reads to the genome with STAR, keeping only uniquely mapped reads and outputting unsorted BAM and gene counts.",
      "substeps": [
        {
          "instruction": "STAR --runThreadN 60 \\",
          "title": ""
        },
        {
          "instruction": "--genomeDir ./STAR_Index_PS \\",
          "title": ""
        },
        {
          "instruction": "--readFilesIn Gene_name-1_combined_R1.fastq.cutadapt.fastq Gene_name-1_combined_R2.fastq.cutadapt.fastq \\",
          "title": ""
        },
        {
          "instruction": "--outFilterMultimapNmax 1 \\",
          "title": ""
        },
        {
          "instruction": "--outFilterMismatchNmax 2 \\",
          "title": ""
        },
        {
          "instruction": "--outSAMtype BAM Unsorted \\",
          "title": ""
        },
        {
          "instruction": "--outFileNamePrefix ./9alignment_batch2/Gene_name_1_ \\",
          "title": ""
        },
        {
          "instruction": "--quantMode GeneCounts",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Count reads with HTSeq‑count",
      "instruction": "Generate gene‑level raw counts from the STAR‑produced BAM using HTSeq‑count with strict intersection on CDS features.",
      "substeps": [
        {
          "instruction": "htseq-count -f bam -r name -s no -t CDS -m intersection-strict Gene_name.bam PS_gene.gtf > Gene_name_intersection_strict_counts_out.txt",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 11,
      "title": "Differential expression with DESeq2",
      "instruction": "Import the count matrix into R, create a DESeqDataSet, run DESeq, extract adjusted‑p‑value results, and save as CSV.",
      "substeps": [
        {
          "instruction": "library(DESeq2)",
          "title": ""
        },
        {
          "instruction": "# Load count tables (example placeholders)",
          "title": ""
        },
        {
          "instruction": "counts <- read.table('Gene_name_intersection_strict_counts_out.txt', header=TRUE, row.names=1)",
          "title": ""
        },
        {
          "instruction": "coldata <- data.frame(row.names=colnames(counts), condition=c('Gene_name','CTRL'))",
          "title": ""
        },
        {
          "instruction": "dds <- DESeqDataSetFromMatrix(countData=counts, colData=coldata, design=~condition)",
          "title": ""
        },
        {
          "instruction": "dds <- DESeq(dds)",
          "title": ""
        },
        {
          "instruction": "res <- results(dds, alpha=0.05)",
          "title": ""
        },
        {
          "instruction": "write.csv(as.data.frame(res), file='Gene_name_DEGs.csv')",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
