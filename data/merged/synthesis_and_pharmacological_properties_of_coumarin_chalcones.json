  "steps": [
    {
      "step_id": 0,
      "title": "Synthesize chalcone 2 (small scale)",
      "instruction": "Dissolve 0.005 mol 3‑acetyl‑4‑hydroxycoumarin and 0.005 mol aromatic aldehyde in 10 mL chloroform in a 50 mL round‑bottom flask. Add 0.005 mol piperidine, reflux the mixture for 1.5 h. After reflux, evaporate the chloroform and recrystallize the residue from methanol to obtain (E)‑4‑hydroxy‑3(3′‑arylacryloyl)‑2H‑benzopyran‑2‑one (compound 2).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Synthesize chalcone 2 (larger scale)",
      "instruction": "Dissolve 0.031 mol 3‑acetyl‑4‑hydroxycoumarin and 0.03 mol substituted aromatic aldehyde in 30 mL chloroform. Add 0.02 mol piperidine (catalytic amount) and reflux for 1.5 h. Remove chloroform by distillation and recrystallize the residue from methanol to afford chalcone 2.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Condense chalcone 2 with 4‑hydroxycoumarin",
      "instruction": "In a suitable flask, dissolve 0.005 mol chalcone 2 in 15 mL glacial acetic acid and add 0.05 mol ammonium acetate; stir at room temperature. Separately dissolve 0.005 mol 4‑hydroxycoumarin in 15 mL glacial acetic acid and add this solution to the first mixture while stirring for 15 min at room temperature. Reflux the combined mixture at 140 °C for 8 h, then stir at room temperature for a further 45 min.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Work‑up and extraction",
      "instruction": "Allow the reaction mixture to cool to room temperature, then pour it into 75 mL ice water. Extract the aqueous phase with chloroform three times (30 mL each). Combine the chloroform extracts and wash first with water, then wash three times with 10 % sodium bicarbonate solution (20 mL each). Dry the organic layer over anhydrous Na₂SO₄, filter, and evaporate chloroform to obtain the crude coumarin‑chalcone product.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Purify and characterize product",
      "instruction": "If necessary, recrystallize the crude product from an appropriate solvent (e.g., methanol). Characterize the isolated compound by ¹H NMR, ¹³C NMR, FT‑IR, and elemental analysis as described in the manuscript.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
