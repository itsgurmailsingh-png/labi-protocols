  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Extract palm oil",
      "instruction": "Place palm biomass in an expeller or mechanical press and collect the extracted oil.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Remove water from oil",
      "instruction": "Transfer the oil to a Soxhlet extractor, heat with a heating mantle, boil the oil to about 110 °C to eliminate water, then allow it to cool to 40 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Prepare methoxide solution",
      "instruction": "Dissolve 0.4 g of concentrated NaOH in 20 mL of methanol (alkanol).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Transesterification reaction",
      "instruction": "Add the methoxide to the cooled oil, regulate the mixture temperature to 60 °C, and stir continuously for 2 hours.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Phase separation",
      "instruction": "Pour the reaction mixture into a separation flask and let it stand for 24 hours; biodiesel will form the upper layer and glycerin will settle at the bottom.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Wash biodiesel",
      "instruction": "Wash the separated biodiesel about five times to remove residual glycerin.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "UV characterization",
      "instruction": "Characterize the washed biodiesel using a UV spectrometer at wavelengths 500 nm, 600 nm, 700 nm, 800 nm, and 900 nm.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Measure viscosity",
      "instruction": "Heat the biodiesel to a constant 40 °C in a viscometer bath tube and measure viscosity using a viscometer with a C value of 7.870 mm²/s.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Prepare fuel blends",
      "instruction": "Mix 10 % biodiesel with 90 % pure diesel to obtain B10, and mix 20 % biodiesel with 80 % diesel to obtain B20; measure each blend with a measuring cylinder and place each in a 1 L bottle.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Engine testing of blends",
      "instruction": "Feed the B10 and B20 blends into the TD 200 test‑bed engine, set engine speeds to 2000, 2150, 2169, 2172, 2193, 2200, and 2500 revolutions per second, and record torque, rotational speed, differential pressure, operational temperature, and power generated at each speed.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Control and secondary calculations",
      "instruction": "Run pure diesel as a control under the same conditions; derive secondary datasets (horsepower, thermal efficiency, normal engine efficiency, brake mean effective pressure) mathematically from the initial measurements.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 11,
      "title": "Measure engine sound",
      "instruction": "Measure the sound of the engine for each fuel (pure diesel, B10, B20) using a sound level meter.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 12,
      "title": "Collect data display",
      "instruction": "Obtain the full dataset from the TQ data display unit.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 13,
      "title": "Simulate results",
      "instruction": "Carry out simulation of the experimental data using Matlab and CERN Root.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
