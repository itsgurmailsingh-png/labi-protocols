  "estimated_time_mins": 84,
  "materials": [
    "Fine-tuning the pre-trained Mask R-CNN model:"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Install Matterport Mask‑RCNN",
      "instruction": "Clone the Matterport Mask‑RCNN repository and install all required Python packages (TensorFlow, Keras, NumPy, etc.) in a virtual environment.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Set up pre‑trained weights",
      "instruction": "Download the COCO pre‑trained weights (label‑bias 0.155) and place them in the weights/ directory; configure the config file to point to these weights.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Download image dataset",
      "instruction": "Obtain the SIIM‑ACR Pneumothorax Segmentation dataset from Kaggle (contains folders stage2 images, dicom_test, dicom_train; total ≈5 GB) and any additional sources referenced.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Examine and convert annotations",
      "instruction": "Open the annotation files, verify their format, and convert each pneumothorax region into a binary mask image matching the corresponding X‑ray.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Standardize and normalize images",
      "instruction": "Resize every chest X‑ray to a uniform size (e.g., 1024 × 1024 pixels), then normalize pixel intensities to zero mean and unit variance.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Apply image augmentation",
      "instruction": "Generate augmented copies of each image‑mask pair using geometric transforms, brightness/contrast adjustments, blurring, sharpening, denoising, enhancing, smoothing, and filtering.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Create training dataset",
      "instruction": "Combine the original and augmented image‑mask pairs into a single training set, ensuring the directory structure matches Mask‑RCNN expectations.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Train Mask‑RCNN model",
      "instruction": "Run training with supervised learning using SGD or Adam optimizer, cross‑entropy loss, learning rate 0.0006 (double to 0.0012 for the Mask‑RCNN heads), for 13 epochs.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Fine‑tune on small dataset",
      "instruction": "Prepare a smaller annotated chest‑X‑ray set with the same preprocessing, then continue training the pre‑trained Mask‑RCNN on this set using the same optimizer and loss function.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Validate model performance",
      "instruction": "Evaluate the trained/fine‑tuned model on a held‑out test set, computing mean Intersection‑over‑Union (IoU) and pixel‑wise accuracy for pneumothorax segmentation.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Analyze model weights",
      "instruction": "Inspect and save the final model weights; optionally visualize feature maps or head parameters to understand learned representations.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
