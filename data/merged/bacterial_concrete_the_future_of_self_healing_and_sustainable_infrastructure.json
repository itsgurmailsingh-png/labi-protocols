  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Select and Prepare Raw Materials",
      "instruction": "Gather Ordinary Portland Cement (OPC) grade 33 (IS 12269:2013) as the binder; obtain fine aggregate (river sand, Zone II, specific gravity 2.65, fineness modulus 2.8) and coarse aggregate (crushed granite, 20 mm size, specific gravity 2.7) complying with IS 383:2016; use clean potable water for mixing and curing; include fly ash (244 kg m⁻³) where required by the mix design.",
      "substeps": [
        {
          "instruction": "Confirm OPC is 33‑grade.",
          "title": ""
        },
        {
          "instruction": "Measure fine aggregate specific gravity (2.65) and fineness modulus (2.8).",
          "title": ""
        },
        {
          "instruction": "Measure coarse aggregate size (20 mm) and specific gravity (2.7).",
          "title": ""
        },
        {
          "instruction": "Verify water is free of impurities.",
          "title": ""
        },
        {
          "instruction": "Prepare fly ash if the mix calls for it.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare Bacterial Suspensions",
      "instruction": "Cultivate the five bacterial strains—Bacillus subtilis, Bacillus licheniformis, Bacillus flexus, Pseudomonas stutzeri, and Escherichia coli—and adjust each culture to the required cell concentration of 10⁴, 10⁵, or 10⁶ cells ml⁻¹ as indicated for each concrete mix.",
      "substeps": [
        {
          "instruction": "Grow each strain under appropriate conditions.",
          "title": ""
        },
        {
          "instruction": "Harvest cells and resuspend in sterile water.",
          "title": ""
        },
        {
          "instruction": "Count cells and dilute or concentrate to reach 10⁴, 10⁵, or 10⁶ cells ml⁻¹.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Formulate Concrete Mixes",
      "instruction": "For each mix designation (M1–M16) weigh cement 399 kg m⁻³, fly ash 244 kg m⁻³ (if specified), fine aggregate 44.87 kg m⁻³, coarse aggregate 100 kg m⁻³, and water 40 kg m⁻³; add the bacterial suspension at the concentration shown in Table 1 (‑‑ for no bacteria, 10⁴, 10⁵, or 10⁶ cells ml⁻¹); mix thoroughly to obtain a homogeneous concrete matrix.",
      "substeps": [
        {
          "instruction": "Weigh cement, fly ash, fine aggregate, coarse aggregate, and water according to the table.",
          "title": ""
        },
        {
          "instruction": "Introduce the bacterial suspension at the prescribed concentration.",
          "title": ""
        },
        {
          "instruction": "Mix using a mechanical mixer until uniform consistency is achieved.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Cast Specimens",
      "instruction": "Pour the fresh concrete into the three types of molds: cubes 15 × 15 × 15 cm for compressive strength, cylinders 15 cm diameter × 30 cm height for splitting tensile strength, and beams 15 × 15 × 750 cm for flexural strength; place concrete in successive layers, compact each layer with tamping rods or vibration, level the top surface, and cover the molds for 24 h to prevent moisture loss.",
      "substeps": [
        {
          "instruction": "Fill molds layer‑by‑layer.",
          "title": ""
        },
        {
          "instruction": "Compact each layer to remove air voids.",
          "title": ""
        },
        {
          "instruction": "Level the surface after the final layer.",
          "title": ""
        },
        {
          "instruction": "Cover molds and keep them undisturbed for 24 hours.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Demold and Water‑Cure",
      "instruction": "After the 24‑hour covering period, demold the specimens and immerse them in clean water for curing until the scheduled testing age of 7 days or 28 days.",
      "substeps": [
        {
          "instruction": "Remove the covering material.",
          "title": ""
        },
        {
          "instruction": "Carefully demold each specimen.",
          "title": ""
        },
        {
          "instruction": "Place specimens in a water tank with continuous water supply.",
          "title": ""
        },
        {
          "instruction": "Maintain curing until the desired testing age (7 d or 28 d).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
