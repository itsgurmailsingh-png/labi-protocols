  "materials": [
    "Glucometer",
    "Glucometer test strips",
    "treadmill",
    "plastic leveler",
    "curved-end forceps",
    "surgical scissors",
    "25 gauge syringe needles",
    "C57BL/6J male mice",
    "transcriptome profiling data",
    "metabolomics data"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Define moderate intensity parameters",
      "instruction": "Set moderate intensity as 45–75% of maximal running capacity, which corresponds to approximately 60% of the maximal velocity (Vmax). For untrained C57BL/6J mice (average Vmax ≈ 40 cm/s), this translates to a constant treadmill speed of 22–25 cm/s.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Record body weight and match cohorts",
      "instruction": "Weigh each mouse and select weight‑matched animals; record all body‑weight values for later analysis.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Set treadmill and lighting conditions",
      "instruction": "Program the treadmill to run at the defined speed of 22–25 cm/s (no slope specified). Document the light‑dark cycle (e.g., 12 h light – 12 h dark) and note the experiment start time using Zeitgeber time (ZT).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Run mice continuously until fatigue",
      "instruction": "Place the mice on the treadmill and run them continuously for several hours (duration varies with time of day) until fatigue is observed (mouse can no longer maintain the set speed despite motivation).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Document run outcomes",
      "instruction": "Record the total run duration, the exact ZT at which the run started and ended, the speed used (22–25 cm/s), and the fatigue point for each mouse.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
