  "materials": [
    "Ethyl 3-aminobenzoate methanesulfonate (MS-222)",
    "Triton X-100",
    "Bovine serum albumin",
    "Donkey serum",
    "Tetramethylrhodamine-dextran",
    "Alexa Fluor 488-dextran",
    "Trizma base",
    "PBS – phosphate-buffered saline",
    "Paraformaldehyde 4% in phosphate buffer",
    "Dumont #5 forceps",
    "Vannas spring scissors",
    "Minutien pins",
    "Silicon carbide lapping sheets",
    "Olympus SZX10 stereo microscope",
    "Zeiss LSM980-Airy2 confocal microscope",
    "Timing: 2 days (for step 5)"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Anesthetize and secure fish",
      "instruction": "Deeply anesthetize each injected zebrafish in 0.1 % MS‑222 solution, place briefly on a paper towel to remove excess water, then glue the fish laterally onto a glass Petri dish with superglue covering head and tail, and immediately submerge the dish in 1× PBS.",
      "substeps": [],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Dissect to expose vertebrae",
      "instruction": "Using surgical tools, remove internal organs, first the skin then the muscle layers, to reveal the vertebrae.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Fix tissue in 4% PFA",
      "instruction": "Discard the 1× PBS, add 4 % paraformaldehyde (PFA) to the dish and keep at 4 °C for 2–24 h to achieve optimal fixation.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Rinse and prepare for isolation",
      "instruction": "After fixation, discard the PFA, rinse once with 1× PBS, and refill the dish with fresh 1× PBS.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Isolate spinal cord under microscope",
      "instruction": "Under a stereomicroscope, use forceps to remove neural spines (ns) and vertebral arches, then remove hemal spines (hs) and the centrum (c) to expose the spinal cord; transfer the isolated cord to a multi‑well plate containing 1× PBS.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Store spinal cord in PBS",
      "instruction": "Keep the isolated spinal cords in 1× PBS at 4 °C and complete subsequent steps within 48 h to avoid dextran‑dye degradation.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Schedule protocol timeline",
      "instruction": "Perform the entire protocol within 10 days; allocate approximately 2 days for the tissue fixation and spinal‑cord isolation steps.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Monitor fluorescence stability",
      "instruction": "Note that fluorescence from the dextran tracers remains detectable for at least one month but gradually loses intensity over time as the dyes degrade.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
