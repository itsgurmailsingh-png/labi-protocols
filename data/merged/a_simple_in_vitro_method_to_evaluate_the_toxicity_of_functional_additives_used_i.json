  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Seed hemolymph and activate hemocytes",
      "instruction": "Deposit hemolymph‑anticoagulant mixture and activate cells with modified HBSS, then incubate.",
      "substeps": [
        {
          "instruction": "Deposit 50 μL mixture of hemolymph‑anticoagulant into each microplate well (final volume 50 μL).",
          "title": ""
        },
        {
          "instruction": "Add 50 μL per well of modified HBSS (MHBSS‑3) containing HBSS 1×, 2.6 g L⁻¹ HEPES, 85 mM NaCl, 12 mM Ca²⁺, 26 mM Mg²⁺, pH 7.2; filter the solution through a 0.22 μm filter before use.",
          "title": ""
        },
        {
          "instruction": "Incubate the plate for 60 min at room temperature to allow hemocyte adherence.",
          "title": ""
        },
        {
          "instruction": "Prepare fresh MHBSS‑3 solution 30 min before use.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Replace supernatant with MHBSS-2",
      "instruction": "Remove the supernatant and add fresh MHBSS‑2 to the adherent hemocytes.",
      "substeps": [
        {
          "instruction": "Aspirate and discard the supernatant from each well.",
          "title": ""
        },
        {
          "instruction": "Immediately add 50 μL per well of MHBSS‑2 containing HBSS 1×, 6 mM Ca²⁺, 12 mM Mg²⁺, pH 7.2.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
