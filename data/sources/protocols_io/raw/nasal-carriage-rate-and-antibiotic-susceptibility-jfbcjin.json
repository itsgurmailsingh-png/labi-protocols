    {
      "title": "",
      "instruction": "Nasal specimen collection protocol"
    },
    {
      "title": "",
      "instruction": "Use the recommended swab to collect the nasal specimen"
    },
    {
      "title": "",
      "instruction": "The swab can be moistened with two drops (about 50 μl) of sterile physiologic saline or used dry."
    },
    {
      "title": "",
      "instruction": "Carefully insert the swab into the study participant’s nostril. The swab should be inserted up to 2.5 cm from the edge of the nares."
    },
    {
      "title": "",
      "instruction": "Roll the swab 5 times."
    },
    {
      "title": "",
      "instruction": "Insert the same swab into the second nostril and repeat sampling as in the preceding step"
    },
    {
      "title": "",
      "instruction": "Return the swab to its container and transport to the laboratory immediately."
    },
    {
