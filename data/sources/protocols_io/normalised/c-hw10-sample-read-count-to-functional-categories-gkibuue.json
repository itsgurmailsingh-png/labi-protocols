  "steps": [
    {
      "step_id": 0,
      "title": "Log into HPC",
      "instruction": "Connect to the high‑performance cluster via SSH (e.g., `ssh hpcice` or `ssh hpc`).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Create analysis directories",
      "instruction": "Make a working directory and subfolders for logs and output, then move into it:",
      "substeps": [
        {
          "instruction": "`mkdir /rsgrps/bh_class/username/function-reads`",
          "title": ""
        },
        {
          "instruction": "`mkdir /rsgrps/bh_class/username/function-reads/std-err`",
          "title": ""
        },
        {
          "instruction": "`mkdir /rsgrps/bh_class/username/function-reads/std-out`",
          "title": ""
        },
        {
          "instruction": "`cd /rsgrps/bh_class/username/function-reads`",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Write uproc PBS script",
      "instruction": "Create a file named `uproc_function.sh` containing the PBS header, environment variable definitions, and the uproc command loop. Edit the FASTQ_DIR variable to point to your unmapped reads directory.",
      "substeps": [
        {
          "instruction": "#!/bin/bash",
          "title": ""
        },
        {
          "instruction": "#PBS -W group_list=bh_class",
          "title": ""
        },
        {
          "instruction": "#PBS -q windfall",
          "title": ""
        },
        {
          "instruction": "#PBS -l jobtype=cluster_only",
          "title": ""
        },
        {
          "instruction": "#PBS -l select=1:ncpus=12:mem=23gb",
          "title": ""
        },
        {
          "instruction": "#PBS -l pvmem=22gb",
          "title": ""
        },
        {
          "instruction": "#PBS -l walltime=24:00:00",
          "title": ""
        },
        {
          "instruction": "#PBS -l cput=24:00:00",
          "title": ""
        },
        {
          "instruction": "#PBS -M netid@email.arizona.edu",
          "title": ""
        },
        {
          "instruction": "#PBS -m bea",
          "title": ""
        },
        {
          "instruction": "#--------------EDIT THESE---------------",
          "title": ""
        },
        {
          "instruction": "FASTQ_DIR=\"/rsgrps/bh_class/username/unmapped\"",
          "title": ""
        },
        {
          "instruction": "OUT_DIR=\"/rsgrps/bh_class/username/function-reads\"",
          "title": ""
        },
        {
          "instruction": "OUTPUT=\"$OUT_DIR/uproc-out\"",
          "title": ""
        },
        {
          "instruction": "#---------------------------------------",
          "title": ""
        },
        {
          "instruction": "export UPROC=\"/rsgrps/bh_class/bin/uproc-dna\"",
          "title": ""
        },
        {
          "instruction": "export DATA=\"/rsgrps/bh_class/data/uproc\"",
          "title": ""
        },
        {
          "instruction": "export UPROC_MODEL=\"$DATA/model\"",
          "title": ""
        },
        {
          "instruction": "export UPROC_OUT_DIR=\"$OUT_DIR/uproc-out\"",
          "title": ""
        },
        {
          "instruction": "export KEGG=\"$DATA/keggready\"",
          "title": ""
        },
        {
          "instruction": "cd $FASTQ_DIR",
          "title": ""
        },
        {
          "instruction": "for file in `cat fastq-list`; do",
          "title": ""
        },
        {
          "instruction": "R1=$FASTQ_DIR/${file}.paired.1.fastq",
          "title": ""
        },
        {
          "instruction": "R2=$FASTQ_DIR/${file}.paired.2.fastq",
          "title": ""
        },
        {
          "instruction": "S=$FASTQ_DIR/${file}.singletons.fastq",
          "title": ""
        },
        {
          "instruction": "$UPROC --preds --short --threads 12 --output $OUTPUT.$file.kegg $KEGG $UPROC_MODEL $R1 $R2 $S",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        },
        {
          "instruction": "# Make sure the script is executable and that the uproc command remains a single line.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Make script executable",
      "instruction": "Run `chmod +x uproc_function.sh` to allow the job script to be submitted.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Submit uproc job",
      "instruction": "Submit the PBS script to the cluster, directing standard error and output to the previously created folders:",
      "substeps": [
        {
          "instruction": "`qsub -e std-err -o std-out uproc_function.sh`",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Summarize uproc output",
      "instruction": "After the job finishes, run a custom summarization script that:",
      "substeps": [
        {
          "instruction": "Iterates over each `uproc-out.$file.kegg` file (where $file is an SRR base name).",
          "title": ""
        },
        {
          "instruction": "Uses `/rsgrps/bh_class/kegg_to_broadcat` to translate KEGG IDs to one of the 31 broad functional categories.",
          "title": ""
        },
        {
          "instruction": "Converts the SRR file name to a body‑site short name (e.g., Um for belly button) using a mapping file that links SRR IDs to sample names, occlusion status, and micro‑environment (example mapping provided in the protocol).",
          "title": ""
        },
        {
          "instruction": "Counts reads per broad category for each sample.",
          "title": ""
        },
        {
          "instruction": "Identifies the five categories with the highest total read counts across all samples; those become Func1–Func5. All remaining categories are summed into a single \"Other\" column (FuncOther).",
          "title": ""
        },
        {
          "instruction": "Writes a tab‑delimited `samples-table` with columns: Sample, Occlusion, MicroEnv, Func1, Func2, Func3, Func4, Func5, FuncOther (example rows shown in the protocol).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Transfer samples table",
      "instruction": "Copy the generated `samples-table` from the HPC to your local workstation:",
      "substeps": [
        {
          "instruction": "`scp sftp.hpc.arizona.edu:/rsgrps/bh_class/username/function-reads/samples-table .`",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Create Anvi'o samples database",
      "instruction": "Generate an Anvi'o samples‑information database from the table:",
      "substeps": [
        {
          "instruction": "`anvi-gen-samples-info-database --samples-information samples-table -o samples.db`",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Visualize results in Anvi'o",
      "instruction": "Launch Anvi'o interactive view using the newly created samples database:",
      "substeps": [
        {
          "instruction": "`anvi-interactive -p SAMPLES-MERGED/PROFILE.db -c contigs.db -s samples.db`",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
