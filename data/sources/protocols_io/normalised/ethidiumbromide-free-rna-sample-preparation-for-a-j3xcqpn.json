        },
        {
          "instruction": "Add 0.5 mM EDTA",
          "title": ""
        },
        {
          "instruction": "Add 0.1 % (w/v) xylencyanole",
          "title": ""
        },
        {
          "instruction": "Add 0.1 % (w/v) bromophenol blue",
          "title": ""
        },
        {
          "instruction": "Mix the solution until homogeneous",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Mix RNA with Midori Green and dye",
      "instruction": "In a micro‑tube, add 5 µL RNA (≈ x µg), then add 2 µL Midori Green Mix, and finally add 7 µL 2× loading dye. Mix gently.",
      "substeps": [
        {
          "instruction": "Add 5 µL RNA (≈ x µg)",
          "title": ""
        },
        {
          "instruction": "Add 2 µL Midori Green Mix",
          "title": ""
        },
        {
          "instruction": "Add 7 µL 2× loading dye",
          "title": ""
        },
        {
          "instruction": "Mix the contents gently",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Denature RNA and load onto gel",
      "instruction": "Denature the mixture by heating at 95 °C for 5 min, then place on ice for 1 min. Briefly centrifuge at ~13 000 g for 15 s, and immediately load the sample onto the agarose gel.",
      "substeps": [
