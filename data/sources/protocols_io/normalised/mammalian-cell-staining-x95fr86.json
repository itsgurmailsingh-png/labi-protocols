  "steps": [
    {
      "step_id": 0,
      "title": "Prepare and Label Flask",
      "instruction": "Label the flask with the cell line, passage number, date, and your initials.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Fix Cells",
      "instruction": "Remove cell culture media and fix the cells using paraformaldehyde.",
      "substeps": [
        {
          "instruction": "Add 100 µL of 4% volume paraformaldehyde solution",
          "title": ""
        },
        {
          "instruction": "Incubate for 00:05:00",
          "title": ""
        },
        {
          "instruction": "Remove paraformaldehyde solution",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Permeabilize Cells",
      "instruction": "Permeabilize the cells using Triton X-100.",
      "substeps": [
        {
          "instruction": "Add 100 µL of 0.1% volume Triton X-100",
          "title": ""
        },
        {
          "instruction": "Incubate for 00:05:00",
          "title": ""
        },
        {
          "instruction": "Remove Triton X-100",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Wash and Block",
      "instruction": "Wash the cells and apply blocking buffer to prevent unspecific binding.",
      "substeps": [
        {
          "instruction": "Wash twice with 100 µL washing buffer (PBS with detergent Tween-20)",
          "title": ""
        },
        {
          "instruction": "Add 100 µL blocking buffer (PBS with BSA)",
          "title": ""
        },
        {
          "instruction": "Incubate for 00:10:00",
          "title": ""
        },
        {
          "instruction": "Remove blocking buffer",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Primary Antibody Staining",
      "instruction": "Apply Anti-Vinculin and blocking buffer mixture to the cells.",
      "substeps": [
        {
          "instruction": "Add 250 µL of Anti-Vinculin and blocking buffer mixture",
          "title": ""
        },
        {
          "instruction": "Incubate for 00:20:00",
          "title": ""
        },
        {
          "instruction": "Remove anti-vinculin blocking buffer mixture",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Wash After Primary Staining",
      "instruction": "Wash the cells following primary antibody incubation.",
      "substeps": [
        {
          "instruction": "Wash twice with washing buffer",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Secondary Antibody Staining",
      "instruction": "Apply FITC:TRITC solution and protect from light.",
      "substeps": [
        {
          "instruction": "Add 100 µL FITC:TRITC solution",
          "title": ""
        },
        {
          "instruction": "Cover in foil",
          "title": ""
        },
        {
          "instruction": "Incubate for 00:30:00",
          "title": ""
        },
        {
          "instruction": "Remove stains",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Nuclear Staining",
      "instruction": "Stain nuclei with DAPI solution and protect from light.",
      "substeps": [
        {
          "instruction": "Add 100 µL of DAPI solution",
          "title": ""
        },
        {
          "instruction": "Cover in foil",
          "title": ""
        },
        {
          "instruction": "Incubate for 00:05:00",
          "title": ""
        },
        {
          "instruction": "Remove DAPI solution",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Final Wash and Imaging",
      "instruction": "Perform final washes and image the cells.",
      "substeps": [
        {
          "instruction": "Wash twice",
          "title": ""
        },
        {
          "instruction": "Add 100 µL PBS",
          "title": ""
        },
        {
          "instruction": "Image cells using UV, Blue, and Green excitation",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
