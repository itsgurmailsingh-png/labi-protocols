      "instruction": "Create an XML file by annotating the tree with the generated annotation file.",
      "substeps": [
        {
          "instruction": "graphlan_annotate.py --annot tmp/BM_SRS013506.annot.txt tmp/BM_SRS013506.tree.txt tmp/BM_SRS013506.xml",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Render GraPhlAn image",
      "instruction": "Render a PNG image from the XML file using graphlan at 200 DPI.",
      "substeps": [
        {
          "instruction": "graphlan.py --dpi 200 tmp/BM_SRS013506.xml output_images/BM_SRS013506.png",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Process all samples batch",
      "instruction": "Loop over every MetaPhlAn profile in profiled_samples, generating tree, annotation, and PNG files for each sample.",
      "substeps": [
        {
          "instruction": "mkdir -p tmp",
          "title": ""
        },
        {
          "instruction": "for file in profiled_samples/*; do",
          "title": ""
        },
        {
          "instruction": "filename=$(basename ${file})",
          "title": ""
        },
        {
          "instruction": "samplename=${filename%.*}",
          "title": ""
        },
        {
          "instruction": "plotting_scripts/metaphlan2graphlan.py ${file} --tree_file tmp/${samplename}.tree.txt --annot_file tmp/${samplename}.annot.txt",
          "title": ""
        },
        {
          "instruction": "graphlan_annotate.py --annot tmp/${samplename}.annot.txt tmp/${samplename}.tree.txt tmp/${samplename}.xml",
          "title": ""
        },
        {
          "instruction": "graphlan.py --dpi 200 tmp/${samplename}.xml output_images/${samplename}.png",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        }
