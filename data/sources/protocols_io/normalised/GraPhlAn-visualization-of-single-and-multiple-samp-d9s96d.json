    {
      "step_id": 1,
      "title": "Generate tree and annotation",
      "instruction": "Run the metaphlan2graphlan.py script on a MetaPhlAn profile to produce a tree file and an annotation file for GraPhlAn.",
      "substeps": [
        {
          "instruction": "plotting_scripts/metaphlan2graphlan.py profiled_samples/BM_SRS013506.txt --tree_file tmp/BM_SRS013506.tree.txt --annot_file tmp/BM_SRS013506.annot.txt",
          "title": ""
