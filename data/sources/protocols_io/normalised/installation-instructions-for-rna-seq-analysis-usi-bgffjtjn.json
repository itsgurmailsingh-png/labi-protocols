  "steps": [
    {
      "step_id": 0,
      "title": "Open terminal and create directory",
      "instruction": "Open a terminal (Ctrl+Alt+T), make a directory named \"softwares\" in your HOME directory, and change into it.",
      "substeps": [
        {
          "instruction": "mkdir $HOME/softwares",
          "title": ""
        },
        {
          "instruction": "cd $HOME/softwares",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Download and install Miniconda",
      "instruction": "Download the 64‑bit Python 3 Miniconda installer and run it in batch mode, installing to $HOME/softwares/conda.",
      "substeps": [
        {
          "instruction": "wget https://repo.continuum.io/miniconda/Miniconda3-latest-Linux-x86_64.sh",
          "title": ""
        },
        {
          "instruction": "bash Miniconda3-latest-Linux-x86_64.sh -bfp $HOME/softwares/conda",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Remove installer and set PATH",
      "instruction": "Delete the installer file, add the new conda bin directory to your PATH permanently, and record the change in your .bashrc.",
      "substeps": [
        {
          "instruction": "rm Miniconda3-latest-Linux-x86_64.sh",
          "title": ""
        },
        {
          "instruction": "export PATH=\"$HOME/softwares/conda/bin:/usr/local/share/rsi/idl/bin:$PATH\"",
          "title": ""
        },
        {
          "instruction": "echo 'export PATH=\"$HOME/softwares/conda/bin:/usr/local/share/rsi/idl/bin:$PATH\"' >> $HOME/.bashrc",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Update base conda packages",
      "instruction": "Update the base conda packages to the latest compatible versions.",
      "substeps": [
        {
          "instruction": "conda update -y -n base conda",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Create rna‑seq YML file",
      "instruction": "Create a YAML file named rna-seq.yml that defines the rna‑seq environment.",
      "substeps": [
        {
          "instruction": "cat > rna-seq.yml",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Build rna‑seq environment",
      "instruction": "Create the conda environment from the YAML file.",
      "substeps": [
        {
          "instruction": "conda env create -f rna-seq.yml",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
