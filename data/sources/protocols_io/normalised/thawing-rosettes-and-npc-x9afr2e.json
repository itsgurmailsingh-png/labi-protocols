  "materials": [
    "DMEM/F12",
    "15 ml conical tube",
    "37 °C water bath",
    "centrifuge",
    "6-well plate",
    "NIM"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare Recovery Medium",
      "instruction": "Aliquot 9 mL of pre-warmed DMEM/F12 into a 15 ml conical tube.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Thaw Cells",
      "instruction": "Remove cells from liquid nitrogen and thaw in a 37 °C water bath for approximately 30 seconds or until a small ice clump remains.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Wash Cells",
      "instruction": "Transfer freshly thawed cells into the 9 mL of pre-warmed DMEM/F12 and mix gently.",
      "substeps": [
        {
          "instruction": "Gently shake the tube 3 times.",
          "title": ""
        },
        {
          "instruction": "Avoid breaking up clumps of cells.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Centrifuge and Collect Cells",
      "instruction": "Centrifuge the cells at 750 rpm for 3 minutes and aspirate the supernatant.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Resuspend and Plate Cells",
      "instruction": "Resuspend the cell pellet in 2 mL of NIM and plate into one well of a 6-well plate.",
      "substeps": [
        {
          "instruction": "If a cell viability count is necessary, remove 10 μl of the resuspension into a separate microfuge tube.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
