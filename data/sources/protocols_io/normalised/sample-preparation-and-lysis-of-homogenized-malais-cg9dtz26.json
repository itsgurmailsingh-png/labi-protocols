      "step_id": 0,
      "title": "Transfer Sample Fractions",
      "instruction": "Transfer specific volumes of the homogenized malaise trap sample fractions into a 2 mL screwcap tube.",
      "substeps": [
        {
          "instruction": "Shake the sample well.",
          "title": ""
        },
        {
          "instruction": "Transfer 800 µL of the small size fraction and 200 µL of the large size fraction to the tube.",
          "title": ""
        },
        {
          "instruction": "Use wide-bore tips or cut off the tip of regular pipette tips if necessary.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Remove Ethanol",
      "instruction": "Remove as much ethanol as possible from the tube using a 1000 µL pipette.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Prepare Lysis Tube",
      "instruction": "Prepare a screwcap tube pre-filled with a few 2 mm zirconia beads for each sample.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Add Lysis Buffer and Proteinase K",
      "instruction": "Add TNES buffer and Proteinase K working solution to the sample and mix.",
      "substeps": [
        {
          "instruction": "Add 900 µL of TNES buffer.",
          "title": ""
        },
        {
          "instruction": "Add 100 µL of Proteinase K working solution.",
          "title": ""
        },
        {
          "instruction": "Vortex shortly.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
