  "steps": [
    {
      "step_id": 0,
      "title": "Perform Initial Deparaffinization and Rehydration",
      "instruction": "Gradually rehydrate the tissue sections through a series of solvent washes.",
      "substeps": [
        {
          "instruction": "Wash 2x for 5 min in Xylene",
          "title": ""
        },
        {
          "instruction": "Wash 2x for 3 min in 100% EtOH",
          "title": ""
        },
        {
          "instruction": "Wash 1x for 2 min in 95% EtOH",
          "title": ""
        },
        {
          "instruction": "Wash 1x for 2 min in 80% EtOH",
          "title": ""
        },
        {
          "instruction": "Wash 1x for 1 min in 70% EtOH",
          "title": ""
        },
        {
          "instruction": "Wash in running tap water for 3 min",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Stain with Hematoxylin",
      "instruction": "Incubate the sections in hematoxylin for 8 min.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Rinse Hematoxylin",
      "instruction": "Wash in running tap water for 10 min.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Stain with Picrosirius Red",
      "instruction": "Incubate for 60 min in Picrosirius red solution (do not shorten this time).",
      "substeps": [],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Wash with Acidified Water",
      "instruction": "Wash 2x for 5 min in acidified H2O, changing the solution after each wash.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Perform Dehydration",
      "instruction": "Gradually dehydrate the sections through an increasing gradient of ethanol.",
      "substeps": [
        {
          "instruction": "Wash 1x for 1 min in 70% EtOH",
          "title": ""
        },
        {
          "instruction": "Wash 1x for 1 min in 80% EtOH",
          "title": ""
        },
        {
          "instruction": "Wash 1x for 1 min in 95% EtOH",
          "title": ""
        },
        {
          "instruction": "Wash 1x for 1 min in 100% EtOH",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Clear Sections in Xylene",
      "instruction": "Wash 2x for 3 min in Xylene.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
