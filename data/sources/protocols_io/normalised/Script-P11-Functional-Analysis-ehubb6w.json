{
  "protocol_id": "functional_analysis_protocol_for_kegg_and_gene_ontology",
  "parent_protocol_id": null,
  "title": "Functional Analysis Protocol for KEGG and Gene Ontology",
  "author": "HANNIGAN GD",
  "license": "CC-BY 4.0",
  "license_verified": true,
  "license_note": "Confirmed via CrossRef DOI metadata: dx.doi.org/10.17504/protocols.io.ehubb6w",
  "source_name": "protocols_io",
  "source_id": "2324",
  "source_url": "https://www.protocols.io/view/Script-P11-Functional-Analysis-ehubb6w",
  "doi": "dx.doi.org/10.17504/protocols.io.ehubb6w",
  "citation": "dx.doi.org/10.17504/protocols.io.ehubb6w",
  "category": "Bioinformatics",
  "estimated_time_mins": 174,
  "materials": [
    "Merge the abundances with the OPF names.",
    "Format the contig IDs."
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Download HUMAnN software",
      "instruction": "Download the HUMAnN 0.99 program from the official source (e.g., https://huttenhower.sph.harvard.edu/humann) and install it according to the provided instructions.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Subsample reads to 10 000",
      "instruction": "Create working directories, subsample each FASTQ file in ./MetaPhlAn_trimmed/input_reads to exactly 10 000 reads with seqtk, convert the subsampled FASTQ to FASTA, and remove the intermediate FASTQ files.",
      "substeps": [
        {
          "instruction": "mkdir -p ./HUMAnN_10k/subsampled_input",
          "title": ""
        },
        {
          "instruction": "for file in $(ls ./MetaPhlAn_trimmed/input_reads); do",
          "title": ""
        },
        {
          "instruction": "seqtk sample ./MetaPhlAn_trimmed/input_reads/$file 10000 > ./HUMAnN_10k/subsampled_input/${file/fastq/_subsampled.fastq}",
          "title": ""
        },
        {
          "instruction": "seqtk seq -a ./HUMAnN_10k/subsampled_input/${file/fastq/_subsampled.fastq} > ./HUMAnN_10k/subsampled_input/${file/.fastq/_subsampled.fa}",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        },
        {
          "instruction": "cd ./HUMAnN_10k/subsampled_input && rm *.fastq",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Discard low‑read samples",
      "instruction": "Identify samples that contain fewer than 10 000 reads and remove them from further analysis. The excluded metagenome samples are MG100184 and MG100755; the excluded virome samples are MG100099, MG100105, MG100416, MG100497, and MG100613.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "BLASTx subsampled reads against KEGG",
      "instruction": "Run blastx in parallel on each subsampled FASTA file against the reduced KEGG database (references/kegg/kegg.reduced.fasta) using 2 threads per job; use an e‑value of 1e‑10 for metagenome samples and 1e‑5 for virome samples.",
      "substeps": [
        {
          "instruction": "export -f run.blast.parallel.for.kegg.HUMAnN",
          "title": ""
        },
        {
          "instruction": "run.blast.parallel.for.kegg.HUMAnN () {",
          "title": ""
        },
        {
          "instruction": "blastx -query ./HUMAnN_10k/subsampled_input/${1}.fa \\",
          "title": ""
        },
        {
          "instruction": "-out ./HUMAnN_10k/humann-0.99/input/${1}.blastx \\",
          "title": ""
        },
        {
          "instruction": "-db references/kegg/kegg.reduced.fasta \\",
          "title": ""
        },
        {
          "instruction": "-outfmt 6 -num_threads 2 -evalue 1e-10",
          "title": ""
        },
        {
          "instruction": "}",
          "title": ""
        },
        {
          "instruction": "ls ./HUMAnN_10k/subsampled_input/ | sed -e 's/^.*\\/.*\\///' -e 's/\\.fa//' | \\",
          "title": ""
        },
        {
          "instruction": "xargs -I {} --max-procs=128 sh -c 'run.blast.parallel.for.kegg.HUMAnN {}'",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Run HUMAnN analysis",
      "instruction": "Execute the HUMAnN pipeline (version 0.99) using scons in its working directory.",
      "substeps": [
        {
          "instruction": "cd ./HUMAnN_10k/humann-0.99",
          "title": ""
        },
        {
          "instruction": "scons",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Prepare GOEAST input files",
      "instruction": "Group samples by microenvironment (sebaceous, moist, intermittently moist) and create separate mapping files that list sample IDs (column 1) and site symbols (column 5).",
      "substeps": [
        {
          "instruction": "# Sebaceous skin metagenome samples",
          "title": ""
        },
        {
          "instruction": "cat SkinMet_001_metadata_subset.tsv | awk '$5==\"Fh\" || $5==\"Ra\" || $5==\"Sc\" {print $1}' > sebaceous_skinmet_samples.txt",
          "title": ""
        },
        {
          "instruction": "# Moist skin metagenome samples",
          "title": ""
        },
        {
          "instruction": "cat SkinMet_001_metadata_subset.tsv | awk '$5==\"Ax\" || $5==\"Um\" || $5==\"Tw\" {print $1}' > moist_skinmet_samples.txt",
          "title": ""
        },
        {
          "instruction": "# Intermittently moist skin metagenome samples",
          "title": ""
        },
        {
          "instruction": "cat SkinMet_001_metadata_subset.tsv | awk '$5==\"Ac\" || $5==\"Pa\" {print $1}' > rimoist_skinmet_samples.txt",
          "title": ""
        },
        {
          "instruction": "# Sebaceous virome samples",
          "title": ""
        },
        {
          "instruction": "cat Virome_001_metadata_subset.tsv | awk '$5==\"Fh\" || $5==\"Ra\" || $5==\"Sc\" {print $1}' > sebaceous_virome_samples.txt",
          "title": ""
        },
        {
          "instruction": "# Moist virome samples",
          "title": ""
        },
        {
          "instruction": "cat Virome_001_metadata_subset.tsv | awk '$5==\"Ax\" || $5==\"Um\" || $5==\"Tw\" {print $1}' > moist_virome_samples.txt",
          "title": ""
        },
        {
          "instruction": "# Intermittently moist virome samples",
          "title": ""
        },
        {
          "instruction": "cat Virome_001_metadata_subset.tsv | awk '$5==\"Ac\" || $5==\"Pa\" {print $1}' > rimoist_virome_samples.txt",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Subsample ORFs and BLASTx against SwissProt",
      "instruction": "For each glimmer3 ORF file, remove block formatting, subsample 1 000 sequences, and blastx against the UniProt/SwissProt database (e‑value 1e‑10, max_target_seqs 1, 16 threads).",
      "substeps": [
        {
          "instruction": "mkdir -p ./glimmer3/orf_uniprot_blast_swissprot_sub",
          "title": ""
        },
        {
          "instruction": "export -f runblastxorfs",
          "title": ""
        },
        {
          "instruction": "runblastxorfs () {",
          "title": ""
        },
        {
          "instruction": "# Remove block formatting",
          "title": ""
        },
        {
          "instruction": "fasta_formatter -w 0 ./glimmer3/output/${1}_no_block.genes",
          "title": ""
        },
        {
          "instruction": "# Subsample 1000 reads",
          "title": ""
        },
        {
          "instruction": "seqtk sample ./glimmer3/output/${1}_no_block.genes 1000 > ./glimmer3/orf_uniprot_blast_swissprot_sub/${1}_sub.genes",
          "title": ""
        },
        {
          "instruction": "# BLASTx",
          "title": ""
        },
        {
          "instruction": "blastx -query ./glimmer3/orf_uniprot_blast_swissprot_sub/${1}_sub.genes \\",
          "title": ""
        },
        {
          "instruction": "-out ./glimmer3/orf_uniprot_blast_swissprot_sub/${1}_orf_uniprot_blastx.txt \\",
          "title": ""
        },
        {
          "instruction": "-db references/SwissProt/uniprot_sprot.fasta \\",
          "title": ""
        },
        {
          "instruction": "-outfmt 6 -num_threads 16 -evalue 1e-10 -max_target_seqs 1",
          "title": ""
        },
        {
          "instruction": "}",
          "title": ""
        },
        {
          "instruction": "ls ./glimmer3/output/*_no_block.genes | sed -e 's/^.*\\/.*\\///' -e 's/_no_block\\.genes//' | \\",
          "title": ""
        },
        {
          "instruction": "xargs -I {} --max-procs=128 sh -c 'runblastxorfs {}'",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Download and format GO‑UniProt mapping",
      "instruction": "Retrieve the GOA UniProt association file, decompress it, discard the first 24 header lines, and extract the UniProt accession (column 2) and GO ID (column 4) into a two‑column file named gp_association.goa_uniprot.goeast_formatted.",
      "substeps": [
        {
          "instruction": "wget ftp://ftp.ebi.ac.uk/pub/databases/GO/goa/UNIPROT/gp_association.goa_uniprot.gz",
          "title": ""
        },
        {
          "instruction": "gunzip gp_association.goa_uniprot.gz",
          "title": ""
        },
        {
          "instruction": "tail -n +24 gp_association.goa_uniprot | awk '{print $2,$4}' > gp_association.goa_uniprot.goeast_formatted",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Combine samples by microenvironment",
      "instruction": "For each *_samples.txt file, concatenate the corresponding ORF‑UniProt BLASTx results, format unique probe IDs, and produce a list of unique probes for downstream GO mapping.",
      "substeps": [
        {
          "instruction": "for file in $(ls *_samples.txt); do",
          "title": ""
        },
        {
          "instruction": "name=${file/samples.txt/uniprot_blastx.txt}",
          "title": ""
        },
        {
          "instruction": "> $name   # empty/initialize",
          "title": ""
        },
        {
          "instruction": "for sample in $(cat $file); do",
          "title": ""
        },
        {
          "instruction": "cat ${sample}_orf_uniprot_blastx.txt >> $name",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        },
        {
          "instruction": "awk '{print $1\"\\t\"$2}' $name | sed 's/.orf[0-9]*//g' | sed 's/sp|//g' | sed 's/|.*//g' | sort -u > ${name/.txt/_formatted_unique.txt}",
          "title": ""
        },
        {
          "instruction": "cut -f 1 ${name/.txt/_formatted_unique.txt} | sort -u > ${name/.txt/_unique_probes.txt}",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Annotate UniProt hits with GO IDs",
      "instruction": "For each microenvironment (sebaceous, moist, intermittently moist), join the formatted unique hits with the GO mapping file, extract GO IDs, and create a formatted GO‑ID file where each line contains the probe ID followed by its GO terms.",
      "substeps": [
        {
          "instruction": "# Sebaceous",
          "title": ""
        },
        {
          "instruction": "cat sebaceous_skinmet_uniprot_blastx_unique_probes.txt sebaceous_virome_uniprot_blastx_unique_probes.txt > sebaceous_probes.txt",
          "title": ""
        },
        {
          "instruction": "cat sebaceous_skinmet_uniprot_blastx_formatted_unique.txt sebaceous_virome_uniprot_blastx_formatted_unique.txt | sort -u -k2 > sebaceous_hits.txt",
          "title": ""
        },
        {
          "instruction": "join -1 2 -2 1 sebaceous_hits.txt gp_association.goa_uniprot.goeast_formatted > sebaceous_GO_ids.txt",
          "title": ""
        },
        {
          "instruction": "awk '{print $2\"\\t\"$3}' sebaceous_GO_ids.txt | sort -u > sebaceous_GO_ids_unique.txt",
          "title": ""
        },
        {
          "instruction": "for line in $(cat sebaceous_probes.txt); do",
          "title": ""
        },
        {
          "instruction": "grep -w \"$line\" sebaceous_GO_ids_unique.txt | perl -pe 's/$line/\\/\\//g' | tr '\\t' ' ' | tr '\\n' ' ' | \\",
          "title": ""
        },
        {
          "instruction": "sed 's/^\\/\\///' | sed 's/$/\\n/' | sed \"s/^/$line\\t/\" >> sebaceous_GO_ids_formatted.txt",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        },
        {
          "instruction": "# Moist",
          "title": ""
        },
        {
          "instruction": "cat moist_skinmet_uniprot_blastx_unique_probes.txt moist_virome_uniprot_blastx_unique_probes.txt > moist_probes.txt",
          "title": ""
        },
        {
          "instruction": "cat moist_skinmet_uniprot_blastx_formatted_unique.txt moist_virome_uniprot_blastx_formatted_unique.txt | sort -u -k2 > moist_hits.txt",
          "title": ""
        },
        {
          "instruction": "join -1 2 -2 1 moist_hits.txt gp_association.goa_uniprot.goeast_formatted > moist_GO_ids.txt",
          "title": ""
        },
        {
          "instruction": "awk '{print $2\"\\t\"$3}' moist_GO_ids.txt | sort -u > moist_GO_ids_unique.txt",
          "title": ""
        },
        {
          "instruction": "for line in $(cat moist_probes.txt); do",
          "title": ""
        },
        {
          "instruction": "grep -w \"$line\" moist_GO_ids_unique.txt | perl -pe 's/$line/\\/\\//g' | tr '\\t' ' ' | tr '\\n' ' ' | \\",
          "title": ""
        },
        {
          "instruction": "sed 's/^\\/\\///' | sed 's/$/\\n/' | sed \"s/^/$line\\t/\" >> moist_GO_ids_formatted.txt",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        },
        {
          "instruction": "# Intermittently moist",
          "title": ""
        },
        {
          "instruction": "cat rimoist_skinmet_uniprot_blastx_unique_probes.txt rimoist_virome_uniprot_blastx_unique_probes.txt > rimoist_probes.txt",
          "title": ""
        },
        {
          "instruction": "cat rimoist_skinmet_uniprot_blastx_formatted_unique.txt rimoist_virome_uniprot_blastx_formatted_unique.txt | sort -u -k2 > rimoist_hits.txt",
          "title": ""
        },
        {
          "instruction": "join -1 2 -2 1 rimoist_hits.txt gp_association.goa_uniprot.goeast_formatted > rimoist_GO_ids.txt",
          "title": ""
        },
        {
          "instruction": "awk '{print $2\"\\t\"$3}' rimoist_GO_ids.txt | sort -u > rimoist_GO_ids_unique.txt",
          "title": ""
        },
        {
          "instruction": "for line in $(cat rimoist_probes.txt); do",
          "title": ""
        },
        {
          "instruction": "grep -w \"$line\" rimoist_GO_ids_unique.txt | perl -pe 's/$line/\\/\\//g' | tr '\\t' ' ' | tr '\\n' ' ' | \\",
          "title": ""
        },
        {
          "instruction": "sed 's/^\\/\\///' | sed 's/$/\\n/' | sed \"s/^/$line\\t/\" >> rimoist_GO_ids_formatted.txt",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Cluster ORFs into operational protein families",
      "instruction": "Sort the ORF fasta file, cluster sequences at 75 % identity with uclust, convert the clustering output to fasta, and extract representative sequences.",
      "substeps": [
        {
          "instruction": "mkdir -p ./define_core_protein_clusters",
          "title": ""
        },
        {
          "instruction": "echo \"Sorting fasta with uclust...\"",
          "title": ""
        },
        {
          "instruction": "uclust --sort ./glimmer3/output/Contigs_no_block_with_names_glimmer_output_final.fa \\",
          "title": ""
        },
        {
          "instruction": "--output ./define_core_protein_clusters/glimmer_final_sorted.fa",
          "title": ""
        },
        {
          "instruction": "echo \"Clustering at 75% identity...\"",
          "title": ""
        },
        {
          "instruction": "uclust --input ./define_core_protein_clusters/glimmer_final_sorted.fa \\",
          "title": ""
        },
        {
          "instruction": "--uc ./define_core_protein_clusters/protein_clusters_uclust.txt \\",
          "title": ""
        },
        {
          "instruction": "--id 0.75",
          "title": ""
        },
        {
          "instruction": "echo \"Converting uclust output to fasta...\"",
          "title": ""
        },
        {
          "instruction": "uclust --uc2fasta ./define_core_protein_clusters/protein_clusters_uclust.txt \\",
          "title": ""
        },
        {
          "instruction": "--input ./define_core_protein_clusters/glimmer_final_sorted.fa \\",
          "title": ""
        },
        {
          "instruction": "--output ./define_core_protein_clusters/protein_clusters_with_repeats.fa",
          "title": ""
        },
        {
          "instruction": "echo \"Pulling out representative seqs...\"",
          "title": ""
        },
        {
          "instruction": "grep -A 1 \"*\" ./define_core_protein_clusters/protein_clusters_with_repeats.fa | \\",
          "title": ""
        },
        {
          "instruction": "grep -v -P '^--' > ./define_core_protein_clusters/protein_clusters.fa",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 11,
      "title": "Calculate protein cluster lengths",
      "instruction": "Create a tab‑delimited file with each cluster’s identifier and its sequence length, then produce a version without the leading ‘>’ character.",
      "substeps": [
        {
          "instruction": "awk 'NR % 2 {printf $0\"\\t\"} !(NR % 2) {print length($0)}' ./define_core_protein_clusters/protein_clusters.fa > ./define_core_protein_clusters/protein_cluster_length.txt",
          "title": ""
        },
        {
          "instruction": "sed 's/>//g' ./define_core_protein_clusters/protein_cluster_length.txt > ./define_core_protein_clusters/protein_cluster_length_no_greater_sign.txt",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 12,
      "title": "Map reads to OPFs with Bowtie2",
      "instruction": "Build a Bowtie2 index (assumed pre‑built as ./protein_cluster_rel_abund_table/bowtie2_contig_build) and align each negative‑clean sequence file against it using 25‑bp seed length and 1 mismatch; output SAM files.",
      "substeps": [
        {
          "instruction": "export -f run_bowtie2_against_contigs",
          "title": ""
        },
        {
          "instruction": "run_bowtie2_against_contigs () {",
          "title": ""
        },
        {
          "instruction": "if [ -f /etc/profile.d/modules.sh ]; then source /etc/profile.d/modules.sh; fi",
          "title": ""
        },
        {
          "instruction": "module load bowtie2-2.1.0",
          "title": ""
        },
        {
          "instruction": "bowtie2 -x ./protein_cluster_rel_abund_table/bowtie2_contig_build \\",
          "title": ""
        },
        {
          "instruction": "-f ./negative_clean_seqs/$1 \\",
          "title": ""
        },
        {
          "instruction": "-S ./protein_cluster_rel_abund_table/bowtie2_neg_cleaned_hits/$1 \\",
          "title": ""
        },
        {
          "instruction": "-L 25 -N 1",
          "title": ""
        },
        {
          "instruction": "}",
          "title": ""
        },
        {
          "instruction": "ls ./negative_clean_seqs/ | xargs -I {} --max-procs=128 sh -c 'run_bowtie2_against_contigs {}'",
          "title": ""
        },
        {
          "instruction": "mkdir -p ./protein_cluster_rel_abund_table/bowtie2_neg_cleaned_hits",
          "title": ""
        },
        {
          "instruction": "for file in $(ls ./protein_cluster_rel_abund_table/bowtie2_neg_cleaned_hits); do",
          "title": ""
        },
        {
          "instruction": "mv ./protein_cluster_rel_abund_table/bowtie2_neg_cleaned_hits/$file \\",
          "title": ""
        },
        {
          "instruction": "./protein_cluster_rel_abund_table/bowtie2_neg_cleaned_hits/${file/%.fa/.sam}",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 13,
      "title": "Calculate abundances from SAM files",
      "instruction": "Run the provided Perl script calculate_abundance_from_sam.pl on each SAM file to obtain raw read counts per protein cluster.",
      "substeps": [
        {
          "instruction": "mkdir -p ./protein_cluster_rel_abund_table/abundance_from_sam",
          "title": ""
        },
        {
          "instruction": "for file in $(ls ./protein_cluster_rel_abund_table/bowtie2_neg_cleaned_hits); do",
          "title": ""
        },
        {
          "instruction": "perl calculate_abundance_from_sam.pl \\",
          "title": ""
        },
        {
          "instruction": "./protein_cluster_rel_abund_table/bowtie2_neg_cleaned_hits/${file} \\",
          "title": ""
        },
        {
          "instruction": "./protein_cluster_rel_abund_table/abundance_from_sam/${file}",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        },
        {
          "instruction": "# Rename .sam to .txt for downstream processing",
          "title": ""
        },
        {
          "instruction": "for file in $(ls ./protein_cluster_rel_abund_table/abundance_from_sam); do",
          "title": ""
        },
        {
          "instruction": "mv ./protein_cluster_rel_abund_table/abundance_from_sam/${file} \\",
          "title": ""
        },
        {
          "instruction": "./protein_cluster_rel_abund_table/abundance_from_sam/${file/.sam/.txt}",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 14,
      "title": "Compute RPKM values",
      "instruction": "For each abundance file, sum all read counts, then calculate RPKM for each protein cluster using its length; output a file with contig ID, raw count, length, and RPKM.",
      "substeps": [
        {
          "instruction": "mkdir -p ./protein_cluster_rel_abund_table/abundance_with_length",
          "title": ""
        },
        {
          "instruction": "for file in $(ls ./protein_cluster_rel_abund_table/abundance_from_sam); do",
          "title": ""
        },
        {
          "instruction": "SUM=$(awk '{ SUM += $2 } END { print SUM }' ./protein_cluster_rel_abund_table/abundance_from_sam/${file})",
          "title": ""
        },
        {
          "instruction": "echo \"Sum is $SUM\"",
          "title": ""
        },
        {
          "instruction": "awk --assign=sum=$SUM 'FNR==NR { a[$1]=$2; next } $1 in a {",
          "title": ""
        },
        {
