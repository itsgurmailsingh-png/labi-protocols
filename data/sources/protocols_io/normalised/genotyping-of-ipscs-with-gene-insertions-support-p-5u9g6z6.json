  "steps": [
    {
      "step_id": 0,
      "title": "Prepare PCR reaction mix",
      "instruction": "For each 10 µL PCR, combine 1 µL of 10 µM Primer 1, 1 µL of 10 µM Primer 2, 1 µL purified genomic DNA from the iPSC clone, 2 µL H₂O, and 5 µL 2× PCR Master Mix.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Run PCR amplification",
      "instruction": "Place the prepared reactions in a thermocycler and run the appropriate PCR program for the chosen primer pair.",
      "substeps": [
        {
          "instruction": "If the samples were obtained after Cre excision, increase the extension time to allow detection of the larger un‑excised template in heterogeneous cultures.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Electrophorese PCR products",
      "instruction": "Load the PCR products onto a 1 % agarose gel and run electrophoresis; interpret band patterns according to the expected sizes for each primer pair.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
