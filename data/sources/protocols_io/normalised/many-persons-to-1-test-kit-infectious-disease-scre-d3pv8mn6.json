  "steps": [
    {
      "step_id": 0,
      "title": "Define Basic Units",
      "instruction": "Identify the basic units for screening based on the environment (e.g., housing units in a complex, cabins on a cruise ship, cubicles in an office, classrooms/seating sections in schools, or houses in a village).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Pool Samples from Basic Units",
      "instruction": "Collect samples (e.g., sputum) from all members of each basic unit and pool them together.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Concentrate Pooled Samples",
      "instruction": "If necessary, reduce the volume of the sample pool to fit the sample volume size of the commercial virus/pathogen extraction kit using a microconcentrator and centrifuge.",
      "substeps": [
        {
          "instruction": "Select a microconcentrator based on starting volume (0.5, 2, 4, or 15mL) and outside diameter (11, 16, 23, or 30mm).",
          "title": ""
        },
        {
          "instruction": "Use a filter with an appropriate NMWL (e.g., 100kDa for coronavirus).",
          "title": ""
        },
        {
          "instruction": "Centrifuge to achieve a concentration factor of 60 to 100X (typically 100X in about 15 minutes).",
          "title": ""
        },
        {
          "instruction": "For low pathogen copy numbers (e.g., swabs after 1st week of symptom onset), ensure individual sample contribution is not substantially below 1mL and concentrate the pool to a final volume of 400uL.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Perform Primary Screening",
      "instruction": "Send the pooled/concentrated samples for reaction to identify which basic units are infected.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Identify and Treat Individuals",
      "instruction": "Perform individual testing only for members of the basic units identified as infected to determine who requires treatment.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
