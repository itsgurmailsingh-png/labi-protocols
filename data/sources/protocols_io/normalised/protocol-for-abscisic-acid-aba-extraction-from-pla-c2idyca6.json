  "materials": [
    "Safe-Lock 2.0 mL Eppendorf tube",
    "beads",
    "balance",
    "Standard solution",
    "sonicator",
    "centrifuge",
    "vacuum speedVac",
    "acetonitrile",
    "water",
    "0.22 µm filter",
    "0.1 mL micro-insert",
    "UHPLC-Triple-Stage Quadrupole",
    "Weight 100 mg fine powder of ground seeds.",
    "Tap the bottle to remove any bubbles.",
    "ABA quantification is performed by LC-MS/MS using a UHPLC-Triple-Stage Quadrupole Mass Spectrometer (Thermo Scientific Altis) machine."
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Grind Plant Seeds",
      "instruction": "Grind 7-8 seeds in a Safe-Lock 2.0 mL Eppendorf tube containing 3-4 beads.",
      "substeps": [
        {
          "instruction": "Set duration to 00:01:00",
          "title": ""
        },
        {
          "instruction": "Set frequency to 25-26 Hz",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "First Extraction Cycle",
      "instruction": "Perform the first extraction of the ground seeds.",
      "substeps": [
        {
          "instruction": "Add 1 mL of Standard solution to each tube",
          "title": ""
        },
        {
          "instruction": "Sonicate the samples for 00:15:00",
          "title": ""
        },
        {
          "instruction": "Centrifuge at 14000 rpm for 5 minutes",
          "title": ""
        },
        {
          "instruction": "Transfer the supernatant to a new 2 mL Eppendorf tube",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Second Extraction Cycle",
      "instruction": "Perform a second extraction to maximize yield.",
      "substeps": [
        {
          "instruction": "Add another 1 mL of Standard solution to the original tube",
          "title": ""
        },
        {
          "instruction": "Sonicate for 00:15:00",
          "title": ""
        },
        {
          "instruction": "Centrifuge at 14000 rpm for 5 minutes",
          "title": ""
        },
        {
          "instruction": "Transfer the supernatant (2 mL total) to a 2 mL Eppendorf tube",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Evaporate Solvent",
      "instruction": "Dry the combined supernatant under vacuum using a speedVac for 02:00:00.",
      "substeps": [
        {
          "instruction": "After evaporation, either store samples at -20 °C or proceed immediately to the next step",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Re-dissolve and Filter Extract",
      "instruction": "Prepare the final extract for injection.",
      "substeps": [
        {
          "instruction": "Re-dissolve the final extract in 120 µL of acetonitrile : water [25:75 (v/v)]",
          "title": ""
        },
        {
          "instruction": "Sonicate for 00:01:00",
          "title": ""
        },
        {
          "instruction": "Filter the re-suspended solution through a 0.22 µm filter into 0.1 mL micro-insert 29x5.7 mm clear glass tubes with inserted vials",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Configure HPLC Separation",
      "instruction": "Set up the chromatographic separation using a Hypersil GOLD C18 Selectivity HPLC Column (150 × 4.6 mm; 3 μm; fisher scientific).",
      "substeps": [
        {
          "instruction": "Prepare mobile phases: water (A) and acetonitrile (B), both containing 0.1% formic acid",
          "title": ""
        },
        {
          "instruction": "Set flow rate to 0.5 mL/min",
          "title": ""
        },
        {
          "instruction": "Apply linear gradient: 0–10 min, 15%–100% B",
          "title": ""
        },
        {
          "instruction": "Wash with 100% B for 00:05:00",
          "title": ""
        },
        {
          "instruction": "Equilibrate with 15% B for 00:02:00",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Inject Sample and Run HPLC",
      "instruction": "Inject the sample and maintain column conditions.",
      "substeps": [
        {
          "instruction": "Inject 10 µL of sample",
          "title": ""
        },
        {
          "instruction": "Maintain column temperature at 35 °C for each run",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Configure MS Parameters",
      "instruction": "Set the Thermo ScientificTM AltisTM MS parameters as follows:",
      "substeps": [
        {
          "instruction": "Mode: negative",
          "title": ""
        },
        {
          "instruction": "Ion source: H-ESI",
          "title": ""
        },
        {
          "instruction": "Ion spray voltage: 3000 V",
          "title": ""
        },
        {
          "instruction": "Sheath gas: 40 arbitrary units",
          "title": ""
        },
        {
          "instruction": "Aux gas: 15 arbitrary units",
          "title": ""
        },
        {
          "instruction": "Sweep gas: 0 arbitrary units",
          "title": ""
        },
        {
          "instruction": "Ion transfer tube gas temperature: 350 °C",
          "title": ""
        },
        {
          "instruction": "Vaporizer temperature: 350 °C",
          "title": ""
        },
        {
          "instruction": "Collision energy: 20 eV",
          "title": ""
        },
        {
          "instruction": "CID gas: 2 mTorr",
          "title": ""
        },
        {
          "instruction": "Q1/Q3 mass FWHM: 0.4 Da",
          "title": ""
        },
        {
          "instruction": "Set MRM transitions: 263.2 → 153.1 for ABA and 269.2 → 159.1 for D6-ABA",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
