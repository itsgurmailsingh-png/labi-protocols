      "instruction": "Assess completeness and redundancy of PASS1 bins with CheckM lineage workflow (30 threads, .fna extension).",
      "substeps": [
        {
          "instruction": "checkm lineage_wf -x fna -t 30 . PASS1-checkm > PASS1-checkm_out",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
