  "steps": [
    {
      "step_id": 0,
      "title": "Generate contig ID list",
      "instruction": "Use the BinSanity `get-ids` command to create a list of contig identifiers for the metagenome you will bin.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Run BinSanity profile",
      "instruction": "Execute the BinSanity‑profile command with the contig FASTA, BAM directory, and the ID list:",
      "substeps": [
        {
          "instruction": "Binsanity‑profile -i tara_southpacific_SECONDARY_contigs.min14000.fasta \\",
          "title": ""
        },
        {
          "instruction": "-s <directory/to/BAM/files> \\",
          "title": ""
        },
        {
          "instruction": "--ids tara_southpacific_SECONDARY_contigs.min14000.ids \\",
          "title": ""
        },
        {
          "instruction": "--transform scale",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Create work directory and move coverage",
      "instruction": "Make a directory called `Tara-MAGs`, move the coverage file (`tara_southpacific_SECONDARY_min14000.ALLSAMPLES.coverage.x100.lognorm`) into it, then change into that directory.",
      "substeps": [
        {
          "instruction": "mkdir Tara-MAGs",
          "title": ""
        },
        {
          "instruction": "mv tara_southpacific_SECONDARY_min14000.ALLSAMPLES.coverage.x100.lognorm Tara-MAGs/",
          "title": ""
        },
        {
          "instruction": "cd Tara-MAGs",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "First BinSanity pass (PASS1)",
      "instruction": "Run BinSanity on the contigs with a preference of –10 (all other parameters default).",
      "substeps": [
        {
          "instruction": "Binsanity -f . -l tara_southpacific_SECONDARY_contigs.min14000.fasta \\",
          "title": ""
        },
        {
          "instruction": "-p -10 \\",
          "title": ""
        },
        {
          "instruction": "-c tara_southpacific_SECONDARY_min14000.ALLSAMPLES.coverage.x100.lognorm \\",
          "title": ""
        },
        {
          "instruction": "-o PASS1",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Organise PASS1 output files",
      "instruction": "Move the log file into the PASS1 folder, rename it, and rename the bin FASTA files sequentially.",
      "substeps": [
        {
          "instruction": "mv *.txt PASS1/",
          "title": ""
        },
        {
          "instruction": "cd PASS1",
          "title": ""
        },
        {
          "instruction": "mv *.txt PASS1-log.txt",
          "title": ""
        },
        {
          "instruction": "num=1",
          "title": ""
        },
        {
          "instruction": "for file in *.fna; do",
          "title": ""
        },
        {
          "instruction": "mv \"$file\" \"$(printf \"PASS1-%u\" $num).fna\"",
          "title": ""
        },
        {
          "instruction": "let num=$num+1",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
