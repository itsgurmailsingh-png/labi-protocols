      "step_id": 0,
      "title": "Prepare Tween 60-Esculin Agar Medium",
      "instruction": "Combine the following ingredients in 1 L of distilled water (dH2O): 10 g peptone, 10 g glucose, 2 g yeast extract, 0.5 g ferric ammonium citrate, 1 g esculin, 15 g agar, and 5 mL Tween 60.",
      "substeps": [],
      "is_critical": false,
