      "instruction": "Download the combine_gafs Docker container (version 1.1) from Docker Hub.",
      "substeps": [
        {
          "instruction": "docker pull agbase/combine_gafs:1.1",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
