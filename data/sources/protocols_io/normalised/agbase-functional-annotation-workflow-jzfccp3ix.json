    {
      "step_id": 10,
      "title": "Download InterProScan data",
      "instruction": "Pull the InterProScan data archive, verify checksum, and extract it.",
      "substeps": [
        {
          "instruction": "wget ftp://ftp.ebi.ac.uk/pub/software/unix/iprscan/5/5.75-106.0/alt/interproscan-data-5.75-106.0.tar.gz",
          "title": ""
        },
        {
          "instruction": "wget ftp://ftp.ebi.ac.uk/pub/software/unix/iprscan/5/5.75-106.0/alt/interproscan-data-5.75-106.0.tar.gz.md5",
          "title": ""
        },
        {
          "instruction": "md5sum -c interproscan-data-5.75-106.0.tar.gz.md5",
          "title": ""
        },
        {
          "instruction": "tar -pxvzf interproscan-data-5.75-106.0.tar.gz",
          "title": ""
        }
