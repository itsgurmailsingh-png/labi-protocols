    {
      "step_id": 9,
      "title": "Download KOfam databases",
      "instruction": "Retrieve the KOfam profile and ko_list tarballs, extract them, and gunzip the list file.",
      "substeps": [
        {
          "instruction": "wget https://www.genome.jp/ftp/db/kofam/profiles.tar.gz",
          "title": ""
