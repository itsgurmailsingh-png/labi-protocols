  "steps": [
    {
      "step_id": 0,
      "title": "Install GoCommands and download GOanna data",
      "instruction": "Install the GoCommands binary, initialise it, and pull the required GOanna directories (agbase_database and go_info) from iRODS.",
      "substeps": [
        {
          "instruction": "Obtain the latest version number: GOCMD_VER=$(curl -L -s https://raw.githubusercontent.com/cyverse/gocommands/main/VERSION.txt)",
          "title": ""
        },
        {
          "instruction": "Download and extract the binary: curl -L https://github.com/cyverse/gocommands/releases/download/${GOCMD_VER}/gocmd-${GOCMD_VER}-linux-amd64.tar.gz | tar zxvf -",
          "title": ""
        },
        {
          "instruction": "Make it executable: chmod +x gocmd",
          "title": ""
        },
        {
          "instruction": "Initialise GoCommands: ./gocmd init and answer the prompts (iRODS Host: data.cyverse.org, Port: 1247, Zone: iplant, Username: anonymous)",
          "title": ""
        },
        {
          "instruction": "Download the GOanna databases recursively with progress:",
          "title": ""
        },
        {
          "instruction": "./gocmd get -r --progress /iplant/home/shared/iplantcollaborative/protein_blast_dbs/go_info .",
          "title": ""
        },
        {
          "instruction": "./gocmd get -r --progress /iplant/home/shared/iplantcollaborative/protein_blast_dbs/agbase_database .",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
