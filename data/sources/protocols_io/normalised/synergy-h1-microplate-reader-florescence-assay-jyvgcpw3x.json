      "title": "Transform and Plate Cells",
      "instruction": "Transform DH5α electrocompetent cells and plate on LB agar containing 25 µg/mL chloramphenicol (cm).",
      "substeps": [
        {
          "instruction": "Electroporate at 1.8 kV",
          "title": ""
        },
        {
          "instruction": "Allow 1 hour SOC recovery",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Screen Colonies via PCR",
      "instruction": "Perform colony PCR on 8 colonies plus an NTC using VR/VF2 primers and Taq polymerase.",
      "substeps": [
        {
          "instruction": "Run for 25 cycles",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Verify Colony PCR via Gel Electrophoresis",
      "instruction": "Perform gel electrophoresis using 1% agarose.",
      "substeps": [
        {
          "instruction": "Run at 100 V for 45 minutes",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Prepare Overnight Inoculum",
      "instruction": "Pick 3 positive colonies and inoculate into 5 mL LB + cm.",
      "substeps": [
        {
          "instruction": "Incubate at 37°C and 250 rpm for 16 hours",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
