    },
    {
      "step_id": 1,
      "title": "Perform PCR Amplification",
      "instruction": "Conduct PCR using Q5 polymerase and Q5 buffer for 12 samples, including a non-template control (NTC).",
      "substeps": [
        {
          "instruction": "Set up 50 µL reactions",
          "title": ""
        },
        {
          "instruction": "Run for 30 cycles with the following parameters: 98°C for 10s, 60°C for 30s, and 72°C for 30s/kb",
