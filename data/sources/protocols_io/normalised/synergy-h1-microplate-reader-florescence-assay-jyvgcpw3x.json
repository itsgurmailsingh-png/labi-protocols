      "title": "Verify PCR via Gel Electrophoresis",
      "instruction": "Perform gel electrophoresis using 1% agarose.",
      "substeps": [
        {
          "instruction": "Run at 100 V for 30 minutes",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Clean Up and Concentrate DNA",
      "instruction": "Clean up and concentrate the DNA using the QIAquick kit.",
      "substeps": [
        {
          "instruction": "Elute 30 µL in the kit-provided buffer (EB)",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Perform Modular Gibson Assembly",
      "instruction": "Execute modular Gibson assembly using NEBuilder HiFi with 12 fragments, including the pSB1C3 backbone.",
      "substeps": [
        {
          "instruction": "Set up 20 µL reactions",
          "title": ""
        },
        {
          "instruction": "Incubate at 50°C for 60 minutes",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
