      "substeps": [
        {
          "instruction": "Use 2×150 paired-end reads",
          "title": ""
        },
        {
          "instruction": "Target 100× coverage",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
