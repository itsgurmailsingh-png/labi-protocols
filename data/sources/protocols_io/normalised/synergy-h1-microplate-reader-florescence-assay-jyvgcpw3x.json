      "title": "Create Glycerol Stocks",
      "instruction": "Prepare glycerol stocks using 25% glycerol.",
      "substeps": [
        {
          "instruction": "Create 1 mL aliquots",
          "title": ""
        },
        {
          "instruction": "Store at −80°C",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 12,
      "title": "Induce Protein Expression",
