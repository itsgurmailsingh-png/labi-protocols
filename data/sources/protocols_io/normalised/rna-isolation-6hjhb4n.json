  "materials": [
    "DPBS",
    "Trizol",
    "chloroform",
    "ethanol",
    "RNAse-free water",
    "centrifuge",
    "eppendorfs",
    "pipettes",
    "tips",
    "●Get plates, aspirate media",
    "●Add 2mL ice cold DPBS",
    "○Aspirate DPBS",
    "●Add 500uL Trizol/well in chemical hood",
    "●Add 100uL chloroform to tubes",
    "○hand shake 15s",
    "○Place on ice 5min until see layers (aq/lipids/bottom)",
    "●Spin full speed 20min cold centrifuge",
    "○Make new ep set 1-9",
    "●Spin 9000x 1min bench centrifuge",
    "○Discard flowthrough in hood, keep tube",
    "●Add 350uL RW1 buffer to tubes",
    "○Spin 1 min",
    "○During, prepare DNAse soln (with syringe)",
    "●Repeat RW1 and spin",
    "○Discard collection tube and get new",
    "●Wash RPE 500uL",
    "○Spin 1min",
    "○Discard collection and keep tubes",
    "●Repeat RPE, spin 2min",
    "○Discard tubes"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare Tubes and Reagents",
      "instruction": "Prepare the initial tubes and the ethanol solution required for the isolation.",
      "substeps": [
        {
          "instruction": "Add Trizol to yellow tubes in the hood.",
          "title": ""
        },
        {
          "instruction": "Prepare 70% ethanol on ice by mixing 3mL RNAse-free water with 7mL ethanol.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Collect Supernatant",
      "instruction": "Isolate the top layer from the spun samples.",
      "substeps": [
        {
          "instruction": "Collect the top layer after spinning and place into eppendorfs.",
          "title": ""
        },
        {
          "instruction": "Ensure the first volume collected is noted and all subsequent volumes are kept the same.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Prepare Sample for Spin Tubes",
      "instruction": "Mix the supernatant with ethanol and transfer to spin tubes.",
      "substeps": [
        {
          "instruction": "Mix the supernatant with ethanol in a 1:1 ratio.",
          "title": ""
        },
        {
          "instruction": "Use the same tip to transfer the mixture from eppendorfs into pink spin tubes.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Perform DNAse Treatment",
      "instruction": "Treat the columns with DNAse solution to remove DNA contamination.",
      "substeps": [
        {
          "instruction": "Add 70uL DNAse solution to the middle of each column.",
          "title": ""
        },
        {
          "instruction": "Incubate for 15 minutes at room temperature (RT).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Final Recovery and Analysis",
      "instruction": "Secure the samples and prepare for quantification.",
      "substeps": [
        {
          "instruction": "Close tubes as quickly as possible.",
          "title": ""
        },
        {
          "instruction": "Keep tubes on ice.",
          "title": ""
        },
        {
          "instruction": "Analyze samples using Nanodrop.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
