    "Make an anvio-genes directory. $ mkdir anvio-genes",
    "Move into the script directory. $ cd scripts",
    "export CENT_DB=\"/rsgrps/bh_class/b_compressed+h+v/b_compressed+h+v\"",
    "export TYPE=\"single\"",
    "export FILE_EXT='faa'",
    "Get the \"optparse\" package. >"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Log into HPC",
      "instruction": "Connect to the HPC cluster named ocelote via SSH.",
      "substeps": [
        {
          "instruction": "$ ssh hpc",
          "title": ""
        },
        {
          "instruction": "$ ssh ocelote",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Clone Centrifuge repository",
      "instruction": "Clone the Centrifuge GitHub repository into your class directory on the HPC.",
      "substeps": [
        {
          "instruction": "$ pwd /rsgrps/bh_class/username",
          "title": ""
        },
        {
          "instruction": "$ git clone git@github.com:jetjr/Centrifuge.git",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Configure Centrifuge parameters",
      "instruction": "Edit config.sh and set all required environment variables for the run.",
      "substeps": [
        {
          "instruction": "$ nano config.sh",
          "title": ""
        },
        {
          "instruction": "export FASTA_DIR='/rsgrps/bh_class/username/anvio-genes'   # directory containing nucleotides.fna",
          "title": ""
        },
        {
          "instruction": "export REPORT_DIR='/rsgrps/bh_class/username/anvio-genes/taxonomy/'   # will be created if missing",
          "title": ""
        },
        {
          "instruction": "export PLOT_OUT='/rsgrps/bh_class/username/anvio-genes/taxonomy/'   # include trailing /",
          "title": ""
        },
        {
          "instruction": "export PLOT_FILE='your_sample_name'   # file name for bubble plot",
          "title": ""
        },
        {
          "instruction": "export PLOT_TITLE='your_sample_name'   # title shown on the plot",
          "title": ""
        },
        {
          "instruction": "export FILE_TYPE=\"f\"   # nucleotides.fna is FASTA format",
          "title": ""
        },
        {
          "instruction": "export EXCLUDE=\"\"   # leave blank",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Install R environment",
      "instruction": "Load the required R module on the HPC and install the ggplot2 and plyr packages.",
      "substeps": [
        {
          "instruction": "$ module load unsupported",
          "title": ""
        },
        {
          "instruction": "$ module load markb/R/3.1.1",
          "title": ""
        },
        {
          "instruction": "In R console:",
          "title": ""
        },
        {
          "instruction": "install.packages(\"plyr\")",
          "title": ""
        },
        {
          "instruction": "install.packages(\"ggplot2\")",
          "title": ""
        },
        {
          "instruction": "Quit R without saving workspace:",
          "title": ""
        },
        {
          "instruction": "> q()",
          "title": ""
        },
        {
          "instruction": "Save workspace image? [y/n/c]: n",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Submit Centrifuge job",
      "instruction": "Launch the taxonomy assignment job using the provided submit script.",
      "substeps": [
        {
          "instruction": "$ ./submit.sh",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Monitor job status",
      "instruction": "Check the status of the submitted job.",
      "substeps": [
        {
          "instruction": "$ stat -u username",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Prepare gene sequences",
      "instruction": "On your local machine, navigate to the directory containing contigs.db, extract gene‑call sequences, and copy the nucleotides.fna file to the HPC.",
      "substeps": [
        {
          "instruction": "cd /path/to/local/directory/containing/contigs.db",
          "title": ""
        },
        {
          "instruction": "$ anvi-get-dna-sequences-for-gene-calls -c CONTIGS.db -o nucleotides.faa",
          "title": ""
        },
        {
          "instruction": "If using Windows, run Anvi'o via Docker:",
          "title": ""
        },
        {
          "instruction": "docker run --rm -v /path/to/files:/my_data -p 8080:8080 -it meren/anvio:latest",
          "title": ""
        },
        {
          "instruction": "$ scp nucleotides.fna username@sftp.hpc.arizona.edu:/rsgrps/bh_class/username/anvio-genes",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Edit PBS script",
      "instruction": "Modify the PBS variables in centrifuge_single_tax.sh to include your group and email, then return to the main Centrifuge directory.",
      "substeps": [
        {
          "instruction": "$ nano centrifuge_single_tax.sh",
          "title": ""
        },
        {
          "instruction": "Add or edit:",
          "title": ""
        },
        {
          "instruction": "#PBS -W group_list=bh_class",
          "title": ""
        },
        {
          "instruction": "#PBS -M netid@email.arizona.edu",
          "title": ""
        },
        {
          "instruction": "Save and quit the editor",
          "title": ""
        },
        {
          "instruction": "$ cd ..",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
