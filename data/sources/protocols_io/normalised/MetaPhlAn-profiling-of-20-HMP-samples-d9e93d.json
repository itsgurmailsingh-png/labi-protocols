{
  "protocol_id": "metaphlan_profiling_of_20_hmp_samples",
  "parent_protocol_id": null,
  "title": "MetaPhlAn profiling of 20 HMP samples",
  "author": "Curtis Huttenhower",
  "license": "CC-BY 4.0",
  "license_verified": true,
  "license_note": "Confirmed via CrossRef DOI metadata: dx.doi.org/10.17504/protocols.io.d9e93d",
  "source_name": "protocols_io",
  "source_id": "2054",
  "source_url": "https://www.protocols.io/view/MetaPhlAn-profiling-of-20-HMP-samples-d9e93d",
  "doi": "dx.doi.org/10.17504/protocols.io.d9e93d",
  "citation": "dx.doi.org/10.17504/protocols.io.d9e93d",
  "category": "Bioinformatics",
  "estimated_time_mins": 180,
  "materials": [
    "MetaPhlAn software",
    "BowTie2 software",
    "Mercurial (optional)",
    "Unix environment",
    "Internet connection",
    "Human Microbiome Project (HMP) metagenome samples"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Download MetaPhlAn software",
      "instruction": "Obtain the latest MetaPhlAn release (v1.7.8) as a compressed archive, extract it, and rename the directory to \"metaphlan\".",
      "substeps": [
        {
          "instruction": "wget https://bitbucket.org/nsegata/metaphlan/get/default.tar.bz2",
          "title": ""
        },
        {
          "instruction": "tar xjvf default.tar.bz2",
          "title": ""
        },
        {
          "instruction": "mv *-metaphlan-* metaphlan",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Optional: Clone via Mercurial",
      "instruction": "If you prefer a Mercurial checkout that can be kept up‑to‑date, clone the repository.",
      "substeps": [
        {
          "instruction": "hg clone ssh://hg@bitbucket.org/nsegata/metaphlan",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Create working directories",
      "instruction": "Enter the MetaPhlAn directory and make a subfolder called \"input\" for the raw metagenome archives.",
      "substeps": [
        {
          "instruction": "cd metaphlan",
          "title": ""
        },
        {
          "instruction": "mkdir input",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Download buccal mucosa samples",
      "instruction": "Retrieve the ten buccal mucosa metagenome tar.bz2 files from the HMP DACC and store them in the input folder (this may take several hours).",
      "substeps": [
        {
          "instruction": "buccal_mucosa_samples=\"SRS013506 SRS015374 SRS015646 SRS017687 SRS019221 SRS019329 SRS020336 SRS022145 SRS022532 SRS045049\"",
          "title": ""
        },
        {
          "instruction": "for s in ${buccal_mucosa_samples}; do",
          "title": ""
        },
        {
          "instruction": "wget http://downloads.hmpdacc.org/data/Illumina/buccal_mucosa/${s}.tar.bz2 -O input/${s}.tar.bz2",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Download tongue dorsum samples",
      "instruction": "Retrieve the ten tongue dorsum metagenome tar.bz2 files from the HMP DACC and store them in the input folder.",
      "substeps": [
        {
          "instruction": "tongue_dorsum_samples=\"SRS011243 SRS013234 SRS014888 SRS015941 SRS016086 SRS016342 SRS017713 SRS019219 SRS019327 SRS043663\"",
          "title": ""
        },
        {
          "instruction": "for s in ${tongue_dorsum_samples}; do",
          "title": ""
        },
        {
          "instruction": "wget http://downloads.hmpdacc.org/data/Illumina/tongue_dorsum/${s}.tar.bz2 -O input/${s}.tar.bz2",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Create output directory",
      "instruction": "Make a folder to hold MetaPhlAn profiling results.",
      "substeps": [
        {
          "instruction": "mkdir profiled_samples",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Profile buccal mucosa samples",
      "instruction": "For each buccal mucosa sample, stream the compressed reads directly to MetaPhlAn (using the BowTie2 engine) and write the taxonomic profile to the profiled_samples folder. BowTie2 must be installed and in the PATH; internal parallelisation cannot be used when piping.",
      "substeps": [
        {
          "instruction": "BM_samples=\"SRS013506 SRS015374 SRS015646 SRS017687 SRS019221 SRS019329 SRS020336 SRS022145 SRS022532 SRS045049\"",
          "title": ""
        },
        {
          "instruction": "for s in ${BM_samples}; do",
          "title": ""
        },
        {
          "instruction": "tar xjf input/${s}.tar.bz2 --to-stdout | \\",
          "title": ""
        },
        {
          "instruction": "./metaphlan.py --bowtie2db bowtie2db/mpa \\",
          "title": ""
        },
        {
          "instruction": "--bt2_ps very-sensitive \\",
          "title": ""
        },
        {
          "instruction": "--input_type multifastq \\",
          "title": ""
        },
        {
          "instruction": "--bowtie2out BM_${s}.bt2out > profiled_samples/BM_${s}.txt",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Profile tongue dorsum samples",
      "instruction": "Repeat the profiling for the ten tongue dorsum samples, directing output to files prefixed with TD_.",
      "substeps": [
        {
          "instruction": "TD_samples=\"SRS011243 SRS013234 SRS014888 SRS015941 SRS016086 SRS016342 SRS017713 SRS019219 SRS019327 SRS043663\"",
          "title": ""
        },
        {
          "instruction": "for s in ${TD_samples}; do",
          "title": ""
        },
        {
          "instruction": "tar xjf input/${s}.tar.bz2 --to-stdout | \\",
          "title": ""
        },
        {
          "instruction": "./metaphlan.py --bowtie2db bowtie2db/mpa \\",
          "title": ""
        },
        {
          "instruction": "--bt2_ps very-sensitive \\",
          "title": ""
        },
        {
          "instruction": "--input_type multifastq \\",
          "title": ""
        },
        {
          "instruction": "--bowtie2out TD_${s}.bt2out > profiled_samples/TD_${s}.txt",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "View MetaPhlAn help (optional)",
      "instruction": "Run the help command to see additional options and usage details.",
      "substeps": [
        {
          "instruction": "./metaphlan.py -h",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Inspect example output",
      "instruction": "Display the first few lines of a buccal mucosa profile to verify successful execution.",
      "substeps": [
        {
          "instruction": "cat profiled_samples/BM_SRS013506.txt",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
