  "steps": [
    {
      "step_id": 0,
      "title": "Prepare 2 L TET Buffer",
      "instruction": "Prepare 2 L of TET buffer using a single-use cell culture bottle.",
      "substeps": [
        {
          "instruction": "Add 1800 mL RNase free Water to a 2 L single use cell culture bottle.",
          "title": ""
        },
        {
          "instruction": "Add 4 mL 0.5 M EDTA, pH 8.0.",
          "title": ""
        },
        {
          "instruction": "Add 20 mL 1 M Tris-HCl, pH 8.0.",
          "title": ""
        },
        {
          "instruction": "Add 1 mL Tween-20.",
          "title": ""
        },
        {
          "instruction": "Bring the final volume up to 2000 mL with RNase free Water.",
          "title": ""
        },
        {
          "instruction": "Swirl very well to ensure Tween-20 is thoroughly mixed.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Label and Store 2 L Buffer",
      "instruction": "Label the 2 L TET buffer and store it appropriately.",
      "substeps": [
        {
          "instruction": "Label the bottle with the batch number and date.",
          "title": ""
        },
        {
          "instruction": "Store the solution at room temperature (15 °C – 25 °C).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
