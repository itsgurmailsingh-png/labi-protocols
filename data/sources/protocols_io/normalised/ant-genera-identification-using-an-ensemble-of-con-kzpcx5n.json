        },
        {
          "instruction": "model_file = '/module/directory/bvlc_my_model.caffemodel'",
          "title": ""
        },
        {
          "instruction": "deploy_prototxt = '/deploy/directory/deploy.prototxt'",
          "title": ""
        },
        {
          "instruction": "imagemean_file = np.load('/image_mean/directory/antnet#_mean.npy').mean(1).mean(1)",
          "title": ""
        },
        {
          "instruction": "# Set computation mode (CPU or GPU)",
          "title": ""
        },
        {
          "instruction": "caffe.set_mode_gpu()   # or caffe.set_mode_cpu()",
          "title": ""
        },
        {
          "instruction": "# Initialise network",
          "title": ""
        },
        {
          "instruction": "net = caffe.Net(deploy_prototxt, model_file, caffe.TEST)",
          "title": ""
        },
        {
          "instruction": "transformer = caffe.io.Transformer({'data': net.blobs['data'].data.shape})",
          "title": ""
        },
        {
          "instruction": "transformer.set_mean('data', imagemean_file)",
          "title": ""
        },
        {
          "instruction": "transformer.set_transpose('data', (2,0,1))",
          "title": ""
        },
        {
          "instruction": "transformer.set_raw_scale('data', 255.0)",
          "title": ""
        },
        {
          "instruction": "net.blobs['data'].reshape(50, 3, 256, 256)   # batch size 50, 3 channels, 256×256 pixels",
          "title": ""
        },
        {
          "instruction": "# Load a test image (example path shown)",
          "title": ""
        },
        {
          "instruction": "img = caffe.io.load_image('/image_example/Leptogenys/casent0095124/casent0095124_p_1_high.jpg')",
          "title": ""
        },
        {
          "instruction": "# Forward function",
          "title": ""
        },
        {
          "instruction": "def forward(image, net, transformer):",
          "title": ""
        },
        {
          "instruction": "net.blobs['data'].data[...] = transformer.preprocess('data', image)",
          "title": ""
        },
        {
          "instruction": "output = net.forward()",
          "title": ""
        },
        {
          "instruction": "return output['prob'][0]",
          "title": ""
        }
