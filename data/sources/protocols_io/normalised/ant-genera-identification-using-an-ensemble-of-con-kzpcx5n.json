    {
      "step_id": 6,
      "title": "Set up testing environment in Jupyter",
      "instruction": "Import libraries, load a trained model, configure the transformer, and define a forward‑pass function.",
      "substeps": [
        {
          "instruction": "import numpy as np",
          "title": ""
        },
        {
          "instruction": "import caffe",
          "title": ""
        },
        {
          "instruction": "# Paths (replace # with the perspective code H, P, D, or '' for all)",
