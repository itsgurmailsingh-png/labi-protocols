  "steps": [
    {
      "step_id": 0,
      "title": "Filter Aged Seawater",
      "instruction": "Filter 1L of aged seawater (aged at least two months) using a prefilter and a 0.2 µm filter.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Heat Seawater",
      "instruction": "Heat the seawater at 100°C for 20 minutes.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Add Nutrients to Seawater",
      "instruction": "Add the following components to 300 mL of the seawater: 1 g Difco bacto-peptone, 1 g Bacto yeast extract, and 10 g D-glucose anhydrous.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Sterilize Medium",
      "instruction": "Filter the medium through a 0.2 micron Stericup while working under a laminar flow hood.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
