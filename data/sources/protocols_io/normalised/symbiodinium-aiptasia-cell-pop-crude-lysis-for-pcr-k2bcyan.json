      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Heat for lysis",
      "instruction": "Heat the sample for 10 minutes at 95°C.",
      "substeps": [
        {
          "instruction": "Use an Eppendorf Thermomixer with agitation (700 rpm) or alternatively boil for 10 minutes",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Separate lysate",
