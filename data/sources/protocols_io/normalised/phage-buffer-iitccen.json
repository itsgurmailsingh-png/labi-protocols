      "title": "Prepare Phage Buffer",
      "instruction": "Combine the following reagents in a one liter bottle and bring to final volume with Milli-Q water before sterilizing.",
      "substeps": [
        {
          "instruction": "Add 10 ml of 1 M MgSO4",
          "title": ""
        },
        {
          "instruction": "Add 1 ml of 1 M CaCl2",
          "title": ""
        },
        {
          "instruction": "Add 1 ml of 1 M Tris-HCl (pH~7)",
          "title": ""
        },
        {
          "instruction": "Add 1 g gelatin",
          "title": ""
        },
        {
          "instruction": "Add Milli-Q water to a final volume of 1000 mL",
          "title": ""
        },
        {
          "instruction": "Autoclave sterilize the solution",
