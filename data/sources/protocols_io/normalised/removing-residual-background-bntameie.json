      "step_id": 1,
      "title": "Remove residual smeary background",
      "instruction": "If the initial wash fails to remove residual smeary background, manually scrub the membrane to remove precipitated radioactive gunk.",
      "substeps": [
        {
          "instruction": "Use a paper towel to scrub both sides of the membrane while it remains under the SSC/SDS solution.",
          "title": ""
        },
        {
          "instruction": "Repeat scrubbing until no more counts are transferred to the paper towel.",
