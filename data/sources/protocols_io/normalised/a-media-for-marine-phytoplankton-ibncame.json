  "steps": [
    {
      "step_id": 0,
      "title": "Prepare salt mixture",
      "instruction": "Weigh and add the following salts to the appropriate volume of distilled water:",
      "substeps": [
        {
          "instruction": "18 g NaCl (Sodium Chloride) – Catalog #PubChem CID:5234",
          "title": ""
        },
        {
          "instruction": "5 g MgSO₄·7H₂O (Magnesium sulfate heptahydrate)",
          "title": ""
        },
        {
          "instruction": "0.6 g KCl (Potassium chloride) – P212121",
          "title": ""
        },
        {
          "instruction": "0.04 g H₃BO₃ (Boric acid) – Fisher Scientific Catalog #BP1681",
          "title": ""
        },
        {
          "instruction": "0.360 g CaCl₂·2H₂O (Calcium chloride dihydrate)",
          "title": ""
        },
        {
          "instruction": "0.03 g Na₂EDTA (Disodium EDTA) – Catalog #PubChem CID:8759",
          "title": ""
        },
        {
          "instruction": "0.05 g KH₂PO₄ (Potassium phosphate, monobasic) – P212121",
          "title": ""
        },
        {
          "instruction": "1.0 g NaNO₃ (Sodium nitrate) – P212121",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Add iron stock",
      "instruction": "Add 1 mL of FeCl₃ stock solution (3.89 g/L FeCl₃·6H₂O in 0.1 N HCl, Sigma‑Aldrich Catalog #44944) to the mixture.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Add Tris buffer",
      "instruction": "Add 8.3 mL of 1 M Tris stock (pH 7.8) to the mixture.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Cool and add vitamins",
      "instruction": "Allow the media to cool, then add 0.1 mL of vitamin solution prepared with Thiamine (100 mg/mL), Vitamin B₁₂ (2 mg/mL) and Biotin (1 mg/mL).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Sterilize medium",
      "instruction": "Filter‑sterilize the complete medium through a 0.2 µm filter.",
