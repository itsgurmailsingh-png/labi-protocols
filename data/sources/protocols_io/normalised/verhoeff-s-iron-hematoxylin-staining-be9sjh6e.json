      "step_id": 0,
      "title": "Fix slides with acetone",
      "instruction": "If slides keep falling off, air dry for 30 minutes before fixation with acetone.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Differentiate with ferric chloride",
      "instruction": "Treat slides with 2% wt/vol ferric chloride in water, followed by 3 water washes.",
      "substeps": [
        {
          "instruction": "Check slide for differentiation at 1 minute 30 seconds.",
          "title": ""
        },
        {
          "instruction": "Check slide every 30 seconds thereafter.",
          "title": ""
        },
        {
          "instruction": "Halt staining when nuclei and elastin fibers are still black with weak background.",
          "title": ""
        },
        {
          "instruction": "If over-differentiated, return to step 3.",
