      "title": "Add path exports",
      "instruction": "Add the following export lines to the .bashrc file to configure the PATH and PYTHONPATH.",
      "substeps": [
        {
          "instruction": "Add: export PATH=/rsgrps/bh_class/rakudobrew/bin:/rsgrps/bh_class/bin:$PATH",
          "title": ""
        },
        {
          "instruction": "Add: export PYTHONPATH=/rsgrps/bh_class/lib/python",
          "title": ""
        }
