  "estimated_time_mins": 6,
  "materials": [
    "Lutz R, Bujard H. (",
    "Sequence of pgMAX "
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare pgMAX Vector",
      "instruction": "Digest the pgMAX plasmid to prepare it for subcloning.",
      "substeps": [
        {
          "instruction": "Combine 1 µg pgMAX plasmid, H2O (up to 17.5 µl), 2 µl B buffer (Roche, Sigma-Aldrich), and 0.5 µl EcoRV-HF (New England Biolabs) for a total volume of 20 µl.",
          "title": ""
        },
        {
          "instruction": "Incubate the mixture at 37 °C for 20 min.",
          "title": ""
        },
        {
          "instruction": "Heat-inactivate at 80 °C for 15 min.",
          "title": ""
        },
        {
          "instruction": "Cool on ice for 3 min (or store at −20 °C).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Ligate DNA Fragment into Vector",
      "instruction": "Ligate a blunt-end DNA fragment (typically a PCR fragment produced with a proofreading DNA polymerase) into the EcoRV site of the pgMAX plasmid.",
      "substeps": [
        {
          "instruction": "Mix 1.0 µl blunt-end DNA (usually ~0.2 µg), 0.5 µl digested vector, and 1.5 µl ligase (Takara DNA Ligation Kit ver. 2.1) for a total volume of 3.0 µl.",
          "title": ""
        },
        {
          "instruction": "Incubate the reaction at 16 °C for 30 min.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Transform and Select Prokaryotic Clones",
      "instruction": "Transform the ligation product into competent E. coli cells and select for recombinant clones.",
      "substeps": [
        {
          "instruction": "Perform standard transformation using competent cells prepared according to the Inoue Protocol.",
          "title": ""
        },
        {
          "instruction": "Plate cells on LB agar containing ampicillin (150 µg/ml) and IPTG (1 mM).",
          "title": ""
        },
        {
          "instruction": "Incubate plates at 37 °C for 16 h.",
          "title": ""
        },
        {
          "instruction": "Collect resulting colonies.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Perform Prokaryotic Analysis",
      "instruction": "Analyze the recombinant plasmid and verify protein expression in E. coli.",
      "substeps": [
        {
          "instruction": "Inoculate a single colony in ~5 ml LB broth containing ampicillin (150 µg/ml) and IPTG (1 mM).",
          "title": ""
        },
        {
          "instruction": "Incubate for 12−16 h at 37 °C with vigorous shaking (~225 rpm).",
          "title": ""
        },
        {
          "instruction": "Collect 3 ml of the culture for plasmid DNA purification using a standard mini-prep.",
          "title": ""
        },
        {
          "instruction": "Collect 0.5 ml of the culture for protein analysis: harvest cells by centrifugation (14,000 rpm in an Eppendorf 5418 centrifuge).",
          "title": ""
        },
        {
          "instruction": "Re-suspend cell pellet in 100 µl cell lysis buffer (1 mM EDTA, 1 mg/ml lysozyme) and incubate at room temperature for 15 min.",
          "title": ""
        },
        {
          "instruction": "For Western blot analysis, load 5% of the resulting cell lysate.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Convert to Mammalian Expression Mode",
      "instruction": "Switch the plasmid from prokaryotic to mammalian expression mode by removing the lac promoter unit.",
      "substeps": [
        {
          "instruction": "Digest ~0.3 µg of the confirmed recombinant plasmid with PmeI and SwaI.",
          "title": ""
        },
        {
          "instruction": "Re-ligate the plasmid using standard techniques.",
          "title": ""
        },
        {
          "instruction": "Transform the re-ligated plasmid into E. coli.",
          "title": ""
        },
        {
          "instruction": "Plate on LB agar containing ampicillin (150 µg/ml) and incubate at 37 °C for 12−16 h (Alternatively, for the 'short-cut method', incubate 50% of transformants directly in LB broth containing ampicillin 150 µg/ml).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Transfect Mammalian Cells",
      "instruction": "Introduce the mammalian expression vector into HEK 293T cells.",
      "substeps": [
        {
          "instruction": "Purify the plasmid DNA using a standard mini-prep.",
          "title": ""
        },
        {
          "instruction": "Transfect the purified DNA into HEK 293T cells using Lipofectamine (Thermo Fisher Scientific) or X-treme (Sigma-Aldrich).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
