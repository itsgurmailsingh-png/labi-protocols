  "protocol_id": "extended_approach_to_sum_of_absolute_differences_method_for_improved_identificat",
  "parent_protocol_id": null,
  "title": "Extended approach to sum of absolute differences method for improved identification of periods in biomedical time series",
  "author": "Wiktorski, Królak",
  "license": "CC-BY-4.0",
