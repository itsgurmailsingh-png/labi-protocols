  "steps": [
    {
      "step_id": 0,
      "title": "Feature extraction and selection",
      "instruction": "Extract bot‑related features from the raw social‑media data and select the most informative ones using the improved PSO algorithm to reduce dimensionality and improve computational efficiency.",
      "substeps": [
        {
          "instruction": "Identify relevant bot features from the dataset.",
          "title": ""
        },
        {
          "instruction": "Apply the metaheuristic improved Particle Swarm Optimization (PSO) to evaluate and select features.",
          "title": ""
        },
        {
          "instruction": "Eliminate redundant or unwanted features to create a reduced feature set for classification.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Global search seeding",
      "instruction": "Perform a global‑search seeding operation that ranks features by frequency and selects them using a Boltzmann‑distribution probability.",
      "substeps": [
        {
          "instruction": "Count the occurrence frequency Fi of each extracted feature.",
          "title": ""
        },
        {
          "instruction": "Compute the selection probability for each feature with P(fi) = e^{α*Fi} / Σ_{j=1}^{N} e^{α*Fj}, where α is a control parameter related to temperature.",
          "title": ""
        },
        {
          "instruction": "Store features with higher probabilities in a storage list for the next generation of the PSO algorithm.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Gbest mutation",
      "instruction": "Mutate or reverse the current global‑best (Gbest) particle to explore uncharted regions of the solution space.",
      "substeps": [
        {
          "instruction": "Generate a random number rand.",
          "title": ""
        },
        {
          "instruction": "If rand < s_v (mutation probability), set x_mutated = 1; otherwise set x_mutated = 0.",
          "title": ""
        },
        {
          "instruction": "Apply the mutation (or reversal) to the Gbest particle based on x_mutated.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Fitness evaluation",
      "instruction": "Calculate the fitness value of each candidate solution to measure classification accuracy of the selected features.",
      "substeps": [
        {
          "instruction": "Use the formula Fitness(X) = (1/N) Σ_{i=1}^{N} δ(Xi, Yi), where N is the number of data points, Xi is the i‑th data point, Yi is its true class label, and δ is the Kronecker delta (1 if prediction matches true label, 0 otherwise).",
          "title": ""
        },
        {
          "instruction": "Record the fitness value for each solution to guide the PSO optimization.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Model training and validation",
      "instruction": "Train the adaptive fuzzy classifier combined with a Hist Gradient Boosting classifier on the selected features and evaluate its performance using separate testing data.",
      "substeps": [
        {
          "instruction": "Collect Twitter and Twitch bot datasets containing normal and malicious accounts.",
          "title": ""
        },
        {
          "instruction": "Split each dataset into 80 % training data and 20 % testing data.",
          "title": ""
        },
        {
          "instruction": "Train the integrated fuzzy‑gradient‑boosting model on the training set using the selected features.",
          "title": ""
        },
        {
          "instruction": "Validate the trained model on the testing set and record performance metrics.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
