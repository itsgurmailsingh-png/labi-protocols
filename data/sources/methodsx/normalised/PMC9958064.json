  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare Mosquito Dataset",
      "instruction": "Utilize the open-sourced mosquito dataset containing approximately 3600 images classified into six classes: Non-Vector, Aedes albopictus, Aedes vexans, Anopheles sinensis, Culex pipiens, and Culex tritaeniorhynchus.",
      "substeps": [
        {
          "instruction": "Split the dataset according to the Pareto principle: 80% for training and 20% for validation.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Train Teacher Candidate Models",
      "instruction": "Train multiple state-of-the-art (SOTA) models to identify the best teacher model for knowledge distillation using the training dataset.",
      "substeps": [
        {
          "instruction": "Set hyperparameters: Batch Size = 16, Optimizer = Adam, Epochs = 30, and Learning Rate = 0.0001.",
          "title": ""
        },
        {
          "instruction": "Evaluate candidates to select the model with the highest accuracy (e.g., EfficientNetB7).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Train Student Model without KD",
      "instruction": "Train a student model using a standard softmax approach to establish a performance baseline.",
      "substeps": [
        {
          "instruction": "Apply the same hyperparameters used for teacher candidates: Batch Size = 16, Optimizer = Adam, Epochs = 30, and Learning Rate = 0.0001.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Perform Knowledge Distillation (KD)",
      "instruction": "Conduct a distillation stage where the student model learns from the selected teacher model (e.g., EfficientNetB7).",
      "substeps": [
        {
          "instruction": "Use the base hyperparameters: Batch Size = 16, Optimizer = Adam, and Epochs = 30.",
          "title": ""
        },
        {
          "instruction": "Apply KD-specific hyperparameters: Temperature (τ) = 2, Alpha (α) = 0.3, and a modified Learning Rate = 0.001.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Validate Model Performance",
      "instruction": "Evaluate the resulting model using the 20% validation dataset and calculate performance and efficiency metrics.",
      "substeps": [
        {
          "instruction": "Calculate Accuracy (Acc), Precision (Pr), Recall (Rc), and F1-Score (F1).",
          "title": ""
        },
        {
          "instruction": "Calculate Floating-Point Operations per second (FLOPs) for upper feature extraction layers and dense connections/classifier.",
          "title": ""
        },
        {
          "instruction": "Measure disk size consumption (e.g., target ~437 KB).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
