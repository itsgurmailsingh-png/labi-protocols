{
  "protocol_id": "methodology_for_dissolution_of_sediment_and_calcareous_deposits_for_paleontologi",
  "parent_protocol_id": null,
  "title": "Methodology for dissolution of sediment and calcareous deposits for paleontological specimen collection and identification",
  "author": "Schultz, Scheurer, et al.",
  "license": "CC-BY-4.0",
  "license_verified": true,
  "license_note": "CC-BY-4.0 - verified from PMC XML",
  "source_name": "methodsx",
  "source_id": "PMC9420959",
  "source_url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9420959/",
  "doi": "10.1016/j.mex.2022.101816",
  "citation": "10.1016/j.mex.2022.101816",
  "category": "Taxonomy & Biodiversity",
  "tags": [],
  "estimated_time_mins": 3060,
  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Examine initial sediment sample",
      "instruction": "Inspect a representative batch of sediment under appropriate magnification to assess the presence and condition of small macrofossils before any chemical or surfactant treatment.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare treatment solutions",
      "instruction": "Prepare four treatment solutions: (1) 5 % (v/v) acetic acid (vinegar), (2) 50 % (w/v) Calgon© solution, (3) distilled water as a positive control, and (4) no solution as a negative control.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Add sediment and solution to dishes",
      "instruction": "Place 10 g of sediment into a 10 cm‑diameter glass Petri dish and add 300 ml of the assigned solution for each treatment.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Incubate samples",
      "instruction": "Incubate the dishes for 3 h at room temperature (19 °C).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Separate dissolved material",
      "instruction": "After incubation, pour the contents into a 254 µm sieve and rinse the retained sediment with warm water to remove dissolved clay and any remaining solution.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Dry sediment",
      "instruction": "Transfer the sieved sediment to a cabinet incubator set at 37 °C and dry for 24 h until all water has evaporated.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Weigh dried sediment",
      "instruction": "Weigh the dried sediment and record the mass for each treatment; perform each of the four treatments in triplicate and compare average mass losses to evaluate solution effectiveness.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
