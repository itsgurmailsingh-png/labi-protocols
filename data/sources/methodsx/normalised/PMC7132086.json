  "category": "Lab Automation & Robotics",
  "tags": [],
  "estimated_time_mins": 12,
  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Detach fresh leaf",
      "instruction": "Detach leaves and use them immediately while still fresh; no further preparation is required.",
      "substeps": [],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Place leaf on slide",
      "instruction": "Spread the fresh leaf over the surface of a clean glass slide, ensuring the leaf lies flat.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Trim large leaf portions (optional)",
      "instruction": "If the leaf is large or has thick veins, cut a tissue portion between the veins before proceeding.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Cover with second slide and press",
      "instruction": "Place a second glass slide on top of the leaf and apply enough pressure with the fingers to bring the most protruding part of each epidermal cell into contact with both slides, but without crushing the cells.",
      "substeps": [
        {
          "instruction": "Ensure the adaxial and abaxial laminas of each cell touch the glass surfaces.",
          "title": ""
        },
        {
          "instruction": "Maintain the applied pressure while observing under the microscope.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Mount on microscope",
      "instruction": "Place the slide pair under a visible‑light microscope equipped with a digital camera.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Set focal plane at contact",
      "instruction": "Adjust the microscope focus to the contact plane between the upper glass slide and the leaf epidermal cells (the plane where the cells touch the glass).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Acquire micrographs",
      "instruction": "While keeping the finger pressure constant, capture images of the leaf epidermis with the digital camera.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
