  ],
  "estimated_time_mins": 96,
  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Set up reaction (l‑proline/Et3N)",
      "instruction": "In a 10 mL round‑bottom flask add 2‑acetylpyridine (1.0 mmol, 121 mg) and the chosen aromatic aldehyde (1.0 mmol) to methanol (2 mL). Add l‑proline (0.15 mmol, 17 mg) then add triethylamine (0.30 mmol, 31 mg) dropwise. Stir the mixture at room temperature for 24 h.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Set up reaction (NaOH catalyst)",
      "instruction": "In a separate 10 mL round‑bottom flask add 2‑acetylpyridine (1.0 mmol, 121 mg) and the chosen aromatic aldehyde (1.0 mmol) to methanol (2 mL). Prepare a solution of NaOH (0.6 g in 3 mL ethanol) and add it dropwise to the reaction mixture while stirring continuously for 10 min. Then stir the mixture at room temperature for 24 h.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Monitor reaction progress",
      "instruction": "Take small aliquots and run thin‑layer chromatography using n‑hexane/ethyl acetate as the mobile phase to confirm consumption of starting materials.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Work‑up the reaction mixture",
      "instruction": "After the 24 h reaction, extract the mixture with ethyl acetate. Wash the combined organic extracts sequentially with water and then brine. Dry the organic layer over anhydrous sodium sulfate and evaporate the solvent under reduced pressure to obtain the crude product.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Purify crude azachalcone",
      "instruction": "Purify the crude material by column chromatography on silica gel using a gradient of n‑hexane/ethyl acetate (as described for each product) to afford the pure azachalcone derivative (2a‑d).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Prepare DPPH stock solution",
      "instruction": "Dissolve 10 mg of DPPH in 100 mL of ethanol to make a 0.1 mg mL⁻¹ (100 ppm) stock solution. Measure its absorbance at 517 nm to record the control value.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Perform DPPH antioxidant assay",
      "instruction": "In a test tube mix 2 mL of the DPPH stock solution with 2 mL of the azachalcone sample solution (prepared at 100 ppm). Keep the tube in the dark for 30 min, then measure the absorbance at 517 nm. Repeat the measurement three times.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Calculate inhibition percentage",
      "instruction": "Use the formula Inhibition (%) = [(C − S)/C] × 100, where C is the absorbance of the DPPH control and S is the absorbance of the sample, to determine the antioxidant activity.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
