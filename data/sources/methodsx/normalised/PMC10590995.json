{
  "protocol_id": "preparation_of_azachalcone_derivatives_and_study_of_their_antioxidant_potential",
  "parent_protocol_id": null,
  "title": "Preparation of azachalcone derivatives and study of their antioxidant potential",
  "author": "Rohman, Ardiansah, et al.",
  "license": "CC-BY-4.0",
