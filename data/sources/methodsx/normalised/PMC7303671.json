  "steps": [
    {
      "step_id": 0,
      "title": "Set up mesocosm system",
      "instruction": "Install the temperature‑difference control recording system in the shallow‑lake mesocosms, arranging separate tanks for the ambient (control) treatment and the heated (warming) treatment.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Program temperature offset",
      "instruction": "Program the system to create a sustained temperature increase of 4 °C in the heated mesocosms relative to the ambient mesocosms (i.e., set the target warming temperature to ambient + 4 °C).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Run experiment with replicates",
      "instruction": "Run the experiment with 12 replicate mesocosms per treatment, continuously recording water temperature to verify that the heated mesocosms maintain the designed 4 °C offset throughout the study.",
