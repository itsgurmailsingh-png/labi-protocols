  "steps": [
    {
      "step_id": 0,
      "title": "Establish initial reference frame",
      "instruction": "Align the transmitter’s local z‑axis with the local gravity direction (parallel to the transmitter position vector R→TX). Align the local x‑axis with the collimation laser (L1) that points toward the nearby reference station. Then rotate the reference frame about the y‑axis until the x‑axis is directed exactly at the reference‑station position, creating the intermediate frame (x′, y′, z′).",
      "substeps": [
        {
          "instruction": "Align z‑axis with gravity / R→TX.",
          "title": ""
        },
        {
          "instruction": "Align x‑axis with laser L1 toward reference station.",
          "title": ""
        },
        {
          "instruction": "Rotate about y‑axis until x‑axis points to reference station (define x′, y′, z′).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Rotate to make planes coplanar",
      "instruction": "Using the intermediate frame (x′, y′, z′), rotate the system around the x′‑axis by the angle φ so that the plane π defined by the transmitter, receiver and reference‑station vectors (R→TX, R→RX, R→Rf) becomes coplanar with the plane π′ spanned by x′ and y′. This yields the final frame (x″, y″, z″) where z″ is orthogonal to the now‑coplanar plane π″.",
      "substeps": [
        {
          "instruction": "Rotate about x′ by angle φ to align planes π and π′.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Final rotation to align transmitter with receiver",
      "instruction": "With the laser now aimed at the reference station, rotate the system about the z″‑axis by the angle θ. This rotation aligns the transmitter’s transmission direction (or antenna main‑lobe) with the receiver’s location.",
      "substeps": [
        {
          "instruction": "Rotate about z″ by angle θ to point at the receiver.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
