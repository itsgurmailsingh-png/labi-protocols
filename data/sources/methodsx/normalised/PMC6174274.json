  "category": "Other",
  "tags": [],
  "estimated_time_mins": 60,
  "materials": [
    "SD: Standard deviation",
    "RSD (%): Relative standard deviation",
    "N: Number of times that test performed"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Adjust formaldehyde pH",
      "instruction": "Add 6 mL formaldehyde to a volumetric flask and dropwise add 0.1 M NaOH until the solution reaches pH 8.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Dissolve urea and heat",
      "instruction": "Add 3 g urea to the pH‑adjusted solution, place in a 50 °C water bath until fully dissolved, then raise temperature to 70 °C until the solution becomes completely colorless.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Add cadmium and acid",
      "instruction": "Introduce 2 mL of cadmium solution (500 mg/L) to the heated mixture, then add 0.5 mL of 100 % acetic acid; allow the mixture to stand until it stiffens into a polymer.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Grind polymer",
      "instruction": "Grind the stiff polymer into a fine powder.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Wash polymer with acid",
      "instruction": "Wash the powder three times with 50 mL of 0.1 M nitric acid, each wash lasting 30 min, adjusting the pH to 6 after each wash.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Percolate and dry",
      "instruction": "Percolate the washed polymer and dry it to remove all moisture.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Perform adsorption tests",
      "instruction": "Use the dried adsorbent to conduct cadmium adsorption experiments as illustrated in Figures 1 and 2.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
