{
  "protocol_id": "adsorptive_removal_of_noxious_cadmium_from_aqueous_solutions_using_poly_urea_for",
  "parent_protocol_id": null,
  "title": "Adsorptive removal of noxious cadmium from aqueous solutions using poly urea-formaldehyde: A novel polymer adsorbent",
  "author": "Dehghani, Tajik, et al.",
  "license": "CC-BY-4.0",
  "license_verified": true,
