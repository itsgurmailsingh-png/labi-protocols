  "steps": [
    {
      "step_id": 0,
      "title": "Prepare chromium solution",
      "instruction": "Dissolve potassium dichromate (K2Cr3O7) in distilled water to make the chromium stock solution; use tap‑water samples as needed.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Adjust solution pH",
      "instruction": "Adjust the pH of each solution to the desired value using sodium hydroxide (NaOH) or hydrochloric acid (HCl).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Analyze Cr(VI) by AAS",
      "instruction": "Measure the concentration of hexavalent chromium in the feed solution with an advanced Atomic Absorption Spectrometer (Contraa‑700, Model) at laboratory temperature (25 °C).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Analyze sulfate by UV‑vis",
      "instruction": "Determine sulfate anion concentration using a UV–vis Array Spectrophotometer (Photonix Ar 2015, Teifsanje Pishro Pajohesh Company, Iran) with Sigma‑Aldrich sulfate reagent.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
