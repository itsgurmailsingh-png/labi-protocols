{
  "protocol_id": "advanced_image_preprocessing_and_context_aware_spatial_decomposition_for_enhance",
  "parent_protocol_id": null,
  "title": "Advanced image preprocessing and context-aware spatial decomposition for enhanced breast cancer segmentation",
  "author": "Kalpana, Deepa, et al.",
  "license": "CC-BY-4.0",
  "license_verified": true,
