      "step_id": 0,
      "title": "Load TD tubes into instrument",
      "instruction": "After returning from the field, remove the thermal desorption (TD) tubes from the Less‑P manifold and place each tube into the appropriate tray of the automated TD‑GC‑MS system as described in the methods.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Run thermal desorption analysis",
      "instruction": "Run the TD‑GC‑MS analysis for each tube; each sample requires approximately 50 min, allowing a complete light‑curve sequence to be finished within about 5 h.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Calculate monoterpene concentrations",
      "instruction": "Determine the concentration of each monoterpene in parts per billion (ppb) using the most recent calibration curve.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Compute monoterpene emission rates",
      "instruction": "Calculate the emission rate of each monoterpene by combining its concentration (ppb) with the measured leaf area and the airflow rate through the leaf chamber.",
