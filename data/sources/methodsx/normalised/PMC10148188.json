{
  "protocol_id": "structural_testing_of_concrete_walls_on_edge_with_combined_axial_and_out_of_plan",
  "parent_protocol_id": null,
  "title": "Structural Testing of Concrete Walls on-Edge with Combined Axial and Out-of-Plane Loading",
  "author": "Al-Rubaye, Maguire",
  "license": "CC-BY-4.0",
