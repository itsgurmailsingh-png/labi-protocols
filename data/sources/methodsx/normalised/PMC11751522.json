{
  "protocol_id": "ai_pocalypse_now_automating_the_systematic_literature_review_with_spark_systemat",
  "parent_protocol_id": null,
  "title": "AI-pocalypse now: Automating the systematic literature review with SPARK (Systematic processing and automated review Kit) – gathering, organising, filtering, and scaffolding.",
  "author": "Atkinson",
  "license": "CC-BY-4.0",
  "license_verified": true,
  "license_note": "CC-BY-4.0 - verified from PMC XML",
  "source_name": "methodsx",
  "source_id": "PMC11751522",
  "source_url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC11751522/",
  "doi": "10.1016/j.mex.2024.103129",
  "citation": "10.1016/j.mex.2024.103129",
  "category": "Lab Automation & Robotics",
  "tags": [],
  "estimated_time_mins": 48,
  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare computational environment",
      "instruction": "Install Python version 3.11.3, set up a Jupyter Notebook in Microsoft Visual Studio Code, and install all required libraries for the workflow (e.g., requests, pandas, fuzzywuzzy, nltk, gensim, pyLDAvis).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Obtain required API keys",
      "instruction": "Secure API keys for Web of Science (WoS), Scopus, and the Search Engine Results Page API (SerpAPI) and store them securely for use in the scripts.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Gather metadata from databases",
      "instruction": "Run the provided Python script to query WoS, Scopus, and Google Scholar with targeted search strings for trauma‑informed policing training, retrieving article metadata (title, authors, DOI, year, abstract) for each source.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Screen Google Scholar DOIs",
      "instruction": "From the Google Scholar results, keep only records that contain a valid DOI; discard entries without DOIs to ensure verifiable, academic sources.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Combine database results",
      "instruction": "Merge the three individual datasets (WoS, Scopus, Google Scholar) into a single consolidated DataFrame, preserving title, authors, DOI, publication year, and abstract for each record.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Remove duplicate records",
      "instruction": "Identify and eliminate duplicate articles using two methods: (1) exact DOI matching and (2) fuzzy‑matching algorithms on titles/authors. Ensure each article appears only once in the combined dataset.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Filter by predefined keywords",
      "instruction": "Apply a keyword filter based on a list of terms related to trauma‑informed policing training; retain only articles whose titles, abstracts, or keywords contain at least one of these terms.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Preprocess abstracts for LDA",
      "instruction": "Tokenise and lemmatise each abstract, convert text to lowercase, remove stopwords, and generate bi‑grams and tri‑grams to capture common phrases.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Train and evaluate LDA models",
      "instruction": "Create multiple LDA models with varying random states, compute coherence scores for each, and visualise the scores in a plot to identify the random state that yields the most coherent topics.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Run final LDA model",
      "instruction": "Using the optimal random state (fixed at 89), train a final LDA model with the following parameters: number of topics = 10, update_every = 12, chunk size = 100, passes = 30, alpha = 'auto', per_word_topics = True, and the preprocessed corpus and dictionary (id2word). After training, print the identified topics with their word weights via the print_topics method and retrieve each document’s topic distribution.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
