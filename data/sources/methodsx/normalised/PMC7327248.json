  "steps": [
    {
      "step_id": 0,
      "title": "Prepare real assembly station",
      "instruction": "Place the different panels on top of a steel panel as shown in Fig. 6 and seat the participant at the workstation.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare virtual assembly station",
      "instruction": "Set up a 24‑inch computer monitor displaying the virtual environment at 1080p resolution (1920 × 1080 pixels, 16:9 aspect ratio); adjust the monitor height to the participant’s eye level; position a floor marking and have the participant stand on it approximately 60 cm from the screen; place the LEAP® motion controller so the participant’s real hand is above the controller and below eye level, allowing only the virtual hand to be seen on the screen.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Run real assembly cycle",
      "instruction": "Allow the participant to perform the assembly task while seated; when the cycle is finished, instruct the participant to rotate the chair to the left side so experimenters can replace the baseplates for the resource and assembly areas, which also prevents the participant from viewing or memorising the visual instruction pattern.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Run virtual assembly cycle",
      "instruction": "Have the participant perform the assembly task while standing; after the cycle, display a scenic image for a ten‑second pause during which the participant lowers the hand and rests, preventing observation or memorisation of the visual instruction pattern.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
