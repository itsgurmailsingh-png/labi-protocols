{
  "protocol_id": "micromechanical_beol_robustness_evaluation_methods_for_customization_and_monitor",
  "parent_protocol_id": null,
  "title": "Micromechanical BEoL Robustness Evaluation Methods for Customization and Monitoring",
  "author": "Silomon, Chimeg, et al.",
  "license": "CC-BY-4.0",
  "license_verified": true,
  "license_note": "CC-BY-4.0 - verified from PMC XML",
  "source_name": "methodsx",
  "source_id": "PMC9918789",
  "source_url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9918789/",
  "doi": "10.1016/j.mex.2023.102028",
  "citation": "10.1016/j.mex.2023.102028",
  "category": "Materials Science",
  "tags": [
    "micromechanics",
    "acoustic emission",
    "robustness evaluation"
  ],
  "estimated_time_mins": 180,
  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare AE Sensor and Sample Holder",
      "instruction": "Set up the acoustic emission (AE) monitoring system to detect minor damages during mechanical loading.",
      "substeps": [
        {
          "instruction": "Place a Mistras PICO sensor (5 mm diameter, 4 mm height) into the dedicated cavity of the sensor/sample holder.",
          "title": ""
        },
        {
          "instruction": "Apply high vacuum grease as a coupling agent to the sensor to ensure acoustic signal transmission from the sample.",
          "title": ""
        },
        {
          "instruction": "Place the sample on the sensor and immobilize it using a metal mask with two sample windows.",
          "title": ""
        },
        {
          "instruction": "Screw the holder into the Bruker/Hysitron TI950 base plate or another mechanical loading unit.",
          "title": ""
        },
        {
          "instruction": "Connect the AE sensor to a Mistras 2/4/6 Preamplifier (60 dB gain) and then to an HBM transient recorder using 'Perception' software.",
          "title": ""
        },
        {
          "instruction": "Configure the software to record data at 100 MSamples/s only when the amplitude surpasses a threshold (typically 50 mV).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Perform Regular Shear Test",
      "instruction": "Induce mechanical load on single Cu-pillars using a diamond indenter tip.",
      "substeps": [
        {
          "instruction": "Use a diamond indenter tip with a 50 µm x 50 µm base, ensuring at least one edge has no incline and the shear face is parallel to the Cu-pillar.",
          "title": ""
        },
        {
          "instruction": "Set the shear velocity and shear height using the Bruker/Hysitron control software.",
          "title": ""
        },
        {
          "instruction": "Conduct the experiment in displacement-control mode over a defined shear distance and time.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Perform Mechanical Immobilization Test",
      "instruction": "Emulate application conditions by immobilizing the Cu-pillar to prevent tilting during loading.",
      "substeps": [
        {
          "instruction": "Use a customized indenter tip with a cavity designed for Cu-pillar immobilization.",
          "title": ""
        },
        {
          "instruction": "Perform an initial indent of 8 to 12 µm (typically 10 µm) to plastically deform the solder cap and mechanically connect the pillar to the tip.",
          "title": ""
        },
        {
          "instruction": "Apply lateral or cyclical loading along one axis.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Perform Cu-Pillar Soldering and Tensile Test",
      "instruction": "Establish a solder connection between a customized copper indenter tip and a Cu-pillar to emulate flip-chip assembly and apply tensile stress.",
      "substeps": [
        {
          "instruction": "Prepare the copper indenter tip (200 µm tip diameter, 2.5 mm shaft diameter, 5 mm length) by applying a thin layer of flux with a brush.",
          "title": ""
        },
        {
          "instruction": "Ensure the tip is insulated with 2–3 layers of Teflon tape (replace tape approximately every 15 experiments) and installed with a Macor adapter for thermal/electrical insulation.",
          "title": ""
        },
        {
          "instruction": "Approach a single unsoldered Cu-pillar with an initial force of 150 mN – 400 mN, monitoring via USB camera.",
          "title": ""
        },
        {
          "instruction": "Apply an electrical current of 0.7 A and voltage of 2.3 V to the Kanthal heating wire (0.2 mm diameter) to reach the reflow temperature (220 °C for Sn97Ag3).",
          "title": ""
        },
        {
          "instruction": "Hold the reflow temperature for 10 – 20 s.",
          "title": ""
        },
        {
          "instruction": "Remove the current and allow the connection to cool for 1 min.",
          "title": ""
        },
        {
          "instruction": "Apply tensile force using the motorized XYZ stage at a constant speed until failure occurs.",
          "title": ""
        },
        {
          "instruction": "Remove the detached Cu-pillar by reapplying heat and wiping with a Q-tip once the solder is molten.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Execute Sub-Critical Loading Strategy",
      "instruction": "Identify the exact location of damage initiation by stopping the experiment at the first sign of acoustic emission.",
      "substeps": [
        {
          "instruction": "Select a low mechanical loading velocity (typically 1 µm/s).",
          "title": ""
        },
        {
          "instruction": "Monitor AE signals continuously during the loading process.",
          "title": ""
        },
        {
          "instruction": "Manually stop the application of mechanical load in the software immediately upon the detection of an AE signal.",
          "title": ""
        },
        {
          "instruction": "Analyze the sample using nXCT and SEM/FIB to quantify the initial damage.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
