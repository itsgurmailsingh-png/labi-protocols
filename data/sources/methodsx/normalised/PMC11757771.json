  "steps": [
    {
      "step_id": 0,
      "title": "Collect scale samples and label",
      "instruction": "Take scale samples from live Asian arowana kept in cages at the proposed Arowana Sanctuary of Bukit Merah Lake, under monitoring by the Department of Fisheries, Malaysia; photograph each sample and assign a lab inventory number.",
      "substeps": [
        {
          "instruction": "Carefully remove a scale from each live specimen.",
          "title": ""
        },
        {
          "instruction": "Photograph the collected scale.",
          "title": ""
        },
        {
          "instruction": "Record a unique lab inventory number for the sample.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Extract genomic DNA",
      "instruction": "Extract genomic DNA from each scale using the DNEasy Blood and Tissue Kit (Qiagen, USA) following the manufacturer’s instructions, incorporating the unspecified modifications mentioned in the protocol.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Measure DNA concentration",
      "instruction": "Measure the concentration of the eluted DNA with a UV spectrophotometer Q3000 (Quawell, USA).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
