  "steps": [
    {
      "step_id": 0,
      "title": "Calculate and weigh components",
      "instruction": "Using the solid‑volume‑fraction equation φ(%) = mNF / (mNF + mOIL) × 100 and the values given in Table 1, determine the required mass of NiFe₂O₄‑MWCNT hybrid nanoparticles (mNF) and of 20W‑50 SAE engine oil (mOIL) for each solid volume fraction (0, 0.25, 0.50, 0.75, 1.0 %). For each sample weigh the exact masses listed in Table 1 so that the combined mass corresponds to 60 mL of nanofluid (≈ 60 g assuming oil density ≈ 1 g mL⁻¹).",
      "substeps": [
        {
          "instruction": "Sample 1 (0 % SVF): mNF = 0 g, mOIL = 49.83 g",
          "title": ""
        },
        {
          "instruction": "Sample 2 (0.25 % SVF): mNF = 0.137 g, mOIL = 49.69 g",
          "title": ""
        },
        {
          "instruction": "Sample 3 (0.50 % SVF): mNF = 0.275 g, mOIL = 49.55 g",
          "title": ""
        },
        {
          "instruction": "Sample 4 (0.75 % SVF): mNF = 0.412 g, mOIL = 49.00 g",
          "title": ""
        },
        {
          "instruction": "Sample 5 (1.00 % SVF): mNF = 0.550 g, mOIL = 49.77 g",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Blend and ultrasonicate",
      "instruction": "Manually add the weighed NiFe₂O₄‑MWCNT nanoparticles to the measured oil, stir continuously to disperse the particles, then place the mixture in a UC‑4120 ultrasonic bath and operate for 8 hours at ambient temperature to obtain a homogeneous nanofluid and break up any agglomerates.",
      "substeps": [
        {
          "instruction": "Add nanoparticles to oil in a beaker.",
          "title": ""
        },
        {
          "instruction": "Stir the suspension constantly while adding.",
          "title": ""
        },
        {
          "instruction": "Transfer the suspension to the UC‑4120 ultrasonic bath.",
          "title": ""
        },
        {
          "instruction": "Run the bath for 8 hours without interruption.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
