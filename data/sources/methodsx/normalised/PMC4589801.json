{
  "protocol_id": "an_accurate_precise_method_for_general_labeling_of_extracellular_vesicles",
  "parent_protocol_id": null,
  "title": "An accurate, precise method for general labeling of extracellular vesicles",
  "author": "Gray, Mitchell, et al.",
  "license": "CC-BY-4.0",
  "license_verified": true,
  "license_note": "CC-BY-4.0 - verified from PMC XML",
