  "doi": "10.1016/j.mex.2015.08.002",
  "citation": "10.1016/j.mex.2015.08.002",
  "category": "Other",
  "tags": [],
  "estimated_time_mins": 95,
  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare permeabilization solutions",
      "instruction": "Resuspend isolated EVs in 0.2 µm‑filtered Triton‑X‑100 at 0 %, 0.001 %, 0.01 %, 0.1 % or 1 % (v/v) for 10 min, or in filtered saponin at 0 mg/mL, 1 µg/mL, 10 µg/mL, 100 µg/mL or 1 mg/mL for 20 min.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Dilute and centrifuge EVs",
      "instruction": "Dilute each permeabilized EV suspension 2‑fold with filtered PBS, then centrifuge at 16,100 × g for 20 min to pellet EVs and remove residual permeabilizing agent.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Label EVs with calcein AM",
      "instruction": "Resuspend each pellet in 100 µL of 10 µM calcein AM solution and incubate for 20 min at 37 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Remove salts and resuspend in Diluent C",
      "instruction": "Pellet the calcein‑AM‑labeled EVs by centrifugation at 16,100 × g for 20 min, discard supernatant, and resuspend the pellet in Diluent C (provided with PKH26 dye).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Add PKH26 membrane dye",
      "instruction": "Add PKH26 dye to the Diluent C‑resuspended EVs to achieve a final concentration of 2 µM, mix and incubate for 5 min at room temperature.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Adjust volume and prepare for flow cytometry",
      "instruction": "Add filtered PBS to each EV suspension to bring the final volume to 300 µL, then keep on ice (or as appropriate) until flow cytometry analysis.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Prepare single‑stain and control samples",
      "instruction": "Prepare single‑stain controls by labeling non‑permeabilized EVs with calcein AM only and PKH26 only, and include a non‑stained EV sample for compensation controls.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
