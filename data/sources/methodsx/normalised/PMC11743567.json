  "citation": "10.1016/j.mex.2024.103124",
  "category": "Synthetic Biology",
  "tags": [],
  "estimated_time_mins": 12,
  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Segment CT and export 3D model",
      "instruction": "Load the patient CT scan, segment the aorta and outflow cannula, isolate them, and export the resulting geometry as a 3D object file (e.g., STL).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Create insert and design external molds",
      "instruction": "Using CAD software, import the 3D anatomical object, generate a sacrificial insert that includes extended segments of the aorta, and design multiplanar external molds that will encase the insert.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "3D print and assemble molds",
      "instruction": "3‑D print the sacrificial insert and each external mold (FDM printing is acceptable); clean the prints, then assemble the external molds around the insert to form a sealed casting cavity.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Pour and cure silicone",
      "instruction": "Prepare an optically clear silicone according to the manufacturer’s instructions, pour it into the assembled mold cavity until the insert is fully covered, and allow the silicone to cure (follow the silicone’s specified cure time and temperature).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Remove insert to obtain hollow model",
      "instruction": "After the silicone has fully cured, disassemble the external molds and carefully extract the sacrificial insert, leaving a hollow, thin‑walled, optically clear aorta model suitable for flow visualization.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
