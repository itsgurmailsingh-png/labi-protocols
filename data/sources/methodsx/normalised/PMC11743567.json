  "protocol_id": "rapid_manufacturing_method_of_cardiovascular_models_for_experimental_flow_analys",
  "parent_protocol_id": null,
  "title": "Rapid Manufacturing Method of Cardiovascular Models for Experimental Flow Analysis",
  "author": "Fowler, Robbins, et al.",
  "license": "CC-BY-4.0",
  "license_verified": true,
  "license_note": "CC-BY-4.0 - verified from PMC XML",
