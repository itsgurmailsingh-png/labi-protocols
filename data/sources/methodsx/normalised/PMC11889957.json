  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Obtain scene image dataset",
      "instruction": "Download the Kaggle Scene Classification dataset containing six classes (buildings, forest, glacier, mountain, sea, street) with ~25,000 RGB images of varying resolutions (256 × 256 to 1024 × 1024). For the reported experiments select 500 images per class (total 3,000 images).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Preprocess images",
      "instruction": "Resize every image to 200 × 200 pixels, apply normalization and the desired data‑augmentation (e.g., random flips, rotations) to ensure consistent quality and diversity before training.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Split dataset into train/test",
      "instruction": "Randomly partition the 3,000 pre‑processed images into 80 % (2,400 images) for training and 20 % (600 images) for testing.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Define multimodal CNN architecture",
      "instruction": "Construct two parallel convolutional pathways, merge them with an element‑wise addition, and attach a feature‑selection block followed by classification layers as described below.",
      "substeps": [
        {
          "instruction": "Input layer: 200 × 200 × 3 image tensor.",
          "title": ""
        },
        {
          "instruction": "Pathway 1 – Convolution 1: 128 filters, kernel 3 × 3, stride [1 1], padding enabled → output 200 × 200 × 128.",
          "title": ""
        },
        {
          "instruction": "Pathway 1 – Max‑pool 1: 2 × 2 pool size, padding → 200 × 200 × 128.",
          "title": ""
        },
        {
          "instruction": "Pathway 1 – ReLU activation.",
          "title": ""
        },
        {
          "instruction": "Pathway 1 – Convolution 2: 64 filters, kernel 3 × 3, stride [1 1], padding → 200 × 200 × 64.",
          "title": ""
        },
        {
          "instruction": "Pathway 1 – Max‑pool 2: 2 × 2, padding → 200 × 200 × 64.",
          "title": ""
        },
        {
          "instruction": "Pathway 1 – ReLU activation.",
          "title": ""
        },
        {
          "instruction": "Pathway 1 – Convolution 3: 32 filters, kernel 3 × 3, stride [1 1], padding → 200 × 200 × 32.",
          "title": ""
        },
        {
          "instruction": "Pathway 1 – Max‑pool 3: 2 × 2, padding → 200 × 200 × 32.",
          "title": ""
        },
        {
          "instruction": "Pathway 1 – ReLU activation.",
          "title": ""
        },
        {
          "instruction": "Pathway 1 – Fully Connected 1: 1 × 1 × 1024 (weights 1024 × 1280 000, biases 1024 × 1).",
          "title": ""
        },
        {
          "instruction": "Pathway 2 – Convolution 1: 128 filters, kernel 3 × 3, stride [1 1], padding → 200 × 200 × 128.",
          "title": ""
        },
        {
          "instruction": "Pathway 2 – Max‑pool 1: 2 × 2, padding → 200 × 200 × 128.",
          "title": ""
        },
        {
          "instruction": "Pathway 2 – ReLU activation.",
          "title": ""
        },
        {
          "instruction": "Pathway 2 – Convolution 2: 64 filters, kernel 3 × 3, stride [1 1], padding → 200 × 200 × 64.",
          "title": ""
        },
        {
          "instruction": "Pathway 2 – Max‑pool 2: 2 × 2, padding → 200 × 200 × 64.",
          "title": ""
        },
        {
          "instruction": "Pathway 2 – ReLU activation.",
          "title": ""
        },
        {
          "instruction": "Pathway 2 – Convolution 3: 32 filters, kernel 3 × 3, stride [1 1], padding → 200 × 200 × 32.",
          "title": ""
        },
        {
          "instruction": "Pathway 2 – Max‑pool 3: 2 × 2, padding → 200 × 200 × 32.",
          "title": ""
        },
        {
          "instruction": "Pathway 2 – ReLU activation.",
          "title": ""
        },
        {
          "instruction": "Pathway 2 – Fully Connected 2: 1 × 1 × 1024 (weights 1024 × 1280 000, biases 1024 × 1).",
          "title": ""
        },
        {
          "instruction": "Element‑wise addition: combine the two 1 × 1 × 1024 tensors → 1 × 1 × 1024.",
          "title": ""
        },
        {
          "instruction": "ReLU activation on addition output → 1 × 1 × 1024.",
          "title": ""
        },
        {
          "instruction": "Feature‑Selection Layer – Fully Connected: 600 neurons (weights 600 × 1024, biases 600 × 1).",
          "title": ""
        },
        {
          "instruction": "ReLU activation → 1 × 1 × 600.",
          "title": ""
        },
        {
          "instruction": "Dropout: 50 % → 1 × 1 × 600.",
          "title": ""
        },
        {
          "instruction": "Classification Layer – Fully Connected: 6 neurons (weights 6 × 600, biases 6 × 1).",
          "title": ""
        },
        {
          "instruction": "Softmax activation → 1 × 1 × 6 class probabilities.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Set training hyperparameters",
      "instruction": "Configure the training routine with the following settings: optimizer = Adam, batch size = 4, learning rate = 1.0 × 10⁻⁴ (adaptive schedule), total epochs = 10, loss function = categorical cross‑entropy, validation frequency = 87 iterations.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Train the model",
      "instruction": "Feed the 2,400‑image training set through the defined architecture, updating weights via Adam optimizer for 10 epochs with the specified batch size and learning‑rate schedule. Validate every 87 iterations.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Evaluate model performance",
      "instruction": "Run inference on the 600‑image test set and compute the following metrics:",
      "substeps": [
        {
          "instruction": "Accuracy = (TP + TN) / (TP + TN + FP + FN)",
          "title": ""
        },
        {
          "instruction": "Precision = TP / (TP + FP)",
          "title": ""
        },
        {
          "instruction": "Recall = TP / (TP + FN)",
          "title": ""
        },
        {
          "instruction": "F1‑Score = 2 × (Precision × Recall) / (Precision + Recall)",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Validate on AID dataset (optional)",
      "instruction": "Repeat steps 1‑6 using the AID dataset (30 classes, 10,000 images, each 600 × 600 pixels). Select ~200 images per class (≈6,000 images), split 80 %/20 % train/test, and apply the same architecture and hyperparameters.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
