  "steps": [
    {
      "step_id": 0,
      "title": "Dissect propterygium from rays",
      "instruction": "Dissect the propterygium (the long, rod‑like portion of the skeleton supporting the wing) from two adult Haller's round rays (Urobatis halleri): one female with a 19 cm disk width and one male with a 21.4 cm disk width.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare cartilage strips",
      "instruction": "Excise long strips of tessellated cartilage from the dissected skeletal samples, air‑dry the strips, and affix them upright in micro‑centrifuge tubes for subsequent synchrotron experiments.",
      "substeps": [
        {
          "instruction": "Excise long strips of tessellated cartilage from each specimen.",
          "title": ""
        },
        {
          "instruction": "Air‑dry the excised strips.",
          "title": ""
        },
        {
          "instruction": "Affix the dried strips upright in micro‑centrifuge tubes.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "SR‑µCT scan and reconstruction",
      "instruction": "Scan the tesserae samples at the BAMline synchrotron (BESSY II, Helmholtz‑Zentrum Berlin für Materialien und Energien) using synchrotron radiation micro‑computed tomography, reconstruct the volumes as described in reference [6], and note that the effective pixel size of the resulting datasets is 876 nm.",
