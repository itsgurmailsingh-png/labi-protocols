    "_Metrics_Summary.csv."
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Isolate PBMCs from blood",
      "instruction": "Perform peripheral blood mononuclear cell (PBMC) isolation from 3–5 mL whole blood collected in BD Vacutainer CPT tubes (kept at 25 °C) following the steps below.",
      "substeps": [
        {
          "instruction": "Thaw 1× PBS (filtered) and FBS to 25 °C.",
          "title": ""
        },
        {
          "instruction": "Prepare 50 mL freezing media by mixing 45 mL FBS with 5 mL DMSO (store at 4 °C).",
          "title": ""
        },
        {
          "instruction": "Collect 3–5 mL blood into each CPT tube; keep tubes upright at 25 °C.",
          "title": ""
        },
        {
          "instruction": "Within 2 h, gently invert each tube 8–10 times to remix blood.",
          "title": ""
        },
        {
          "instruction": "Centrifuge tubes in a swing‑out rotor at 25 °C for ≥15 min at 1500–1800 × g (do not exceed 2000 × g).",
          "title": ""
        },
        {
          "instruction": "Locate the whitish mononuclear cell layer just below the plasma.",
          "title": ""
        },
        {
          "instruction": "Aspirate ~½ of the plasma without disturbing the cell layer.",
          "title": ""
        },
        {
          "instruction": "Using a sterile pipette, transfer the mononuclear cell layer to a 15 mL conical tube.",
          "title": ""
        },
        {
          "instruction": "Add 1× PBS to bring the volume to 15 mL, cap and invert 5 times.",
          "title": ""
        },
        {
          "instruction": "Centrifuge at 300 × g for 15 min, then carefully aspirate supernatant.",
          "title": ""
        },
        {
          "instruction": "Resuspend pellet, add 1× PBS to 10 mL, cap and invert 5 times.",
          "title": ""
        },
        {
          "instruction": "Centrifuge again at 300 × g for 10 min and aspirate supernatant.",
          "title": ""
        },
        {
          "instruction": "Resuspend the final pellet in 1 mL freezing media (90 % FBS, 10 % DMSO).",
          "title": ""
        },
        {
          "instruction": "Transfer the suspension to a labeled cryotube and store at –80 °C.",
          "title": ""
        },
        {
          "instruction": "Within one week move cryotubes to liquid nitrogen (–196 °C) for long‑term storage.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Install required bioinformatics tools",
      "instruction": "Create a conda environment and install all software needed for downstream analysis.",
      "substeps": [
        {
          "instruction": "conda install -c bioconda bcl2fastq",
          "title": ""
        },
        {
          "instruction": "conda install -c bioconda fastqc",
          "title": ""
        },
        {
          "instruction": "conda install -c bioconda trimmomatic",
          "title": ""
        },
        {
          "instruction": "conda install -c bioconda star",
          "title": ""
        },
        {
          "instruction": "conda install -c bioconda kraken2",
          "title": ""
        },
        {
          "instruction": "conda install -c bioconda sevenbridges-python",
          "title": ""
        },
        {
          "instruction": "conda install -c bioconda agat",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Download raw sequencing data",
      "instruction": "Retrieve the GEO dataset GSE201088 and, if needed, the corresponding SRA fastq files.",
      "substeps": [
        {
          "instruction": "mkdir scRNAseq && cd scRNAseq",
          "title": ""
        },
        {
          "instruction": "wget --recursive --no-parent -nd https://ftp.ncbi.nlm.nih.gov/geo/series/GSE201nnn/GSE201088/suppl/GSE201088_RAW.tar",
          "title": ""
        },
        {
          "instruction": "tar -xvf GSE201088_RAW.tar",
          "title": ""
        },
        {
          "instruction": "for f in *.gz; do gunzip $f; done",
          "title": ""
        },
        {
          "instruction": "Install SRA‑Toolkit (https://github.com/ncbi/sra-tools/wiki/02.-Installing-SRA-Toolkit).",
          "title": ""
        },
        {
          "instruction": "prefetch SRR18827616",
          "title": ""
        },
        {
          "instruction": "fastq-dump SRR18827616.sra",
          "title": ""
        },
        {
          "instruction": "If prefetch fails, rerun with --max-size <value> to increase memory.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Quality control and trimming of reads",
      "instruction": "Assess read quality with FastQC, trim adapters and low‑quality bases, and prepare reads for alignment.",
      "substeps": [
        {
          "instruction": "Run FastQC on all raw FASTQ files: fastqc *.fastq.gz",
          "title": ""
        },
        {
          "instruction": "Trim reads with Trimmomatic (example command omitted; use default adapter and quality settings).",
          "title": ""
        },
        {
          "instruction": "For STARsolo mapping, keep R1 for cell barcode/UMI and R2 for cDNA.",
          "title": ""
        },
        {
          "instruction": "STARsolo trimming parameters for BD Rhapsody:",
          "title": ""
        },
        {
          "instruction": "--readFilesCommand zcat",
          "title": ""
        },
        {
          "instruction": "--soloType CB_UMI_Complex",
          "title": ""
        },
        {
          "instruction": "--soloCBmatchWLtype 1MM",
          "title": ""
        },
        {
          "instruction": "--soloCBposition 0_0_0_8 0_13_0_21 0_26_0_34",
          "title": ""
        },
        {
          "instruction": "--soloUMIposition 0_35_0_43",
          "title": ""
        },
        {
          "instruction": "--soloCBwhitelist CL1S.txt CL2S.txt CL3S.txt",
          "title": ""
        },
        {
          "instruction": "--outFileNamePrefix ./star_solo",
          "title": ""
        },
        {
          "instruction": "--outSAMattributes CB UB",
          "title": ""
        },
        {
          "instruction": "--outSAMtype BAM SortedByCoordinate",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Align reads to human genome and extract unmapped reads",
      "instruction": "Map trimmed reads to the human reference with STAR, then isolate reads that did not align.",
      "substeps": [
        {
          "instruction": "STAR --runThreadN 40 \\",
          "title": ""
        },
        {
          "instruction": "--genomeDir /path/to/human/STAR/index \\",
          "title": ""
        },
        {
          "instruction": "--readFilesIn _R2.fastq.gz _R1.fastq.gz \\",
          "title": ""
        },
        {
          "instruction": "--soloType CB_UMI_Complex \\",
          "title": ""
        },
        {
          "instruction": "--soloCBmatchWLtype 1MM \\",
          "title": ""
        },
        {
          "instruction": "--soloCBposition 0_0_0_8 0_13_0_21 0_26_0_34 \\",
          "title": ""
        },
        {
          "instruction": "--soloUMIposition 0_35_0_43 \\",
          "title": ""
        },
        {
          "instruction": "--soloCBwhitelist CL1S.txt CL2S.txt CL3S.txt \\",
          "title": ""
        },
        {
          "instruction": "--outFileNamePrefix ./star_human \\",
          "title": ""
        },
        {
          "instruction": "--outSAMattributes CB UB \\",
          "title": ""
        },
        {
          "instruction": "--outSAMtype BAM SortedByCoordinate",
          "title": ""
        },
        {
          "instruction": "Extract unmapped reads:",
          "title": ""
        },
        {
          "instruction": "samtools view -u -f 4 star_human/Aligned.sortedByCoord.out.bam > unmapped.bam",
          "title": ""
        },
        {
          "instruction": "Convert to FASTQ:",
          "title": ""
        },
        {
          "instruction": "samtools bam2fq unmapped.bam | gzip > unmapped.fastq.gz",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Classify unmapped reads with Kraken2",
      "instruction": "Identify microbial taxa present in the unmapped read set using Kraken2 and visualize results with Pavian.",
      "substeps": [
        {
          "instruction": "Download a Kraken2 database (maxikraken2_1903, ~140 GB) or the smaller kraken2‑microbial (30 GB) as storage permits.",
          "title": ""
        },
        {
          "instruction": "kraken2 --threads 20 --db /path/to/kraken2_db \\",
          "title": ""
        },
        {
          "instruction": "--report sample.report \\",
          "title": ""
        },
        {
          "instruction": "--output sample.output \\",
          "title": ""
        },
        {
          "instruction": "--gzip-compressed unmapped.fastq.gz",
          "title": ""
        },
        {
          "instruction": "Repeat for each sample.",
          "title": ""
        },
        {
          "instruction": "Install Pavian in R:",
          "title": ""
        },
        {
          "instruction": "install.packages(\"remotes\"); remotes::install_github(\"fbeitwieser/pavian\")",
          "title": ""
        },
        {
          "instruction": "pavian::runApp(port=5000)",
          "title": ""
        },
        {
          "instruction": "Upload all *.report files to the Pavian web interface (increase maxUploadSize if needed).",
          "title": ""
        },
        {
          "instruction": "Export the combined count matrix as count_matrix_microbes.csv.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Normalize metagenomic read counts",
      "instruction": "Apply Cumulative Sum Scaling (CSS) normalization to the microbial count matrix using the metagenomeSeq R package.",
      "substeps": [
        {
          "instruction": "setwd(\"/path/to/working/dir\")",
          "title": ""
        },
        {
          "instruction": "library(metagenomeSeq)",
          "title": ""
        },
        {
          "instruction": "raw_data <- read.csv(\"count_matrix_microbes.csv\", row.names=1)",
          "title": ""
        },
        {
          "instruction": "physeq_obj <- phyloseq::phyloseq(phyloseq::otu_table(raw_data, taxa_are_rows=TRUE))",
          "title": ""
        },
        {
          "instruction": "physeq_obj <- prune_taxa(taxa_sums(physeq_obj) > 0, physeq_obj)  # filter 0‑count taxa",
          "title": ""
        },
        {
          "instruction": "# Filter taxa with <1 % relative abundance using phyloseq (optional)",
          "title": ""
        },
        {
          "instruction": "css_norm <- cumNorm(physeq_obj, p=0.5)  # CSS normalization",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Build combined human‑microbe reference index",
      "instruction": "Create a STAR genome index that contains both the human genome and selected microbial genomes.",
      "substeps": [
        {
          "instruction": "Download microbial FASTA and GFF3 files (example for Bacillus cereus):",
          "title": ""
        },
        {
          "instruction": "wget https://ftp.ensemblgenomes.ebi.ac.uk/pub/bacteria/release-59/fasta/bacteria_119_collection/bacillus_cereus_03bb102_gca_000022505/dna/Bacillus_cereus_03bb102_gca_000022505.ASM2250v1_.dna.toplevel.fa.gz",
          "title": ""
        },
        {
          "instruction": "wget https://ftp.ensemblgenomes.ebi.ac.uk/pub/bacteria/release-59/gff3/bacteria_119_collection/bacillus_cereus_03bb102_gca_000022505/Bacillus_cereus_03bb102_gca_000022505.ASM2250v1.59.gff3.gz",
          "title": ""
        },
        {
          "instruction": "If GFF3, convert to GTF:",
          "title": ""
        },
        {
          "instruction": "agat_convert_sp_gff2gtf.pl --gff Bacillus_cereus_03bb102_gca_000022505.ASM2250v1.59.gff3 -to Bacillus_cereus.gtf",
          "title": ""
        },
        {
          "instruction": "Place all human FASTA/GTF and microbial FASTA/GTF files in one folder.",
          "title": ""
        },
        {
          "instruction": "Concatenate FASTA files:",
          "title": ""
        },
        {
          "instruction": "cat *.fa *.fasta *.fa.gz > human_microbes.fa",
          "title": ""
        },
        {
          "instruction": "Concatenate GTF files:",
          "title": ""
        },
        {
          "instruction": "cat *.gtf > human_microbes.gtf",
          "title": ""
        },
        {
          "instruction": "Build STAR index:",
          "title": ""
        },
        {
          "instruction": "STAR --runThreadN 20 \\",
          "title": ""
        },
        {
          "instruction": "--runMode genomeGenerate \\",
          "title": ""
        },
        {
          "instruction": "--genomeDir STAR_index \\",
          "title": ""
        },
        {
          "instruction": "--genomeFastaFiles human_microbes.fa \\",
          "title": ""
        },
        {
          "instruction": "--sjdbGTFfile human_microbes.gtf \\",
          "title": ""
        },
        {
          "instruction": "--genomeSAsparseD 3",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Align single‑cell reads to combined reference",
      "instruction": "Map the cell‑specific FASTQ files to the human‑microbe STAR index using either Seven Bridges (BD Rhapsody) or STARsolo.",
      "substeps": [
        {
          "instruction": "Option A – Seven Bridges:",
          "title": ""
        },
        {
          "instruction": "sb upload start human_microbes_index.tar.gz --destination /microbes-run",
          "title": ""
        },
        {
          "instruction": "sb upload start sample1_R1.fastq.gz --destination /microbes-run",
          "title": ""
        },
        {
          "instruction": "sb upload start sample1_R2.fastq.gz --destination /microbes-run",
          "title": ""
        },
        {
          "instruction": "Run the BD Rhapsody pipeline on the Seven Bridges portal with default parameters and the custom index.",
          "title": ""
        },
        {
          "instruction": "Expected output files include _RSEC_MolsPerCell.csv, _Expression_Data.st, etc.",
          "title": ""
        },
        {
          "instruction": "Option B – STARsolo:",
          "title": ""
        },
        {
          "instruction": "STAR --runThreadN 40 \\",
          "title": ""
        },
        {
          "instruction": "--genomeDir STAR_index \\",
          "title": ""
        },
        {
          "instruction": "--readFilesIn sample_R2.fastq.gz sample_R1.fastq.gz \\",
          "title": ""
        },
        {
          "instruction": "--readFilesCommand zcat \\",
          "title": ""
        },
        {
          "instruction": "--soloType CB_UMI_Complex \\",
          "title": ""
        },
        {
          "instruction": "--soloCBmatchWLtype 1MM \\",
          "title": ""
        },
        {
          "instruction": "--soloCBposition 0_0_0_8 0_13_0_21 0_26_0_34 \\",
          "title": ""
        },
        {
          "instruction": "--soloUMIposition 0_35_0_43 \\",
          "title": ""
        },
        {
          "instruction": "--soloCBwhitelist CL1S.txt CL2S.txt CL3S.txt \\",
          "title": ""
        },
        {
          "instruction": "--soloCellFilter EmptyDrops_CR \\",
          "title": ""
        },
        {
          "instruction": "--outFileNamePrefix ./star_combined \\",
          "title": ""
        },
        {
          "instruction": "--outSAMattributes CB UB \\",
          "title": ""
        },
        {
          "instruction": "--outSAMtype BAM SortedByCoordinate",
          "title": ""
        },
        {
          "instruction": "For ABseq data, generate an ABseq reference FASTA and GTF (format shown in protocol) and repeat the STARsolo command with the appropriate index.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Extract microbial gene counts from single‑cell matrix",
      "instruction": "From the BD Rhapsody (or STARsolo) count matrix, pull out counts for microbial genes identified in the combined GTF.",
      "substeps": [
        {
          "instruction": "library(data.table); library(rtracklayer); library(Seurat)",
          "title": ""
        },
        {
          "instruction": "setwd(\"/path/to/count/matrix\")",
          "title": ""
        },
        {
          "instruction": "load(\"B1_RSEC_MolsPerCell.rds\")  # example count matrix",
          "title": ""
        },
        {
          "instruction": "gtf <- import.gff(\"human_microbes.gtf\")",
          "title": ""
        },
        {
          "instruction": "microbe_genes <- gtf[gtf$gene_biotype == \"protein_coding\" & grepl(\"Bacillus|...\", gtf$gene_id), \"gene_id\"]",
          "title": ""
        },
        {
          "instruction": "microbe_counts <- count_matrix[rownames(count_matrix) %in% microbe_genes, ]",
          "title": ""
        },
        {
          "instruction": "Save for downstream analysis:",
          "title": ""
        },
        {
          "instruction": "saveRDS(microbe_counts, file=\"microbe_counts.rds\")",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Pseudo‑bulk differential abundance analysis",
      "instruction": "Aggregate microbial counts by cell type and sample, then test for differential abundance with DESeq2.",
      "substeps": [
        {
          "instruction": "library(DESeq2); library(tidyverse); library(SingleCellExperiment)",
          "title": ""
        },
        {
          "instruction": "Load count matrix and metadata:",
          "title": ""
        },
        {
          "instruction": "counts <- readRDS(\"microbe_counts.rds\")",
          "title": ""
        },
        {
          "instruction": "meta <- read.csv(\"cell_metadata.csv\")  # must contain columns: cell_id, cell_type, sample_id, group",
          "title": ""
        },
        {
          "instruction": "Create pseudo‑bulk matrix:",
          "title": ""
        },
        {
          "instruction": "counts$cell_type <- meta$cell_type[match(colnames(counts), meta$cell_id)]",
          "title": ""
        },
        {
          "instruction": "counts$sample_id <- meta$sample_id[match(colnames(counts), meta$cell_id)]",
          "title": ""
        },
        {
          "instruction": "agg_counts <- counts %>% t() %>% as.data.frame() %>%",
          "title": ""
        },
        {
          "instruction": "group_by(cell_type, sample_id) %>% summarise_all(sum) %>%",
          "title": ""
        },
        {
          "instruction": "column_to_rownames(var=\"cell_type_sample\") %>% t()",
          "title": ""
        },
        {
          "instruction": "Prepare DESeq2 object:",
          "title": ""
        },
        {
          "instruction": "coldata <- data.frame(row.names=colnames(agg_counts), group=meta$group[match(colnames(agg_counts), meta$sample_id)])",
          "title": ""
        },
        {
          "instruction": "dds <- DESeqDataSetFromMatrix(countData=agg_counts, colData=coldata, design=~group)",
          "title": ""
        },
        {
          "instruction": "dds <- DESeq(dds)",
          "title": ""
        },
        {
          "instruction": "res <- results(dds)",
          "title": ""
        },
        {
          "instruction": "Write results:",
          "title": ""
        },
        {
          "instruction": "write.csv(as.data.frame(res), file=\"DESeq2_microbe_diff_abundance.csv\")",
          "title": ""
        },
        {
          "instruction": "Optional visualizations:",
          "title": ""
        },
        {
          "instruction": "rld <- rlog(dds, blind=FALSE)",
          "title": ""
        },
        {
          "instruction": "pheatmap(cor(assay(rld)), annotation_col=coldata)",
          "title": ""
        },
        {
          "instruction": "plotPCA(rld, intgroup=\"group\")",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
  "verification_status": "literature_sourced",
