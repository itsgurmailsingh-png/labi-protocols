  "steps": [
    {
      "step_id": 0,
      "title": "Prepare RNase‑free workspace",
      "instruction": "Clean all work surfaces, pipettes, tube racks and pipette boxes with Vikron, 1 % bleach or RNase Away; wear gloves at all times; keep all reagents and equipment cold; use filtered pipette tips; use DNase/RNase‑free 1.5 mL tubes, water and PBS; change gloves frequently to maintain cleanliness.",
      "substeps": [
        {
          "instruction": "Wash surfaces, pipettes, tube racks, and pipette boxes with Vikron, 1 % bleach or RNase Away.",
          "title": ""
        },
        {
          "instruction": "Wear gloves and change them frequently.",
          "title": ""
        },
        {
          "instruction": "Keep all reagents and equipment on ice or at 4 °C.",
          "title": ""
        },
        {
          "instruction": "Use pipette tips with filters.",
          "title": ""
        },
        {
          "instruction": "Use DNase/RNase‑free 1.5 mL tubes, water and PBS.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Purify RNA from INPUT and IP+BEADS samples",
      "instruction": "Thaw INPUT and IP+BEADS samples on ice; for IP samples, place tubes on a magnetic rack, remove the beads and collect the supernatant; purify RNA from the supernatant with the QIAGEN RNeasy Micro kit following the manufacturer’s protocol (https://www.qiagen.com/gb/resources/resourcedetail?id=e112adfa-cc06-4e29-87f8-4820062ae44e&lang=en); store the purified RNA at –80 °C, avoiding freeze‑thaw cycles; set aside an aliquot for quality assessment (volume depends on the downstream assay). Do not keep samples longer than 3 months at –80 °C before purification.",
      "substeps": [
        {
          "instruction": "Thaw INPUT and IP+BEADS samples on ice.",
          "title": ""
        },
        {
          "instruction": "Place IP+BEADS tubes on a magnetic rack and remove the beads; keep the supernatant.",
          "title": ""
        },
        {
          "instruction": "Purify RNA from the supernatant using the RNeasy Micro kit according to the manufacturer’s instructions.",
          "title": ""
        },
        {
          "instruction": "Store purified RNA at –80 °C; avoid repeated freeze‑thaw cycles.",
          "title": ""
        },
        {
          "instruction": "Aliquot a portion of the RNA for quality assessment (volume as required by the chosen assay).",
          "title": ""
        }
      ],
      "is_critical": true,
      "timers": []
    }
  ],
