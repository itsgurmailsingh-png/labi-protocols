  "steps": [
    {
      "step_id": 0,
      "title": "Obtain CRISPRi backbone",
      "instruction": "Acquire the all‑in‑one CRISPRi plasmid from Addgene (catalog number 71237).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Combine guides for off‑target reduction",
      "instruction": "Mix the two selected CRISPRi guide RNAs into a single experimental condition to minimize off‑target effects; this preparation requires a total of 4 days.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Sort GFP+ fbNPCs and prep RNA‑seq",
      "instruction": "Perform fluorescence‑activated cell sorting (FACS) to isolate GFP‑positive fibroblast‑derived neural progenitor cells (fbNPCs) and immediately process the sorted cells for RNA‑sequencing library preparation.",
      "substeps": [],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Run RNA‑seq and compare groups",
      "instruction": "Sequence the RNA from the prepared samples and analyze transcriptional differences between control cells (n = 4) and CRISPRi‑treated cells (n = 8).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
  "verification_status": "literature_sourced",
  "normalised_at": "2026-06-19T01:29:50.443480Z",
  "llm_normalised": true,
  "description": "The protocol below describes the specific steps for using CRISPRi in human induced pluripotent stem cells (hiPSCs). This protocol has also been used in fibroblasts converted to induced neurons (Pircs et al., 2022) and is likely suitable for other cell lines. We have used an all-in-one CRISPRi backbone from Addgene (Thakore et al., 2015; Addgene_71237). Molecular cloning, lentiviral production, qRT-PCR and hiPSCs culture techniques need to be established in the lab for successful application of this protocol (these techniques are not covered here). Verified qRT-PCR primers for the gene of interest and one or two housekeeping genes are also essential.",
