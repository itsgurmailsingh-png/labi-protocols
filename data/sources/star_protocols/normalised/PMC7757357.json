  "steps": [
    {
      "step_id": 0,
      "title": "Obtain required approvals and reagents",
      "instruction": "Secure institutional biosafety, animal use, and human sample approvals; ensure a concentrated stock of shRNA‑expressing lentivirus is available for infection.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare 293T cells for virus production",
      "instruction": "Culture 293T cells in DMEM supplemented with 10 % heat‑inactivated fetal bovine serum (FBS) in a T175 flask, without adding any antibiotics, until the culture reaches approximately 75 % confluency.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Implement biosafety precautions",
      "instruction": "Perform all subsequent steps in a biosafety‑approved laboratory wearing double gloves, a lab coat, and appropriate protective gear while handling lentiviral samples.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
