  "steps": [
    {
      "step_id": 0,
      "title": "Determine tumor subgroup",
      "instruction": "Upload the DNA‑methylation microarray IDAT files to the Molecular Neuropathology Classifier website (compatible with classifier versions v11.4 and v12.5) to obtain a subgroup call for each sample; ensure you have prior knowledge of R and RStudio for downstream processing.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare computational environment",
      "instruction": "Install R version 4.2.2 and RStudio on a workstation with at least 16 GB RAM; verify that command‑line and Shiny‑app tutorials run under Linux (Ubuntu 20.04.5 LTS), macOS, or Windows.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Project data onto NMF model",
      "instruction": "Load the pre‑trained Non‑negative Matrix Factorization (NMF) model that was built using 331 medulloblastoma tumors and project the incoming sample data (RNA‑seq or DNA‑methylation) onto this model following the procedure described by Tamayo et al.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Compute G3/G4 continuum score",
      "instruction": "Identify the two metagenes that correspond to Group 3 and Group 4 patients, apply a logistic (log‑it) transformation to each metagene, calculate the ratio of the Group 3 metagene to the Group 4 metagene, and then scale this ratio to the 0–1 interval to obtain the G3/G4 continuum score.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Infer score from methylation",
      "instruction": "Apply the random‑forest regression model that was trained on 192 paired expression‑methylation profiles (out of the original 331) using 115 CpGs (RMSE = 0.036) to predict the continuum score directly from an Illumina Methylation450k or MethylationEPIC profile, without requiring an expression profile.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
