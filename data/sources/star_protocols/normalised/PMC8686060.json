{
  "protocol_id": "cryopreservation_protocol_for_euglena_gracilis",
  "parent_protocol_id": null,
  "title": "Cryopreservation protocol for Euglena gracilis",
  "author": "Shah, Morrison, et al.",
  "license": "CC-BY-4.0",
  "license_verified": true,
  "license_note": "CC-BY-4.0 - verified from PMC XML",
  "source_name": "star_protocols",
