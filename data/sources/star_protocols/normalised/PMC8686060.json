  "citation": "10.1016/j.xpro.2021.101043",
  "category": "Microbiology",
  "tags": [
    "cryopreservation",
    "euglena gracilis",
    "ln2",
    "cell culture",
    "biotechnology"
  ],
  "estimated_time_mins": 30,
  "materials": [
    "Mr. Frosty cooling unit",
    "cryobox",
    "cryorack",
    "LN2 storage dewar",
    "isopropanol",
    "sodium acetate trihydrate",
    "Lab-Lemco powder",
    "tryptone",
    "yeast extract",
    "calcium chloride",
    "glucose",
    "Trypan Blue solution",
    "ethanol",
    "cryovials",
    "Countess II FL Automated cell counter",
    "benchtop centrifuge",
    "Timing: 1 day\n3.Fill the Mr. Frosty cooling unit with 250 mL isopropanol and equilibrate overnight at 4°C.4.Pre-chill a cryo-box and cryo-rack (−196°C LN2) for long-term storage in LN2.5.Fill and prepare LN2 storage dewar.\nCRITICAL: Steps 3 and 4 should be done the day prior to cryopreservation.",
    "Timing: 15 min"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Obtain Euglena gracilis strain",
      "instruction": "Obtain Euglena gracilis strain Z (UTEX 753; catalogue number 0753) from the supplier.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare glucose‑supplemented growth media",
      "instruction": "Prepare modified E. gracilis media (MEGM) supplemented with glucose according to the published formulation (see CCAP link).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Fill Mr. Frosty with isopropanol",
      "instruction": "Add 250 mL reagent‑grade isopropanol to the Mr. Frosty cooling unit and equilibrate overnight at 4 °C. CRITICAL: This step (and the pre‑chilling of LN₂ equipment) must be performed the day prior to cryopreservation.",
      "substeps": [],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Pre‑chill cryo‑box and rack",
      "instruction": "Place a cryo‑box and cryo‑rack in liquid nitrogen (−196 °C) to pre‑chill them for long‑term storage.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Prepare LN₂ storage dewar",
      "instruction": "Fill the liquid‑nitrogen storage dewar with LN₂ and ensure it is ready for use.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Prepare cryoprotectant solution",
      "instruction": "Under sterile conditions, add 2 mL reagent‑grade methanol (MeOH) to 8 mL sterile glucose‑supplemented growth media to make 10 mL of 20 % (v/v) cryoprotective agent (CPA).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Filter‑sterilize CPA",
      "instruction": "Filter‑sterilize the CPA into a 50 mL sterile conical tube using a 0.2 µm filter attached to a 50 mL syringe; keep the tube at 19 °C–22 °C until use. CRITICAL: CPA must be prepared fresh on the day of use; prolonged storage or exposure to strong light reduces its efficiency.",
      "substeps": [],
      "is_critical": true,
      "timers": []
    }
  ],
