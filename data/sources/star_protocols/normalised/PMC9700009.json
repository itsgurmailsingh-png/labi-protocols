      "step_id": 0,
      "title": "Run IL‑CCM optimization",
      "instruction": "Execute the full workflow to generate, solve, and analyse the Installation‑Level China Coal Model (IL‑CCM).",
      "substeps": [
        {
          "instruction": "Gather the required input data in the provided spreadsheet files (including mine‑level production costs and capacities, which must be supplied separately as commercial data).",
          "title": ""
        },
        {
          "instruction": "Open the Jupyter notebook on a cloud‑computing instance and run the script that converts the spreadsheet inputs into a linear‑programming problem file (a .lp file).",
          "title": ""
        },
        {
          "instruction": "Download the generated .lp file to a local machine.",
          "title": ""
        },
        {
          "instruction": "Solve the .lp file with the CPLEX solver installed locally (or use a freeware alternative provided in the repository).",
          "title": ""
        },
        {
          "instruction": "Load the solution file into R using the supplied R scripts; process the raw output to extract model results.",
          "title": ""
        },
        {
          "instruction": "Create visualisations of the results (e.g., import volumes by origin, cost breakdowns) using the R visualisation scripts.",
