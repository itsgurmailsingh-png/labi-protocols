{
  "protocol_id": "protocol_to_study_synapse_density_or_volume_using_confocal_microscopy",
  "parent_protocol_id": null,
  "title": "Protocol to study synapse density or volume using confocal microscopy",
  "author": "Gcwensa, Long, et al.",
  "license": "CC-BY-4.0",
  "license_verified": true,
  "license_note": "CC-BY-4.0 - verified from PMC XML",
  "source_name": "star_protocols",
  "source_id": "PMC13084399",
  "source_url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC13084399/",
  "doi": "10.1016/j.xpro.2026.104465",
  "citation": "10.1016/j.xpro.2026.104465",
  "category": "Neuroscience",
  "tags": [
    "synapse density",
    "confocal microscopy",
    "imaris",
    "quantification",
    "mouse"
  ],
  "estimated_time_mins": 42,
  "materials": [
    "Nikon A1R Microscope",
    "Imaris",
    "VGLUT2 antibody",
    "HOMER1 antibody",
    "pSer129-synuclein antibody",
    "Timing: 2 min"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Save individual surface statistics",
      "instruction": "For each surface object (e.g., VGLUT2), export its Overall Statistics to a file.",
      "substeps": [
        {
          "instruction": "Activate the desired surface (e.g., VGLUT2).",
          "title": ""
        },
        {
          "instruction": "Select the “Statistics” tab.",
          "title": ""
        },
        {
          "instruction": "Select the “Overall” tab.",
          "title": ""
        },
        {
          "instruction": "Click the Save icon.",
          "title": ""
        },
        {
          "instruction": "Choose the single‑save option “Export Statistics on Tab Display to File”.",
          "title": ""
        },
        {
          "instruction": "Save the file as .csv, .xml, or .xls.",
          "title": ""
        },
        {
          "instruction": "Repeat the above for every surface object you wish to analyse.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Save mean statistics for all surfaces",
      "instruction": "Export the average values of all generated surface objects in the current Imaris scene.",
      "substeps": [
        {
          "instruction": "Activate the “Scene” folder at the top of the object list (applies to all surfaces).",
          "title": ""
        },
        {
          "instruction": "Select the “Statistics” tab.",
          "title": ""
        },
        {
          "instruction": "Select the “Detailed” tab.",
          "title": ""
        },
        {
          "instruction": "From the drop‑down menu, choose “Average Values”.",
          "title": ""
        },
        {
          "instruction": "Click the Save icon.",
          "title": ""
        },
        {
          "instruction": "Choose the single‑save option “Export Statistics on Tab Display to File”.",
          "title": ""
        },
        {
          "instruction": "Save the file as .csv, .xml, or .xls.",
          "title": ""
        },
        {
          "instruction": "Repeat for any additional scenes or image sets as needed.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Calculate puncta density per frame",
      "instruction": "Divide the number of puncta for the protein of interest by the total volume of the frame to obtain density (puncta/μm³).",
      "substeps": [
        {
          "instruction": "Obtain the puncta count from Imaris (example: 2865 VGLUT2 puncta).",
          "title": ""
        },
        {
          "instruction": "Obtain the total volume for the same frame (example: 34413.60 μm³).",
          "title": ""
        },
        {
          "instruction": "Compute density: 2865 / 34413.60 = 0.0833 puncta · μm⁻³.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Calculate mean puncta density across frames",
      "instruction": "Average the density values from at least four frames to obtain a mouse‑level mean density.",
      "substeps": [
        {
          "instruction": "Collect density values for each frame (example: 0.0833, 0.0858, 0.0789, 0.08574 μm⁻³).",
          "title": ""
        },
        {
          "instruction": "Sum the values and divide by the number of frames (4): (0.0833+0.0858+0.0789+0.08574)/4 = 0.0834 μm⁻³.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Calculate mean puncta volume across frames",
      "instruction": "Average the mean volume of puncta for each frame to obtain a mouse‑level mean volume.",
      "substeps": [
        {
          "instruction": "Collect mean volume values for each frame (example: 0.5484, 0.5834, 0.4532, 0.46564 μm³).",
          "title": ""
        },
        {
          "instruction": "Sum the values and divide by the number of frames (4): (0.5484+0.5834+0.4532+0.46564)/4 = 0.5127 μm³.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Perform statistical analysis",
      "instruction": "Use appropriate statistical software (e.g., R, Prism, SPSS) to test for differences in puncta density or volume between experimental conditions, after planning the analysis strategy in advance.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
