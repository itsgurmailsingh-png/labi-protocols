  "steps": [
    {
      "step_id": 0,
      "title": "Register images to Xenium",
      "instruction": "Register the fluorescence IHC image (acquired on an Akoya Vectra Polaris) and the H&E image (acquired on a Hamamatsu NanoZoomer S60 Digital Slide Scanner) to the Xenium Prime dataset (Human 5K panel, head‑and‑neck squamous cell carcinoma sample) using Warpy2 within FIJI and QuPath.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Assign pixel intensities to cells",
      "instruction": "Using the Xenium cell segmentation boundaries, assign each pixel’s IHC fluorescence intensity and each pixel of the binary H&E annotation mask to the corresponding cell.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Calculate mean intensity per cell",
      "instruction": "For each cell, compute the mean fluorescence intensity from the assigned IHC pixels.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Integrate data into anndata",
      "instruction": "Add the per‑cell mean intensity values as additional observation columns in the anndata object that already contains the Xenium transcriptomic data.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Visualize and analyze with Scanpy",
      "instruction": "Load the enriched anndata object into Scanpy (or compatible plugins) for downstream visualization and single‑cell analyses.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
