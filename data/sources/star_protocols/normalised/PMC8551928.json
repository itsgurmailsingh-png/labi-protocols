  "steps": [
    {
      "step_id": 0,
      "title": "Maintain cells in incubator",
      "instruction": "Culture human iPSCs and differentiated cells in a humidified incubator set to 37 °C with 5 % CO₂, using StemMACS human iPSC Brew medium (Miltenyi) or TeSR‑E8 medium (Stemcell Technologies).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Verify hiPSC confluence and passage",
      "instruction": "Confirm that hiPSC cultures are 70‑80 % confluent, contain no differentiated cells, and are between passage 10 and passage 40 before initiating the differentiation protocol.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Prepare and condition media and dishes",
      "instruction": "Prepare all required media, solutions, and matrix‑coated culture dishes. Supplement the media with N‑2 and B‑27 supplements and store at 4 °C for up to 2 weeks. Add growth‑factor supplements (or other supplements) fresh each time the medium is used. Before use, bring all media to room temperature (20 °C–24 °C) or 37 °C.",
      "substeps": [
        {
