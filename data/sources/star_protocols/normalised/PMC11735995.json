  "estimated_time_mins": 12,
  "materials": [
    "Brimonidine",
    "Yohimbine",
    "Fetal calf serum (FCS)",
    "100x penicillin-streptomycin-L-glutamine (PSG)",
    "DMEM, high glucose",
    "Trypsin, 0.25% (w/v)-2.21 mM EDTA",
    "Hank’s balanced salt solution (HBSS)",
    "Phosphate-buffered saline (PBS)",
    "Gelatin type-B, 2% (w/v)",
    "NaCl",
    "HEPES",
    "NaH2PO4",
    "CaCl2·2H2O",
    "KCl",
    "MgCl2·6H2O",
    "Glucose",
    "Timing: 2 h"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Warm reagents",
      "instruction": "Warm HEK293T DMEM, 2× HBS, 2 M CaCl₂, and ddH₂O in a 37 °C water bath.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Replace cell culture media",
      "instruction": "Aspirate existing media from each well of a 6‑well plate (cells at 50‑60 % confluence) and add 1.5 mL fresh HEK293T DMEM per well, dispensing slowly against the wall to avoid detaching cells. Return plate to the incubator.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Prepare calcium‑phosphate mix",
      "instruction": "Create the calcium‑phosphate transfection solution using the specified volumes and DNA amounts.",
      "substeps": [
        {
          "instruction": "Add 122 μL 2× HBS to a 5‑mL polystyrene tube.",
          "title": ""
        },
        {
          "instruction": "In a second 5‑mL tube, mix 105.6 μL ddH₂O with 14.4 μL 2 M CaCl₂.",
          "title": ""
        },
        {
          "instruction": "Add plasmid DNA to the CaCl₂ tube: 200 ng α2A‑AR plasmid and 50 ng Gαi1 ONE‑GO sensor plasmid (total DNA volume kept <10 μL).",
          "title": ""
        },
        {
          "instruction": "Vortex the DNA tube at medium speed for 5 s, then let it sit for ~5 min.",
          "title": ""
        },
        {
          "instruction": "Add the entire CaCl₂/DNA volume dropwise to the 2× HBS tube while vortexing at ~30 % of maximum speed; hold the HBS tube steady and pipette the CaCl₂ solution slowly.",
          "title": ""
        },
        {
          "instruction": "Incubate the combined mixture at 18‑23 °C for 25 min.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Add transfection mix to cells",
      "instruction": "Deliver the prepared transfection mixture to the cells and ensure even distribution.",
      "substeps": [
        {
          "instruction": "Add the entire transfection mixture dropwise to each well and gently rock the plate to mix.",
          "title": ""
        },
        {
          "instruction": "For replicate wells, scale reagents proportionally (e.g., for triplicates use 366 μL 2× HBS, 316.8 μL ddH₂O, 43.2 μL 2 M CaCl₂, and three‑fold plasmid amounts) and resuspend the precipitate before addition.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Incubate and replace media",
      "instruction": "Allow cells to recover and then replace the culture medium.",
      "substeps": [
        {
          "instruction": "Return the plate to the incubator.",
          "title": ""
        },
        {
          "instruction": "After ~6 h, replace the media with 2 mL pre‑warmed HEK293T DMEM per well.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Perform luminescence assay",
      "instruction": "Measure biosensor luminescence the following day; optionally starve cells for ~18 h if the GPCR requires desensitization.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
