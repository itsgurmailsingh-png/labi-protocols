{
  "protocol_id": "protocol_for_detecting_introgressed_archaic_variants_with_sprime",
  "parent_protocol_id": null,
  "title": "Protocol for Detecting Introgressed Archaic Variants with SPrime",
  "author": "Zhou, Browning",
  "license": "CC-BY-4.0",
  "license_verified": true,
  "license_note": "CC-BY-4.0 - verified from PMC XML",
  "source_name": "star_protocols",
  "source_id": "PMC8164089",
  "source_url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8164089/",
  "doi": "10.1016/j.xpro.2021.100550",
  "citation": "10.1016/j.xpro.2021.100550",
  "category": "Genomics & Sequencing",
  "tags": [
    "sprime",
    "archaic variants",
    "genotype data",
    "vcf files",
    "linux"
  ],
  "estimated_time_mins": 54,
  "materials": [
    "1000 Genomes Project data",
    "high coverage data from New York Genome Center",
    "Altai Denisovan genome",
    "Vindija Neanderthal genome",
    "HapMap genetic map",
    "SPrime software",
    "bcftools",
    "SAMtools",
    "R scripts",
    "Linux computer with bash",
    "Genotype data (VCF files)",
    "Timing: 1.5 h"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Install SPrime software",
      "instruction": "Download the latest SPrime release from https://github.com/browning-lab/sprime, place the file sprime.jar into the project’s tools folder, and verify the installation by executing java -jar sprime.jar which prints the parameter help message.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Extract samples and filter SNPs",
      "instruction": "Using the 1000 Genomes Phase 3 genotype data, extract the CHB (n=103) target samples and the YRI (n=108) outgroup samples, create a VCF list for chromosomes 1‑22, and filter each chromosome to retain only bi‑allelic SNPs.",
      "substeps": [
        {
          "instruction": "Set pfile=../download/1000genome/integrated_call_samples_v3.20130502.ALL.panel",
          "title": ""
        },
        {
          "instruction": "grep -E \"(YRI|CHB)\" ${pfile} | cut -f1 > sample.txt",
          "title": ""
        },
        {
          "instruction": "grep YRI ${pfile} | cut -f1 > outgroup.txt",
          "title": ""
        },
        {
          "instruction": "echo -n \"\" > vcf.file.list",
          "title": ""
        },
        {
          "instruction": "for chr in {1..22}; do",
          "title": ""
        },
        {
          "instruction": "vcf=../download/1000genome/ALL.chr${chr}.phase3_shapeit2_mvncall_integrated_v5a.20130502.genotypes.vcf.gz",
          "title": ""
        },
        {
          "instruction": "outvcf=../tmp/chr${chr}.vcf.gz",
          "title": ""
        },
        {
          "instruction": "echo ${outvcf} >> vcf.file.list",
          "title": ""
        },
        {
          "instruction": "bcftools view --samples-file sample.txt ${vcf} |",
          "title": ""
        },
        {
          "instruction": "bcftools view -c1 -m2 -M2 -v snps |",
          "title": ""
        },
        {
          "instruction": "bcftools annotate -x INFO,ˆFORMAT/GT -Oz > ${outvcf}",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        },
        {
          "instruction": "Note: this extraction and filtering step takes ≈5 h and uses ≤13.5 MB RAM.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Concatenate autosomal VCFs",
      "instruction": "Combine the filtered chromosome VCFs listed in vcf.file.list into a single whole‑genome VCF required by SPrime.",
      "substeps": [
        {
          "instruction": "bcftools concat --file-list vcf.file.list --naive --output-type z --output all.auto.vcf.gz",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Run SPrime per chromosome",
      "instruction": "Execute SPrime on each autosome using the HapMap combined LD map (Plink format, GRCh37) with the CHB target VCF and YRI outgroup list, producing a score file for each chromosome.",
      "substeps": [
        {
          "instruction": "map=../download/plinkmap/plink.all.GRCh37.map",
          "title": ""
        },
        {
          "instruction": "outgroup=../step2/outgroup.txt",
          "title": ""
        },
        {
          "instruction": "gt=../step2/all.auto.vcf.gz",
          "title": ""
        },
        {
          "instruction": "for chr in {1..22}; do",
          "title": ""
        },
        {
          "instruction": "out=chb.yri.${chr}",
          "title": ""
        },
        {
          "instruction": "java -jar ../tools/sprime.jar gt=${gt} outgroup=${outgroup} map=${map} out=${out} chrom=${chr}",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        },
        {
          "instruction": "Note: the full run takes ≈1 h and each chromosome uses ≤4.6 GB RAM.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Map variants to archaic genomes",
      "instruction": "For each chromosome, add a match status column to the SPrime score file by comparing to the Vindija Neanderthal and Altai Denisovan genomes using the provided map_arch C script.",
      "substeps": [
        {
          "instruction": "maparch=\"../tools/map_arch_genome/map_arch\"",
          "title": ""
        },
        {
          "instruction": "for chr in {1..22}; do",
          "title": ""
        },
        {
          "instruction": "script=o.script.${chr}.sh",
          "title": ""
        },
        {
          "instruction": "# Neanderthal mapping",
          "title": ""
        },
        {
          "instruction": "bedfile=\"../download/archaic_genome/RecalledVindija/chr${chr}_mask.bed.gz\"",
          "title": ""
        },
        {
          "instruction": "archaicfile=\"../download/archaic_genome/RecalledVindija/chr${chr}_mq25_mapab100.vcf.gz\"",
          "title": ""
        },
        {
          "instruction": "reftag=\"AltaiNean\"",
          "title": ""
        },
        {
          "instruction": "scorefile=\"../step3/chb.yri.${chr}.score\"",
          "title": ""
        },
        {
          "instruction": "outmscore=\"out.chr${chr}.mscore\"",
          "title": ""
        },
        {
          "instruction": "tmpprefix=../tmp/${RANDOM}",
          "title": ""
        },
        {
          "instruction": "echo \"#! /bin/bash",
          "title": ""
        },
        {
          "instruction": "${maparch} --kp --sep '\\t' --tag ${reftag} --mskbed ${bedfile} --vcf ${archaicfile} --score ${scorefile} > ${tmpprefix}.tmp1.${chr}.mscore\" > ${script}",
          "title": ""
        },
        {
          "instruction": "# Denisovan mapping",
          "title": ""
        },
        {
          "instruction": "bedfile=\"../download/archaic_genome/RecalledDenisova/chr${chr}_mask.bed.gz\"",
          "title": ""
        },
        {
          "instruction": "archaicfile=\"../download/archaic_genome/RecalledDenisova/chr${chr}_mq25_mapab100.vcf.gz\"",
          "title": ""
        },
        {
          "instruction": "reftag=\"AltaiDeni\"",
          "title": ""
        },
        {
          "instruction": "echo \"${maparch} --kp --sep '\\t' --tag ${reftag} --mskbed ${bedfile} --vcf ${archaicfile} --score ${tmpprefix}.tmp1.${chr}.mscore > ${tmpprefix}.tmp2.${chr}.mscore",
          "title": ""
        },
        {
          "instruction": "mv ${tmpprefix}.tmp2.${chr}.mscore ${outmscore}",
          "title": ""
        },
        {
          "instruction": "rm ${tmpprefix}.*.${chr}.mscore",
          "title": ""
        },
        {
          "instruction": "rm ${script}\" >> ${script}",
          "title": ""
        },
        {
          "instruction": "sh ${script}",
          "title": ""
        },
        {
          "instruction": "done",
          "title": ""
        },
        {
          "instruction": "Note: mismatch analysis requires ~7 min for chromosome 2 and ~81 min for all autosomes; max RAM per chromosome is 10 GB.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Calculate segment match rates (optional)",
      "instruction": "Summarize match‑status scores per introgressed segment and generate a contour plot showing multiple archaic sources.",
      "substeps": [
        {
          "instruction": "Rscript ../tools/score_summary.r ../step4 match.summary.txt   # produces match.summary.txt",
          "title": ""
        },
        {
          "instruction": "Rscript ../tools/plot_contour.r match.summary.txt chb.contour   # creates contour plot files",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
