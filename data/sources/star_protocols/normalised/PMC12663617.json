{
  "protocol_id": "protocol_for_culturing_olfactory_epithelium_organoids_supporting_neuronal_differ",
  "parent_protocol_id": null,
  "title": "Protocol for culturing olfactory epithelium organoids supporting neuronal differentiation",
  "author": "Gameiro, Virtanen, et al.",
  "license": "CC-BY-4.0",
  "license_verified": true,
  "license_note": "CC-BY-4.0 - verified from PMC XML",
  "source_name": "star_protocols",
  "source_id": "PMC12663617",
  "source_url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC12663617/",
  "doi": "10.1016/j.xpro.2025.104211",
  "citation": "10.1016/j.xpro.2025.104211",
  "category": "Cell Biology",
  "tags": [
    "organoids",
    "olfactory epithelium",
    "neuronal differentiation",
    "immunostaining",
    "papain",
    "mouse"
  ],
  "estimated_time_mins": 18,
  "materials": [
    "Rat anti-Sox2",
    "Chicken anti-Krt14",
    "Mouse anti-TUBB3",
    "HBSS 1X",
    "Papain",
    "DNase I",
    "DMEM/F12",
    "Primocin 1x",
    "Recombinant murine R-spondin 1",
    "Recombinant murine Noggin",
    "Recombinant murine Wnt-3a",
    "Y27632",
    "Cultrex Stem Cell Qualified Reduced Growth Factor Basement Membrane Extract",
    "PBS pH 7.4 1x",
    "Bovine serum albumin (BSA)"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Gather required reagents",
      "instruction": "Consult the Key Resources Table and collect all listed reagents, including papain dissociation mix, organoid growth media, and any antibodies needed for staining.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Set up dissection equipment",
      "instruction": "Arrange the following items on a dissection board: five 20G needles (0.9 mm × 40 mm, BD PrecisionGlide), Pearson Rongeurs, narrow pattern forceps, two Dumont #5 jeweller’s forceps, spring scissors, (Strabismus) scissors, a #15 scalpel blade, a 10 cm Petri dish, and a 10 ml syringe with a 20G needle (0.9 mm × 40 mm) that has been cut and blunted manually.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Prepare enzymatic reagents on ice",
      "instruction": "Thaw papain dissociation mix and organoid growth media on ice, or prepare them fresh on the day of the experiment, and keep them on ice throughout the procedure.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Keep Cultrex media chilled",
      "instruction": "Maintain all Cultrex‑containing media on ice at all times to prevent premature solidification.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Aspirate media and optional PBS wash",
      "instruction": "On day 7 of culture, completely aspirate the culture media from each well, leaving only the gel coating; optionally rinse briefly with PBS.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Fix organoids with 4% PFA",
      "instruction": "Add 4 % paraformaldehyde (PFA) prepared in 1× PBS, pH 7.2–7.4, directly to the wells and incubate for 15 min at room temperature. Use PFA aliquots that have been pH‑adjusted and stored frozen at –20 °C; do not reuse after thawing.",
      "substeps": [],
      "is_critical": true,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Remove fixative and incubate PBST",
      "instruction": "Carefully remove the PFA solution (the gelatinous surface should disappear, revealing organoids). Then incubate the wells with PBST for 15 min at room temperature for permeabilization.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Prepare antibody solutions",
      "instruction": "Make primary and secondary antibody dilutions using the concentrations listed in the Key Resources Table. Use Triton X‑100 (not Tween 20) in the antibody dilution buffer, which also serves as a blocking buffer; a separate blocking step is unnecessary.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Incubate with primary antibodies",
      "instruction": "Add primary antibody solution (with optional DAPI) to the samples and incubate for 1 h at room temperature or overnight at 4 °C with gentle agitation.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Wash with PBST after primary",
      "instruction": "Wash the samples three times with PBST.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Incubate with secondary antibodies",
      "instruction": "Add secondary antibody solution and incubate for 1 h at room temperature.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 11,
      "title": "Wash with PBST after secondary",
      "instruction": "Wash the samples 1–3 times with PBST.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 12,
      "title": "Detach chamber slide cassette",
      "instruction": "Remove the chamber slide cassette. If using NEST chamber slides, decontaminate and sterilize the clamping mechanism and chamber with UV light and 70 % ethanol for reuse; ensure surfaces face the UV source. Ibidi and Thermo Scientific Lab‑Tek slides cannot be reused.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 13,
      "title": "Mount slides and store",
      "instruction": "Mount the slides with Fluoromount G. Store mounted slides at 4 °C for short‑term use or at –20 °C for extended storage.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
