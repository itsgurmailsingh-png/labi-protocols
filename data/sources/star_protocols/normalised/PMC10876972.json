  "steps": [
    {
      "step_id": 0,
      "title": "Plan analysis timeline",
      "instruction": "Allocate 1–2 days for the transgene integration analysis after you begin the genotyping workflow.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Delay genotyping to ≥10 days",
      "instruction": "Although genotyping can be attempted at day 7 post‑electroporation, wait until at least day 10 (≥10 days after transfection) to avoid false‑positive PCR from residual P‑modified dsDNA donor that remains stable for 5–7 days if not incorporated.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Collect eggs, wash, extract DNA",
      "instruction": "Retrieve cultured schistosome eggs, wash them three times with 1× PBS, and isolate genomic DNA using DNAzol ES according to the manufacturer’s protocol.",
      "substeps": [
        {
          "instruction": "Retrieve eggs from culture.",
          "title": ""
        },
        {
          "instruction": "Wash eggs 3 × with 1× PBS.",
          "title": ""
        },
        {
          "instruction": "Extract genomic DNA with DNAzol ES following the supplier’s instructions.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Design primers outside homology arms",
      "instruction": "Place each genotyping primer at least 50 nt outside the donor homology arms to prevent amplification of episomal donor DNA; design primers with NCBI Primer‑Blast using the ‘nr’ database and excluding ‘Schistosomatidae’.",
      "substeps": [
        {
          "instruction": "Select primer sites ≥50 nt away from homology arms.",
          "title": ""
        },
        {
          "instruction": "Run Primer‑Blast (https://www.ncbi.nlm.nih.gov/tools/primer-blast/) with database = nr and exclude = Schistosomatidae.",
          "title": ""
        },
        {
          "instruction": "Verify that primers do not cross‑amplify the wild‑type GSH1 locus or other genomic regions.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Perform PCR with KI primers",
      "instruction": "Prepare a fresh PCR master mix and amplify the extracted DNA using the 5′ KI and 3′ KI specific primer pairs; include a positive‑control PCR to confirm genomic DNA integrity for each sample.",
      "substeps": [
        {
          "instruction": "Prepare fresh PCR master mix.",
          "title": ""
        },
        {
          "instruction": "Set up reactions with 5′ KI primer pair.",
          "title": ""
        },
        {
          "instruction": "Set up reactions with 3′ KI primer pair.",
          "title": ""
        },
        {
          "instruction": "Include a positive‑control PCR using a universal genomic DNA primer set for each treatment and control sample.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
