  "materials": [
    "Streptococcus pyogenes Alt-R HiFi Cas9 nuclease",
    "Opti-MEM",
    "DMEM",
    "Fetal bovine serum",
    "Antibiotic antimycotic",
    "Phusion high-fidelity DNA polymerase",
    "NucBlue Live ReadyProbes reagent",
    "Deoxynucleotide set, 100 mM",
    "AmPure XP bead-based reagent",
    "Custom guide RNA",
    "HA-donor forward primer",
    "HA-donor reverse primer",
