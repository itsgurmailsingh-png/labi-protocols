  "steps": [
    {
      "step_id": 0,
      "title": "Define assay system",
      "instruction": "Study the effect of O‑GlcNAc on sphingosine‑1‑phosphate (S1P)‑mediated 2D cell contraction in mouse embryonic fibroblast NIH3T3 cells and on 3D cell contraction in primary human dermal fibroblast BJ‑5ta cells; the same protocol can also be used to examine lysophosphatidic acid (LPA) signaling (Morales et al., 2021).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare O‑GlcNAc inhibitors",
      "instruction": "Obtain small‑molecule inhibitors: Thiamet‑G (Sigma Aldrich, catalog SML0244) or synthesize Thiamet‑G and Ac45SGlcNAc according to the literature (Yuzwa et al., 2008; Gloster et al., 2011); alternatively acquire the OGT inhibitor OSMI‑4 (Selleck Chem, catalog S8910).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
