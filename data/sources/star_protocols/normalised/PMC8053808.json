{
  "protocol_id": "in_vitro_differentiation_of_human_pluripotent_stem_cells_into_the_b_lineage",
  "parent_protocol_id": null,
  "title": "In vitro differentiation of human pluripotent stem cells into the B lineage",
  "author": "Richardson, Ghazanfari, et al.",
