  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Aliquot CD34‑enriched cells",
      "instruction": "Take an aliquot of the CD34‑enriched fraction for staining; no additional Fc‑blocking is required because Fc block was performed in step 7b.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Harvest cells for staining",
      "instruction": "Collect cells at the desired culture time (day 10‑31 of differentiation; for B‑cell analysis use day 24‑31) and keep them on ice until staining.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Prepare antibody cocktail",
      "instruction": "Make a staining cocktail containing 2×‑concentrated antibodies diluted in MACS buffer.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Set up staining controls",
      "instruction": "Include unstained cells, fluorescence‑minus‑one (FMO) controls for each fluorochrome, and a stroma‑only control (MS5 cells without hematopoietic cells) to assess background.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Mix cells with staining cocktail",
      "instruction": "Combine equal volumes of the 2× antibody cocktail and the Fc‑receptor‑blocked cell suspension.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Incubate staining mixture",
      "instruction": "Incubate the mixture in the dark on a shaker for 40 min at 4 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Wash stained cells",
      "instruction": "Add 1 mL MACS buffer, mix gently, then centrifuge at 300 g for 5 min.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Resuspend with viability dye",
      "instruction": "Discard supernatant and resuspend the cell pellet in MACS buffer containing 1× viability dye (e.g., 7‑AAD).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Adjust staining volume",
      "instruction": "Scale the total staining volume proportionally to the number of cells being processed.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Titrate antibodies if needed",
      "instruction": "Perform a titration series to determine the optimal antibody concentration for your samples.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Prepare flow cytometer",
      "instruction": "Set up the flow cytometer (BD Fortessa X20 or BD Aria III) with single‑stained compensation beads and a sample stained only with the viability dye; for cell sorting use a 100 µm nozzle to reduce mechanical stress.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 11,
      "title": "Acquire and analyze data",
      "instruction": "Run samples, applying the following gating strategy: singlets → scatter → viability (7‑AAD) → CD45⁺ (human) → CD19/CD34 for B‑cell identification; include CD10, CD20, CD11b, CD14 as needed. Use counting beads for absolute quantification if desired.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
