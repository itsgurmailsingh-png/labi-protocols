  ],
  "estimated_time_mins": 24,
  "materials": [
    "pET-17b-tamavidin 2",
    "Ampicillin sodium salt",
    "Isopropyl-β-D-thiogalactopyranoside",
    "Phenylmethylsulfonyl fluoride",
    "Dimethyl sulfoxide",
    "NaCl",
    "CAPS",
    "Ammonium acetate",
    "Iminobiotin agarose",
    "HEPES",
    "Magnesium chloride hexahydrate",
    "Polyethylene glycol 6000",
    "Glutaraldehyde solution",
    "C24:1 galactosyl(β) ceramide",
    "NanoDrop 2000c spectrophotometer",
    "Sample scanning HS-AFM instrument"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Transform competent E. coli",
      "instruction": "Transform competent E. coli cells (e.g., BL21(DE3)) with the tamavidin 2 expression vector.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Grow culture to mid‑log phase",
      "instruction": "Inoculate the transformed cells into 800 mL LB medium containing 100 µg/mL ampicillin and incubate at 37 °C with shaking until OD₆₀₀ reaches 0.5–0.8.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Induce protein expression",
      "instruction": "Add 800 µL of 0.5 M IPTG (final 0.5 mM) to the culture, then shake at ~120 rpm for ~18 h at 25 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Harvest cells",
      "instruction": "Centrifuge the culture at 4 °C, 4000 × g for 10 min and collect the cell pellet.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Store cell pellet",
      "instruction": "Freeze the pellet at –80 °C until further use.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Prepare buffers",
      "instruction": "Prepare Buffer L, Buffer W, Buffer E, and Buffer S as described in the Materials and Equipment section.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Resuspend and add protease inhibitor",
      "instruction": "Resuspend the frozen pellet in 50 mL Buffer L and add 50 µL of 1 M PMSF (final 1 mM).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 7,
      "title": "Lyse cells by sonication",
      "instruction": "Sonicate the suspension on ice using 0.2 s pulses with 0.8 s intervals at ~200 W for a total of 10 min.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 8,
      "title": "Clarify lysate",
      "instruction": "Centrifuge the sonicated suspension at 4 °C, 18 000 × g for 40 min and collect the clear supernatant.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 9,
      "title": "Purify with 2‑iminobiotin agarose",
      "instruction": "Purify tamavidin 2 using a 2‑iminobiotin agarose column as follows:",
      "substeps": [
        {
          "instruction": "Transfer 2 mL of 2‑iminobiotin agarose resin slurry into an empty Bio‑Rad column.",
          "title": ""
        },
        {
          "instruction": "Equilibrate the column with 4 column volumes of Buffer L.",
          "title": ""
        },
        {
          "instruction": "Apply the clarified supernatant to the column.",
          "title": ""
        },
        {
          "instruction": "Wash the column with 20 column volumes of Buffer W.",
          "title": ""
        },
        {
          "instruction": "Elute tamavidin 2 with 5 column volumes of Buffer E.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 10,
      "title": "Concentrate and exchange buffer",
      "instruction": "Concentrate the eluate and exchange it into Buffer S using an Amicon Ultra‑15 (10 kDa MWCO) centrifugal filter.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 11,
      "title": "Clarify concentrated protein",
      "instruction": "Centrifuge the concentrated tamavidin 2 solution at 12 000 × g, 4 °C for 10 min and collect the supernatant.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 12,
      "title": "Adjust final protein concentration",
      "instruction": "Measure absorbance at 280 nm (ε = 41 750 M⁻¹·cm⁻¹ per subunit); concentrate the solution to 150 µM (A₂₈₀ = 6.26).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
