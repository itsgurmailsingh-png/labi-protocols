      "step_id": 0,
      "title": "Thaw and expand Nalm6 cells",
      "instruction": "Thaw frozen Nalm6 cells and expand them, ensuring enough cells for the entire experiment; plan to add eight Nalm6 cells for each T cell (effector:target ratio 1:8) every other day, and maintain Nalm6 cultures at a density of 1 × 10^6 cells/mL.",
      "substeps": [
        {
          "instruction": "Ensure sufficient Nalm6 cells for the number of conditions being evaluated.",
          "title": ""
        },
        {
          "instruction": "Add 8× as many Nalm6 cells as T cells (E:T = 1:8) every other day.",
          "title": ""
        },
        {
          "instruction": "Maintain Nalm6 cell concentration at 1 × 10^6 cells/mL.",
          "title": ""
        }
      ],
