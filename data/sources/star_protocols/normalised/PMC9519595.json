  "steps": [
    {
      "step_id": 0,
      "title": "Dry and titrate m-CPBA",
      "instruction": "Dry the m‑chloroperbenzoic acid (m‑CPBA) under vacuum for 1 h at the Schlenk line, then titrate it as described by Vogel et al.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Distill amine (if needed)",
      "instruction": "Distill the amine unless it is taken directly from a new bottle.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Degas deionized water",
      "instruction": "Degas the deionized water prior to use by argon bubbling and store under argon.",
      "substeps": [
        {
          "instruction": "Keep the water in a pear‑shaped flask sealed with a septum; insert a long needle connected to a Schlenk line through the septum into the solvent.",
          "title": ""
        },
        {
          "instruction": "Add a needle outlet on the septum to allow oxygen to escape while argon is bubbled through the water.",
          "title": ""
        },
        {
          "instruction": "Store the water under an argon atmosphere for up to one week.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Prepare dried reaction vessels",
      "instruction": "Use flame‑ or oven‑dried reaction vessels; employ microwave vials for small‑scale reactions (0.1–1.0 mmol) and round‑bottom flasks for larger scales.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Use and degas anhydrous solvents",
      "instruction": "Use anhydrous solvents obtained from a VAC solvent‑purification system and degas each solvent by argon bubbling for 15 min before every reaction.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
