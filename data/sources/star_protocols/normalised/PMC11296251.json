{
  "protocol_id": "generating_in_frame_seamless_knockins_in_drosophila_using_seedharvest_technology",
  "parent_protocol_id": null,
  "title": "Generating In-Frame Seamless Knockins in Drosophila Using SEED/Harvest Technology",
  "author": "Aguilar, Bauer, et al.",
  "license": "CC-BY-4.0",
  "license_verified": true,
  "license_note": "CC-BY-4.0 - verified from PMC XML",
  "source_name": "star_protocols",
  "source_id": "PMC11296251",
  "source_url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC11296251/",
  "doi": "10.1016/j.xpro.2024.102932",
  "citation": "10.1016/j.xpro.2024.102932",
  "category": "Genomics & Sequencing",
  "tags": [
    "drosophila",
    "knockin",
    "crispr",
    "plasmid",
    "gene editing"
  ],
  "estimated_time_mins": 36,
  "materials": [
    "TOP10 electrocompetent E. coli",
    "Q5 polymerase",
    "OneTaq Hot Start Quick-Load 2X master mix",
    "BbsI",
    "Gibson assembly master mix",
    "NEBridge Golden Gate Assembly (BsaI-HF v2)",
    "NEBridge Golden Gate Assembly (BsmBI-v2)",
    "SdNTP mix 10 mM",
    "DNA gel loading dye 6x",
    "1 kb DNA ladder",
    "Nuclease-free water",
    "GelRed nucleic acid gel stain",
    "Proteinase K",
    "Agarose",
    "T4 DNA ligase reaction buffer",
    "Miniprep Plasmid Purification Kit",
    "Timing: 1.5 months"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Create digital target map",
      "instruction": "Generate a digital map of the target region using a DNA analysis platform (e.g., SnapGene, Benchling, SerialCloner). Include exons, introns, splice acceptors, and start/stop codons.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Download and analyze target sequence",
      "instruction": "Obtain the gene FASTA from FlyBase Sequence Downloader (enter FBgn, select “sequence features”, download “all FASTA”). Alternatively use FlyBase genomic‑location → sequence → get sequence, Ensembl export, or UCSC genome browser. Sequence the targeted area in the chosen fly strain (e.g., nos‑Cas9) to verify gRNA sites and off‑targets. Set the viewer so the gene is on the top strand in transcription direction; flip if it is on the bottom strand.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Prepare plasmid and verify sequence",
      "instruction": "Perform colony picking, miniprep, sequencing, and midiprep to obtain injection‑ready plasmid.",
      "substeps": [
        {
          "instruction": "Pick 2–4 colonies and inoculate each into 3 mL LB + 100 µg/mL ampicillin; incubate 12–16 h at 37 °C with shaking.",
          "title": ""
        },
        {
          "instruction": "Purify plasmid from the cultures with a Miniprep kit (use 2 mL for purification, store the remainder at 4 °C).",
          "title": ""
        },
        {
          "instruction": "Send the Miniprep DNA for Sanger sequencing using primers U6_fwd or T3_fwd.",
          "title": ""
        },
        {
          "instruction": "If the sequence is correct, use the remaining culture (kept at 4 °C) to inoculate 110 mL LB + 100 µg/mL ampicillin; incubate 12–16 h at 37 °C, 180 rpm.",
          "title": ""
        },
        {
          "instruction": "Optional pre‑screen: perform colony‑PCR with primers U6_fwd and T3_fwd; expect a 985 bp band (see https://www.crisprflydesign.org/wp-content/uploads/2016/07/pCFD5cloningprotocol.pdf).",
          "title": ""
        },
        {
          "instruction": "Purify plasmid from the 100 mL culture with a Midiprep kit; elute in 200–350 µL endotoxin‑free water and measure concentration with a NanoDrop spectrophotometer.",
          "title": ""
        },
        {
          "instruction": "Store purified plasmid at –20 °C (long‑term) or make glycerol stocks at –70 °C; plates should be retained for troubleshooting.",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Screen and isolate knock‑in flies",
      "instruction": "Set up crosses with y,w flies, screen F1 for 3xP3 fluorescence, and establish balanced lines.",
      "substeps": [
        {
          "instruction": "Collect sufficient y,w (yellow & white mutant) virgin females and males before injection survivors hatch.",
          "title": ""
        },
        {
          "instruction": "Set up single crosses between each injection survivor and y,w flies (other backgrounds may be used).",
          "title": ""
        },
        {
          "instruction": "Screen the F1 generation (larvae or adults) for 3xP3‑dsRED or 3xP3‑GFP fluorescence in eye, brain, and midgut; for larval screening, transfer fluorescent candidates to fresh tubes.",
          "title": ""
        },
        {
          "instruction": "Note that fluorescence intensity varies between loci and lines; wide divergence may indicate off‑target integration, while uniform intensity suggests identical insertions.",
          "title": ""
        },
        {
          "instruction": "CRITICAL: 3xP3‑dsRED is generally easier to detect in larvae.",
          "title": ""
        },
        {
          "instruction": "Cross ten fluorescent candidates individually to appropriate balancer flies (balancer choice depends on knock‑in location) and follow segregation using fluorescence.",
          "title": ""
        },
        {
          "instruction": "Established SEED stocks can be maintained at 18 °C without removing the SEED cassette.",
          "title": ""
        },
        {
          "instruction": "Alternatively, cross 3xP3‑positive flies directly to the Harvester stock (ensure Harvester flies are males to avoid cassette removal by maternally supplied Cas9).",
          "title": ""
        }
      ],
      "is_critical": false,
      "timers": []
    }
  ],
  "verification_status": "literature_sourced",
  "normalised_at": "2026-06-19T00:25:30.059302Z",
  "llm_normalised": true,
  "description": "The precise, targeted manipulation of genetic information is fundamental in biological research. Gene editing has permitted not only the functional dissection of transcriptional and non-transcriptional units, but also the predictable manipulation of protein-coding sequences. When engineering proteins, two manipulations stand out: peptide tagging and the generation of specific allelic variants. The addition of tags is an important step for many downstream applications, such as protein visualization or purification, and more recently, direct protein manipulation in vivo. Here we describe in detail the generation of knockins using the SEED/Harvest technology, from donor template generation to the efficient excision of the selectable marker.",
  "content_type": "protocol",
  "content_type_score": 44,
  "exclude_low_confidence": false,
  "_whole_protocol_attempted": true,
