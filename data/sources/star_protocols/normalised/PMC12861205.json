  "steps": [
    {
      "step_id": 0,
      "title": "Expand hiPSCs for differentiation",
      "instruction": "Culture plated hiPSCs for 4 days (≈10 min work per day) so that they reach ~90–100 % confluency by day 0. Seed at 0.5 × 10⁴–2 × 10⁴ cells/cm² depending on proliferation rate to achieve this density.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Remove ROCK inhibitor medium (day –2)",
      "instruction": "Two days after passaging (day –2), discard the ROCK‑inhibitor‑containing medium and add StemMACS Brew medium without ROCK inhibitor.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Refresh StemMACS Brew medium (day –1)",
      "instruction": "On the following day (day –1), replace the medium with fresh StemMACS Brew medium (still without ROCK inhibitor).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Confirm confluency before differentiation (day 0)",
      "instruction": "Ensure cells have reached 90–100 % confluency (uniform monolayer, no visible gaps, no multilayering or detachment) before starting differentiation on day 0.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
  "verification_status": "literature_sourced",
  "normalised_at": "2026-06-19T01:04:45.708141Z",
  "llm_normalised": true,
  "description": "This protocol was developed and optimized to generate contractile vSMCs from hiPSCs for downstream functional and molecular analyses. In its current form, the protocol has been validated using collagen gel contraction assays and by assessing expression of vSMC markers together with expression changes in markers associated with epicardial development. The technique is compatible with downstream genetic perturbation approaches. As a proof of concept, gene modulation was performed in differentiated vSMCs via CRISPR activation (a) approach. Minor adaptations to the protocol may be required when applying the protocol to different hiPSC lines.",
