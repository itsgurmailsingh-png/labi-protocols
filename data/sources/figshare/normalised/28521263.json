  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Harvest fibroblasts and macrophages",
      "instruction": "Isolate peritoneal fibroblasts, bone‑marrow‑derived macrophages (BMDM), and peritoneal macrophages from five male C57BL/6J mice (8–13 weeks old) using standard tissue‑digestion and cell‑collection methods.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Plate fibroblasts in AMCF",
      "instruction": "Seed fibroblasts at 20,000 cells per well in AMCF medium and incubate 24 h at 37 °C with 5 % CO₂.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Plate macrophages according to condition",
      "instruction": "After the 24‑h fibroblast incubation, add macrophages at 30,000 cells per well in BMDM medium in one of three configurations: (a) macrophages alone; (b) directly on top of the fibroblast monolayer; (c) in transwell inserts placed above fibroblasts seeded on the bottom plate.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Incubate macrophage cultures",
      "instruction": "Culture the macrophage‑containing wells for an additional 24 h under the same conditions (37 °C, 5 % CO₂).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Replace media with LPS or control",
      "instruction": "Remove the existing media and add fresh AMCF medium containing 100 ng/mL LPS to the LPS‑treated wells; add plain AMCF medium to the control wells (no LPS).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Incubate after LPS stimulation",
      "instruction": "Maintain all wells for 16 h at 37 °C with 5 % CO₂.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 6,
      "title": "Harvest cells for qPCR",
      "instruction": "Collect cells from each well, lyse, and extract RNA for quantitative PCR analysis as described in the study.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
