  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Extract total RNA with TRIzol",
      "instruction": "Homogenize silkworm (Dazao) tissue and extract total RNA using TRIzol reagent (Ambion, USA) according to the manufacturer’s protocol.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Measure RNA concentration (NanoDrop)",
      "instruction": "Determine the concentration of the extracted RNA with a NanoDrop 2000 spectrophotometer.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Digest genomic DNA with DNase I",
      "instruction": "Treat the RNA sample with DNase I (Promega, USA) at 37 °C for 30 min to remove contaminating genomic DNA.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Synthesize cDNA using miRNA RT kit",
      "instruction": "Use the miRNA reverse transcription kit (Clontech, USA) to synthesize cDNA from the DNase‑treated RNA following the kit instructions.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Run qPCR on ABI 7500 fast",
      "instruction": "Perform real‑time fluorescent quantitative PCR (qPCR) on an ABI 7500 Fast instrument using the synthesized cDNA.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 5,
      "title": "Prepare qRT‑PCR primers for miRNAs",
      "instruction": "Add the following primers to the qPCR reactions: qmiR‑274‑5p (TTTGTGACCGTCACTAACGGGCA), qmiR‑274‑3p (TCGTTTTGGCGATCGCAAAATG), qmiR‑1175 (AAGTGGAGTAGTGGTCTCATCG).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
