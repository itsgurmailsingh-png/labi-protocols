  "steps": [
    {
      "step_id": 0,
      "title": "Prepare MIN6 cell culture medium",
      "instruction": "Prepare Dulbecco’s Minimum Essential Medium (DMEM) supplemented with 15 % fetal bovine serum, 100 U ml⁻¹ penicillin, 100 µg ml⁻¹ streptomycin, and 142 µM β‑mercaptoethanol. Pre‑warm the medium and keep cells in a humidified incubator at 37 °C with 5 % CO₂/95 % air.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Seed MIN6 cells for IP1 assay",
      "instruction": "Plate 5 × 10⁴ MIN6 cells per well in a sterile 96‑well plate. Incubate for 2 days to allow attachment and growth before stimulation.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Stimulate and lyse cells for IP1 measurement",
      "instruction": "Wash cells once with stimulation buffer containing 10 mM LiCl. Add 100 µM carbachol (CCh) in the same buffer and incubate at 37 °C for 60 min. Lyse cells with the lysis buffer provided in the IP‑One Tb kit and determine IP1 levels according to the kit instructions.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Isolate pancreatic islets from mice",
      "instruction": "Euthanize mouse by cervical dislocation. Dissolve Collagenase P to 0.5 mg ml⁻¹ in ice‑cold Krebs‑Ringer buffer (115 mM NaCl, 4.7 mM KCl, 1.2 mM KH₂PO₄, 1.2 mM MgSO₄, 2.56 mM CaCl₂, 20 mM NaHCO₃, 10 mM HEPES, 0.1 % BSA, 5 mM glucose, pH 7.3). Inject this solution via the common bile duct into the pancreas, excise the pancreas and digest in a shaking water bath at 37 °C for 12–15 min. Wash the released islets twice in warm KRB and hand‑pick viable islets under a stereomicroscope.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Culture isolated islets overnight",
      "instruction": "Transfer hand‑picked islets to RPMI medium containing 10 % fetal bovine serum, 100 U ml⁻¹ penicillin, and 100 µg ml⁻¹ streptomycin. Incubate overnight at 37 °C with 5 % CO₂/95 % air in a humidified atmosphere.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
