      "title": "Culture Hybridomas in Serum‑Free Medium",
      "instruction": "Grow anti‑TFF3 hybridoma cells in serum‑free hybridoma medium (Gibco, Grand Island, NY, USA) under standard cell‑culture conditions.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
