    },
    {
      "step_id": 4,
      "title": "Download structural data (first structure)",
      "instruction": "Use the builder to download the first mmCIF file (PDB ID 1oj6) and store the returned builder reference:",
      "substeps": [
        {
          "instruction": "download1 = builder.download(url='https://files.wwpdb.org/download/1oj6.cif')",
