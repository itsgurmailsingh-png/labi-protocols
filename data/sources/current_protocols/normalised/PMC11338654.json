      "instruction": "Write `protocol3.py` to visualise a single heme ligand:",
      "substeps": [
        {
          "instruction": "import molviewspec as mvs",
          "title": ""
        },
        {
          "instruction": "builder = mvs.create_builder()",
          "title": ""
        },
        {
          "instruction": "download = builder.download(url='https://www.ebi.ac.uk/pdbe/entry-files/download/4hhb_updated.cif')",
