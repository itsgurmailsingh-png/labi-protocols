  "estimated_time_mins": 18,
  "materials": [
    "Linux or MacOS 64‐bit operating system",
    "ExpansionHunter",
    "REViewer",
    "Samtools",
    "wget",
    "unzip",
    "Illumina short‐read sequencing files",
    "reference genome in FASTA format",
    "ExpansionHunter variant catalogue file in JSON format"
  ],
  "steps": [
    {
      "step_id": 0,
      "title": "Choose ExpansionHunter mode",
      "instruction": "Decide whether to run ExpansionHunter in “seeking” (default) for small catalogues or in “streaming” for large catalogues. Seeking uses the alignment file index to locate specific reads and requires a sorted, indexed BAM or CRAM file. Streaming reads the alignment file in a single pass, does not need indexing, consumes more memory (proportional to catalogue size), and may give different repeat‑size estimates for repeats longer than the read length.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Prepare alignment file for seeking mode",
      "instruction": "If you selected seeking mode, ensure the input BAM or CRAM file is sorted and has an accompanying index file (.bai or .crai).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Run ExpansionHunter",
      "instruction": "Execute ExpansionHunter with the chosen mode (seeking or streaming) on the prepared alignment file. No additional parameters are required beyond the mode selection; the software will automatically process the reads according to the selected mode.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Select STRipy analysis type",
      "instruction": "Set the STRipy “--analysis” parameter to either “standard” (default) or “extended”. Use “extended” only for repeats longer than the read length (typically 150 bp); this option attempts to detect mis‑aligned reads from long expansions but may still under‑ or over‑estimate allele size.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Run STRipy with chosen analysis",
      "instruction": "Run STRipy using the selected “--analysis” setting on the ExpansionHunter output to obtain repeat size estimates.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
