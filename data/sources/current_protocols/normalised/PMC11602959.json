{
  "protocol_id": "analysis_of_tandem_repeats_in_shortread_sequencing_data",
  "parent_protocol_id": null,
  "title": "Analysis of Tandem Repeats in Short‐Read Sequencing Data",
  "author": "Halman, Lonsdale, et al.",
  "license": "CC-BY-4.0",
