      "title": "Design DUF247 constructs",
      "instruction": "Generate a full‑length DUF247 construct and three fragments: fragment A (amino acids 1‑216), fragment B (amino acids 217‑468), and fragment C (amino acids 469‑503). Also prepare fragment AB (A + B) and fragment ABC (full‑length DUF248).",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "PCR amplify fragments",
      "instruction": "Amplify each DUF247 fragment (A, B, C, AB, ABC) using a high‑fidelity DNA polymerase.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Clone into entry vector",
      "instruction": "Insert each amplified fragment into the entry vector pGGC (GreenGate system) so that mVenus is fused as an N‑terminal tag.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Add promoter",
      "instruction": "Place the Ubiquitin 10 promoter upstream of the cloned insert in the entry vector.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Sequence entry clones",
      "instruction": "Evaluate each entry clone by Sanger sequencing to verify that no mutations are present.",
