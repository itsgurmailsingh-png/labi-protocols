  "materials": [],
  "steps": [
    {
      "step_id": 0,
      "title": "Prepare DNA template dilutions",
      "instruction": "Dilute the DNA extract (the same extract used for amplicon sequencing) to mitigate PCR inhibitors; keep enough volume for triplicate analysis of each sample.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 1,
      "title": "Assemble qPCR reaction mix",
      "instruction": "For each 20 µL reaction combine Luna® Universal qPCR Master Mix (NEB), 1 µL of the diluted template DNA, forward primer 341F (Muyzer et al., 1993), and reverse primer 518R (Muyzer et al., 1993) in a PCR plate; set up each sample in triplicate and include an Escherichia coli V3 amplicon standard.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 2,
      "title": "Run qPCR program",
      "instruction": "Place the plate in a 7500 Fast Real-Time PCR System (Applied Biosystems™, Thermo Fisher Scientific) and run the following program: initial denaturation 95 °C for 1 min; 40 cycles of 95 °C for 15 s (denaturation) followed by 60 °C for 30 s (extension). Record a melting curve from 60 °C to 95 °C.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 3,
      "title": "Generate standard curve and calculate efficiency",
      "instruction": "Using the E. coli V3 amplicon standard, construct a standard curve to determine the 16S rRNA gene copy number per gram of soil; note that the average amplification efficiency observed was 100.77 % ± 3.15 %. Normalize sample copy numbers against this standard.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    },
    {
      "step_id": 4,
      "title": "Compute absolute phylum copy numbers",
      "instruction": "Multiply the normalized 16S rRNA gene copy numbers for each sample by the relative abundance percentages obtained from 16S rRNA gene sequencing to obtain absolute copy numbers for each bacterial phylum.",
      "substeps": [],
      "is_critical": false,
      "timers": []
    }
  ],
